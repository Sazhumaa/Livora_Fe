---
import { ClientRouter } from 'astro:transitions';
import Navbar from '../components/common/Navbar.astro';
import FloatingHud from '../components/common/FloatingHud.astro';
import AuthModal from '../components/auth/AuthModal.astro';
import ActiveOrderBanner from '../components/common/ActiveOrderBanner.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { 
  title = "AFTERGLOW — Cinematic Live Concert Ticketing Platform",
  description = "MUSIC FADES. MEMORIES DON'T. Discover headliners, secure authentic digital concert passes, and experience unforgettable live moments with zero latency."
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0B090B" />

    <!-- Google Fonts Preconnect -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <!-- Speculation Rules for Instant Client-Side Navigation -->
    <script type="speculationrules">
      {
        "prefetch": [
          {
            "source": "document",
            "where": {
              "and": [
                { "href_matches": "/*" }
              ]
            },
            "eagerness": "moderate"
          }
        ]
      }
    </script>

    <!-- Theme, Language & Auth Pre-Paint Flash Prevention -->
    <script is:inline>
      (function() {
        try {
          const root = document.documentElement;
          const stored = localStorage.getItem('theme');
          const isDark = stored === 'dark' || (stored !== 'light' && window.matchMedia('(prefers-color-scheme: dark)').matches);
          root.classList.toggle('dark', isDark);
          root.classList.toggle('light', !isDark);

          const themeMeta = document.querySelector('meta[name="theme-color"]');
          if (themeMeta) {
            themeMeta.setAttribute('content', isDark ? '#0B090B' : '#FAF7F9');
          }

          const storedLang = localStorage.getItem('afterglow_lang') === 'en' ? 'en' : 'id';
          root.lang = storedLang;
          root.setAttribute('data-lang', storedLang);

          const hasAuth = Boolean(localStorage.getItem('afterglow_access_token') && localStorage.getItem('afterglow_user'));
          root.setAttribute('data-auth', hasAuth ? 'true' : 'false');
        } catch (e) {}
      })();
    </script>

    <!-- Astro View Transitions Engine -->
    <ClientRouter />
  </head>
  <body class="bg-[#FAF7F9] dark:bg-void-black text-neutral-900 dark:text-soft-white antialiased selection:bg-electric-magenta selection:text-white">
    <!-- Ambient Concert Embers Canvas (Persisted Background) -->
    <canvas 
      id="stage-embers-canvas"
      transition:persist="stage-embers"
      class="fixed inset-0 pointer-events-none z-0 opacity-20 dark:opacity-60 w-full h-full"
    ></canvas>

    <!-- Global Persistent Navigation -->
    <Navbar />

    <!-- Main Content Area (no z-index stacking context so page modals can layer cleanly above Navbar) -->
    <main class="relative flex flex-col min-h-screen">
      <slot />
    </main>

    <!-- Floating HUD Elements -->
    <FloatingHud />

    <!-- Active Pending Order Recovery Banner -->
    <ActiveOrderBanner />

    <!-- Global Passwordless Auth Modal -->
    <AuthModal />

    <!-- Client-side Motion, Intersection & Language Scripts -->
    <script>
      import '../scripts/scrollObserver';
      import '../scripts/stageEmbers';
      import '../scripts/hudObserver';
      import '../scripts/lenisInit';
      import '../scripts/theme';
      import '../scripts/i18n';
    </script>
  </body>
</html>
