---
// AFTERGLOW Cinematic Motion-Graphic Auth Modal (Passwordless OTP)
// Art Direction: Void Black (#0B090B) x Electric Magenta (#D14D91) x Soundwave Motion Graphic
---

<div 
  id="auth-modal" 
  class="fixed inset-0 z-50 flex items-center justify-center p-4 sm:p-6 opacity-0 pointer-events-none transition-all duration-500"
  role="dialog" 
  aria-modal="true" 
  aria-hidden="true"
>
  <!-- Backdrop Blur with Ambient Stage Lighting -->
  <div 
    id="auth-modal-backdrop" 
    class="absolute inset-0 bg-neutral-950/55 dark:bg-void-black/80 backdrop-blur-xl transition-opacity duration-500 cursor-pointer"
  ></div>

  <!-- Stage Laser Beam Accent Gradients -->
  <div class="absolute -top-32 left-1/2 -translate-x-1/2 w-96 h-96 bg-electric-magenta/15 dark:bg-electric-magenta/25 rounded-full blur-[120px] pointer-events-none animate-pulse"></div>
  <div class="absolute -bottom-32 left-1/4 w-80 h-80 bg-deep-magenta/15 dark:bg-deep-magenta/30 rounded-full blur-[100px] pointer-events-none"></div>

  <!-- Modal Shell -->
  <div 
    id="auth-modal-card" 
    class="relative w-full max-w-md rounded-3xl bg-white/95 dark:bg-dark-plum/95 border border-neutral-200 dark:border-white/15 p-7 sm:p-9 shadow-2xl backdrop-blur-2xl overflow-hidden scale-95 transition-all duration-500 ease-cinematic text-neutral-950 dark:text-soft-white"
  >
    <!-- Animated Neon Border Glow Ray -->
    <div class="absolute top-0 left-0 right-0 h-[2px] bg-gradient-to-r from-transparent via-electric-magenta to-transparent animate-pulse"></div>

    <!-- Close Button -->
    <button 
      id="auth-modal-close" 
      type="button" 
      aria-label="Tutup Dialog Masuk" 
      class="absolute top-5 right-5 w-9 h-9 rounded-full flex items-center justify-center bg-neutral-100 dark:bg-white/5 border border-neutral-200 dark:border-white/10 text-neutral-500 dark:text-muted-gray hover:text-neutral-950 dark:hover:text-soft-white hover:border-neutral-300 dark:hover:border-white/30 hover:bg-neutral-200/70 dark:hover:bg-white/10 transition-all duration-200"
    >
      <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>

    <!-- Header Section with Stage Equalizer Motion Graphic -->
    <div class="flex items-center gap-4 mb-6">
      <!-- Dynamic Equalizer Animation Disc -->
      <div class="relative w-14 h-14 rounded-2xl bg-neutral-950 dark:bg-void-black/80 border border-electric-magenta/40 flex items-center justify-center shadow-magenta-glow shrink-0 overflow-hidden group">
        <!-- Laser sweep line -->
        <div class="absolute inset-0 bg-gradient-to-b from-transparent via-electric-magenta/20 to-transparent translate-y-[-100%] animate-[scan_3s_ease-in-out_infinite]"></div>
        
        <!-- Live SVG Audio Equalizer Bars -->
        <div class="flex items-end gap-1 h-6">
          <span class="w-1 bg-electric-magenta rounded-full animate-[soundbar_0.8s_ease-in-out_infinite_alternate] h-2"></span>
          <span class="w-1 bg-electric-magenta rounded-full animate-[soundbar_1.1s_ease-in-out_infinite_alternate-reverse] h-5"></span>
          <span class="w-1 bg-soft-white rounded-full animate-[soundbar_0.7s_ease-in-out_infinite_alternate] h-6"></span>
          <span class="w-1 bg-electric-magenta rounded-full animate-[soundbar_1s_ease-in-out_infinite_alternate-reverse] h-3"></span>
          <span class="w-1 bg-electric-magenta rounded-full animate-[soundbar_0.9s_ease-in-out_infinite_alternate] h-4"></span>
        </div>
      </div>

      <div>
        <span class="text-[10px] font-bold tracking-[0.25em] text-electric-magenta uppercase block font-mono">
          AKSES GERBANG // PASSWORDLESS
        </span>
        <h2 id="auth-modal-title" class="font-display text-3xl tracking-wide text-neutral-950 dark:text-soft-white">
          MASUK ARENA KONSER
        </h2>
      </div>
    </div>

    <!-- Alert / Toast Container -->
    <div id="auth-alert" class="hidden mb-5 p-3.5 rounded-xl text-xs font-medium border flex items-start gap-2.5 transition-all">
      <svg class="w-4 h-4 shrink-0 mt-0.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
      </svg>
      <span id="auth-alert-text" class="flex-1"></span>
    </div>

    <!-- Dev Mode Quick-Fill Pill -->
    <div id="auth-dev-pill" class="hidden mb-5 p-2.5 rounded-xl bg-electric-magenta/10 dark:bg-electric-magenta/15 border border-electric-magenta/30 dark:border-electric-magenta/40 flex items-center justify-between gap-2 text-xs">
      <div class="flex items-center gap-1.5 font-mono text-[11px] text-electric-magenta">
        <span class="w-1.5 h-1.5 rounded-full bg-electric-magenta animate-ping"></span>
        <span>DEV OTP: <strong id="auth-dev-otp-code" class="text-neutral-950 dark:text-soft-white tracking-widest text-sm">------</strong></span>
      </div>
      <button 
        id="auth-dev-autofill-btn" 
        type="button" 
        class="px-2.5 py-1 rounded-md bg-electric-magenta text-white font-bold text-[10px] uppercase tracking-wider hover:brightness-110 active:scale-95 transition-all"
      >
        Isi Otomatis
      </button>
    </div>

    <!-- ============================================== -->
    <!-- STEP 1: REQUEST OTP FORM (EMAIL & NAME)        -->
    <!-- ============================================== -->
    <form id="auth-step1-form" class="space-y-4">
      <div>
        <label for="auth-email-input" class="block text-xs font-semibold uppercase tracking-wider text-neutral-600 dark:text-muted-gray mb-1.5 font-mono">
          Alamat Email Resmi <span class="text-electric-magenta">*</span>
        </label>
        <div class="relative">
          <input 
            type="email" 
            id="auth-email-input" 
            required 
            placeholder="nama@email.com" 
            autocomplete="email" 
            class="w-full px-4 py-3 pl-11 rounded-xl bg-neutral-50 dark:bg-void-black/70 border border-neutral-300 dark:border-white/15 text-sm text-neutral-950 dark:text-soft-white placeholder-neutral-400 dark:placeholder-muted-gray/60 focus:outline-none focus:border-electric-magenta focus:ring-1 focus:ring-electric-magenta transition-all"
          />
          <svg class="w-4 h-4 text-neutral-400 dark:text-muted-gray absolute left-4 top-1/2 -translate-y-1/2 pointer-events-none" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M16 12a4 4 0 10-8 0 4 4 0 008 0zm0 0v1.5a2.5 2.5 0 005 0V12a9 9 0 10-9 9m4.5-1.206a8.959 8.959 0 01-4.5 1.206" />
          </svg>
        </div>
        <p class="text-[11px] text-neutral-500 dark:text-muted-gray mt-1">Kami akan mengirimkan 6-digit kode tiket ke email ini.</p>
      </div>

      <div>
        <label for="auth-username-input" class="block text-xs font-semibold uppercase tracking-wider text-neutral-600 dark:text-muted-gray mb-1.5 font-mono">
          Nama Lengkap Penonton <span class="text-neutral-400 dark:text-muted-gray/60 text-[10px]">(Opsional / Akun Baru)</span>
        </label>
        <div class="relative">
          <input 
            type="text" 
            id="auth-username-input" 
            placeholder="Contoh: Budi Santoso" 
            autocomplete="name" 
            class="w-full px-4 py-3 pl-11 rounded-xl bg-neutral-50 dark:bg-void-black/70 border border-neutral-300 dark:border-white/15 text-sm text-neutral-950 dark:text-soft-white placeholder-neutral-400 dark:placeholder-muted-gray/60 focus:outline-none focus:border-electric-magenta focus:ring-1 focus:ring-electric-magenta transition-all"
          />
          <svg class="w-4 h-4 text-neutral-400 dark:text-muted-gray absolute left-4 top-1/2 -translate-y-1/2 pointer-events-none" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
          </svg>
        </div>
      </div>

      <!-- Submit Request Button -->
      <button 
        type="submit" 
        id="auth-submit-step1-btn" 
        class="w-full mt-2 py-3.5 px-6 rounded-xl bg-electric-magenta text-white font-bold text-sm tracking-wider uppercase flex items-center justify-center gap-2 hover:shadow-magenta-glow transition-all duration-300 hover:scale-[1.01] active:scale-[0.99] disabled:opacity-50 disabled:pointer-events-none"
      >
        <span class="btn-text">DAPATKAN KODE AKSES PANGGUNG</span>
        <svg class="w-4 h-4 btn-spinner hidden animate-spin" fill="none" viewBox="0 0 24 24">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
        </svg>
      </button>

      <!-- Quick Test Accounts Helper -->
      <div class="pt-4 border-t border-neutral-200 dark:border-white/10 text-center">
        <span class="text-[11px] text-neutral-500 dark:text-muted-gray block mb-2 font-mono">Akun Uji Demo Cepat:</span>
        <div class="flex flex-wrap items-center justify-center gap-1.5">
          <button type="button" data-fill-account="buyer@soundtix.id" class="px-2.5 py-1 rounded-md bg-neutral-100 dark:bg-white/5 border border-neutral-200 dark:border-white/10 text-[10px] font-mono text-neutral-600 dark:text-muted-gray hover:text-neutral-950 dark:hover:text-soft-white hover:border-electric-magenta/60 transition-colors">
            buyer@soundtix.id
          </button>
          <button type="button" data-fill-account="organizer@soundtix.id" class="px-2.5 py-1 rounded-md bg-neutral-100 dark:bg-white/5 border border-neutral-200 dark:border-white/10 text-[10px] font-mono text-neutral-600 dark:text-muted-gray hover:text-neutral-950 dark:hover:text-soft-white hover:border-electric-magenta/60 transition-colors">
            organizer@soundtix.id
          </button>
          <button type="button" data-fill-account="gatecrew@soundtix.id" class="px-2.5 py-1 rounded-md bg-neutral-100 dark:bg-white/5 border border-neutral-200 dark:border-white/10 text-[10px] font-mono text-neutral-600 dark:text-muted-gray hover:text-neutral-950 dark:hover:text-soft-white hover:border-electric-magenta/60 transition-colors">
            gatecrew@soundtix.id
          </button>
          <button type="button" data-fill-account="admin@soundtix.id" class="px-2.5 py-1 rounded-md bg-amber-50 dark:bg-amber-500/10 border border-amber-200 dark:border-amber-500/30 text-[10px] font-mono text-amber-700 dark:text-amber-300 hover:text-amber-900 dark:hover:text-soft-white hover:border-amber-400 transition-colors">
            admin@soundtix.id
          </button>
        </div>
      </div>
    </form>

    <!-- ============================================== -->
    <!-- STEP 2: VERIFY OTP FORM (6-DIGIT PIN BOXES)    -->
    <!-- ============================================== -->
    <form id="auth-step2-form" class="space-y-5 hidden">
      <div class="p-3.5 rounded-xl bg-neutral-50 dark:bg-void-black/60 border border-neutral-200 dark:border-white/10 flex items-center justify-between text-xs">
        <div class="truncate">
          <span class="text-[10px] text-neutral-500 dark:text-muted-gray block font-mono">KODE TERKIRIM KE:</span>
          <span id="auth-sent-target-email" class="font-semibold text-neutral-950 dark:text-soft-white truncate block"></span>
        </div>
        <button 
          id="auth-change-email-btn" 
          type="button" 
          class="text-electric-magenta hover:underline text-[11px] font-semibold shrink-0 ml-2"
        >
          Ganti Email
        </button>
      </div>

      <div>
        <label class="block text-xs font-semibold uppercase tracking-wider text-neutral-600 dark:text-muted-gray mb-2 font-mono text-center">
          Masukkan 6-Digit Kode Verifikasi
        </label>
        
        <!-- 6 OTP Inputs -->
        <div class="flex justify-between gap-2 sm:gap-2.5" id="otp-input-group">
          <input type="text" inputmode="numeric" maxlength="1" pattern="[0-9]" data-otp-index="0" class="otp-box w-12 h-14 sm:w-13 sm:h-16 text-center font-display text-2xl sm:text-3xl bg-neutral-50 dark:bg-void-black/80 border border-neutral-300 dark:border-white/20 rounded-xl text-neutral-950 dark:text-soft-white focus:outline-none focus:border-electric-magenta focus:shadow-magenta-glow transition-all" autofocus />
          <input type="text" inputmode="numeric" maxlength="1" pattern="[0-9]" data-otp-index="1" class="otp-box w-12 h-14 sm:w-13 sm:h-16 text-center font-display text-2xl sm:text-3xl bg-neutral-50 dark:bg-void-black/80 border border-neutral-300 dark:border-white/20 rounded-xl text-neutral-950 dark:text-soft-white focus:outline-none focus:border-electric-magenta focus:shadow-magenta-glow transition-all" />
          <input type="text" inputmode="numeric" maxlength="1" pattern="[0-9]" data-otp-index="2" class="otp-box w-12 h-14 sm:w-13 sm:h-16 text-center font-display text-2xl sm:text-3xl bg-neutral-50 dark:bg-void-black/80 border border-neutral-300 dark:border-white/20 rounded-xl text-neutral-950 dark:text-soft-white focus:outline-none focus:border-electric-magenta focus:shadow-magenta-glow transition-all" />
          <input type="text" inputmode="numeric" maxlength="1" pattern="[0-9]" data-otp-index="3" class="otp-box w-12 h-14 sm:w-13 sm:h-16 text-center font-display text-2xl sm:text-3xl bg-neutral-50 dark:bg-void-black/80 border border-neutral-300 dark:border-white/20 rounded-xl text-neutral-950 dark:text-soft-white focus:outline-none focus:border-electric-magenta focus:shadow-magenta-glow transition-all" />
          <input type="text" inputmode="numeric" maxlength="1" pattern="[0-9]" data-otp-index="4" class="otp-box w-12 h-14 sm:w-13 sm:h-16 text-center font-display text-2xl sm:text-3xl bg-neutral-50 dark:bg-void-black/80 border border-neutral-300 dark:border-white/20 rounded-xl text-neutral-950 dark:text-soft-white focus:outline-none focus:border-electric-magenta focus:shadow-magenta-glow transition-all" />
          <input type="text" inputmode="numeric" maxlength="1" pattern="[0-9]" data-otp-index="5" class="otp-box w-12 h-14 sm:w-13 sm:h-16 text-center font-display text-2xl sm:text-3xl bg-neutral-50 dark:bg-void-black/80 border border-neutral-300 dark:border-white/20 rounded-xl text-neutral-950 dark:text-soft-white focus:outline-none focus:border-electric-magenta focus:shadow-magenta-glow transition-all" />
        </div>
      </div>

      <!-- Resend Timer -->
      <div class="text-center text-xs">
        <span id="auth-resend-countdown" class="text-neutral-500 dark:text-muted-gray font-mono">
          Kirim ulang kode dalam <strong id="auth-timer-sec" class="text-electric-magenta font-bold">60</strong>s
        </span>
        <button 
          id="auth-resend-btn" 
          type="button" 
          class="hidden text-electric-magenta hover:underline font-bold uppercase tracking-wider text-[11px]"
        >
          Kirim Ulang Kode Sekarang
        </button>
      </div>

      <!-- Verify Button -->
      <button 
        type="submit" 
        id="auth-submit-step2-btn" 
        class="w-full py-3.5 px-6 rounded-xl bg-electric-magenta text-white font-bold text-sm tracking-wider uppercase flex items-center justify-center gap-2 hover:shadow-magenta-glow transition-all duration-300 hover:scale-[1.01] active:scale-[0.99] disabled:opacity-50 disabled:pointer-events-none"
      >
        <span class="btn-text">VERIFIKASI & MASUK ARENA</span>
        <svg class="w-4 h-4 btn-spinner hidden animate-spin" fill="none" viewBox="0 0 24 24">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
        </svg>
      </button>
    </form>
  </div>
</div>

<style>
  @keyframes scan {
    0% { transform: translateY(-100%); }
    50% { transform: translateY(100%); }
    100% { transform: translateY(-100%); }
  }

  @keyframes soundbar {
    0% { height: 4px; }
    100% { height: 24px; }
  }
</style>

<script>
  import { requestOtp, verifyOtp } from '../../lib/auth';

  let currentEmail = '';
  let currentUsername = '';
  let resendTimerInterval: any = null;
  let remainingSeconds = 60;

  function initAuthModal() {
    const modal = document.getElementById('auth-modal');
    const backdrop = document.getElementById('auth-modal-backdrop');
    const card = document.getElementById('auth-modal-card');
    const closeBtn = document.getElementById('auth-modal-close');
    const step1Form = document.getElementById('auth-step1-form') as HTMLFormElement;
    const step2Form = document.getElementById('auth-step2-form') as HTMLFormElement;
    const emailInput = document.getElementById('auth-email-input') as HTMLInputElement;
    const usernameInput = document.getElementById('auth-username-input') as HTMLInputElement;
    const alertBox = document.getElementById('auth-alert');
    const alertText = document.getElementById('auth-alert-text');
    const devPill = document.getElementById('auth-dev-pill');
    const devOtpCode = document.getElementById('auth-dev-otp-code');
    const devAutofillBtn = document.getElementById('auth-dev-autofill-btn');
    const step1Btn = document.getElementById('auth-submit-step1-btn') as HTMLButtonElement;
    const step2Btn = document.getElementById('auth-submit-step2-btn') as HTMLButtonElement;
    const sentEmailSpan = document.getElementById('auth-sent-target-email');
    const changeEmailBtn = document.getElementById('auth-change-email-btn');
    const resendBtn = document.getElementById('auth-resend-btn');
    const resendCountdown = document.getElementById('auth-resend-countdown');
    const timerSec = document.getElementById('auth-timer-sec');
    const otpBoxes = document.querySelectorAll<HTMLInputElement>('.otp-box');

    if (!modal) return;

    // Open Modal Function
    window.openAuthModal = () => {
      showAlert('', false);
      resetForms();
      modal.classList.remove('opacity-0', 'pointer-events-none');
      card?.classList.remove('scale-95');
      card?.classList.add('scale-100');
      emailInput?.focus();
    };

    // Close Modal Function
    window.closeAuthModal = () => {
      modal.classList.add('opacity-0', 'pointer-events-none');
      card?.classList.remove('scale-100');
      card?.classList.add('scale-95');
      clearInterval(resendTimerInterval);
    };

    backdrop?.addEventListener('click', window.closeAuthModal);
    closeBtn?.addEventListener('click', window.closeAuthModal);

    // Escape Key to close
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !modal.classList.contains('pointer-events-none')) {
        window.closeAuthModal();
      }
    });

    // Quick account fill buttons
    document.querySelectorAll<HTMLButtonElement>('[data-fill-account]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const acc = btn.dataset.fillAccount;
        if (acc && emailInput) {
          emailInput.value = acc;
          emailInput.focus();
        }
      });
    });

    function showAlert(msg: string, isError = true) {
      if (!alertBox || !alertText) return;
      if (!msg) {
        alertBox.classList.add('hidden');
        return;
      }
      alertBox.classList.remove('hidden');
      alertText.textContent = msg;

      if (isError) {
        alertBox.className = 'mb-5 p-3.5 rounded-xl text-xs font-medium border flex items-start gap-2.5 transition-all bg-red-50 dark:bg-red-950/40 border-red-200 dark:border-red-500/40 text-red-700 dark:text-red-200';
      } else {
        alertBox.className = 'mb-5 p-3.5 rounded-xl text-xs font-medium border flex items-start gap-2.5 transition-all bg-emerald-50 dark:bg-emerald-950/40 border-emerald-200 dark:border-emerald-500/40 text-emerald-700 dark:text-emerald-200';
      }
    }

    function setBtnLoading(btn: HTMLButtonElement, loading: boolean) {
      btn.disabled = loading;
      const text = btn.querySelector('.btn-text');
      const spinner = btn.querySelector('.btn-spinner');
      if (loading) {
        text?.classList.add('opacity-50');
        spinner?.classList.remove('hidden');
      } else {
        text?.classList.remove('opacity-50');
        spinner?.classList.add('hidden');
      }
    }

    function resetForms() {
      step1Form?.reset();
      step2Form?.reset();
      step1Form?.classList.remove('hidden');
      step2Form?.classList.add('hidden');
      devPill?.classList.add('hidden');
      clearInterval(resendTimerInterval);
    }

    // Step 1: Request OTP
    step1Form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      showAlert('');
      currentEmail = emailInput.value.trim().toLowerCase();
      currentUsername = usernameInput.value.trim();

      if (!currentEmail) return;

      setBtnLoading(step1Btn, true);
      try {
        const res = await requestOtp(currentEmail, currentUsername);

        // Switch to Step 2
        step1Form.classList.add('hidden');
        step2Form.classList.remove('hidden');
        if (sentEmailSpan) sentEmailSpan.textContent = currentEmail;

        // Dev mode OTP pill display
        if (res.otp && devPill && devOtpCode) {
          devOtpCode.textContent = res.otp;
          devPill.classList.remove('hidden');
          devAutofillBtn?.addEventListener('click', () => {
            fillOtpBoxes(res.otp!);
          }, { once: true });
        }

        startResendTimer();
        otpBoxes[0]?.focus();
      } catch (err: any) {
        showAlert(err.message || 'Gagal meminta kode OTP. Coba beberapa saat lagi.', true);
      } finally {
        setBtnLoading(step1Btn, false);
      }
    });

    // Step 2: Verify OTP
    step2Form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      showAlert('');

      const otp = Array.from(otpBoxes).map((b) => b.value).join('');
      if (otp.length !== 6) {
        showAlert('Silakan masukkan 6 digit kode OTP secara lengkap.', true);
        return;
      }

      setBtnLoading(step2Btn, true);
      try {
        const verifyRes = await verifyOtp(currentEmail, otp, currentUsername);
        showAlert(`Selamat datang di arena, ${verifyRes.user.username || 'Sobat Musik'}!`, false);

        setTimeout(() => {
          window.closeAuthModal();
          // Reload or navigate if ?next= is set
          const params = new URLSearchParams(window.location.search);
          const next = params.get('next');
          if (next) {
            window.location.href = next;
          }
        }, 1200);
      } catch (err: any) {
        showAlert(err.message || 'Kode OTP tidak valid atau sudah kedaluwarsa.', true);
        otpBoxes.forEach((b) => b.value = '');
        otpBoxes[0]?.focus();
      } finally {
        setBtnLoading(step2Btn, false);
      }
    });

    // Change Email Back to Step 1
    changeEmailBtn?.addEventListener('click', () => {
      step2Form.classList.add('hidden');
      step1Form.classList.remove('hidden');
      devPill?.classList.add('hidden');
      clearInterval(resendTimerInterval);
      emailInput.focus();
    });

    // Resend Timer & Handler
    function startResendTimer() {
      clearInterval(resendTimerInterval);
      remainingSeconds = 60;
      if (resendBtn) resendBtn.classList.add('hidden');
      if (resendCountdown) resendCountdown.classList.remove('hidden');
      if (timerSec) timerSec.textContent = '60';

      resendTimerInterval = setInterval(() => {
        remainingSeconds--;
        if (timerSec) timerSec.textContent = String(remainingSeconds);

        if (remainingSeconds <= 0) {
          clearInterval(resendTimerInterval);
          if (resendCountdown) resendCountdown.classList.add('hidden');
          if (resendBtn) resendBtn.classList.remove('hidden');
        }
      }, 1000);
    }

    resendBtn?.addEventListener('click', async () => {
      try {
        showAlert('Mengirim ulang kode OTP...');
        const res = await requestOtp(currentEmail, currentUsername);
        showAlert('Kode OTP baru telah dikirim!', false);

        if (res.otp && devOtpCode) {
          devOtpCode.textContent = res.otp;
          devPill?.classList.remove('hidden');
        }

        startResendTimer();
        otpBoxes.forEach((b) => b.value = '');
        otpBoxes[0]?.focus();
      } catch (err: any) {
        showAlert(err.message || 'Gagal mengirim ulang OTP.', true);
      }
    });

    // 6-digit OTP Box auto-advance & paste handler
    otpBoxes.forEach((box, idx) => {
      box.addEventListener('input', (e: any) => {
        const val = e.target.value.replace(/[^0-9]/g, '');
        box.value = val ? val[val.length - 1] : '';

        if (box.value && idx < otpBoxes.length - 1) {
          otpBoxes[idx + 1].focus();
        }

        // Auto submit if all 6 filled
        const fullOtp = Array.from(otpBoxes).map((b) => b.value).join('');
        if (fullOtp.length === 6) {
          step2Btn.click();
        }
      });

      box.addEventListener('keydown', (e) => {
        if (e.key === 'Backspace' && !box.value && idx > 0) {
          otpBoxes[idx - 1].focus();
        }
      });

      box.addEventListener('paste', (e) => {
        e.preventDefault();
        const text = e.clipboardData?.getData('text').trim() || '';
        const digits = text.replace(/[^0-9]/g, '').slice(0, 6);
        fillOtpBoxes(digits);
      });
    });

    function fillOtpBoxes(otpStr: string) {
      otpStr.split('').forEach((ch, i) => {
        if (otpBoxes[i]) otpBoxes[i].value = ch;
      });
      if (otpStr.length === 6) {
        step2Btn.click();
      } else if (otpBoxes[otpStr.length]) {
        otpBoxes[otpStr.length].focus();
      }
    }
  }

  // Bind to Astro client navigation lifecycle
  declare global {
    interface Window {
      openAuthModal: () => void;
      closeAuthModal: () => void;
    }
  }

  document.addEventListener('astro:page-load', initAuthModal);
</script>
