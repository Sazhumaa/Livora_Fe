---
// Section 05: Why AFTERGLOW (Deconstructed Stage Pass Anatomy — Anti-Bento Architecture)
---

<section id="why" class="relative w-full py-28 px-6 lg:px-12 bg-[#FAF7F9] dark:bg-void-black border-t border-neutral-200/80 dark:border-white/[0.04] transition-colors duration-300 overflow-hidden">
  <div class="max-w-7xl mx-auto">
    
    <!-- Section Header (Centered Editorial) -->
    <div class="text-center mb-16 sm:mb-20">
      <div data-animate="reveal" class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-[11px] font-mono font-bold uppercase tracking-wider bg-electric-magenta/15 text-electric-magenta border border-electric-magenta/30 mb-4">
        <span class="w-1.5 h-1.5 rounded-full bg-electric-magenta animate-pulse"></span>
        STAGE CREDENTIAL ANATOMY
      </div>
      <h2 
        data-animate="reveal" 
        class="delay-100 font-display text-5xl sm:text-7xl lg:text-8xl text-neutral-950 dark:text-soft-white tracking-wide leading-none mb-4"
      >
        MORE THAN JUST A TICKET.
      </h2>
      <p 
        data-animate="reveal" 
        class="delay-200 text-sm sm:text-base text-neutral-600 dark:text-muted-gray max-w-2xl mx-auto leading-relaxed"
      >
        Bukan sekadar lembaran PDF. Ini adalah kredensial panggung terenkripsi yang mematikan bot calo, mengunci kuota resmi promotor, dan menjamin akses masuk dalam 0.3 detik.
      </p>
    </div>

    <!-- Spatial Deconstructed Ticket Layout (3-Column Arena: Wings Left, Pass Center, Wings Right) -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center relative">

      <!-- LEFT COLUMN: 2 Technical Wings (4 Cols) -->
      <div class="lg:col-span-4 space-y-6 sm:space-y-8 order-2 lg:order-1">
        
        <!-- Node 01: Latency Core (Bun + Redis) -->
        <div 
          data-animate="reveal"
          id="node-card-1"
          class="tech-node group p-6 sm:p-7 rounded-3xl bg-white dark:bg-dark-plum border border-neutral-200 dark:border-white/10 hover:border-electric-magenta/70 hover:shadow-magenta-glow transition-all duration-300 cursor-pointer shadow-sm dark:shadow-none"
        >
          <div class="flex items-center justify-between mb-3 font-mono text-xs">
            <span class="text-electric-magenta font-bold tracking-wider">[ 01 // LATENCY CORE ]</span>
            <span class="text-emerald-600 dark:text-emerald-400 font-semibold">&lt; 12ms</span>
          </div>
          <h3 class="font-display text-3xl sm:text-4xl text-neutral-950 dark:text-soft-white group-hover:text-electric-magenta transition-colors leading-none mb-2">
            WAR TIKET ATOMIC SHIELD
          </h3>
          <p class="text-sm text-neutral-600 dark:text-muted-gray leading-relaxed">
            Arsitektur Bun + Redis atomic lock mengunci kursi dalam hitungan milidetik saat war tiket dibuka serentak. 0% server down, 0ms race condition.
          </p>
          <div class="mt-4 pt-3 border-t border-neutral-100 dark:border-white/10 flex items-center justify-between font-mono text-[10px] text-neutral-500 dark:text-muted-gray">
            <span>ENGINE: DISTRIBUTED REDIS</span>
            <span class="text-neutral-950 dark:text-white font-bold">100% ATOMIC</span>
          </div>
        </div>

        <!-- Node 02: Bank-Grade Settlement -->
        <div 
          data-animate="reveal"
          class="delay-100 tech-node group p-6 sm:p-7 rounded-3xl bg-white dark:bg-dark-plum border border-neutral-200 dark:border-white/10 hover:border-electric-magenta/70 hover:shadow-magenta-glow transition-all duration-300 cursor-pointer shadow-sm dark:shadow-none"
          id="node-card-2"
        >
          <div class="flex items-center justify-between mb-3 font-mono text-xs">
            <span class="text-electric-magenta font-bold tracking-wider">[ 02 // ESCROW SETTLEMENT ]</span>
            <span class="text-neutral-900 dark:text-white font-semibold">IDEMPOTENT</span>
          </div>
          <h3 class="font-display text-3xl sm:text-4xl text-neutral-950 dark:text-soft-white group-hover:text-electric-magenta transition-colors leading-none mb-2">
            BANK-GRADE TRANSACTIONS
          </h3>
          <p class="text-sm text-neutral-600 dark:text-muted-gray leading-relaxed">
            Integrasi payment gateway resmi berstandar perbankan dengan webhook idempoten. Transaksi tiket Anda tidak pernah terpotong ganda atau hang di tengah jalan.
          </p>
          <div class="mt-4 pt-3 border-t border-neutral-100 dark:border-white/10 flex items-center justify-between font-mono text-[10px] text-neutral-500 dark:text-muted-gray">
            <span>CHANNELS: QRIS • VA • CARDS</span>
            <span class="text-emerald-600 dark:text-emerald-400 font-bold">INSTANT VERIFIED</span>
          </div>
        </div>

      </div>

      <!-- CENTER COLUMN: The Holographic Credential Stage Pass (4 Cols) -->
      <div 
        data-animate="reveal"
        class="delay-200 lg:col-span-4 flex items-center justify-center order-1 lg:order-2 my-4 lg:my-0"
      >
        <div 
          id="center-stage-pass"
          class="relative w-full max-w-sm rounded-3xl bg-white dark:bg-dark-plum border-2 border-neutral-200 dark:border-electric-magenta/40 shadow-xl dark:shadow-[0_0_60px_rgba(209,77,145,0.25)] p-6 sm:p-7 overflow-hidden transition-all duration-500"
        >
          <!-- Ambient Glow Aura -->
          <div class="absolute -top-12 -left-12 w-44 h-44 bg-electric-magenta/15 dark:bg-electric-magenta/25 rounded-full blur-3xl pointer-events-none"></div>

          <!-- Holographic Foil Sheen Strip -->
          <div id="hologram-strip" class="h-3 w-full rounded-full hologram-sheen mb-5 transition-all duration-500"></div>

          <!-- Pass Brand Header -->
          <div class="flex items-start justify-between pb-4 border-b border-neutral-200 dark:border-white/10 font-mono">
            <div>
              <span class="text-[9px] text-electric-magenta tracking-widest uppercase block font-bold">AFTERGLOW CREDENTIAL</span>
              <h4 class="font-display text-3xl sm:text-4xl text-neutral-950 dark:text-soft-white leading-tight">VOID STAGE '26</h4>
              <span class="text-[10px] text-neutral-500 dark:text-muted-gray">GBK STADIUM • JAKARTA</span>
            </div>
            <div class="w-11 h-11 rounded-2xl bg-neutral-100 dark:bg-black/60 border border-neutral-200 dark:border-white/15 flex flex-col items-center justify-center shrink-0">
              <span class="text-[8px] text-neutral-400 dark:text-muted-gray">GATE</span>
              <span class="text-sm font-bold text-electric-magenta">04</span>
            </div>
          </div>

          <!-- Central Target: The Rotating Dynamic QR Pass -->
          <div 
            id="ticket-qr-zone" 
            class="my-5 p-4 rounded-2xl bg-neutral-50 dark:bg-void-black border border-neutral-200 dark:border-white/10 text-center transition-all duration-300"
          >
            <span class="text-[9px] font-mono text-electric-magenta tracking-wider uppercase block mb-2 font-bold flex items-center justify-center gap-1.5">
              <span class="w-1.5 h-1.5 rounded-full bg-electric-magenta animate-ping"></span>
              DYNAMIC ENCRYPTED MATRIX
            </span>
            <div class="w-24 h-24 sm:w-28 sm:h-28 mx-auto bg-white p-1.5 rounded-2xl flex items-center justify-center shadow-md border border-neutral-200 dark:border-none">
              <div class="grid grid-cols-4 gap-1 w-full h-full bg-black p-1 rounded-xl">
                <div class="bg-white rounded-xs"></div><div class="bg-white rounded-xs"></div><div class="bg-black"></div><div class="bg-white rounded-xs"></div>
                <div class="bg-black"></div><div class="bg-white rounded-xs"></div><div class="bg-white rounded-xs"></div><div class="bg-black"></div>
                <div class="bg-white rounded-xs"></div><div class="bg-black"></div><div class="bg-white rounded-xs"></div><div class="bg-white rounded-xs"></div>
                <div class="bg-white rounded-xs"></div><div class="bg-white rounded-xs"></div><div class="bg-black"></div><div class="bg-white rounded-xs"></div>
              </div>
            </div>
            <span class="text-[10px] font-mono text-neutral-500 dark:text-muted-gray block mt-2">
              AUTO-ROTATES: <strong class="text-neutral-900 dark:text-white font-bold">15s</strong> • ANTI-SCREENSHOT
            </span>
          </div>

          <!-- Perforated Tear Line with Notches -->
          <div class="relative flex items-center justify-between my-3">
            <div class="w-5 h-5 -ml-8 sm:-ml-9 rounded-full bg-[#FAF7F9] dark:bg-void-black border-r border-neutral-200 dark:border-white/10"></div>
            <div class="flex-1 border-b-2 border-dashed border-neutral-300 dark:border-white/20 mx-2"></div>
            <div class="w-5 h-5 -mr-8 sm:-mr-9 rounded-full bg-[#FAF7F9] dark:bg-void-black border-l border-neutral-200 dark:border-white/10"></div>
          </div>

          <!-- Bottom Pass Meta -->
          <div class="flex items-center justify-between text-xs font-mono text-neutral-500 dark:text-muted-gray pt-1">
            <div>
              <span class="text-[9px] block text-neutral-400 dark:text-muted-gray/70">SECURITY TIER</span>
              <span class="text-neutral-900 dark:text-soft-white font-bold">VIP ADMISSION</span>
            </div>
            <div class="text-right">
              <span class="text-[9px] block text-neutral-400 dark:text-muted-gray/70">VERIFICATION</span>
              <span class="text-emerald-600 dark:text-emerald-400 font-bold">100% PROMOTOR</span>
            </div>
          </div>

        </div>
      </div>

      <!-- RIGHT COLUMN: 2 Technical Wings (4 Cols) -->
      <div class="lg:col-span-4 space-y-6 sm:space-y-8 order-3">

        <!-- Node 03: Anti-Calo Dynamic QR -->
        <div 
          data-animate="reveal"
          class="delay-100 tech-node group p-6 sm:p-7 rounded-3xl bg-white dark:bg-dark-plum border border-neutral-200 dark:border-white/10 hover:border-electric-magenta/70 hover:shadow-magenta-glow transition-all duration-300 cursor-pointer shadow-sm dark:shadow-none"
          id="node-card-3"
        >
          <div class="flex items-center justify-between mb-3 font-mono text-xs">
            <span class="text-electric-magenta font-bold tracking-wider">[ 03 // DYNAMIC TURNSTILE ]</span>
            <span class="text-neutral-900 dark:text-white font-semibold">0.3s SCAN</span>
          </div>
          <h3 class="font-display text-3xl sm:text-4xl text-neutral-950 dark:text-soft-white group-hover:text-electric-magenta transition-colors leading-none mb-2">
            ANTI-CALO ROTATING QR
          </h3>
          <p class="text-sm text-neutral-600 dark:text-muted-gray leading-relaxed">
            QR Code dinamis berputar otomatis setiap 15 detik, mematikan calo tiket liar, bot borongan, dan screenshot palsu. Langsung tap di gate turnstile venue.
          </p>
          <div class="mt-4 pt-3 border-t border-neutral-100 dark:border-white/10 flex items-center justify-between font-mono text-[10px] text-neutral-500 dark:text-muted-gray">
            <span>PROTECTION: ANTI-SCREENSHOT</span>
            <span class="text-electric-magenta font-bold">ZERO SECONDARY RESALE</span>
          </div>
        </div>

        <!-- Node 04: Promotor Direct Official Allocation -->
        <div 
          data-animate="reveal"
          class="delay-200 tech-node group p-6 sm:p-7 rounded-3xl bg-white dark:bg-dark-plum border border-neutral-200 dark:border-white/10 hover:border-electric-magenta/70 hover:shadow-magenta-glow transition-all duration-300 cursor-pointer shadow-sm dark:shadow-none"
          id="node-card-4"
        >
          <div class="flex items-center justify-between mb-3 font-mono text-xs">
            <span class="text-electric-magenta font-bold tracking-wider">[ 04 // PROMOTOR DIRECT ]</span>
            <span class="text-emerald-600 dark:text-emerald-400 font-semibold">100% GENUINE</span>
          </div>
          <h3 class="font-display text-3xl sm:text-4xl text-neutral-950 dark:text-soft-white group-hover:text-electric-magenta transition-colors leading-none mb-2">
            OFFICIAL STAGE ALLOCATION
          </h3>
          <p class="text-sm text-neutral-600 dark:text-muted-gray leading-relaxed">
            Setiap kuota tiket bersumber langsung dari promotor resmi festival dan operator venue. Bebas dari mark-up tidak masuk akal dan tanpa iklan spam yang mengganggu.
          </p>
          <div class="mt-4 pt-3 border-t border-neutral-100 dark:border-white/10 flex items-center justify-between font-mono text-[10px] text-neutral-500 dark:text-muted-gray">
            <span>PARTNERSHIP: DIRECT PROMOTER</span>
            <span class="text-neutral-950 dark:text-white font-bold">GUARANTEED ENTRY</span>
          </div>
        </div>

      </div>

    </div>

  </div>
</section>

<style>
  .hologram-sheen {
    background: linear-gradient(135deg, rgba(209,77,145,0.4) 0%, rgba(255,255,255,0.2) 25%, rgba(0,255,200,0.3) 50%, rgba(209,77,145,0.4) 100%);
    background-size: 200% 200%;
    animation: holoPillars 5s ease infinite;
  }

  @keyframes holoPillars {
    0% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
    100% { background-position: 0% 50%; }
  }
</style>

<script>
  function setupDeconstructedPass() {
    const qrZone = document.getElementById('ticket-qr-zone');
    const holoStrip = document.getElementById('hologram-strip');
    const passCard = document.getElementById('center-stage-pass');

    const node1 = document.getElementById('node-card-1');
    const node2 = document.getElementById('node-card-2');
    const node3 = document.getElementById('node-card-3');
    const node4 = document.getElementById('node-card-4');

    if (!passCard) return;

    node1?.addEventListener('mouseenter', () => {
      passCard.classList.add('border-electric-magenta', 'scale-[1.02]');
    });
    node1?.addEventListener('mouseleave', () => {
      passCard.classList.remove('border-electric-magenta', 'scale-[1.02]');
    });

    node2?.addEventListener('mouseenter', () => {
      passCard.classList.add('border-emerald-500', 'scale-[1.02]');
    });
    node2?.addEventListener('mouseleave', () => {
      passCard.classList.remove('border-emerald-500', 'scale-[1.02]');
    });

    node3?.addEventListener('mouseenter', () => {
      qrZone?.classList.add('border-electric-magenta', 'shadow-magenta-glow', 'scale-105');
      passCard.classList.add('scale-[1.02]');
    });
    node3?.addEventListener('mouseleave', () => {
      qrZone?.classList.remove('border-electric-magenta', 'shadow-magenta-glow', 'scale-105');
      passCard.classList.remove('scale-[1.02]');
    });

    node4?.addEventListener('mouseenter', () => {
      holoStrip?.classList.add('shadow-magenta-glow', 'scale-105');
      passCard.classList.add('scale-[1.02]');
    });
    node4?.addEventListener('mouseleave', () => {
      holoStrip?.classList.remove('shadow-magenta-glow', 'scale-105');
      passCard.classList.remove('scale-[1.02]');
    });
  }

  document.addEventListener('DOMContentLoaded', setupDeconstructedPass);
  document.addEventListener('astro:page-load', setupDeconstructedPass);
</script>
