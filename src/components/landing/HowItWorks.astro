---
// Section 06: How It Works (Open Editorial Pipeline — Zero Bulky Boxes)
const steps = [
  {
    num: '01',
    phase: 'PHASE 01 // 3D STAGE RADAR',
    title: 'DISCOVER & MAP.',
    desc: 'Jelajahi konser idaman berdasarkan kota, tanggal, atau lineup artis. Dapatkan visualisasi tata panggung 3D presisi untuk memilih titik pandang terbaik — dari VIP front-row pit hingga tribun akustik.',
    protocolTag: 'STAGE PROTOCOL',
    statusTag: 'VERIFIED SEATING',
    microType: 'seatmap',
  },
  {
    num: '02',
    phase: 'PHASE 02 // ATOMIC REDIS ENGINE',
    title: 'SECURE & LOCK.',
    desc: 'War tiket tanpa server crash. Engine Redis atomik mengunci kuota tiket Anda secara eksklusif selama 10 menit checkout penuh. Selesaikan pembayaran dengan garansi 0ms race condition.',
    protocolTag: 'CONCURRENCY',
    statusTag: '100% ATOMIC',
    microType: 'timer',
  },
  {
    num: '03',
    phase: 'PHASE 03 // DYNAMIC TURNSTILE GATE',
    title: 'EXPERIENCE.',
    desc: 'Pass digital aktif seketika di akun Anda dengan dynamic rotating QR code anti-screenshot dan anti-calo. Dekatkan ponsel di turnstile gate venue, dan nikmati dentuman panggung terbaik.',
    protocolTag: 'CHECK-IN SPEED',
    statusTag: '0.3 SECONDS',
    microType: 'gate',
  },
];
---

<section id="how-it-works" class="relative w-full py-28 px-6 lg:px-12 bg-[#FAF7F9] dark:bg-void-black border-t border-neutral-200/80 dark:border-white/[0.04] overflow-hidden transition-colors duration-300">
  <div class="max-w-7xl mx-auto">
    
    <!-- Section Header (Open Editorial) -->
    <div class="mb-14 sm:mb-20">
      <div data-animate="reveal" class="flex items-center gap-2 mb-3">
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[11px] font-mono font-bold uppercase tracking-wider bg-electric-magenta/15 text-electric-magenta border border-electric-magenta/30">
          <span class="w-1.5 h-1.5 rounded-full bg-electric-magenta animate-pulse"></span>
          <span data-i18n="howItWorks.badge">ALUR TIKET KILAT</span>
        </span>
        <span class="text-xs font-mono text-neutral-500 dark:text-muted-gray">• <span data-i18n="howItWorks.subtitleBeat">0 DETIK MENUJU BARISAN TERDEPAN</span></span>
      </div>
      <h2 
        data-animate="reveal" 
        data-i18n="howItWorks.title"
        class="delay-100 font-display text-5xl sm:text-7xl lg:text-8xl text-neutral-950 dark:text-soft-white tracking-wide leading-none"
      >
        TIGA LANGKAH MENUJU PANGGUNG.
      </h2>
      <p 
        data-animate="reveal" 
        data-i18n="howItWorks.subtitle"
        class="delay-200 text-sm sm:text-base text-neutral-600 dark:text-muted-gray max-w-2xl mt-4 leading-relaxed"
      >
        Bukan sekadar beli tiket biasa. Ini adalah alur tercepat dan teraman tanpa calo, tanpa bot, dan nol antrean fiktif menuju panggung impianmu.
      </p>
    </div>

    <!-- Continuous Pipeline Line on Top of Steps (Desktop) -->
    <div data-animate="reveal" class="hidden lg:grid grid-cols-3 gap-12 mb-8 relative">
      <div class="h-[2px] bg-gradient-to-r from-electric-magenta to-neutral-300 dark:to-white/20 relative">
        <div class="absolute -top-1.5 left-0 w-3.5 h-3.5 rounded-full bg-electric-magenta shadow-magenta-glow"></div>
      </div>
      <div class="h-[2px] bg-gradient-to-r from-neutral-300 dark:from-white/20 via-electric-magenta to-neutral-300 dark:to-white/20 relative">
        <div class="absolute -top-1.5 left-0 w-3.5 h-3.5 rounded-full bg-[#FAF7F9] dark:bg-void-black border-2 border-electric-magenta"></div>
      </div>
      <div class="h-[2px] bg-gradient-to-r from-neutral-300 dark:from-white/20 to-electric-magenta relative">
        <div class="absolute -top-1.5 left-0 w-3.5 h-3.5 rounded-full bg-[#FAF7F9] dark:bg-void-black border-2 border-electric-magenta"></div>
        <div class="absolute -top-1.5 right-0 w-3.5 h-3.5 rounded-full bg-electric-magenta shadow-magenta-glow"></div>
      </div>
    </div>

    <!-- 3 Open Editorial Columns (Divided by razor lines, ZERO bulky boxes) -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-10 lg:gap-14 divide-y lg:divide-y-0 lg:divide-x divide-neutral-200 dark:divide-white/10 pt-4">

      <!-- Column 1: DISCOVER -->
      <div data-animate="reveal" class="pt-8 lg:pt-0 lg:pr-10 relative group flex flex-col justify-between">
        <div>
          <!-- Giant Ghost Number -->
          <span class="ghost-number text-8xl sm:text-9xl font-display select-none pointer-events-none block mb-2 transition-all duration-500">
            01
          </span>

          <span data-i18n="howItWorks.step1Phase" class="text-xs font-mono text-electric-magenta uppercase tracking-widest block font-bold mb-2">
            LANGKAH 01 // PILIH SPOT
          </span>

          <h3 data-i18n="howItWorks.step1Title" class="font-display text-4xl sm:text-5xl text-neutral-950 dark:text-soft-white group-hover:text-electric-magenta transition-colors leading-none mb-4">
            PILIH PANGGUNG & DENAH
          </h3>

          <p data-i18n="howItWorks.step1Desc" class="text-sm text-neutral-600 dark:text-muted-gray leading-relaxed mb-8">
            Jelajahi konser idaman berdasarkan artis favorit atau kotamu. Dapatkan visual denah panggung interaktif untuk memilih titik pandang terbaik — dari VIP festival pit hingga tribun bernyanyi.
          </p>

          <!-- Minimalist Visual Blueprint (Frameless) -->
          <div class="p-4 rounded-2xl bg-white/80 dark:bg-dark-plum/60 border border-neutral-200 dark:border-white/10 space-y-2.5 shadow-sm dark:shadow-none group-hover:border-electric-magenta/50 transition-colors">
            <div class="flex items-center justify-between text-[10px] font-mono text-neutral-500 dark:text-muted-gray">
              <span class="text-electric-magenta font-bold flex items-center gap-1.5">
                <span class="w-1.5 h-1.5 rounded-full bg-electric-magenta animate-pulse"></span>
                STAGE // CENTER
              </span>
              <span>100% ACOUSTIC</span>
            </div>
            <div class="grid grid-cols-3 gap-1.5 text-center font-mono text-[10px]">
              <div class="py-2 rounded-lg bg-electric-magenta/15 border border-electric-magenta/40 text-neutral-900 dark:text-white font-bold">
                VIP PIT
              </div>
              <div class="py-2 rounded-lg bg-neutral-100 dark:bg-white/5 border border-neutral-200 dark:border-white/10 text-neutral-600 dark:text-muted-gray">
                CAT 1
              </div>
              <div class="py-2 rounded-lg bg-neutral-100 dark:bg-white/5 border border-neutral-200 dark:border-white/10 text-neutral-600 dark:text-muted-gray">
                CAT 2
              </div>
            </div>
          </div>
        </div>

        <div class="mt-8 pt-4 border-t border-neutral-200 dark:border-white/10 flex items-center justify-between text-xs font-mono text-neutral-500 dark:text-muted-gray">
          <span>DENAH RESMI</span>
          <span data-i18n="howItWorks.step1Tag" class="text-electric-magenta font-bold">PANDANGAN MAKSIMAL</span>
        </div>
      </div>

      <!-- Column 2: SECURE & BOOK -->
      <div data-animate="reveal" class="delay-150 pt-8 lg:pt-0 lg:px-10 relative group flex flex-col justify-between">
        <div>
          <!-- Giant Ghost Number -->
          <span class="ghost-number text-8xl sm:text-9xl font-display select-none pointer-events-none block mb-2 transition-all duration-500">
            02
          </span>

          <span data-i18n="howItWorks.step2Phase" class="text-xs font-mono text-electric-magenta uppercase tracking-widest block font-bold mb-2">
            LANGKAH 02 // CHECKOUT KILAT
          </span>

          <h3 data-i18n="howItWorks.step2Title" class="font-display text-4xl sm:text-5xl text-neutral-950 dark:text-soft-white group-hover:text-electric-magenta transition-colors leading-none mb-4">
            WAR TIKET TANPA PANIK
          </h3>

          <p data-i18n="howItWorks.step2Desc" class="text-sm text-neutral-600 dark:text-muted-gray leading-relaxed mb-8">
            War tiket tanpa server tumbang atau error tiba-tiba. Kursimu langsung dikunci aman selama 10 menit checkout penuh. Selesaikan pembayaran dengan QRIS, VA, atau Kartu tanpa rasa cemas.
          </p>

          <!-- Minimalist Hold Timer (Frameless) -->
          <div class="p-4 rounded-2xl bg-white/80 dark:bg-dark-plum/60 border border-neutral-200 dark:border-white/10 space-y-2 shadow-sm dark:shadow-none group-hover:border-electric-magenta/50 transition-colors">
            <div class="flex items-center justify-between text-[10px] font-mono text-neutral-500 dark:text-muted-gray">
              <span>HOLD TIMER</span>
              <span class="text-emerald-600 dark:text-emerald-400 font-bold flex items-center gap-1">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
                LOCKED
              </span>
            </div>
            <div class="flex items-center justify-center py-1">
              <span class="font-mono text-3xl font-bold text-neutral-950 dark:text-soft-white tracking-widest">
                09:59<span class="text-electric-magenta text-lg animate-pulse">.42</span>
              </span>
            </div>
            <div class="flex items-center justify-between text-[9px] font-mono text-neutral-500 dark:text-muted-gray pt-1 border-t border-neutral-200 dark:border-white/10">
              <span>ANTI-BOT SHIELD</span>
              <span class="text-neutral-900 dark:text-white font-semibold">QRIS • VA • CARDS</span>
            </div>
          </div>
        </div>

        <div class="mt-8 pt-4 border-t border-neutral-200 dark:border-white/10 flex items-center justify-between text-xs font-mono text-neutral-500 dark:text-muted-gray">
          <span>KUOTA TERKUNCI</span>
          <span data-i18n="howItWorks.step2Tag" class="text-emerald-600 dark:text-emerald-400 font-bold">BEBAS REBUTAN</span>
        </div>
      </div>

      <!-- Column 3: EXPERIENCE -->
      <div data-animate="reveal" class="delay-300 pt-8 lg:pt-0 lg:pl-10 relative group flex flex-col justify-between">
        <div>
          <!-- Giant Ghost Number -->
          <span class="ghost-number text-8xl sm:text-9xl font-display select-none pointer-events-none block mb-2 transition-all duration-500">
            03
          </span>

          <span data-i18n="howItWorks.step3Phase" class="text-xs font-mono text-electric-magenta uppercase tracking-widest block font-bold mb-2">
            LANGKAH 03 // SCAN & GO
          </span>

          <h3 data-i18n="howItWorks.step3Title" class="font-display text-4xl sm:text-5xl text-neutral-950 dark:text-soft-white group-hover:text-electric-magenta transition-colors leading-none mb-4">
            TIKET AKTIF, LANGSUNG MASUK
          </h3>

          <p data-i18n="howItWorks.step3Desc" class="text-sm text-neutral-600 dark:text-muted-gray leading-relaxed mb-8">
            Tiket digital langsung aktif di ponselmu dengan QR code dinamis anti-palsu dan anti-screenshot. Cukup tempelkan layar di pintu masuk venue, dan nikmati dentuman panggung terbaik.
          </p>

          <!-- Minimalist Gate Scan (Frameless) -->
          <div class="p-4 rounded-2xl bg-white/80 dark:bg-dark-plum/60 border border-neutral-200 dark:border-white/10 space-y-2 shadow-sm dark:shadow-none group-hover:border-electric-magenta/50 transition-colors">
            <div class="flex items-center justify-between text-[10px] font-mono text-neutral-500 dark:text-muted-gray">
              <span>GATE PASS</span>
              <span class="text-electric-magenta font-bold">ACCESS GRANTED</span>
            </div>
            <div class="flex items-center gap-3 py-1">
              <div class="w-10 h-10 bg-white p-0.5 rounded-lg shrink-0 flex items-center justify-center border border-neutral-200 dark:border-none">
                <div class="grid grid-cols-3 gap-0.5 w-full h-full bg-black p-0.5 rounded">
                  <div class="bg-white"></div><div class="bg-white"></div><div class="bg-white"></div>
                  <div class="bg-white"></div><div class="bg-black"></div><div class="bg-white"></div>
                  <div class="bg-white"></div><div class="bg-white"></div><div class="bg-white"></div>
                </div>
              </div>
              <div class="font-mono text-[10px]">
                <span class="text-neutral-900 dark:text-white font-bold block">GATE 04 • VIP PIT</span>
                <span class="text-electric-magenta block">TURNSTILE SCAN READY</span>
              </div>
            </div>
            <div class="flex items-center justify-between text-[9px] font-mono text-neutral-500 dark:text-muted-gray pt-1 border-t border-neutral-200 dark:border-white/10">
              <span>ROTATING QR</span>
              <span class="text-neutral-900 dark:text-white font-semibold">AUTO-REFRESH: 15s</span>
            </div>
          </div>
        </div>

        <div class="mt-8 pt-4 border-t border-neutral-200 dark:border-white/10 flex items-center justify-between text-xs font-mono text-neutral-500 dark:text-muted-gray">
          <span>SCAN GATE RESMI</span>
          <span data-i18n="howItWorks.step3Tag" class="text-electric-magenta font-bold">MASUK DALAM 0.3 DETIK</span>
        </div>
      </div>

    </div>

  </div>
</section>

<style>
  html.dark .ghost-number {
    -webkit-text-stroke: 1.5px rgba(248, 240, 245, 0.15);
    color: transparent;
  }
  html.dark .group:hover .ghost-number {
    -webkit-text-stroke: 1.5px rgba(209, 77, 145, 0.45);
  }

  html:not(.dark) .ghost-number {
    -webkit-text-stroke: 1.5px rgba(20, 14, 19, 0.15);
    color: transparent;
  }
  html:not(.dark) .group:hover .ghost-number {
    -webkit-text-stroke: 1.5px rgba(209, 77, 145, 0.55);
  }
</style>
