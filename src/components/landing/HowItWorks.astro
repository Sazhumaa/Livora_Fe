                <span data-i18n="howItWorks.col1MapLabel">AREA PANGGUNG</span>
              </span>
              <span data-i18n="howItWorks.col1ViewLabel">DEPAN PANGGUNG</span>
            </div>
            <div class="grid grid-cols-3 gap-1.5 text-center font-mono text-[10px]">
              <div data-i18n="howItWorks.col1Tier1" class="py-2 rounded-lg bg-electric-magenta/15 border border-electric-magenta/40 text-neutral-900 dark:text-white font-bold">
                FESTIVAL
              </div>
              <div data-i18n="howItWorks.col1Tier2" class="py-2 rounded-lg bg-neutral-100 dark:bg-white/5 border border-neutral-200 dark:border-white/10 text-neutral-600 dark:text-muted-gray">
                TRIBUN 1
              </div>
              <div data-i18n="howItWorks.col1Tier3" class="py-2 rounded-lg bg-neutral-100 dark:bg-white/5 border border-neutral-200 dark:border-white/10 text-neutral-600 dark:text-muted-gray">
                TRIBUN 2
              </div>
            </div>
          </div>
        </div>

        <div class="mt-8 pt-4 border-t border-neutral-200 dark:border-white/10 flex items-center justify-between text-xs font-mono text-neutral-500 dark:text-muted-gray">
          <span data-i18n="howItWorks.col1FootLeft">DENAH RESMI</span>
          <span data-i18n="howItWorks.step1Tag" class="text-electric-magenta font-bold">LENGKAP & JELAS</span>
        </div>
      </div>

