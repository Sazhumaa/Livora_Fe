                  <div class="bg-white"></div><div class="bg-white"></div><div class="bg-white"></div>
                  <div class="bg-white"></div><div class="bg-black"></div><div class="bg-white"></div>
                  <div class="bg-white"></div><div class="bg-white"></div><div class="bg-white"></div>
                </div>
              </div>
              <div class="font-mono text-[10px]">
                <span data-i18n="howItWorks.col3GateName" class="text-neutral-900 dark:text-white font-bold block">PINTU MASUK RESMI</span>
                <span data-i18n="howItWorks.col3GateAction" class="text-electric-magenta block">TUNJUKKAN DARI HP</span>
              </div>
            </div>
            <div class="flex items-center justify-between text-[9px] font-mono text-neutral-500 dark:text-muted-gray pt-1 border-t border-neutral-200 dark:border-white/10">
              <span data-i18n="howItWorks.col3PassType">TIKET DIGITAL</span>
              <span data-i18n="howItWorks.col3PassStatus" class="text-neutral-900 dark:text-white font-semibold">LANGSUNG MASUK</span>
            </div>
          </div>
        </div>

        <div class="mt-8 pt-4 border-t border-neutral-200 dark:border-white/10 flex items-center justify-between text-xs font-mono text-neutral-500 dark:text-muted-gray">
          <span data-i18n="howItWorks.col3FootLeft">PINTU MASUK</span>
          <span data-i18n="howItWorks.step3Tag" class="text-electric-magenta font-bold">TINGGAL SCAN & MASUK</span>
