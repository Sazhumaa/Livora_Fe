---
// Section 07: Final CTA — Sleek, Compact & Cinematic Stage Finale
// Simpel, to the point, zero bloat. Features interactive spotlight lighting and mini ticket-notch CTA.
---

<section 
  id="final-cta-section"
  class="relative w-full py-20 sm:py-28 px-6 lg:px-12 overflow-hidden border-t border-neutral-200/80 dark:border-white/[0.06] bg-[#FAF7F9] dark:bg-void-black transition-colors duration-300"
>
  
  <!-- ======================================================================== -->
  <!-- BACKGROUND STAGE ATMOSPHERE & MOUSE SPOTLIGHT -->
  <!-- ======================================================================== -->
  <div class="absolute inset-0 z-0 overflow-hidden pointer-events-none select-none">
    <!-- Stadium Concert Visual with Laser Silhouette -->
    <img 
      src="https://images.unsplash.com/photo-1514525253161-7a46d19cd819?auto=format&fit=crop&w=2000&q=85" 
      alt="Concert stage laser lights and cheering crowd" 
      class="w-full h-full object-cover object-center filter brightness-[0.5] dark:brightness-[0.25] contrast-125"
      loading="lazy"
    />

    <!-- Deep Vignette & Darkening Gradients -->
    <div class="absolute inset-0 bg-gradient-to-b from-[#FAF7F9] via-transparent to-[#FAF7F9] dark:from-void-black dark:via-dark-plum/30 dark:to-void-black"></div>
    <div class="absolute inset-0 bg-gradient-to-r from-[#FAF7F9]/85 via-transparent to-[#FAF7F9]/85 dark:from-void-black/85 dark:via-transparent dark:to-void-black/85"></div>

    <!-- Interactive Stage Spotlight (Subtle glow following cursor) -->
    <div 
      id="stage-spotlight-beam"
      class="absolute inset-0 pointer-events-none transition-opacity duration-700"
      style="background: radial-gradient(circle 420px at var(--spotlight-x, 50%) var(--spotlight-y, 50%), rgba(209,77,145,0.25) 0%, rgba(88,196,220,0.1) 40%, transparent 75%); mix-blend-mode: screen;"
    ></div>
  </div>

  <!-- ======================================================================== -->
  <!-- MAIN COMPACT CONTENT (Simpel, Bernafas, To The Point) -->
  <!-- ======================================================================== -->
  <div class="relative z-10 max-w-3xl mx-auto flex flex-col items-center text-center">
    
    <!-- Top Micro Telemetry Pill -->
    <div 
      data-animate="reveal" 
      class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white/80 dark:bg-white/[0.05] border border-neutral-300 dark:border-white/10 backdrop-blur-md mb-6 shadow-sm"
    >
      <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
      <span data-i18n="cta.telemetry" class="font-mono text-[11px] font-bold tracking-widest text-electric-magenta uppercase">
        // TIKET RESMI DIBUKA
      </span>
      <span class="text-neutral-400 dark:text-muted-gray text-xs">•</span>
      <span data-i18n="cta.promoterBacked" class="font-mono text-[10px] text-neutral-600 dark:text-muted-gray uppercase">
        100% PROMOTOR RESMI
      </span>
    </div>

    <!-- 2-Line Compact Headline -->
    <h2 
      data-animate="reveal" 
      class="delay-100 font-display text-4xl sm:text-6xl md:text-7xl text-neutral-950 dark:text-soft-white leading-[0.95] tracking-wide mb-5 uppercase"
    >
      <span data-i18n="cta.headline1">JANGAN CUMA DENGAR CERITANYA.</span><br />
      <span data-i18n="cta.headline2" class="text-transparent bg-clip-text bg-gradient-to-r from-neutral-950 via-electric-magenta to-neutral-950 dark:from-white dark:via-electric-magenta dark:to-white">
        SAKSIKAN LANGSUNG.
      </span>
    </h2>

    <!-- Concise Copy (2 Simple Sentences, Zero Fluff) -->
    <p 
      data-animate="reveal" 
      data-i18n="cta.subtitle"
      class="delay-200 text-sm sm:text-base text-neutral-600 dark:text-muted-gray max-w-xl mb-8 font-normal leading-relaxed font-sans"
    >
      Beli tiket resmi tanpa calo. Saat panggung membara dan musik dimulai, pastikan kamu ada di barisan depan.
    </p>

    <!-- Compact Action Buttons (Special Mini Ticket Styling) -->
    <div 
      data-animate="reveal" 
      class="delay-300 flex flex-col sm:flex-row items-center justify-center gap-4 w-full sm:w-auto"
    >
      <!-- Primary: Special Stage Pass Button with Animated Soundwave & Shimmer -->
      <a 
        href="/events" 
        class="group relative w-full sm:w-auto inline-flex items-center justify-center gap-3 px-8 py-4 rounded-full bg-electric-magenta text-white font-mono text-xs uppercase tracking-widest font-bold transition-all duration-300 hover:scale-105 active:scale-95 shadow-[0_0_25px_rgba(209,77,145,0.45)] overflow-hidden"
      >
        <!-- Shimmer Sheen on Hover -->
        <div class="absolute inset-0 -translate-x-full group-hover:translate-x-full transition-transform duration-1000 bg-gradient-to-r from-transparent via-white/30 to-transparent"></div>
        
        <!-- Live Soundwave Bars inside Button -->
        <span class="flex items-center gap-0.5 h-3">
          <span class="w-0.5 h-2 bg-white rounded-full animate-bounce"></span>
          <span class="w-0.5 h-3 bg-white rounded-full animate-bounce [animation-delay:0.15s]"></span>
          <span class="w-0.5 h-1.5 bg-white rounded-full animate-bounce [animation-delay:0.3s]"></span>
        </span>
        
        <span data-i18n="cta.primaryBtn">CARI TIKET SEKARANG</span>
        
        <svg class="w-4 h-4 transform group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
        </svg>
      </a>

      <!-- Secondary: Create Event -->
      <a 
        href="/organizer" 
        class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-7 py-4 rounded-full bg-white/80 dark:bg-white/[0.04] border border-neutral-300 dark:border-white/15 text-neutral-900 dark:text-soft-white font-mono text-xs uppercase tracking-wider font-semibold hover:border-electric-magenta hover:text-electric-magenta transition-all duration-300 backdrop-blur-md hover:scale-105 active:scale-95 shadow-sm"
      >
        <span data-i18n="cta.secondaryBtn">GELAR KONSERMU</span>
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M7 17L17 7M17 7H9M17 7V15" />
        </svg>
      </a>
    </div>

    <!-- Minimalist Bottom Footprint Line -->
    <div 
      data-animate="reveal" 
      class="delay-400 mt-10 pt-6 border-t border-neutral-200/80 dark:border-white/10 flex flex-wrap items-center justify-center gap-6 font-mono text-[11px] text-neutral-500 dark:text-muted-gray"
    >
      <span data-i18n="cta.stagesInfo">PANGGUNG: JKT // BDG // DPS // YOG</span>
      <span class="hidden sm:inline">•</span>
      <span data-i18n="cta.dynamicQrInfo">SCAN MASUK CEPAT</span>
      <span class="hidden sm:inline">•</span>
      <span data-i18n="cta.zeroBotInfo" class="text-electric-magenta font-semibold">100% BEBAS CALO</span>
    </div>

  </div>
</section>

<!-- ======================================================================== -->
<!-- INTERACTIVE STAGE SPOTLIGHT SCRIPT (Cursor Tracking) -->
<!-- ======================================================================== -->
<script>
  function initStageSpotlight() {
    const section = document.getElementById('final-cta-section');
    const spotlight = document.getElementById('stage-spotlight-beam');

    if (!section || !spotlight) return;

    let targetX = 50;
    let targetY = 50;
    let currentX = 50;
    let currentY = 50;
    let animId: number | null = null;

    function renderLoop() {
      currentX += (targetX - currentX) * 0.1;
      currentY += (targetY - currentY) * 0.1;

      spotlight.style.setProperty('--spotlight-x', `${currentX.toFixed(1)}%`);
      spotlight.style.setProperty('--spotlight-y', `${currentY.toFixed(1)}%`);

      animId = requestAnimationFrame(renderLoop);
    }

    animId = requestAnimationFrame(renderLoop);

    section.addEventListener('mousemove', (e) => {
      const rect = section.getBoundingClientRect();
      targetX = ((e.clientX - rect.left) / rect.width) * 100;
      targetY = ((e.clientY - rect.top) / rect.height) * 100;
    });

    section.addEventListener('mouseleave', () => {
      targetX = 50;
      targetY = 50;
    });
  }

  document.addEventListener('DOMContentLoaded', initStageSpotlight);
  document.addEventListener('astro:page-load', initStageSpotlight);
</script>
