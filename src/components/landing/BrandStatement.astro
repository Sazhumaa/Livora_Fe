                <stop offset="50%" stop-color="#0E0514" />
                <stop offset="100%" stop-color="#200B2A" />
              </linearGradient>

              <!-- Right Tear-Off Stub Iridescent Gradient (Violet to Cyan Foil) -->
              <linearGradient id="stubIridescentGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" stop-color="#3C1249" />
                <stop offset="30%" stop-color="#70264F" />
                <stop offset="70%" stop-color="#D14D91" />
                <stop offset="100%" stop-color="#58C4DC" />
