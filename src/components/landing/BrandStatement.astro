      <!-- Floating Card Wrapper (NO FILTER on 3D wrapper to prevent Chromium 3D flattening!) -->
      <div 
        id="interactive-ticket-card" 
        class="relative w-full max-w-[920px] aspect-[2.63/1] min-h-[260px] sm:min-h-[300px] cursor-grab active:cursor-grabbing will-change-transform touch-none"
