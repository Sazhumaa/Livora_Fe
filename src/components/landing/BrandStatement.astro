          <span class="inline-block w-2.5 h-2.5 bg-electric-magenta/40"></span>
          <span class="ml-1">06 // MANIFESTO PASS</span>
        </div>
        <div class="flex items-baseline gap-4">
          <h2 class="font-display text-5xl sm:text-7xl lg:text-8xl text-neutral-950 dark:text-soft-white tracking-tight leading-none">
            ABOUT AFTERGLOW
          </h2>
          <span class="font-mono text-xs text-electric-magenta font-bold uppercase tracking-wider hidden sm:inline-block">
