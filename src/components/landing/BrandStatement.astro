                <stop offset="25%" stop-color="#58C4DC" stop-opacity="0.7" />
                <stop offset="50%" stop-color="#D14D91" stop-opacity="0.8" />
                <stop offset="75%" stop-color="#FFD700" stop-opacity="0.5" />
