<!-- ======================================================================== -->
<!-- INTERACTIVE 3D TICKET PHYSICS ENGINE (Persistent Rotation + Click to Reset) -->
<!-- ======================================================================== -->
<script>
  function initInteractiveTicket() {
    const card = document.getElementById('interactive-ticket-card');
    const viewport = document.getElementById('ticket-stage-viewport');

    if (!card || !viewport) return;

    // Default Showcase Resting Orientation
    const defaultRotX = 6;
    const defaultRotY = -10;

    // Physics State
    let currentRotX = defaultRotX;
    let currentRotY = defaultRotY;
    let targetRotX = defaultRotX;
    let targetRotY = defaultRotY;
    let velX = 0;
    let velY = 0;
    let isDragging = false;
    let startPointerX = 0;
    let startPointerY = 0;
    let lastPointerX = 0;
    let lastPointerY = 0;
    let hasDragged = false;
    let animationFrameId: number | null = null;

    // Continuous 60fps Loop
    function updateCardTransform() {
      if (!isDragging) {
        // Inertia damping when released
        if (Math.abs(velX) > 0.04 || Math.abs(velY) > 0.04) {
          targetRotY += velX;
          targetRotX += velY;
          velX *= 0.92;
          velY *= 0.92;
          // Clamp target X to keep card comfortable to view
          targetRotX = Math.max(-65, Math.min(65, targetRotX));
        }

        // Smooth Lerp towards target angle (stays wherever user dropped it!)
        currentRotX += (targetRotX - currentRotX) * 0.12;
        currentRotY += (targetRotY - currentRotY) * 0.12;
      } else {
        currentRotX = targetRotX;
        currentRotY = targetRotY;
      }

      card.style.transform = `rotateX(${currentRotX.toFixed(2)}deg) rotateY(${currentRotY.toFixed(2)}deg)`;

      // Dynamic Holographic Prism Glare
      const glareX = 50 + (currentRotY * 1.3) % 100;
      const glareY = 50 - (currentRotX * 1.5) % 100;
      const glareOpacity = Math.max(0.25, Math.min(0.9, 0.65 + Math.sin(currentRotY * 0.04) * 0.25));

      card.style.setProperty('--glare-x', `${glareX.toFixed(1)}%`);
      card.style.setProperty('--glare-y', `${glareY.toFixed(1)}%`);
      card.style.setProperty('--glare-opacity', glareOpacity.toFixed(2));

      animationFrameId = requestAnimationFrame(updateCardTransform);
    }

    // Start 60fps Physics Loop
    animationFrameId = requestAnimationFrame(updateCardTransform);

    // Pointer Events for 3D Drag Rotation (Mouse + Touch)
    card.addEventListener('pointerdown', (e) => {
      isDragging = true;
      hasDragged = false;
      card.setPointerCapture(e.pointerId);
      startPointerX = e.clientX;
      startPointerY = e.clientY;
      lastPointerX = e.clientX;
      lastPointerY = e.clientY;
      velX = 0;
      velY = 0;
    });

    card.addEventListener('pointermove', (e) => {
      if (!isDragging) return;
      const totalDx = e.clientX - startPointerX;
      const totalDy = e.clientY - startPointerY;
      
      // If moved more than 4px, mark as drag (not a simple click)
      if (Math.hypot(totalDx, totalDy) > 4) {
        hasDragged = true;
      }

      const deltaX = e.clientX - lastPointerX;
      const deltaY = e.clientY - lastPointerY;

      lastPointerX = e.clientX;
      lastPointerY = e.clientY;

      velX = deltaX * 0.45;
      velY = -deltaY * 0.45;

      targetRotY += velX;
      targetRotX += velY;

      // Restrict extreme flipping on X-axis to keep card pleasant to view
      targetRotX = Math.max(-65, Math.min(65, targetRotX));
    });

    const stopDragging = (e: PointerEvent) => {
      if (!isDragging) return;
      isDragging = false;
      try {
        card.releasePointerCapture(e.pointerId);
      } catch (err) {}

      // IF USER CLICKED (tap without dragging) -> SNAP BACK TO DEFAULT SHOWCASE ANGLE!
      if (!hasDragged) {
        targetRotX = defaultRotX;
        targetRotY = defaultRotY;
        velX = 0;
        velY = 0;
      }
      // IF USER DRAGGED -> It stays right at the new angle with momentum inertia!
    };

    card.addEventListener('pointerup', stopDragging);
    card.addEventListener('pointercancel', stopDragging);
  }

  // Initialize on load and on Astro View Transitions
  document.addEventListener('DOMContentLoaded', initInteractiveTicket);
  document.addEventListener('astro:page-load', initInteractiveTicket);
</script>
