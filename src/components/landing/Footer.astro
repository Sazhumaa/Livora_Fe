---
// Section 08: Footer
---

<footer data-element="footer" class="relative w-full bg-[#FAF7F9] dark:bg-void-black border-t border-neutral-200/80 dark:border-white/[0.08] pt-20 pb-12 px-6 lg:px-12 text-neutral-600 dark:text-muted-gray transition-colors duration-300">
  <div class="max-w-7xl mx-auto">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-12 mb-16">
      <!-- Col 1: Brand & Manifesto -->
      <div class="lg:col-span-2 flex flex-col gap-4">
        <a href="/" class="flex items-center gap-2">
          <span class="font-display text-3xl text-neutral-950 dark:text-soft-white tracking-wider">AFTERGLOW</span>
          <span class="w-2 h-2 rounded-full bg-electric-magenta shadow-magenta-glow"></span>
        </a>
        <p data-i18n="footer.tagline" class="text-xs uppercase tracking-[0.2em] text-electric-magenta font-semibold">
          MUSIK BERLALU. MEMORINYA ABADI.
        </p>
        <p data-i18n="footer.desc" class="text-sm text-neutral-600 dark:text-muted-gray max-w-sm leading-relaxed mt-2">
          Platform tiket konser berkecepatan tinggi dengan garansi 100% tiket resmi promotor, perlindungan anti-calo, dan pass digital siap scan di pintu gerbang.
        </p>
      </div>

      <!-- Col 2: Discover -->
      <div class="flex flex-col gap-3">
        <span data-i18n="footer.explore" class="text-xs font-bold tracking-widest text-neutral-950 dark:text-soft-white uppercase mb-2">JELAJAHI</span>
        <a href="/events" data-i18n="footer.discoverEvents" class="text-sm hover:text-electric-magenta transition-colors py-1 min-h-[44px] flex items-center">Jelajahi Konser</a>
        <a href="/events?category=music-festival" data-i18n="footer.festivals" class="text-sm hover:text-electric-magenta transition-colors py-1 min-h-[44px] flex items-center">Festival Musik</a>
        <a href="/events?category=pop-kpop" data-i18n="footer.popKpop" class="text-sm hover:text-electric-magenta transition-colors py-1 min-h-[44px] flex items-center">Pop & K-Pop</a>
        <a href="/events?category=rock-alternative" data-i18n="footer.rockAlt" class="text-sm hover:text-electric-magenta transition-colors py-1 min-h-[44px] flex items-center">Rock & Alternative</a>
      </div>

      <!-- Col 3: Promotor & Organizers -->
      <div class="flex flex-col gap-3">
        <span data-i18n="footer.promoters" class="text-xs font-bold tracking-widest text-neutral-950 dark:text-soft-white uppercase mb-2">PROMOTOR</span>
        <a href="/organizer" data-i18n="footer.createEvent" class="text-sm hover:text-electric-magenta transition-colors py-1 min-h-[44px] flex items-center">Buat Event</a>
        <a href="/organizer#dashboard" data-i18n="footer.dashboard" class="text-sm hover:text-electric-magenta transition-colors py-1 min-h-[44px] flex items-center">Dashboard Penyelenggara</a>
        <a href="/organizer#pricing" data-i18n="footer.fees" class="text-sm hover:text-electric-magenta transition-colors py-1 min-h-[44px] flex items-center">Biaya Layanan</a>
        <a href="/organizer#scanner" data-i18n="footer.gateScanner" class="text-sm hover:text-electric-magenta transition-colors py-1 min-h-[44px] flex items-center">Aplikasi Gate Scanner</a>
      </div>

      <!-- Col 4: Support & Legal -->
      <div class="flex flex-col gap-3">
        <span data-i18n="footer.legalHelp" class="text-xs font-bold tracking-widest text-neutral-950 dark:text-soft-white uppercase mb-2">BANTUAN & HUKUM</span>
        <a href="/#faq" data-i18n="footer.faq" class="text-sm hover:text-electric-magenta transition-colors py-1 min-h-[44px] flex items-center">Pusat Bantuan & FAQ</a>
        <a href="/#contact" data-i18n="footer.contact" class="text-sm hover:text-electric-magenta transition-colors py-1 min-h-[44px] flex items-center">Hubungi Kami</a>
        <a href="/#terms" data-i18n="footer.terms" class="text-sm hover:text-electric-magenta transition-colors py-1 min-h-[44px] flex items-center">Syarat & Ketentuan</a>
        <a href="/#privacy" data-i18n="footer.privacy" class="text-sm hover:text-electric-magenta transition-colors py-1 min-h-[44px] flex items-center">Kebijakan Privasi</a>
      </div>
    </div>

    <!-- Bottom Copyright & Socials Bar -->
    <div class="pt-8 border-t border-neutral-200/80 dark:border-white/[0.06] flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-neutral-500 dark:text-muted-gray/70">
      <p>&copy; {new Date().getFullYear()} AFTERGLOW Entertainment Inc. <span data-i18n="footer.rights">Hak cipta dilindungi undang-undang.</span></p>

      <div class="flex items-center gap-6">
        <a href="https://instagram.com" target="_blank" rel="noopener noreferrer" class="hover:text-neutral-950 dark:hover:text-soft-white transition-colors min-h-[44px] flex items-center">
          Instagram
        </a>
        <a href="https://x.com" target="_blank" rel="noopener noreferrer" class="hover:text-neutral-950 dark:hover:text-soft-white transition-colors min-h-[44px] flex items-center">
          X (Twitter)
        </a>
        <a href="https://youtube.com" target="_blank" rel="noopener noreferrer" class="hover:text-neutral-950 dark:hover:text-soft-white transition-colors min-h-[44px] flex items-center">
          YouTube
        </a>
      </div>
    </div>
  </div>
</footer>
