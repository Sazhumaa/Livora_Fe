---
// Section 08: Footer
---

<footer data-element="footer" class="relative w-full bg-[#FAF7F9] dark:bg-void-black border-t border-neutral-200/80 dark:border-white/[0.08] pt-20 pb-12 px-6 lg:px-12 text-neutral-600 dark:text-muted-gray transition-colors duration-300">
  <div class="max-w-7xl mx-auto">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-12 mb-16">
      <!-- Col 1: Brand & Manifesto -->
      <div class="lg:col-span-2 flex flex-col gap-4">
        <a href="/" class="flex items-center gap-2">
          <span class="font-display text-3xl text-neutral-950 dark:text-soft-white tracking-wider">AFTERGLOW</span>
          <span class="w-2 h-2 rounded-full bg-electric-magenta shadow-magenta-glow"></span>
        </a>
        <p class="text-xs uppercase tracking-[0.2em] text-electric-magenta font-semibold">
          MUSIC FADES. MEMORIES DON'T.
        </p>
        <p class="text-sm text-neutral-600 dark:text-muted-gray max-w-sm leading-relaxed mt-2">
          Platform tiket konser berkecepatan tinggi dengan jaminan keaslian 100%, sistem anti-bot terisolasi, dan tiket digital QR dinamis.
        </p>
      </div>

      <!-- Col 2: Discover -->
      <div class="flex flex-col gap-3">
        <span class="text-xs font-bold tracking-widest text-neutral-950 dark:text-soft-white uppercase mb-2">EXPLORE</span>
        <a href="/events" class="text-sm hover:text-electric-magenta transition-colors py-1 min-h-[44px] flex items-center">Discover Events</a>
        <a href="/events?category=music-festival" class="text-sm hover:text-electric-magenta transition-colors py-1 min-h-[44px] flex items-center">Music Festivals</a>
        <a href="/events?category=pop-kpop" class="text-sm hover:text-electric-magenta transition-colors py-1 min-h-[44px] flex items-center">Pop & K-Pop</a>
        <a href="/events?category=rock-alternative" class="text-sm hover:text-electric-magenta transition-colors py-1 min-h-[44px] flex items-center">Rock & Alternative</a>
      </div>

      <!-- Col 3: Promotor & Organizers -->
      <div class="flex flex-col gap-3">
        <span class="text-xs font-bold tracking-widest text-neutral-950 dark:text-soft-white uppercase mb-2">PROMOTORS</span>
        <a href="/organizer" class="text-sm hover:text-electric-magenta transition-colors py-1 min-h-[44px] flex items-center">Create Event</a>
        <a href="/organizer#dashboard" class="text-sm hover:text-electric-magenta transition-colors py-1 min-h-[44px] flex items-center">Organizer Dashboard</a>
        <a href="/organizer#pricing" class="text-sm hover:text-electric-magenta transition-colors py-1 min-h-[44px] flex items-center">Ticketing Fee</a>
        <a href="/organizer#scanner" class="text-sm hover:text-electric-magenta transition-colors py-1 min-h-[44px] flex items-center">Gate Scanner App</a>
      </div>

      <!-- Col 4: Support & Legal -->
      <div class="flex flex-col gap-3">
        <span class="text-xs font-bold tracking-widest text-neutral-950 dark:text-soft-white uppercase mb-2">LEGAL & HELP</span>
        <a href="/#faq" class="text-sm hover:text-electric-magenta transition-colors py-1 min-h-[44px] flex items-center">FAQ & Help Center</a>
        <a href="/#contact" class="text-sm hover:text-electric-magenta transition-colors py-1 min-h-[44px] flex items-center">Contact Support</a>
        <a href="/#terms" class="text-sm hover:text-electric-magenta transition-colors py-1 min-h-[44px] flex items-center">Terms of Service</a>
        <a href="/#privacy" class="text-sm hover:text-electric-magenta transition-colors py-1 min-h-[44px] flex items-center">Privacy Policy</a>
      </div>
    </div>

    <!-- Bottom Copyright & Socials Bar -->
    <div class="pt-8 border-t border-neutral-200/80 dark:border-white/[0.06] flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-neutral-500 dark:text-muted-gray/70">
      <p>&copy; {new Date().getFullYear()} AFTERGLOW Entertainment Inc. All rights reserved.</p>

      <div class="flex items-center gap-6">
        <a href="https://instagram.com" target="_blank" rel="noopener noreferrer" class="hover:text-neutral-950 dark:hover:text-soft-white transition-colors min-h-[44px] flex items-center">
          Instagram
        </a>
        <a href="https://x.com" target="_blank" rel="noopener noreferrer" class="hover:text-neutral-950 dark:hover:text-soft-white transition-colors min-h-[44px] flex items-center">
          X (Twitter)
        </a>
        <a href="https://youtube.com" target="_blank" rel="noopener noreferrer" class="hover:text-neutral-950 dark:hover:text-soft-white transition-colors min-h-[44px] flex items-center">
          YouTube
        </a>
      </div>
    </div>
  </div>
</footer>
