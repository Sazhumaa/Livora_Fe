---
// Section 04: Discover Categories (Editorial Sonic Bento Matrix)
import { MOCK_CATEGORIES } from '../../data/mockCategories';

// Sonic metadata and custom layout attributes for each genre
const CATEGORY_META: Record<string, {
  colSpan: string;
  tag: string;
  subkicker?: string;
  ctaText: string;
  minHeight: string;
  hasEqualizer?: boolean;
  isPanoramic?: boolean;
}> = {
  'music-festival': {
    colSpan: 'lg:col-span-7 md:col-span-2',
    tag: 'STAGE MATRIX // 35Hz SUB-BASS',
    subkicker: 'STADIUM & OUTDOOR ARENA',
    ctaText: 'EXPLORE FESTIVALS',
    minHeight: 'min-h-[380px]',
    hasEqualizer: true,
  },
  'electronic-edm': {
    colSpan: 'lg:col-span-5 md:col-span-2',
    tag: 'SYNTH // 128-150 BPM',
    subkicker: 'CLUB & VISUAL SPECTACLES',
    ctaText: 'SECURE CLUB PASSES',
    minHeight: 'min-h-[380px]',
  },
  'pop-kpop': {
    colSpan: 'lg:col-span-4 md:col-span-1',
    tag: 'GLOBAL IDOL ARENA',
    ctaText: 'BROWSE ARENAS',
    minHeight: 'min-h-[320px]',
  },
  'rock-alternative': {
    colSpan: 'lg:col-span-4 md:col-span-1',
    tag: 'HIGH GAIN // 118 dB',
    ctaText: 'JOIN THE MOSH PIT',
    minHeight: 'min-h-[320px]',
  },
  'jazz-soul': {
    colSpan: 'lg:col-span-4 md:col-span-2 lg:col-span-4',
    tag: 'INTIMATE ACOUSTICS',
    ctaText: 'DISCOVER SOUL',
    minHeight: 'min-h-[320px]',
  },
  'indie-local': {
    colSpan: 'lg:col-span-12 md:col-span-2',
    tag: 'UNDERGROUND CIRCUIT',
    subkicker: 'RAW SOUNDSTAGE // INDIE CIRCUIT',
    ctaText: 'EXPLORE INDIE GIGS',
    minHeight: 'min-h-[220px]',
    isPanoramic: true,
  },
};

// Reorder categories to fit the 7+5 / 4+4+4 / 12 Bento Matrix
const orderedSlugs = [
  'music-festival',
  'electronic-edm',
  'pop-kpop',
  'rock-alternative',
  'jazz-soul',
  'indie-local',
];

const categories = orderedSlugs
  .map(slug => MOCK_CATEGORIES.find(c => c.slug === slug))
  .filter(Boolean) as typeof MOCK_CATEGORIES;
---

<section id="categories" class="relative w-full py-28 px-6 lg:px-12 bg-[#FAF7F9] dark:bg-void-black border-t border-neutral-200/80 dark:border-white/[0.04] transition-colors duration-300">
  <div class="max-w-7xl mx-auto">
    <!-- Section Header (Editorial & Punchy) -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-12 sm:mb-16">
      <div>
        <div data-animate="reveal" class="flex items-center gap-2 mb-3">
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[11px] font-mono font-bold uppercase tracking-wider bg-electric-magenta/15 text-electric-magenta border border-electric-magenta/30">
            <span class="w-1.5 h-1.5 rounded-full bg-electric-magenta animate-pulse"></span>
            SONIC ATMOSPHERE // BENTO MATRIX
          </span>
          <span class="text-xs text-neutral-500 dark:text-muted-gray font-mono">GENRE FREQUENCIES</span>
        </div>
        <h2 
          data-animate="reveal" 
          class="delay-100 font-display text-4xl sm:text-6xl text-neutral-950 dark:text-soft-white tracking-wide"
        >
          FIND YOUR FREQUENCY.
        </h2>
        <p 
          data-animate="reveal" 
          class="delay-200 text-sm sm:text-base text-neutral-600 dark:text-muted-gray max-w-xl mt-2 leading-relaxed"
        >
          Pilih panggung berdasarkan resonansi gelombang suara — dari dentuman bass stadium hingga keintiman klub underground.
        </p>
      </div>

      <!-- Quick Action / Link to Full Catalog -->
      <a 
        data-animate="reveal"
        href="/events" 
        class="self-start md:self-auto inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-white dark:bg-dark-plum border border-neutral-200 dark:border-white/10 hover:border-electric-magenta text-neutral-900 dark:text-soft-white hover:text-electric-magenta text-xs font-semibold uppercase tracking-wider transition-all duration-300 shadow-sm shrink-0"
      >
        <span>View All 6 Genres</span>
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </a>
    </div>

    <!-- Bento Grid Container (12 Columns) -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-6">
      {categories.map((cat, idx) => {
        const meta = CATEGORY_META[cat.slug] || {
          colSpan: 'lg:col-span-4 md:col-span-1',
          tag: 'LIVE ROSTER',
          ctaText: 'EXPLORE GIGS',
          minHeight: 'min-h-[320px]',
        };

        if (meta.isPanoramic) {
          // Card 6: Panoramic 12-Column Banner (Underground Scene)
          return (
            <a 
              data-animate="reveal"
              href={`/events?category=${cat.slug}`}
              class={`${meta.colSpan} ${meta.minHeight} group relative rounded-3xl overflow-hidden bg-white dark:bg-dark-plum border border-neutral-200 dark:border-white/10 hover:border-electric-magenta/60 hover:shadow-magenta-glow transition-all duration-500 flex flex-col md:flex-row items-center justify-between p-8 sm:p-10 cursor-pointer shadow-sm dark:shadow-none`}
            >
              <!-- Background Image -->
              <img 
                src={cat.imageUrl} 
                alt={cat.name} 
                class="absolute inset-0 w-full h-full object-cover group-hover:scale-103 transition-transform duration-700 filter brightness-[0.75] dark:brightness-[0.35] contrast-125 pointer-events-none"
                loading="lazy"
              />
              <div class="absolute inset-0 bg-gradient-to-t md:bg-gradient-to-r from-[#FAF7F9] via-[#FAF7F9]/85 dark:from-void-black dark:via-void-black/85 to-transparent pointer-events-none"></div>

              <!-- Left Content -->
              <div class="relative z-10 max-w-xl">
                <div class="flex items-center gap-2 mb-2">
                  <span class="px-2.5 py-0.5 rounded text-[10px] font-mono font-bold uppercase tracking-wider bg-electric-magenta/15 border border-electric-magenta/30 text-electric-magenta">
                    {meta.tag}
                  </span>
                  <span class="text-xs font-mono text-neutral-600 dark:text-muted-gray">• {cat.count} INDIE STAGES</span>
                </div>
                <h3 class="font-display text-4xl sm:text-5xl text-neutral-950 dark:text-soft-white group-hover:text-electric-magenta transition-colors mb-2">
                  {cat.name}
                </h3>
                <p class="text-sm text-neutral-600 dark:text-muted-gray leading-relaxed">
                  {cat.description}
                </p>
              </div>

              <!-- Right Action Pill & Status -->
              <div class="relative z-10 mt-6 md:mt-0 flex flex-col sm:flex-row items-center gap-4">
                <div class="flex items-center gap-2 px-4 py-2 rounded-xl bg-white/80 dark:bg-black/60 backdrop-blur-md border border-neutral-200 dark:border-white/10 font-mono text-xs text-neutral-600 dark:text-muted-gray">
                  <span class="w-2 h-2 rounded-full bg-electric-magenta animate-pulse"></span>
                  <span>CURATED ROSTER ACTIVE</span>
                </div>
                <span class="px-6 py-3 rounded-full bg-electric-magenta text-white font-semibold text-xs tracking-wider uppercase shadow-magenta-glow group-hover:scale-105 transition-all shrink-0">
                  {meta.ctaText}
                </span>
              </div>
            </a>
          );
        }

        // Standard & Featured Bento Cards
        return (
          <a 
            data-animate="reveal"
            href={`/events?category=${cat.slug}`}
            class={`${meta.colSpan} ${meta.minHeight} group relative rounded-3xl overflow-hidden bg-white dark:bg-dark-plum border border-neutral-200 dark:border-white/10 hover:border-electric-magenta/60 hover:shadow-magenta-glow transition-all duration-500 flex flex-col justify-between p-6 sm:p-8 cursor-pointer shadow-sm dark:shadow-none`}
          >
            <!-- Background Image -->
            <img 
              src={cat.imageUrl} 
              alt={cat.name} 
              class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 filter brightness-[0.75] dark:brightness-[0.4] contrast-125 pointer-events-none"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-[#FAF7F9] via-[#FAF7F9]/70 dark:from-void-black dark:via-void-black/65 to-transparent pointer-events-none"></div>

            <!-- Top Badges Row -->
            <div class="relative z-10 flex items-center justify-between gap-2">
              <span class="px-2.5 py-1 rounded text-[10px] font-mono font-bold uppercase tracking-wider bg-white/80 dark:bg-black/60 backdrop-blur-md border border-neutral-200 dark:border-white/15 text-electric-magenta">
                {meta.tag}
              </span>

              <div class="flex items-center gap-1.5 bg-white/80 dark:bg-black/60 backdrop-blur-md px-3 py-1 rounded-full border border-neutral-200 dark:border-white/10">
                {meta.hasEqualizer && (
                  <!-- Live Audio Equalizer Animation -->
                  <div class="flex items-end gap-0.5 h-3.5 mr-0.5">
                    <span class="w-0.5 bg-electric-magenta rounded-full eq-bar-1"></span>
                    <span class="w-0.5 bg-electric-magenta rounded-full eq-bar-2"></span>
                    <span class="w-0.5 bg-electric-magenta rounded-full eq-bar-3"></span>
                    <span class="w-0.5 bg-electric-magenta rounded-full eq-bar-4"></span>
                  </div>
                )}
                <span class="text-xs font-mono font-bold text-neutral-900 dark:text-soft-white">
                  {cat.count} PASSES
                </span>
              </div>
            </div>

            <!-- Bottom Content Row -->
            <div class="relative z-10 mt-12 sm:mt-16">
              {meta.subkicker && (
                <span class="text-xs font-mono tracking-widest text-electric-magenta uppercase block mb-1">
                  {meta.subkicker}
                </span>
              )}

              <h3 class={`font-display text-3xl sm:text-4xl text-neutral-950 dark:text-soft-white group-hover:text-electric-magenta transition-colors mb-2 leading-none`}>
                {cat.name}
              </h3>

              <p class="text-xs sm:text-sm text-neutral-600 dark:text-muted-gray line-clamp-2 mb-4 leading-relaxed">
                {cat.description}
              </p>

              <div class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-neutral-900 dark:text-soft-white group-hover:text-electric-magenta transition-colors">
                <span>{meta.ctaText}</span>
                <svg class="w-4 h-4 transform group-hover:translate-x-1.5 transition-transform" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                </svg>
              </div>
            </div>
          </a>
        );
      })}
    </div>
  </div>
</section>

<style>
  @keyframes eqPulse1 { 0%, 100% { height: 3px; } 50% { height: 14px; } }
  @keyframes eqPulse2 { 0%, 100% { height: 12px; } 50% { height: 5px; } }
  @keyframes eqPulse3 { 0%, 100% { height: 6px; } 50% { height: 16px; } }
  @keyframes eqPulse4 { 0%, 100% { height: 15px; } 50% { height: 7px; } }

  .eq-bar-1 { animation: eqPulse1 0.8s ease-in-out infinite; }
  .eq-bar-2 { animation: eqPulse2 0.7s ease-in-out infinite 0.1s; }
  .eq-bar-3 { animation: eqPulse3 0.9s ease-in-out infinite 0.2s; }
  .eq-bar-4 { animation: eqPulse4 0.6s ease-in-out infinite 0.15s; }
</style>
