---
// AFTERGLOW Floating Action HUD (Inspired by modern concert stage & reference interface)
---

<div 
  data-element="floating-hud"
  transition:persist="floating-hud"
  class="print:hidden fixed right-6 bottom-8 z-40 flex flex-col items-end gap-5 transition-all duration-500 pointer-events-none select-none [&.is-intersecting-footer]:translate-y-[-70px]"
>
  <!-- Ambient Audio Toggle Pill -->
  <button 
    id="hud-audio-toggle" 
    type="button"
    aria-pressed="false"
    aria-label="Toggle Stage Ambiance" 
    class="pointer-events-auto flex items-center gap-2.5 px-3.5 py-2 rounded-full bg-white/90 dark:bg-dark-plum/90 backdrop-blur-md border border-neutral-200 dark:border-white/10 text-xs text-neutral-800 dark:text-soft-white hover:border-electric-magenta/60 hover:shadow-magenta-glow shadow-md dark:shadow-none transition-all duration-300 group"
  >
    <span id="hud-audio-dot" class="w-2 h-2 rounded-full bg-neutral-400 dark:bg-muted-gray transition-colors"></span>
    <span data-i18n="hud.audioToggle" class="font-medium tracking-wider text-[11px] text-neutral-600 dark:text-muted-gray group-hover:text-neutral-900 dark:group-hover:text-soft-white uppercase">AUDIO PANGGUNG</span>
    
    <!-- Soundwave animation bars (paused until active) -->
    <div id="hud-eq-bars" class="flex items-center gap-0.5 h-3 ml-1 opacity-50 transition-opacity">
      <span class="hud-eq-bar w-0.5 h-1.5 bg-electric-magenta rounded-full"></span>
      <span class="hud-eq-bar w-0.5 h-2.5 bg-electric-magenta rounded-full [animation-delay:0.2s]"></span>
      <span class="hud-eq-bar w-0.5 h-1.5 bg-electric-magenta rounded-full [animation-delay:0.4s]"></span>
    </div>
  </button>

  <!-- Rotating Circular Radar Badge -->
  <a 
    href="/events" 
    aria-label="Discover All Live Concerts" 
    class="pointer-events-auto relative w-24 h-24 md:w-28 md:h-28 flex items-center justify-center group cursor-pointer"
  >
    <!-- Background Glass Disc -->
    <div class="absolute inset-0 rounded-full bg-white/90 dark:bg-dark-plum/80 backdrop-blur-md border border-neutral-200 dark:border-white/15 shadow-xl dark:shadow-2xl group-hover:border-electric-magenta group-hover:shadow-magenta-glow transition-all duration-500 group-hover:scale-105"></div>

    <!-- Rotating SVG Circular Text -->
    <svg class="absolute inset-0 w-full h-full animate-spin-slow pointer-events-none" viewBox="0 0 100 100">
      <path
        id="circlePath"
        d="M 50, 50 m -37, 0 a 37,37 0 1,1 74,0 a 37,37 0 1,1 -74,0"
        fill="none"
      ></path>
      <text class="text-[9.2px] tracking-[0.22em] uppercase font-bold fill-neutral-600 dark:fill-muted-gray group-hover:fill-neutral-950 dark:group-hover:fill-soft-white transition-colors">
        <textPath href="#circlePath" data-i18n="hud.circleText">
          • BELI TIKET • RASAKAN KONSER •
        </textPath>
      </text>
    </svg>

    <!-- Center Icon & Pulse -->
    <div class="relative z-10 flex flex-col items-center justify-center text-electric-magenta group-hover:scale-110 transition-transform duration-300">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15 5v2m0 4v2m0 4v2M5 5a2 2 0 00-2 2v3a2 2 0 110 4v3a2 2 0 002 2h14a2 2 0 002-2v-3a2 2 0 110-4V7a2 2 0 00-2-2H5z" />
      </svg>
      <span data-i18n="hud.now" class="text-[9px] font-bold tracking-tighter text-neutral-900 dark:text-soft-white mt-0.5">GAS</span>
    </div>
  </a>
</div>

<script>
  interface StageAudioEngine {
    ctx: AudioContext;
    masterGain: GainNode;
    oscillators: OscillatorNode[];
  }

  let audioEngine: StageAudioEngine | null = null;
  let isPlaying = false;

  function initStageSynth(): StageAudioEngine | null {
    if (audioEngine) return audioEngine;
    const AudioCtx = window.AudioContext || (window as any).webkitAudioContext;
    if (!AudioCtx) return null;

    const ctx = new AudioCtx();
    const filter = ctx.createBiquadFilter();
    filter.type = 'lowpass';
    filter.frequency.setValueAtTime(340, ctx.currentTime);
    filter.Q.setValueAtTime(1.8, ctx.currentTime);

    const masterGain = ctx.createGain();
    masterGain.gain.setValueAtTime(0.0001, ctx.currentTime);

    // Subtle fifth pad (A2 + E3 + detuned warmth + slow sub)
    const freqs = [110, 110.6, 164.81, 220];
    const types: OscillatorType[] = ['triangle', 'sine', 'sine', 'triangle'];
    const oscillators = freqs.map((freq, idx) => {
      const osc = ctx.createOscillator();
      osc.type = types[idx];
      osc.frequency.setValueAtTime(freq, ctx.currentTime);
      const voiceGain = ctx.createGain();
      voiceGain.gain.setValueAtTime(idx === 3 ? 0.14 : 0.25, ctx.currentTime);
      osc.connect(voiceGain);
      voiceGain.connect(filter);
      osc.start();
      return osc;
    });

    // Gentle LFO breathing on the stage filter
    const lfo = ctx.createOscillator();
    const lfoGain = ctx.createGain();
    lfo.frequency.setValueAtTime(0.18, ctx.currentTime);
    lfoGain.gain.setValueAtTime(120, ctx.currentTime);
    lfo.connect(lfoGain);
    lfoGain.connect(filter.frequency);
    lfo.start();
    oscillators.push(lfo);

    filter.connect(masterGain);
    masterGain.connect(ctx.destination);

    audioEngine = { ctx, masterGain, oscillators };
    return audioEngine;
  }

  function updateAudioUi(active: boolean) {
    const audioBtn = document.getElementById('hud-audio-toggle');
    const audioDot = document.getElementById('hud-audio-dot');
    const eqWrap = document.getElementById('hud-eq-bars');
    if (!audioBtn) return;

    audioBtn.setAttribute('aria-pressed', active ? 'true' : 'false');
    audioBtn.classList.toggle('border-electric-magenta', active);
    audioBtn.classList.toggle('shadow-magenta-glow', active);

    if (audioDot) {
      audioDot.classList.toggle('bg-electric-magenta', active);
      audioDot.classList.toggle('animate-pulse', active);
      audioDot.classList.toggle('bg-neutral-400', !active);
      audioDot.classList.toggle('dark:bg-muted-gray', !active);
    }
    if (eqWrap) {
      eqWrap.classList.toggle('opacity-100', active);
      eqWrap.classList.toggle('opacity-50', !active);
      eqWrap.querySelectorAll('.hud-eq-bar').forEach((bar) => {
        bar.classList.toggle('animate-bounce', active);
      });
    }
  }

  function setupAudioToggle() {
    const audioBtn = document.getElementById('hud-audio-toggle');
    if (!audioBtn) return;
    updateAudioUi(isPlaying);

    if (audioBtn.dataset.audioBound === '1') return;
    audioBtn.dataset.audioBound = '1';

    audioBtn.addEventListener('click', async () => {
      isPlaying = !isPlaying;
      updateAudioUi(isPlaying);

      const engine = initStageSynth();
      if (!engine) return;

      try {
        if (isPlaying) {
          if (engine.ctx.state === 'suspended') {
            await engine.ctx.resume();
          }
          engine.masterGain.gain.cancelScheduledValues(engine.ctx.currentTime);
          engine.masterGain.gain.setTargetAtTime(0.055, engine.ctx.currentTime, 0.25);
        } else {
          engine.masterGain.gain.cancelScheduledValues(engine.ctx.currentTime);
          engine.masterGain.gain.setTargetAtTime(0.0001, engine.ctx.currentTime, 0.15);
        }
      } catch {
        // Fallback smoothly if Web Audio is blocked by browser policy
      }
    });
  }

  document.addEventListener('astro:page-load', setupAudioToggle);
</script>
