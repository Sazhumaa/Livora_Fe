---
// AFTERGLOW Minimalist Cinematic Navbar
const pathname = Astro.url.pathname;
---

<header class="fixed top-0 left-0 right-0 z-50 bg-white/85 dark:bg-void-black/85 backdrop-blur-md border-b border-black/[0.06] dark:border-white/[0.06] transition-colors duration-300">
  <div class="max-w-7xl mx-auto px-6 lg:px-12 h-20 flex items-center justify-between">
    <!-- Brand Logo -->
    <a href="/" class="flex items-center gap-2 group tracking-wider">
      <span class="font-display text-3xl md:text-4xl text-neutral-950 dark:text-soft-white group-hover:text-electric-magenta transition-colors duration-200">
        AFTERGLOW
      </span>
      <span class="w-2 h-2 rounded-full bg-electric-magenta shadow-magenta-glow animate-pulse"></span>
    </a>

    <!-- Desktop Nav Links -->
    <nav class="hidden md:flex items-center gap-8">
      <a 
        href="/events" 
        data-i18n="nav.discoverEvents"
        class={`text-sm tracking-wide transition-colors duration-200 ${pathname.startsWith('/events') ? 'text-electric-magenta font-semibold' : 'text-neutral-600 dark:text-muted-gray hover:text-neutral-950 dark:hover:text-soft-white'}`}
      >
        Jelajahi Konser
      </a>
      <a 
        href="/#about" 
        data-i18n="nav.about"
        class="text-sm tracking-wide text-neutral-600 dark:text-muted-gray hover:text-neutral-950 dark:hover:text-soft-white transition-colors duration-200"
      >
        Tentang Kami
      </a>
      <a 
        href="/tickets" 
        data-i18n="nav.myTickets"
        class={`text-sm tracking-wide transition-colors duration-200 ${pathname.startsWith('/tickets') ? 'text-electric-magenta font-semibold' : 'text-neutral-600 dark:text-muted-gray hover:text-neutral-950 dark:hover:text-soft-white'}`}
      >
        Tiket Saya
      </a>
      <a 
        href="/organizer" 
        data-i18n="nav.createEvent"
        class={`text-sm tracking-wide transition-colors duration-200 ${pathname.startsWith('/organizer') ? 'text-electric-magenta font-semibold' : 'text-neutral-600 dark:text-muted-gray hover:text-neutral-950 dark:hover:text-soft-white'}`}
      >
        Buat Event
      </a>
    </nav>

    <!-- Right Action CTA & Switchers -->
    <div class="hidden md:flex items-center gap-3">
      <!-- Bilingual Language Switcher (ID / EN) -->
      <div 
        class="flex items-center p-0.5 rounded-full border border-neutral-200 dark:border-white/10 bg-neutral-100/90 dark:bg-white/5 text-xs font-mono font-bold" 
        role="group" 
        aria-label="Pilih Bahasa / Select Language"
      >
        <button 
          type="button" 
          data-lang-btn="id" 
          class="px-2.5 py-1 rounded-full transition-all duration-200 text-[11px] uppercase font-bold bg-electric-magenta text-white shadow-sm"
          aria-pressed="true"
          title="Bahasa Indonesia"
        >
          ID
        </button>
        <button 
          type="button" 
          data-lang-btn="en" 
          class="px-2.5 py-1 rounded-full transition-all duration-200 text-[11px] uppercase font-bold text-neutral-500 dark:text-muted-gray hover:text-neutral-900 dark:hover:text-soft-white"
          aria-pressed="false"
          title="English"
        >
          EN
        </button>
      </div>

      <!-- Dark / Light Theme Toggle Button -->
      <button 
        type="button"
        data-theme-toggle
        aria-label="Toggle Dark / Light Mode"
        title="Toggle Dark / Light Mode"
        class="w-10 h-10 rounded-full flex items-center justify-center border border-neutral-200 dark:border-white/10 bg-neutral-100/90 dark:bg-white/5 text-neutral-700 dark:text-soft-white hover:border-electric-magenta/60 hover:text-electric-magenta transition-all duration-300 hover:scale-105 active:scale-95"
      >
        <!-- Sun Icon (Active in Dark Mode to switch to Light) -->
        <svg data-icon="sun" class="w-4 h-4 hidden" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <circle cx="12" cy="12" r="4"></circle>
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 2v2m0 16v2M4.93 4.93l1.41 1.41m11.32 11.32l1.41 1.41M2 12h2m16 0h2M6.34 17.66l-1.41 1.41m14.14-14.14l-1.41 1.41" />
        </svg>
        <!-- Moon Icon (Active in Light Mode to switch to Dark) -->
        <svg data-icon="moon" class="w-4 h-4 hidden" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
        </svg>
      </button>

      <!-- Auth Action: Sign In Button or User Dropdown -->
      <div id="nav-auth-wrapper" class="relative">
        <!-- Sign In Button (Visible when logged out) -->
        <button 
          id="nav-signin-btn" 
          type="button" 
          data-i18n="nav.signIn"
          class="text-sm font-medium text-neutral-600 dark:text-muted-gray hover:text-neutral-950 dark:hover:text-soft-white transition-colors duration-200 px-3 py-2 cursor-pointer"
        >
          Masuk
        </button>

        <!-- User Dropdown (Visible when logged in) -->
        <div id="nav-user-menu" class="hidden relative">
          <button 
            id="nav-user-toggle-btn" 
            type="button" 
            class="flex items-center gap-2.5 px-3 py-1.5 rounded-full border border-neutral-200 dark:border-white/10 bg-neutral-100/80 dark:bg-dark-plum/80 hover:border-electric-magenta/60 transition-all text-xs"
            aria-expanded="false"
          >
            <div id="nav-avatar-disc" class="w-7 h-7 rounded-full bg-electric-magenta text-soft-white font-bold flex items-center justify-center text-xs shadow-magenta-glow">
              U
            </div>
            <span id="nav-user-name" class="font-medium text-neutral-800 dark:text-soft-white max-w-[100px] truncate">
              User
            </span>
            <svg class="w-3.5 h-3.5 text-muted-gray transition-transform duration-200 arrow-icon" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
            </svg>
          </button>

          <!-- Dropdown Popover Card -->
          <div 
            id="nav-user-popover" 
            class="hidden absolute right-0 mt-3 w-60 rounded-2xl bg-white dark:bg-dark-plum border border-neutral-200 dark:border-white/15 shadow-2xl p-3 z-50 backdrop-blur-xl animate-in fade-in zoom-in-95 duration-150"
          >
            <div class="px-3 py-2 border-b border-neutral-100 dark:border-white/10 mb-2">
              <p id="nav-popover-fullname" class="font-bold text-sm text-neutral-900 dark:text-soft-white truncate"></p>
              <p id="nav-popover-email" class="text-xs text-muted-gray truncate font-mono"></p>
              <span id="nav-popover-role" class="mt-1.5 inline-block px-2 py-0.5 rounded text-[10px] font-mono font-bold uppercase bg-electric-magenta/15 text-electric-magenta border border-electric-magenta/30">
                PENONTON
              </span>
            </div>

            <div class="space-y-1">
              <a href="/tickets" class="flex items-center gap-2.5 px-3 py-2 rounded-xl text-xs font-medium text-neutral-700 dark:text-soft-white hover:bg-neutral-100 dark:hover:bg-white/5 transition-colors">
                <svg class="w-4 h-4 text-electric-magenta" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 5v2m0 4v2m0 4v2M5 5a2 2 0 00-2 2v3a2 2 0 110 4v3a2 2 0 002 2h14a2 2 0 002-2v-3a2 2 0 110-4V7a2 2 0 00-2-2H5z" />
                </svg>
                <span>Tiket Konser Saya</span>
              </a>

              <a href="/account" class="flex items-center gap-2.5 px-3 py-2 rounded-xl text-xs font-medium text-neutral-700 dark:text-soft-white hover:bg-neutral-100 dark:hover:bg-white/5 transition-colors">
                <svg class="w-4 h-4 text-electric-magenta" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                </svg>
                <span>Akun, Order & Wishlist</span>
              </a>

              <a href="/organizer" class="flex items-center gap-2.5 px-3 py-2 rounded-xl text-xs font-medium text-neutral-700 dark:text-soft-white hover:bg-neutral-100 dark:hover:bg-white/5 transition-colors">
                <svg class="w-4 h-4 text-electric-magenta" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
                </svg>
                <span>Konsol Promotor</span>
              </a>

              <a href="/scanner" id="nav-scanner-link" class="hidden flex items-center gap-2.5 px-3 py-2 rounded-xl text-xs font-medium text-neutral-700 dark:text-soft-white hover:bg-neutral-100 dark:hover:bg-white/5 transition-colors">
                <svg class="w-4 h-4 text-electric-magenta" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v1m6 11h2m-6 0h-2v4m0-11v3m0 0h.01M12 12h4.01M16 20h4M4 12h4m12 0h.01M5 8h2a1 1 0 001-1V5a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1zm12 0h2a1 1 0 001-1V5a1 1 0 00-1-1h-2a1 1 0 00-1 1v2a1 1 0 001 1zM5 20h2a1 1 0 001-1v-2a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1z" />
                </svg>
                <span>Kru Gate Scanner</span>
              </a>

              <a href="/admin" id="nav-admin-link" class="hidden flex items-center gap-2.5 px-3 py-2 rounded-xl text-xs font-semibold text-amber-500 dark:text-amber-400 hover:bg-amber-500/10 transition-colors">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                </svg>
                <span>Admin Command Center</span>
              </a>
            </div>

            <div class="border-t border-neutral-100 dark:border-white/10 mt-2 pt-2">
              <button 
                id="nav-logout-btn" 
                type="button" 
                class="w-full flex items-center gap-2.5 px-3 py-2 rounded-xl text-xs font-medium text-red-500 hover:bg-red-50 dark:hover:bg-red-950/30 transition-colors text-left"
              >
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
                </svg>
                <span>Keluar Sesi</span>
              </button>
            </div>
          </div>
        </div>
      </div>

      <a 
        href="/events" 
        data-i18n="nav.getTickets"
        class="px-5 py-2.5 rounded-full bg-electric-magenta text-soft-white font-medium text-sm tracking-wide hover:shadow-magenta-glow transition-all duration-300 hover:scale-[1.02] active:scale-[0.98]"
      >
        Beli Tiket
      </a>
    </div>

    <!-- Mobile Action Row: Lang Toggle + Theme toggle + Hamburger -->
    <div class="md:hidden flex items-center gap-2">
      <!-- Mobile Language Switcher Pill -->
      <div 
        class="flex items-center p-0.5 rounded-full border border-neutral-200 dark:border-white/10 bg-neutral-100 dark:bg-white/5 text-xs font-mono font-bold" 
        role="group"
      >
        <button 
          type="button" 
          data-lang-btn="id" 
          class="px-2 py-0.5 rounded-full text-[10px] uppercase font-bold bg-electric-magenta text-white shadow-sm"
        >
          ID
        </button>
        <button 
          type="button" 
          data-lang-btn="en" 
          class="px-2 py-0.5 rounded-full text-[10px] uppercase font-bold text-neutral-500 dark:text-muted-gray"
        >
          EN
        </button>
      </div>

      <button 
        type="button"
        data-theme-toggle
        aria-label="Toggle Dark / Light Mode"
        class="w-9 h-9 rounded-full flex items-center justify-center border border-neutral-200 dark:border-white/10 bg-neutral-100 dark:bg-white/5 text-neutral-700 dark:text-soft-white"
      >
        <svg data-icon="sun" class="w-4 h-4 hidden" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <circle cx="12" cy="12" r="4"></circle>
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 2v2m0 16v2M4.93 4.93l1.41 1.41m11.32 11.32l1.41 1.41M2 12h2m16 0h2M6.34 17.66l-1.41 1.41m14.14-14.14l-1.41 1.41" />
        </svg>
        <svg data-icon="moon" class="w-4 h-4 hidden" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
        </svg>
      </button>

      <button 
        id="mobile-menu-btn" 
        aria-label="Toggle Navigation Menu" 
        class="flex flex-col justify-center items-center w-10 h-10 gap-1.5 focus:outline-none"
      >
        <span class="w-6 h-0.5 bg-neutral-800 dark:bg-soft-white transition-transform duration-300 line-top"></span>
        <span class="w-4 h-0.5 bg-electric-magenta transition-opacity duration-300 line-mid"></span>
        <span class="w-6 h-0.5 bg-neutral-800 dark:bg-soft-white transition-transform duration-300 line-bot"></span>
      </button>
    </div>
  </div>

  <!-- Mobile Drawer Menu Overlay -->
  <div 
    id="mobile-menu-drawer" 
    class="md:hidden hidden fixed inset-0 top-20 bg-white/95 dark:bg-void-black/95 backdrop-blur-xl border-t border-black/[0.08] dark:border-white/[0.08] flex-col p-8 gap-6 z-40 transition-all duration-300 overflow-y-auto"
  >
    <a href="/events" data-i18n="nav.discoverEvents" class="font-display text-3xl text-neutral-900 dark:text-soft-white hover:text-electric-magenta transition-colors">
      Jelajahi Konser
    </a>
    <a href="/#about" data-i18n="nav.about" class="font-display text-3xl text-neutral-900 dark:text-soft-white hover:text-electric-magenta transition-colors">
      Tentang Kami
    </a>
    <a href="/tickets" data-i18n="nav.myTickets" class="font-display text-3xl text-neutral-900 dark:text-soft-white hover:text-electric-magenta transition-colors">
      Tiket Saya
    </a>
    <a href="/organizer" data-i18n="nav.createEvent" class="font-display text-3xl text-neutral-900 dark:text-soft-white hover:text-electric-magenta transition-colors">
      Buat Event
    </a>

    <div class="h-px bg-black/10 dark:bg-white/10 my-2"></div>

    <div class="flex flex-col gap-4">
      <!-- Mobile Drawer Language Selector Row -->
      <div class="w-full flex items-center justify-between px-5 py-3.5 rounded-xl border border-neutral-300 dark:border-white/15 text-neutral-800 dark:text-soft-white font-medium text-sm">
        <span>Bahasa / Language</span>
        <div class="flex items-center p-0.5 rounded-full border border-neutral-300 dark:border-white/15 bg-neutral-100 dark:bg-white/5 text-xs font-mono font-bold">
          <button type="button" data-lang-btn="id" class="px-3 py-1 rounded-full text-xs uppercase font-bold bg-electric-magenta text-white">ID</button>
          <button type="button" data-lang-btn="en" class="px-3 py-1 rounded-full text-xs uppercase font-bold text-neutral-500 dark:text-muted-gray">EN</button>
        </div>
      </div>

      <button 
        type="button" 
        data-theme-toggle 
        class="w-full flex items-center justify-between px-5 py-3.5 rounded-xl border border-neutral-300 dark:border-white/15 text-neutral-800 dark:text-soft-white font-medium text-sm"
      >
        <span>Mode Tampilan / Theme</span>
        <span data-theme-label class="text-xs uppercase font-mono text-electric-magenta">LIGHT MODE</span>
      </button>

      <a 
        href="/events" 
        data-i18n="nav.getTickets"
        class="w-full text-center py-4 rounded-xl bg-electric-magenta text-soft-white font-semibold text-lg shadow-magenta-glow"
      >
        Beli Tiket
      </a>
      <!-- Mobile Auth Action -->
      <button 
        id="mobile-signin-btn" 
        type="button" 
        data-i18n="nav.signIn"
        class="w-full text-center py-3.5 rounded-xl border border-neutral-300 dark:border-white/20 text-neutral-800 dark:text-soft-white font-medium text-base hover:bg-neutral-100 dark:hover:bg-white/5"
      >
        Masuk
      </button>

      <div id="mobile-user-card" class="hidden p-4 rounded-xl bg-neutral-100 dark:bg-dark-plum border border-neutral-300 dark:border-white/10 flex flex-col gap-3">
        <div class="flex items-center gap-3">
          <div id="mobile-avatar-disc" class="w-10 h-10 rounded-full bg-electric-magenta text-soft-white font-bold flex items-center justify-center text-sm shadow-magenta-glow">
            U
          </div>
          <div class="truncate">
            <p id="mobile-user-fullname" class="font-bold text-sm text-neutral-900 dark:text-soft-white truncate"></p>
            <p id="mobile-user-email" class="text-xs text-muted-gray truncate font-mono"></p>
          </div>
        </div>
        <div class="grid grid-cols-2 gap-2 text-xs font-semibold">
          <a href="/account" class="px-3 py-2 rounded-lg bg-white/80 dark:bg-white/5 border border-neutral-200 dark:border-white/10 text-neutral-900 dark:text-soft-white text-center">Akun & Order</a>
          <a href="/tickets" class="px-3 py-2 rounded-lg bg-white/80 dark:bg-white/5 border border-neutral-200 dark:border-white/10 text-neutral-900 dark:text-soft-white text-center">Tiket QR</a>
          <a href="/organizer" class="px-3 py-2 rounded-lg bg-white/80 dark:bg-white/5 border border-neutral-200 dark:border-white/10 text-neutral-900 dark:text-soft-white text-center">Promotor</a>
          <a href="/scanner" id="mobile-scanner-link" class="hidden px-3 py-2 rounded-lg bg-electric-magenta/15 border border-electric-magenta/40 text-electric-magenta text-center">Gate Scanner</a>
          <a href="/admin" id="mobile-admin-link" class="hidden col-span-2 px-3 py-2 rounded-lg bg-amber-500/15 border border-amber-500/40 text-amber-500 dark:text-amber-300 text-center">Admin Command Center</a>
        </div>
        <button 
          id="mobile-logout-btn" 
          type="button" 
          class="w-full py-2.5 rounded-lg border border-red-500/30 text-red-500 text-xs font-bold uppercase tracking-wider hover:bg-red-500/10 transition-colors"
        >
          Keluar Sesi
        </button>
      </div>
    </div>
  </div>
</header>

<script>
  import { fetchCurrentUser, getStoredUser, isAuthenticated, logout, USER_ROLES } from '../../lib/auth';

  let navbarDocListenerBound = false;

  function setupNavbar() {
    // Mobile Drawer Setup
    const menuBtn = document.getElementById('mobile-menu-btn');
    const drawer = document.getElementById('mobile-menu-drawer');
    if (menuBtn && drawer) {
      menuBtn.addEventListener('click', () => {
        const isHidden = drawer.classList.contains('hidden');
        if (isHidden) {
          drawer.classList.remove('hidden');
          drawer.classList.add('flex');
          document.body.style.overflow = 'hidden';
        } else {
          drawer.classList.add('hidden');
          drawer.classList.remove('flex');
          document.body.style.overflow = '';
        }
      });

      drawer.querySelectorAll('a').forEach((link) => {
        link.addEventListener('click', () => {
          drawer.classList.add('hidden');
          drawer.classList.remove('flex');
          document.body.style.overflow = '';
        });
      });
    }

    // Auth Modal Triggers
    const navSigninBtn = document.getElementById('nav-signin-btn');
    const mobileSigninBtn = document.getElementById('mobile-signin-btn');

    navSigninBtn?.addEventListener('click', () => {
      if (typeof window.openAuthModal === 'function') {
        window.openAuthModal();
      }
    });

    mobileSigninBtn?.addEventListener('click', () => {
      if (drawer) {
        drawer.classList.add('hidden');
        drawer.classList.remove('flex');
        document.body.style.overflow = '';
      }
      if (typeof window.openAuthModal === 'function') {
        window.openAuthModal();
      }
    });

    // User Dropdown Popover
    const userToggleBtn = document.getElementById('nav-user-toggle-btn');
    const userPopover = document.getElementById('nav-user-popover');

    userToggleBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      const isClosed = userPopover?.classList.contains('hidden');
      if (isClosed) {
        userPopover?.classList.remove('hidden');
        userToggleBtn.setAttribute('aria-expanded', 'true');
      } else {
        userPopover?.classList.add('hidden');
        userToggleBtn.setAttribute('aria-expanded', 'false');
      }
    });

    if (!navbarDocListenerBound) {
      navbarDocListenerBound = true;
      document.addEventListener('click', (e) => {
        const pop = document.getElementById('nav-user-popover');
        const btn = document.getElementById('nav-user-toggle-btn');
        if (pop && !pop.contains(e.target as Node) && !btn?.contains(e.target as Node)) {
          pop.classList.add('hidden');
          btn?.setAttribute('aria-expanded', 'false');
        }
      });
      window.addEventListener('afterglow-auth-changed', syncNavbarAuthState);
    }

    // Logout Handlers
    const logoutBtn = document.getElementById('nav-logout-btn');
    const mobileLogoutBtn = document.getElementById('mobile-logout-btn');

    const handleLogout = async () => {
      await logout();
      syncNavbarAuthState();
    };

    logoutBtn?.addEventListener('click', handleLogout);
    mobileLogoutBtn?.addEventListener('click', handleLogout);

    // Sync UI with Auth State
    function syncNavbarAuthState() {
      const user = getStoredUser();

      const signinBtn = document.getElementById('nav-signin-btn');
      const userMenu = document.getElementById('nav-user-menu');
      const avatarDisc = document.getElementById('nav-avatar-disc');
      const userName = document.getElementById('nav-user-name');
      const popoverFullname = document.getElementById('nav-popover-fullname');
      const popoverEmail = document.getElementById('nav-popover-email');
      const popoverRole = document.getElementById('nav-popover-role');
      const scannerLink = document.getElementById('nav-scanner-link');
      const adminLink = document.getElementById('nav-admin-link');

      const mobSigninBtn = document.getElementById('mobile-signin-btn');
      const mobUserCard = document.getElementById('mobile-user-card');
      const mobAvatarDisc = document.getElementById('mobile-avatar-disc');
      const mobFullname = document.getElementById('mobile-user-fullname');
      const mobEmail = document.getElementById('mobile-user-email');
      const mobScannerLink = document.getElementById('mobile-scanner-link');
      const mobAdminLink = document.getElementById('mobile-admin-link');

      if (user) {
        // Desktop
        signinBtn?.classList.add('hidden');
        userMenu?.classList.remove('hidden');

        const initial = (user.username || user.email || 'U').charAt(0).toUpperCase();
        if (avatarDisc) avatarDisc.textContent = initial;
        if (userName) userName.textContent = user.username || user.email.split('@')[0];
        if (popoverFullname) popoverFullname.textContent = user.username || user.email.split('@')[0];
        if (popoverEmail) popoverEmail.textContent = user.email;

        // Role badge, Admin & Scanner links
        const isScannerAllowed =
          user.role_id === USER_ROLES.ADMIN ||
          user.role_id === USER_ROLES.ORGANIZER ||
          user.email.toLowerCase().includes('gatecrew');

        scannerLink?.classList.toggle('hidden', !isScannerAllowed);
        mobScannerLink?.classList.toggle('hidden', !isScannerAllowed);
        adminLink?.classList.toggle('hidden', user.role_id !== USER_ROLES.ADMIN);
        mobAdminLink?.classList.toggle('hidden', user.role_id !== USER_ROLES.ADMIN);

        if (popoverRole) {
          if (user.role_id === USER_ROLES.ADMIN) {
            popoverRole.textContent = 'ADMIN PLATFORM';
            popoverRole.className = 'mt-1.5 inline-block px-2 py-0.5 rounded text-[10px] font-mono font-bold uppercase bg-amber-500/15 text-amber-400 border border-amber-500/30';
          } else if (user.role_id === USER_ROLES.ORGANIZER) {
            popoverRole.textContent = 'PROMOTOR EVENT';
            popoverRole.className = 'mt-1.5 inline-block px-2 py-0.5 rounded text-[10px] font-mono font-bold uppercase bg-purple-500/15 text-purple-400 border border-purple-500/30';
          } else {
            popoverRole.textContent = 'PENONTON RESMI';
            popoverRole.className = 'mt-1.5 inline-block px-2 py-0.5 rounded text-[10px] font-mono font-bold uppercase bg-electric-magenta/15 text-electric-magenta border border-electric-magenta/30';
          }
        }

        // Mobile
        mobSigninBtn?.classList.add('hidden');
        mobUserCard?.classList.remove('hidden');
        if (mobAvatarDisc) mobAvatarDisc.textContent = initial;
        if (mobFullname) mobFullname.textContent = user.username || user.email.split('@')[0];
        if (mobEmail) mobEmail.textContent = user.email;
      } else {
        // Logged out
        signinBtn?.classList.remove('hidden');
        userMenu?.classList.add('hidden');
        userPopover?.classList.add('hidden');
        scannerLink?.classList.add('hidden');
        adminLink?.classList.add('hidden');
        mobScannerLink?.classList.add('hidden');
        mobAdminLink?.classList.add('hidden');

        mobSigninBtn?.classList.remove('hidden');
        mobUserCard?.classList.add('hidden');
      }
    }

    syncNavbarAuthState();
    if (isAuthenticated()) {
      fetchCurrentUser().catch(() => {});
    }
  }

  document.addEventListener('astro:page-load', setupNavbar);
</script>
