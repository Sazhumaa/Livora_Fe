        const rows = await api.get<any[]>(`/events${q}`);
        if (isDisposed) return;
        const list = Array.isArray(rows) ? rows : [];
        if (list.length === 0) {
          listEl.innerHTML = `<div class="p-10 rounded-3xl bg-dark-plum/50 border border-white/10 text-center text-sm text-muted-gray">Tidak ada event pada filter status ini.</div>`;
          return;
        }
        listEl.innerHTML = list
          .map((ev) => {
