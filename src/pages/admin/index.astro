          listEl.innerHTML = `<div class="p-10 rounded-3xl bg-white dark:bg-dark-plum/50 border border-neutral-200 dark:border-white/10 text-center text-sm text-neutral-600 dark:text-muted-gray">Tidak ada pengajuan payout pada filter status ini.</div>`;
          return;
        }
        listEl.innerHTML = list
          .map(
            (p) => `
            <div class="p-5 sm:p-6 rounded-3xl bg-white dark:bg-dark-plum/85 border border-neutral-200 dark:border-white/12 shadow-sm dark:shadow-none flex flex-col md:flex-row md:items-center justify-between gap-4">
              <div class="space-y-1">
                <div class="flex flex-wrap items-center gap-2">
                  <span class="font-mono text-xs font-bold text-neutral-950 dark:text-soft-white">PAYOUT #${p.id}</span>
                  <span class="px-2.5 py-0.5 rounded-full text-[10px] font-mono font-bold uppercase ${
                    p.status === 'completed' ? 'bg-emerald-50 dark:bg-emerald-500/20 text-emerald-700 dark:text-emerald-300' : p.status === 'failed' ? 'bg-red-50 dark:bg-red-500/15 text-red-700 dark:text-red-300' : 'bg-amber-50 dark:bg-amber-500/20 text-amber-700 dark:text-amber-300'
                  }">${escapeHtml(p.status)}</span>
                </div>
                <h3 class="font-bold text-base text-neutral-950 dark:text-soft-white">${escapeHtml(p.nama_organizer || `Org #${p.organizer_id}`)} — ${escapeHtml(p.nama_event || `Event #${p.event_id}`)}</h3>
                <p class="text-xs font-mono text-neutral-600 dark:text-muted-gray">Tujuan: ${escapeHtml(p.bank_account)} • ${escapeHtml(p.account_number)}</p>
                <p class="text-[11px] font-mono text-neutral-500 dark:text-muted-gray">Diajukan: ${escapeHtml(formatDateIndo(p.created_at))}</p>
                ${p.rejection_reason ? `<p class="text-xs font-mono text-red-600 dark:text-red-300">Alasan Tolak: ${escapeHtml(p.rejection_reason)}</p>` : ''}
              </div>

              <div class="flex flex-col sm:items-end gap-3 shrink-0">
                <strong class="font-display text-3xl text-electric-magenta">${escapeHtml(formatRupiah(p.amount))}</strong>
                ${p.status === 'pending' ? `
                  <div class="flex gap-2">
                    <button type="button" data-payout-approve="${p.id}" class="px-4 py-2 rounded-xl bg-emerald-50 dark:bg-emerald-500/20 border border-emerald-300 dark:border-emerald-500/40 text-emerald-700 dark:text-emerald-300 text-xs font-bold uppercase">
                      Approve Transfer
                    </button>
                    <button type="button" data-payout-reject="${p.id}" class="px-4 py-2 rounded-xl bg-red-50 dark:bg-red-500/15 border border-red-200 dark:border-red-500/30 text-red-700 dark:text-red-300 text-xs font-bold uppercase">
                      Tolak
                    </button>
                  </div>
                ` : ''}
              </div>
            </div>
          `
          )
          .join('');
      } catch (err: any) {
        listEl.innerHTML = `<div class="p-6 rounded-2xl bg-red-50 dark:bg-red-500/10 border border-red-200 dark:border-red-500/30 text-xs font-mono text-red-700 dark:text-red-300">${escapeHtml(err?.message || 'Gagal memuat payout.')}</div>`;
      }
    }

    payoutFilter?.addEventListener('change', loadPayouts);
    document.getElementById('adm-payouts-list')?.addEventListener('click', async (e) => {
      const target = e.target as HTMLElement;
      const appBtn = target.closest('[data-payout-approve]') as HTMLButtonElement | null;
      if (appBtn) {
        const id = Number(appBtn.dataset.payoutApprove);
        if (!confirm(`Setujui & tandai Payout #${id} telah ditransfer ke rekening promotor?`)) return;
        try {
          await api.post(`/admin/payouts/${id}/approve`, {});
          showToast(`Payout #${id} disetujui & selesai.`);
          await loadPayouts();
        } catch (err: any) {
          showToast(err?.message || 'Gagal menyetujui payout.', true);
        }
        return;
      }

      const rejBtn = target.closest('[data-payout-reject]') as HTMLButtonElement | null;
      if (rejBtn) {
        const id = Number(rejBtn.dataset.payoutReject);
        openReasonPrompt(`TOLAK PAYOUT #${id}`, 'Dana akan dikembalikan secara atomik ke withdrawable_balance promotor.', async (reason) => {
          try {
            await api.post(`/admin/payouts/${id}/reject`, { rejection_reason: reason });
            showToast(`Payout #${id} ditolak & saldo dikembalikan.`);
            await loadPayouts();
          } catch (err: any) {
            showToast(err?.message || 'Gagal menolak payout.', true);
          }
        });
      }
    });

