              <div class="space-y-1">
                <div class="flex flex-wrap items-center gap-2">
                  <span class="font-mono text-xs font-bold text-neutral-950 dark:text-soft-white">REFUND #${r.id} • ${escapeHtml(r.order_code)}</span>
                  <span class="px-2.5 py-0.5 rounded-full text-[10px] font-mono font-bold uppercase ${
                    r.status === 'completed' ? 'bg-emerald-50 dark:bg-emerald-500/20 text-emerald-700 dark:text-emerald-300' : 'bg-amber-50 dark:bg-amber-500/20 text-amber-700 dark:text-amber-300'
                  }">${escapeHtml(r.status)}</span>
