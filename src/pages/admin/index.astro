    evFilter?.addEventListener('change', loadEvents);
    document.getElementById('adm-events-list')?.addEventListener('click', async (e) => {
      const target = e.target as HTMLElement;
      const pubBtn = target.closest('[data-ev-publish]') as HTMLButtonElement | null;
      if (pubBtn) {
        const id = Number(pubBtn.dataset.evPublish);
        if (!confirm(`Publikasikan Event #${id} ke katalog publik? Harga tiket akan terkunci (Immutable Pricing Guard).`)) return;
        try {
          await api.patch(`/update/verification-event/${id}`, { status: 'published' });
          showToast(`Event #${id} berhasil dipublikasikan!`);
          await loadEvents();
        } catch (err: any) {
          showToast(err?.message || 'Gagal mempublikasikan event.', true);
        }
        return;
      }

      const rejBtn = target.closest('[data-ev-reject]') as HTMLButtonElement | null;
      if (rejBtn) {
        const id = Number(rejBtn.dataset.evReject);
        openReasonPrompt(`TOLAK EVENT #${id}`, 'Jelaskan kekurangan dokumen atau jadwal agar promotor bisa memperbaiki.', async (reason) => {
          try {
            await api.patch(`/update/verification-event/${id}`, { status: 'rejected', rejection_reason: reason });
            showToast(`Event #${id} ditolak.`);
            await loadEvents();
          } catch (err: any) {
            showToast(err?.message || 'Gagal menolak event.', true);
          }
        });
        return;
      }

      const settleBtn = target.closest('[data-ev-settle]') as HTMLButtonElement | null;
      if (settleBtn) {
        const id = Number(settleBtn.dataset.evSettle);
        if (!confirm(`Eksekusi settlement escrow H+1 untuk Event #${id}?`)) return;
        try {
          await api.post(`/admin/events/${id}/settle`, {});
          showToast(`Escrow H+1 Event #${id} berhasil diselesaikan!`);
          await loadEvents();
        } catch (err: any) {
          showToast(err?.message || 'Event belum memenuhi syarat settlement H+1.', true);
        }
        return;
      }

      const cancelBtn = target.closest('[data-ev-cancel]') as HTMLButtonElement | null;
      if (cancelBtn) {
        const id = Number(cancelBtn.dataset.evCancel);
        openReasonPrompt(`BATALKAN KONSER #${id} & MASS REFUND`, 'Seluruh tiket aktif akan hangus dan seluruh order lunas masuk ke antrean refund.', async (reason) => {
          try {
            await api.post(`/events/${id}/cancel`, { reason });
            showToast(`Konser #${id} dibatalkan & antrean refund dibuat.`);
            await loadEvents();
          } catch (err: any) {
            showToast(err?.message || 'Gagal membatalkan konser.', true);
          }
        });
      }
    });

    // TAB 4: ESCROW & PAYOUTS
    async function loadSettleCandidates() {
      const box = document.getElementById('adm-settle-candidates-list');
      if (!box) return;
      box.innerHTML = `<p class="text-xs font-mono text-neutral-500 dark:text-muted-gray">Memuat konser siap settle H+1...</p>`;
      try {
        const rows = await api.get<any[]>('/admin/escrow/settle-candidates');
        if (isDisposed) return;
        const list = Array.isArray(rows) ? rows : [];
        if (list.length === 0) {
          box.innerHTML = `<div class="p-4 rounded-2xl bg-neutral-50 dark:bg-void-black/50 border border-neutral-200 dark:border-white/10 text-xs font-mono text-neutral-600 dark:text-muted-gray">Tidak ada konser selesai dengan dana tertahan (semua sudah settle H+1).</div>`;
          return;
        }
        box.innerHTML = list
          .map(
            (c: any) => `
            <div class="p-4 rounded-2xl bg-neutral-50 dark:bg-void-black/70 border border-neutral-200 dark:border-white/10 flex flex-col md:flex-row md:items-center justify-between gap-3">
              <div>
                <div class="flex flex-wrap items-center gap-2 text-xs font-mono">
                  <span class="font-bold text-neutral-950 dark:text-soft-white">Event #${c.event_id}</span>
                  <span class="px-2 py-0.5 rounded-full text-[10px] uppercase bg-emerald-50 dark:bg-emerald-500/20 text-emerald-700 dark:text-emerald-300 font-bold">${escapeHtml(c.status)}</span>
                  <span class="text-electric-magenta">${escapeHtml(c.organization_name || '-')}</span>
                </div>
                <h4 class="font-bold text-sm text-neutral-950 dark:text-soft-white mt-0.5">${escapeHtml(c.nama_event)}</h4>
                <p class="text-[11px] font-mono text-neutral-600 dark:text-muted-gray">
                  ${Number(c.unsettled_orders_count || 0)} order unsettled • Gross ${escapeHtml(formatRupiah(c.total_gross || 0))} • Fee 5%: ${escapeHtml(formatRupiah(c.total_platform_fee || 0))}
                </p>
              </div>
              <div class="flex items-center gap-3 shrink-0">
                <div class="text-right">
                  <span class="text-[10px] font-mono uppercase text-neutral-500 dark:text-muted-gray block">Net Siap Rilis</span>
                  <strong class="font-display text-2xl text-emerald-600 dark:text-emerald-400">${escapeHtml(formatRupiah(c.organizer_net_ready || 0))}</strong>
                </div>
                <button type="button" data-candidate-settle="${c.event_id}" class="px-4 py-2 rounded-xl bg-emerald-50 dark:bg-emerald-500/20 border border-emerald-300 dark:border-emerald-500/40 text-emerald-700 dark:text-emerald-300 hover:bg-emerald-100 dark:hover:bg-emerald-500/30 text-xs font-bold uppercase">
                  Settle Sekarang
                </button>
              </div>
            </div>
          `
          )
          .join('');
      } catch (err: any) {
        box.innerHTML = `<p class="text-xs font-mono text-red-600 dark:text-red-300">${escapeHtml(err?.message || 'Gagal memuat antrean settlement.')}</p>`;
      }
    }

    document.getElementById('adm-settle-candidates-list')?.addEventListener('click', async (e) => {
      const btn = (e.target as HTMLElement).closest('[data-candidate-settle]') as HTMLButtonElement | null;
      if (!btn) return;
      const id = Number(btn.dataset.candidateSettle);
      if (!id || !confirm(`Rilis seluruh dana net Event #${id} ke saldo siap tarik promotor sekarang?`)) return;
      btn.disabled = true;
      try {
        await api.post(`/admin/events/${id}/settle`, {});
        showToast(`Escrow Event #${id} berhasil dirilis!`);
        await loadSettleCandidates();
      } catch (err: any) {
        showToast(err?.message || 'Gagal melakukan settlement escrow event.', true);
        btn.disabled = false;
      }
    });

    document.getElementById('adm-manual-settle-form')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const input = document.getElementById('adm-settle-ev-id') as HTMLInputElement;
      const id = Number(input.value);
      if (!id) return;
      try {
        await api.post(`/admin/events/${id}/settle`, {});
        input.value = '';
        showToast(`Escrow Event #${id} berhasil dirilis ke saldo siap tarik promotor!`);
        await loadSettleCandidates();
      } catch (err: any) {
        showToast(err?.message || 'Gagal melakukan settlement escrow event.', true);
      }
    });

    async function loadPayouts() {
