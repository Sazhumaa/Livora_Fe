---
export const prerender = false;

import RootLayout from '../../layouts/RootLayout.astro';
import Footer from '../../components/landing/Footer.astro';

const rawTab = Astro.url.searchParams.get('tab') || 'pulse';
const initialTab = ['pulse', 'organizers', 'events', 'escrow', 'refunds', 'audit'].includes(rawTab)
  ? rawTab
  : 'pulse';
---

<RootLayout
  title="Admin Command Center — AFTERGLOW"
  description="Pusat kendali platform AFTERGLOW: verifikasi promotor, kurasi konser, persetujuan payout escrow, refund, dan audit trail."
>
  <div class="relative pt-28 pb-24 px-4 sm:px-6 lg:px-12 max-w-7xl mx-auto w-full">

    <!-- Access Guard -->
    <div id="admin-access-guard" class="hidden text-center py-24 rounded-3xl bg-dark-plum/60 border border-red-500/30">
      <span class="px-3 py-1 rounded-full bg-red-500/20 text-red-300 font-mono text-[10px] font-bold uppercase">
        RESTRICTED // ADMIN PLATFORM ONLY
      </span>
      <h1 id="admin-guard-title" class="font-display text-4xl sm:text-5xl text-soft-white mt-3 mb-2">
        AKSES KHUSUS ADMINISTRATOR
      </h1>
      <p id="admin-guard-desc" class="text-sm text-muted-gray max-w-md mx-auto mb-6">
        Masuk menggunakan akun Administrator (`admin@soundtix.id`) untuk membuka pusat kontrol operasional platform.
      </p>
      <div class="flex flex-wrap justify-center gap-3">
        <button id="admin-login-btn" type="button" class="px-7 py-3 rounded-full bg-electric-magenta text-soft-white font-bold text-xs uppercase tracking-wider hover:shadow-magenta-glow transition-all">
          Masuk Akun Admin
        </button>
        <a href="/" class="px-7 py-3 rounded-full bg-white/10 hover:bg-white/20 text-soft-white font-bold text-xs uppercase tracking-wider transition-all">
          Kembali ke Beranda
        </a>
      </div>
    </div>

    <!-- Admin Workspace -->
    <div id="admin-workspace" class="hidden space-y-8">
      <!-- Header -->
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-4">
        <div>
          <div class="flex items-center gap-2 mb-2">
            <span class="px-2.5 py-0.5 rounded bg-electric-magenta/20 border border-electric-magenta/40 text-electric-magenta font-mono text-[10px] font-bold uppercase">
              PLATFORM COMMAND CENTER
            </span>
            <span id="admin-operator-badge" class="text-[11px] font-mono text-muted-gray"></span>
          </div>
          <h1 class="font-display text-4xl sm:text-6xl text-soft-white tracking-wide">
            AFTERGLOW ADMIN CONSOLE
          </h1>
        </div>
        <button id="admin-refresh-current-btn" type="button" class="self-start md:self-auto px-5 py-2.5 rounded-xl bg-white/10 hover:bg-white/20 text-soft-white text-xs font-mono font-bold uppercase transition-all">
          Refresh Data Aktif
        </button>
      </div>

      <!-- Navigation Tabs -->
      <div class="flex flex-wrap gap-2 p-1.5 rounded-2xl bg-dark-plum border border-white/10 w-fit" id="admin-tabs">
        <button data-tab="pulse" class="adm-tab-btn px-4 py-2 rounded-xl text-xs font-mono font-bold uppercase transition-all">Command Pulse</button>
        <button data-tab="organizers" class="adm-tab-btn px-4 py-2 rounded-xl text-xs font-mono font-bold uppercase transition-all">Promotor Queue</button>
        <button data-tab="events" class="adm-tab-btn px-4 py-2 rounded-xl text-xs font-mono font-bold uppercase transition-all">Event Curation</button>
        <button data-tab="escrow" class="adm-tab-btn px-4 py-2 rounded-xl text-xs font-mono font-bold uppercase transition-all">Escrow & Payouts</button>
        <button data-tab="refunds" class="adm-tab-btn px-4 py-2 rounded-xl text-xs font-mono font-bold uppercase transition-all">Refund Queue</button>
        <button data-tab="audit" class="adm-tab-btn px-4 py-2 rounded-xl text-xs font-mono font-bold uppercase transition-all">Audit & Cron Jobs</button>
      </div>

      <!-- Global Action Toast Banner -->
      <div id="admin-toast" class="hidden p-4 rounded-2xl border text-xs font-mono"></div>

      <!-- TAB 1: COMMAND PULSE -->
      <section id="adm-panel-pulse" class="adm-panel hidden space-y-8">
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5" id="adm-pulse-kpis"></div>

        <div>
          <h2 class="font-display text-2xl text-soft-white mb-4">ACTION CENTER // ANTREAN BUTUH TINDAKAN</h2>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4" id="adm-action-center"></div>
        </div>
      </section>

      <!-- TAB 2: ORGANIZERS REVIEW -->
      <section id="adm-panel-organizers" class="adm-panel hidden space-y-5">
        <div class="flex flex-wrap items-center justify-between gap-4">
          <h2 class="font-display text-2xl text-soft-white">VERIFIKASI PENDAFTARAN PROMOTOR</h2>
          <select id="adm-org-filter" class="px-4 py-2 rounded-xl bg-dark-plum border border-white/15 text-xs font-mono text-soft-white focus:outline-none focus:border-electric-magenta">
            <option value="pending">Pending Review</option>
            <option value="">Semua Status</option>
            <option value="verified">Verified</option>
            <option value="rejected">Rejected</option>
          </select>
        </div>
        <div id="adm-organizers-list" class="space-y-4"></div>
      </section>

      <!-- TAB 3: EVENT CURATION -->
      <section id="adm-panel-events" class="adm-panel hidden space-y-5">
        <div class="flex flex-wrap items-center justify-between gap-4">
          <h2 class="font-display text-2xl text-soft-white">KURASI & MODERASI EVENT KONSER</h2>
          <select id="adm-ev-filter" class="px-4 py-2 rounded-xl bg-dark-plum border border-white/15 text-xs font-mono text-soft-white focus:outline-none focus:border-electric-magenta">
            <option value="pending">Menunggu Persetujuan (Pending)</option>
            <option value="">Semua Status</option>
            <option value="published">Published</option>
            <option value="ongoing">Ongoing</option>
            <option value="selesai">Selesai</option>
            <option value="rejected">Rejected</option>
            <option value="dibatalkan">Dibatalkan</option>
            <option value="draft">Draft</option>
          </select>
        </div>
        <div id="adm-events-list" class="space-y-4"></div>
      </section>

      <!-- TAB 4: ESCROW & PAYOUTS -->
      <section id="adm-panel-escrow" class="adm-panel hidden space-y-6">
        <!-- Manual Event H+1 Settlement Box -->
        <div class="p-6 rounded-3xl bg-dark-plum/85 border border-white/15 flex flex-col sm:flex-row sm:items-end justify-between gap-4">
          <div>
            <span class="text-[10px] font-mono uppercase tracking-wider text-electric-magenta font-bold block">EKSEKUSI ESCROW MANUAL</span>
            <h3 class="font-display text-2xl text-soft-white mt-0.5">SETTLEMENT DANA EVENT H+1</h3>
            <p class="text-xs text-muted-gray">Pindahkan net omzet event berstatus selesai / H+1 dari pending_balance ke withdrawable_balance promotor.</p>
          </div>
          <form id="adm-manual-settle-form" class="flex items-center gap-2 shrink-0">
            <input id="adm-settle-ev-id" type="number" min="1" required placeholder="Event ID" class="w-32 px-3.5 py-2.5 rounded-xl bg-void-black border border-white/15 text-xs font-mono text-soft-white" />
            <button type="submit" class="px-5 py-2.5 rounded-xl bg-emerald-500/20 border border-emerald-500/40 text-emerald-300 hover:bg-emerald-500/30 text-xs font-bold uppercase">
              Settle Escrow
            </button>
          </form>
        </div>

        <div class="flex flex-wrap items-center justify-between gap-4">
          <h2 class="font-display text-2xl text-soft-white">ANTREAN PENCAIRAN DANA (PAYOUTS)</h2>
          <select id="adm-payout-filter" class="px-4 py-2 rounded-xl bg-dark-plum border border-white/15 text-xs font-mono text-soft-white focus:outline-none focus:border-electric-magenta">
            <option value="pending">Pending Approval</option>
            <option value="">Semua Status</option>
            <option value="completed">Completed</option>
            <option value="failed">Failed / Rejected</option>
          </select>
        </div>

        <div id="adm-payouts-list" class="space-y-4"></div>
      </section>

      <!-- TAB 5: REFUND QUEUE -->
      <section id="adm-panel-refunds" class="adm-panel hidden space-y-5">
        <div class="flex flex-wrap items-center justify-between gap-4">
          <h2 class="font-display text-2xl text-soft-white">ANTREAN PENGEMBALIAN DANA (REFUNDS)</h2>
          <select id="adm-refund-filter" class="px-4 py-2 rounded-xl bg-dark-plum border border-white/15 text-xs font-mono text-soft-white focus:outline-none focus:border-electric-magenta">
            <option value="pending">Pending Transfer</option>
            <option value="">Semua Status</option>
            <option value="completed">Completed</option>
          </select>
        </div>
        <div id="adm-refunds-list" class="space-y-4"></div>
      </section>

      <!-- TAB 6: AUDIT LOGS & CRON JOBS -->
      <section id="adm-panel-audit" class="adm-panel hidden space-y-8">
        <!-- Manual Worker Triggers -->
        <div class="p-6 sm:p-8 rounded-3xl bg-dark-plum/85 border border-white/15 space-y-4">
          <div>
            <span class="text-[10px] font-mono uppercase tracking-wider text-electric-magenta font-bold block">AUTOMATION & UKK DEMO WORKERS</span>
            <h2 class="font-display text-2xl text-soft-white mt-0.5">TRIGGER BACKGROUND CRON JOBS MANUAL</h2>
          </div>

          <div class="flex flex-wrap gap-3" id="adm-jobs-buttons">
            {[
              { name: 'expire-orders', label: '1. Expire Orders (>15m)' },
              { name: 'transition-events', label: '2. Transition Event Lifecycle' },
              { name: 'settle-escrow', label: '3. Auto-Settle Escrow H+1' },
              { name: 'dispatch-emails', label: '4. Dispatch Email Outbox' },
              { name: 'cleanup-auth', label: '5. Cleanup Expired OTP/Tokens' },
            ].map((j) => (
              <button
                type="button"
                data-trigger-job={j.name}
                class="adm-job-btn px-4 py-2.5 rounded-xl bg-void-black border border-white/15 hover:border-electric-magenta hover:text-electric-magenta text-xs font-mono font-bold text-soft-white transition-all"
              >
                {j.label}
              </button>
            ))}
          </div>

          <pre id="adm-job-output" class="hidden p-4 rounded-2xl bg-void-black border border-emerald-500/30 text-[11px] font-mono text-emerald-300 overflow-x-auto"></pre>
        </div>

        <!-- Audit Logs Explorer -->
        <div class="p-6 sm:p-8 rounded-3xl bg-dark-plum/85 border border-white/15 space-y-5">
          <div class="flex flex-col md:flex-row md:items-end justify-between gap-4">
            <h2 class="font-display text-2xl text-soft-white">JEJAK AUDIT FINANSIAL & KEAMANAN</h2>
            <form id="adm-audit-filter-form" class="flex flex-wrap items-center gap-2">
              <input id="audit-action-input" type="text" placeholder="Filter Action (mis. ORDER_PAID)" class="px-3.5 py-2 rounded-xl bg-void-black border border-white/15 text-xs font-mono text-soft-white" />
              <input id="audit-target-input" type="text" placeholder="Target (mis. orders)" class="px-3.5 py-2 rounded-xl bg-void-black border border-white/15 text-xs font-mono text-soft-white" />
              <button type="submit" class="px-4 py-2 rounded-xl bg-electric-magenta text-soft-white text-xs font-bold uppercase">
                Filter Logs
              </button>
            </form>
          </div>

          <div class="overflow-x-auto">
            <table class="w-full text-xs font-mono">
              <thead>
                <tr class="text-left text-muted-gray border-b border-white/10">
                  <th class="pb-3">WAKTU</th>
                  <th class="pb-3">AKSI</th>
                  <th class="pb-3">TARGET</th>
                  <th class="pb-3">PELAKU</th>
                  <th class="pb-3">IP & DETAIL</th>
                </tr>
              </thead>
              <tbody id="adm-audit-tbody" class="divide-y divide-white/5"></tbody>
            </table>
          </div>
        </div>
      </section>
    </div>
  </div>

  <!-- REASON INPUT MODAL (Reject / Cancel Actions) -->
  <div id="admin-reason-modal" class="fixed inset-0 z-50 hidden items-center justify-center p-4 bg-black/80 backdrop-blur-md">
    <div class="w-full max-w-md rounded-3xl bg-dark-plum border border-white/15 p-6 space-y-4 shadow-2xl">
      <div>
        <span class="text-[10px] font-mono uppercase tracking-wider text-electric-magenta font-bold block">KONFIRMASI TINDAKAN ADMIN</span>
        <h3 id="adm-reason-title" class="font-display text-2xl text-soft-white mt-1">ALASAN PENOLAKAN</h3>
        <p id="adm-reason-desc" class="text-xs text-muted-gray mt-1"></p>
      </div>
      <form id="adm-reason-form" class="space-y-4">
        <textarea id="adm-reason-input" rows="3" minlength="5" maxlength="250" required placeholder="Masukkan alasan resmi minimal 5 karakter..." class="w-full px-4 py-3 rounded-xl bg-void-black border border-white/15 text-xs text-soft-white focus:outline-none focus:border-electric-magenta"></textarea>
        <div class="flex gap-3">
          <button type="button" id="adm-reason-cancel" class="flex-1 py-2.5 rounded-xl bg-white/5 border border-white/10 text-xs font-bold uppercase text-muted-gray hover:text-soft-white">Batal</button>
          <button type="submit" id="adm-reason-confirm" class="flex-1 py-2.5 rounded-xl bg-red-600 hover:bg-red-500 text-xs font-bold uppercase text-white">Konfirmasi</button>
        </div>
      </form>
    </div>
  </div>

  <Footer />
</RootLayout>

<script define:vars={{ initialTab }}>
  window.__adminInitialTab = initialTab;
</script>

<script>
  import { api, resolveAssetUrl } from '../../lib/api';
  import { getStoredUser, isAdmin, isAuthenticated } from '../../lib/auth';
  import { escapeHtml, formatDateIndo, formatRupiah } from '../../lib/formatters';

  function initAdminCommandCenter() {
    const accessGuard = document.getElementById('admin-access-guard');
    const guardTitle = document.getElementById('admin-guard-title');
    const guardDesc = document.getElementById('admin-guard-desc');
    const loginBtn = document.getElementById('admin-login-btn');
    const workspace = document.getElementById('admin-workspace');
    const operatorBadge = document.getElementById('admin-operator-badge');
    const refreshBtn = document.getElementById('admin-refresh-current-btn');
    const toastEl = document.getElementById('admin-toast');

    const tabBtns = document.querySelectorAll<HTMLButtonElement>('.adm-tab-btn');
    const panels = document.querySelectorAll<HTMLElement>('.adm-panel');

    const orgFilter = document.getElementById('adm-org-filter') as HTMLSelectElement | null;
    const evFilter = document.getElementById('adm-ev-filter') as HTMLSelectElement | null;
    const payoutFilter = document.getElementById('adm-payout-filter') as HTMLSelectElement | null;
    const refundFilter = document.getElementById('adm-refund-filter') as HTMLSelectElement | null;

    // Reason modal
    const reasonModal = document.getElementById('admin-reason-modal');
    const reasonTitle = document.getElementById('adm-reason-title');
    const reasonDesc = document.getElementById('adm-reason-desc');
    const reasonForm = document.getElementById('adm-reason-form') as HTMLFormElement | null;
    const reasonInput = document.getElementById('adm-reason-input') as HTMLTextAreaElement | null;
    const reasonCancel = document.getElementById('adm-reason-cancel');

    let currentTab: string = (window as any).__adminInitialTab || 'pulse';
    let pendingReasonHandler: ((reason: string) => Promise<void>) | null = null;
    let isDisposed = false;

    loginBtn?.addEventListener('click', () => {
      if (typeof (window as any).openAuthModal === 'function') (window as any).openAuthModal();
      else window.location.href = '/masuk';
    });

    function showToast(msg: string, isErr = false) {
      if (!toastEl) return;
      toastEl.textContent = msg;
      toastEl.className = `p-4 rounded-2xl border text-xs font-mono ${
        isErr ? 'bg-red-500/10 border-red-500/30 text-red-300' : 'bg-emerald-500/10 border-emerald-500/30 text-emerald-300'
      }`;
      toastEl.classList.remove('hidden');
      setTimeout(() => {
        if (!isDisposed) toastEl.classList.add('hidden');
      }, 5000);
    }

    function openReasonPrompt(title: string, desc: string, onConfirm: (reason: string) => Promise<void>) {
      if (reasonTitle) reasonTitle.textContent = title;
      if (reasonDesc) reasonDesc.textContent = desc;
      if (reasonInput) reasonInput.value = '';
      pendingReasonHandler = onConfirm;
      reasonModal?.classList.remove('hidden');
      reasonModal?.classList.add('flex');
      reasonInput?.focus();
    }

    reasonCancel?.addEventListener('click', () => {
      pendingReasonHandler = null;
      reasonModal?.classList.add('hidden');
      reasonModal?.classList.remove('flex');
    });

    reasonForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const val = reasonInput?.value.trim() || '';
      if (val.length < 5 || !pendingReasonHandler) return;
      const handler = pendingReasonHandler;
      pendingReasonHandler = null;
      reasonModal?.classList.add('hidden');
      reasonModal?.classList.remove('flex');
      await handler(val);
    });

    function activateTab(tab: string) {
      currentTab = tab;
      window.history.replaceState(null, '', `${window.location.pathname}?tab=${encodeURIComponent(tab)}`);
      tabBtns.forEach((b) => {
        const active = b.dataset.tab === tab;
        b.classList.toggle('bg-electric-magenta', active);
        b.classList.toggle('text-soft-white', active);
        b.classList.toggle('shadow-magenta-glow', active);
        b.classList.toggle('text-muted-gray', !active);
      });
      panels.forEach((p) => p.classList.toggle('hidden', p.id !== `adm-panel-${tab}`));
      loadActiveTab();
    }

    function loadActiveTab() {
      if (currentTab === 'pulse') loadPulse();
      if (currentTab === 'organizers') loadOrganizers();
      if (currentTab === 'events') loadEvents();
      if (currentTab === 'escrow') loadPayouts();
      if (currentTab === 'refunds') loadRefunds();
      if (currentTab === 'audit') loadAuditLogs();
    }

    tabBtns.forEach((b) => b.addEventListener('click', () => activateTab(b.dataset.tab || 'pulse')));
    refreshBtn?.addEventListener('click', loadActiveTab);

    // TAB 1: PULSE
    async function loadPulse() {
      const kpiWrap = document.getElementById('adm-pulse-kpis');
      const acWrap = document.getElementById('adm-action-center');
      if (!kpiWrap || !acWrap) return;

      try {
        const dash = await api.get<any>('/admin/dashboard');
        if (isDisposed) return;
        const fin = dash.financials || {};
        const stats = dash.platform_stats || {};
        const ac = dash.action_center || {};

        kpiWrap.innerHTML = [
          { label: 'Total GMV Platform', val: formatRupiah(fin.total_gmv || 0), sub: `Diskon voucher: ${formatRupiah(fin.total_discounts || 0)}` },
          { label: 'Laba Platform Fee (5%)', val: formatRupiah(fin.total_platform_fee || 0), sub: 'Akumulasi order paid', accent: true },
          { label: 'Ekosistem Pengguna', val: `${Number(stats.total_users || 0)} Akun`, sub: `${Number(stats.total_verified_organizers || 0)} Promotor • ${Number(stats.total_events || 0)} Konser` },
        ]
          .map(
            (k) => `
            <div class="p-6 rounded-3xl bg-dark-plum/90 border ${k.accent ? 'border-electric-magenta/45' : 'border-white/15'}">
              <span class="text-[11px] font-mono uppercase text-muted-gray block">${escapeHtml(k.label)}</span>
              <strong class="font-display text-4xl text-soft-white mt-1 block">${escapeHtml(k.val)}</strong>
              <span class="text-xs font-mono text-electric-magenta mt-1 block">${escapeHtml(k.sub)}</span>
            </div>
          `
          )
          .join('');

        acWrap.innerHTML = [
          { tab: 'organizers', count: ac.pending_organizers || 0, title: 'Promotor Pending', desc: 'Verifikasi KYC & rekening bank' },
          { tab: 'events', count: ac.pending_events || 0, title: 'Event Review', desc: 'Kurasi konser sebelum publikasi' },
          { tab: 'escrow', count: ac.pending_payouts || 0, title: 'Payout Queue', desc: 'Persetujuan transfer dana' },
          { tab: 'refunds', count: ac.pending_refunds || 0, title: 'Refund Queue', desc: 'Antrean pengembalian dana user' },
        ]
          .map(
            (item) => `
            <button
              type="button"
              data-jump-tab="${item.tab}"
              class="text-left p-5 rounded-3xl bg-dark-plum/85 border ${Number(item.count) > 0 ? 'border-amber-500/45 hover:border-electric-magenta' : 'border-white/10 hover:border-white/25'} transition-all group"
            >
              <div class="flex items-center justify-between mb-2">
                <span class="text-[10px] font-mono uppercase text-muted-gray">${escapeHtml(item.title)}</span>
                <span class="px-2.5 py-0.5 rounded-full text-xs font-mono font-bold ${Number(item.count) > 0 ? 'bg-amber-500/20 text-amber-300' : 'bg-white/10 text-muted-gray'}">
                  ${Number(item.count)}
                </span>
              </div>
              <p class="text-xs text-soft-white group-hover:text-electric-magenta transition-colors">${escapeHtml(item.desc)} →</p>
            </button>
          `
          )
          .join('');

        acWrap.querySelectorAll<HTMLButtonElement>('[data-jump-tab]').forEach((b) => {
          b.addEventListener('click', () => {
            const targetTab = b.dataset.jumpTab || 'pulse';
            if (targetTab === 'organizers' && orgFilter) orgFilter.value = 'pending';
            if (targetTab === 'events' && evFilter) evFilter.value = 'pending';
            if (targetTab === 'escrow' && payoutFilter) payoutFilter.value = 'pending';
            if (targetTab === 'refunds' && refundFilter) refundFilter.value = 'pending';
            activateTab(targetTab);
          });
        });
      } catch (err: any) {
        showToast(err?.message || 'Gagal memuat dashboard Admin.', true);
      }
    }

    // TAB 2: ORGANIZERS
    async function loadOrganizers() {
      const listEl = document.getElementById('adm-organizers-list');
      if (!listEl) return;
      const st = orgFilter?.value || '';
      const q = st ? `?verification_status=${encodeURIComponent(st)}` : '';
      listEl.innerHTML = `<div class="p-8 rounded-2xl bg-dark-plum/60 border border-white/10 text-xs font-mono text-muted-gray">Memuat antrean promotor...</div>`;
      try {
        const rows = await api.get<any[]>(`/get/organizer${q}`);
        if (isDisposed) return;
        const list = Array.isArray(rows) ? rows : [];
        if (list.length === 0) {
          listEl.innerHTML = `<div class="p-10 rounded-3xl bg-dark-plum/50 border border-white/10 text-center text-sm text-muted-gray">Tidak ada pendaftaran promotor pada status ini.</div>`;
          return;
        }
        listEl.innerHTML = list
          .map(
            (o) => `
            <div class="p-5 sm:p-6 rounded-3xl bg-dark-plum/85 border border-white/12 space-y-3">
              <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
                <div>
                  <div class="flex items-center gap-2 mb-1">
                    <span class="font-mono text-xs text-muted-gray">ORG #${o.id} (User #${o.user_id})</span>
                    <span class="px-2.5 py-0.5 rounded-full text-[10px] font-mono font-bold uppercase ${
                      o.verification_status === 'verified' ? 'bg-emerald-500/20 text-emerald-300' : o.verification_status === 'rejected' ? 'bg-red-500/15 text-red-300' : 'bg-amber-500/20 text-amber-300'
                    }">${escapeHtml(o.verification_status)}</span>
                  </div>
                  <h3 class="font-display text-2xl text-soft-white">${escapeHtml(o.organization_name)}</h3>
                  <p class="text-xs font-mono text-muted-gray">Diajukan: ${escapeHtml(formatDateIndo(o.created_at))}</p>
