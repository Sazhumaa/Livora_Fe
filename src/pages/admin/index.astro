---
export const prerender = false;

import RootLayout from '../../layouts/RootLayout.astro';
import Footer from '../../components/landing/Footer.astro';

const rawTab = Astro.url.searchParams.get('tab') || 'pulse';
const initialTab = ['pulse', 'organizers', 'events', 'escrow', 'refunds', 'orders', 'users', 'audit'].includes(rawTab)
  ? rawTab
  : 'pulse';
---

<RootLayout
  title="Admin Command Center — AFTERGLOW"
  description="Pusat kendali platform AFTERGLOW: verifikasi promotor, kurasi konser, persetujuan payout escrow, refund, dan audit trail."
>
  <div class="relative pt-28 pb-24 px-4 sm:px-6 lg:px-12 max-w-7xl mx-auto w-full">

    <!-- Access Guard -->
    <div id="admin-access-guard" class="hidden text-center py-24 rounded-3xl bg-white dark:bg-dark-plum/60 border border-red-200 dark:border-red-500/30 shadow-sm dark:shadow-none">
      <span class="px-3 py-1 rounded-full bg-red-50 dark:bg-red-500/20 text-red-700 dark:text-red-300 font-mono text-[10px] font-bold uppercase">
        RESTRICTED // ADMIN PLATFORM ONLY
      </span>
      <h1 id="admin-guard-title" class="font-display text-4xl sm:text-5xl text-neutral-950 dark:text-soft-white mt-3 mb-2">
        AKSES KHUSUS ADMINISTRATOR
      </h1>
      <p id="admin-guard-desc" class="text-sm text-neutral-600 dark:text-muted-gray max-w-md mx-auto mb-6">
        Masuk menggunakan akun Administrator (`admin@soundtix.id`) untuk membuka pusat kontrol operasional platform.
      </p>
      <div class="flex flex-wrap justify-center gap-3">
        <button id="admin-login-btn" type="button" class="px-7 py-3 rounded-full bg-electric-magenta text-white font-bold text-xs uppercase tracking-wider hover:shadow-magenta-glow transition-all">
          Masuk Akun Admin
        </button>
        <a href="/" class="px-7 py-3 rounded-full bg-neutral-100 hover:bg-neutral-200 border border-neutral-200 text-neutral-900 dark:bg-white/10 dark:hover:bg-white/20 dark:border-transparent dark:text-soft-white font-bold text-xs uppercase tracking-wider transition-all">
          Kembali ke Beranda
        </a>
      </div>
    </div>

    <!-- Admin Workspace -->
    <div id="admin-workspace" class="hidden space-y-8">
      <!-- Header -->
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-4">
        <div>
          <div class="flex items-center gap-2 mb-2">
            <span class="px-2.5 py-0.5 rounded bg-electric-magenta/15 dark:bg-electric-magenta/20 border border-electric-magenta/30 dark:border-electric-magenta/40 text-electric-magenta font-mono text-[10px] font-bold uppercase">
              PLATFORM COMMAND CENTER
            </span>
            <span id="admin-operator-badge" class="text-[11px] font-mono text-neutral-600 dark:text-muted-gray"></span>
          </div>
          <h1 class="font-display text-4xl sm:text-6xl text-neutral-950 dark:text-soft-white tracking-wide">
            AFTERGLOW ADMIN CONSOLE
          </h1>
        </div>
        <button id="admin-refresh-current-btn" type="button" class="self-start md:self-auto px-5 py-2.5 rounded-xl bg-neutral-100 hover:bg-neutral-200 border border-neutral-200 text-neutral-900 dark:bg-white/10 dark:hover:bg-white/20 dark:border-transparent dark:text-soft-white text-xs font-mono font-bold uppercase transition-all">
          Refresh Data Aktif
        </button>
      </div>

      <!-- Navigation Tabs -->
      <div class="flex flex-wrap gap-2 p-1.5 rounded-2xl bg-white dark:bg-dark-plum border border-neutral-200 dark:border-white/10 shadow-sm dark:shadow-none w-fit" id="admin-tabs">
        <button data-tab="pulse" class="adm-tab-btn px-4 py-2 rounded-xl text-xs font-mono font-bold uppercase transition-all">Command Pulse</button>
        <button data-tab="organizers" class="adm-tab-btn px-4 py-2 rounded-xl text-xs font-mono font-bold uppercase transition-all">Promotor Queue</button>
        <button data-tab="events" class="adm-tab-btn px-4 py-2 rounded-xl text-xs font-mono font-bold uppercase transition-all">Event Curation</button>
        <button data-tab="escrow" class="adm-tab-btn px-4 py-2 rounded-xl text-xs font-mono font-bold uppercase transition-all">Escrow & Payouts</button>
        <button data-tab="refunds" class="adm-tab-btn px-4 py-2 rounded-xl text-xs font-mono font-bold uppercase transition-all">Refund Queue</button>
        <button data-tab="orders" class="adm-tab-btn px-4 py-2 rounded-xl text-xs font-mono font-bold uppercase transition-all">Orders & Payments</button>
        <button data-tab="users" class="adm-tab-btn px-4 py-2 rounded-xl text-xs font-mono font-bold uppercase transition-all">Users</button>
        <button data-tab="audit" class="adm-tab-btn px-4 py-2 rounded-xl text-xs font-mono font-bold uppercase transition-all">Audit & Cron Jobs</button>
      </div>

      <!-- Global Action Toast Banner -->
      <div id="admin-toast" class="hidden p-4 rounded-2xl border text-xs font-mono"></div>

      <!-- TAB 1: COMMAND PULSE -->
      <section id="adm-panel-pulse" class="adm-panel hidden space-y-8">
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5" id="adm-pulse-kpis"></div>

        <!-- Escrow Liability & Platform Cashflow Breakdown -->
        <div class="p-6 sm:p-8 rounded-3xl bg-white dark:bg-dark-plum/85 border border-neutral-200 dark:border-white/15 shadow-sm dark:shadow-none space-y-4">
          <div>
            <span class="text-[10px] font-mono uppercase tracking-wider text-electric-magenta font-bold block">NERACA PENAMPUNGAN ESCROW PLATFORM</span>
            <h2 class="font-display text-2xl text-neutral-950 dark:text-soft-white">LIABILITAS DANA & PENCAIRAN PROMOTOR</h2>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4" id="adm-escrow-summary-grid"></div>
        </div>

        <!-- 14-Day Platform GMV & Fee Chart -->
        <div class="p-6 sm:p-8 rounded-3xl bg-white dark:bg-dark-plum/85 border border-neutral-200 dark:border-white/15 shadow-sm dark:shadow-none space-y-4">
          <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-2">
            <div>
              <span class="text-[10px] font-mono uppercase tracking-wider text-electric-magenta font-bold block">PERFORMA PENJUALAN 14 HARI TERAKHIR</span>
              <h2 class="font-display text-2xl text-neutral-950 dark:text-soft-white">GRAFIK GMV & PENDAPATAN FEE 5%</h2>
            </div>
            <div id="adm-revenue-summary" class="text-xs font-mono text-neutral-600 dark:text-muted-gray"></div>
          </div>
          <div id="adm-revenue-chart-wrap" class="w-full overflow-x-auto"></div>
        </div>

        <div>
          <h2 class="font-display text-2xl text-neutral-950 dark:text-soft-white mb-4">ACTION CENTER // ANTREAN BUTUH TINDAKAN</h2>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4" id="adm-action-center"></div>
        </div>

        <!-- Top Grossing Events -->
        <div class="p-6 sm:p-8 rounded-3xl bg-white dark:bg-dark-plum/85 border border-neutral-200 dark:border-white/15 shadow-sm dark:shadow-none">
          <h2 class="font-display text-2xl text-neutral-950 dark:text-soft-white mb-4">TOP KONSER BERDASARKAN GMV</h2>
          <div class="overflow-x-auto">
            <table class="w-full text-xs">
              <thead>
                <tr class="text-left text-neutral-500 dark:text-muted-gray font-mono border-b border-neutral-200 dark:border-white/10">
                  <th class="pb-3">KONSER & PROMOTOR</th>
                  <th class="pb-3">STATUS</th>
                  <th class="pb-3 text-right">ORDER LUNAS</th>
                  <th class="pb-3 text-right">TERJUAL / KUOTA</th>
                  <th class="pb-3 text-right">GMV</th>
                  <th class="pb-3 text-right">FEE PLATFORM</th>
                </tr>
              </thead>
              <tbody id="adm-top-events-tbody" class="divide-y divide-neutral-200 dark:divide-white/5"></tbody>
            </table>
          </div>
        </div>
      </section>

      <!-- TAB 2: ORGANIZERS REVIEW -->
      <section id="adm-panel-organizers" class="adm-panel hidden space-y-5">
        <div class="flex flex-wrap items-center justify-between gap-4">
          <h2 class="font-display text-2xl text-neutral-950 dark:text-soft-white">VERIFIKASI PENDAFTARAN PROMOTOR</h2>
          <select id="adm-org-filter" class="px-4 py-2 rounded-xl bg-white dark:bg-dark-plum border border-neutral-300 dark:border-white/15 text-xs font-mono text-neutral-950 dark:text-soft-white focus:outline-none focus:border-electric-magenta">
            <option value="pending">Pending Review</option>
            <option value="">Semua Status</option>
            <option value="verified">Verified</option>
            <option value="rejected">Rejected</option>
          </select>
        </div>
        <div id="adm-organizers-list" class="space-y-4"></div>
      </section>

      <!-- TAB 3: EVENT CURATION -->
      <section id="adm-panel-events" class="adm-panel hidden space-y-5">
        <div class="flex flex-wrap items-center justify-between gap-4">
          <h2 class="font-display text-2xl text-neutral-950 dark:text-soft-white">KURASI & MODERASI EVENT KONSER</h2>
          <select id="adm-ev-filter" class="px-4 py-2 rounded-xl bg-white dark:bg-dark-plum border border-neutral-300 dark:border-white/15 text-xs font-mono text-neutral-950 dark:text-soft-white focus:outline-none focus:border-electric-magenta">
            <option value="pending">Menunggu Persetujuan (Pending)</option>
            <option value="">Semua Status</option>
            <option value="published">Published</option>
            <option value="ongoing">Ongoing</option>
            <option value="selesai">Selesai</option>
            <option value="rejected">Rejected</option>
            <option value="dibatalkan">Dibatalkan</option>
            <option value="draft">Draft</option>
          </select>
        </div>
        <div id="adm-events-list" class="space-y-4"></div>
      </section>

      <!-- TAB 4: ESCROW & PAYOUTS -->
      <section id="adm-panel-escrow" class="adm-panel hidden space-y-6">
        <!-- Settlement-Ready Events Queue -->
        <div class="p-6 sm:p-8 rounded-3xl bg-white dark:bg-dark-plum/85 border border-neutral-200 dark:border-white/15 shadow-sm dark:shadow-none space-y-4">
          <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4">
            <div>
              <span class="text-[10px] font-mono uppercase tracking-wider text-electric-magenta font-bold block">ANTRIAN RELEASE H+1 (UNSETTLED ORDERS)</span>
              <h3 class="font-display text-2xl text-neutral-950 dark:text-soft-white mt-0.5">KONSER SIAP SETTLE ESCROW</h3>
              <p class="text-xs text-neutral-600 dark:text-muted-gray">Konser berstatus selesai yang masih memiliki dana net tertahan pada pending_balance promotor.</p>
            </div>
            <form id="adm-manual-settle-form" class="flex items-center gap-2 shrink-0">
              <input id="adm-settle-ev-id" type="number" min="1" required placeholder="Manual ID" class="w-28 px-3 py-2 rounded-xl bg-neutral-50 dark:bg-void-black border border-neutral-300 dark:border-white/15 text-xs font-mono text-neutral-950 dark:text-soft-white placeholder:text-neutral-400" />
              <button type="submit" class="px-4 py-2 rounded-xl bg-neutral-900 dark:bg-white/10 hover:bg-electric-magenta text-white text-xs font-bold uppercase transition-colors">
                Settle ID
              </button>
            </form>
          </div>
          <div id="adm-settle-candidates-list" class="space-y-3"></div>
        </div>

        <div class="flex flex-wrap items-center justify-between gap-4">
          <h2 class="font-display text-2xl text-neutral-950 dark:text-soft-white">ANTREAN PENCAIRAN DANA (PAYOUTS)</h2>
          <select id="adm-payout-filter" class="px-4 py-2 rounded-xl bg-white dark:bg-dark-plum border border-neutral-300 dark:border-white/15 text-xs font-mono text-neutral-950 dark:text-soft-white focus:outline-none focus:border-electric-magenta">
            <option value="pending">Pending Approval</option>
            <option value="">Semua Status</option>
            <option value="completed">Completed</option>
            <option value="failed">Failed / Rejected</option>
          </select>
        </div>

        <div id="adm-payouts-list" class="space-y-4"></div>
      </section>

      <!-- TAB 5: REFUND QUEUE -->
      <section id="adm-panel-refunds" class="adm-panel hidden space-y-5">
        <div class="flex flex-wrap items-center justify-between gap-4">
          <h2 class="font-display text-2xl text-neutral-950 dark:text-soft-white">ANTREAN PENGEMBALIAN DANA (REFUNDS)</h2>
          <select id="adm-refund-filter" class="px-4 py-2 rounded-xl bg-white dark:bg-dark-plum border border-neutral-300 dark:border-white/15 text-xs font-mono text-neutral-950 dark:text-soft-white focus:outline-none focus:border-electric-magenta">
            <option value="pending">Pending Transfer</option>
            <option value="">Semua Status</option>
            <option value="completed">Completed</option>
          </select>
        </div>
        <div id="adm-refunds-list" class="space-y-4"></div>
      </section>

      <!-- TAB 6: ORDERS & PAYMENTS MONITOR -->
      <section id="adm-panel-orders" class="adm-panel hidden space-y-5">
        <div class="p-6 sm:p-8 rounded-3xl bg-white dark:bg-dark-plum/85 border border-neutral-200 dark:border-white/15 shadow-sm dark:shadow-none space-y-5">
          <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-4">
            <div>
              <span class="text-[10px] font-mono uppercase tracking-wider text-electric-magenta font-bold block">MONITOR GLOBAL GATEWAY & ESCROW</span>
              <h2 class="font-display text-2xl text-neutral-950 dark:text-soft-white">SELURUH TRANSAKSI & INVOICE XENDIT</h2>
            </div>
            <form id="adm-orders-filter-form" class="flex flex-wrap items-center gap-2">
              <select id="adm-orders-status" class="px-3 py-2 rounded-xl bg-neutral-50 dark:bg-void-black border border-neutral-300 dark:border-white/15 text-xs font-mono text-neutral-950 dark:text-soft-white">
                <option value="">Semua Status</option>
                <option value="paid">Paid</option>
                <option value="pending">Pending</option>
                <option value="expired">Expired</option>
                <option value="cancelled">Cancelled</option>
                <option value="refunded">Refunded</option>
              </select>
              <label class="inline-flex items-center gap-2 px-3 py-2 rounded-xl bg-amber-50 dark:bg-amber-500/15 border border-amber-200 dark:border-amber-500/30 text-xs font-mono text-amber-800 dark:text-amber-300 cursor-pointer">
                <input id="adm-orders-late-only" type="checkbox" class="accent-electric-magenta" />
                <span>Late Payment Saja</span>
              </label>
              <input id="adm-orders-search" type="text" placeholder="Cari order / email / invoice..." class="px-3.5 py-2 rounded-xl bg-neutral-50 dark:bg-void-black border border-neutral-300 dark:border-white/15 text-xs font-mono text-neutral-950 dark:text-soft-white placeholder:text-neutral-400" />
              <button type="submit" class="px-4 py-2 rounded-xl bg-electric-magenta text-white text-xs font-bold uppercase">Filter</button>
            </form>
          </div>
          <div class="overflow-x-auto">
            <table class="w-full text-xs font-mono">
              <thead>
                <tr class="text-left text-neutral-500 dark:text-muted-gray border-b border-neutral-200 dark:border-white/10">
                  <th class="pb-3">ORDER & INVOICE XENDIT</th>
                  <th class="pb-3">PEMBELI</th>
                  <th class="pb-3">KONSER</th>
                  <th class="pb-3 text-right">NOMINAL</th>
                  <th class="pb-3 text-right">STATUS & ESCROW</th>
                </tr>
              </thead>
              <tbody id="adm-orders-tbody" class="divide-y divide-neutral-200 dark:divide-white/5"></tbody>
            </table>
          </div>
        </div>
      </section>

      <!-- TAB 7: USERS DIRECTORY -->
      <section id="adm-panel-users" class="adm-panel hidden space-y-5">
        <div class="p-6 sm:p-8 rounded-3xl bg-white dark:bg-dark-plum/85 border border-neutral-200 dark:border-white/15 shadow-sm dark:shadow-none space-y-5">
          <div class="flex flex-col md:flex-row md:items-end justify-between gap-4">
            <div>
              <span class="text-[10px] font-mono uppercase tracking-wider text-electric-magenta font-bold block">DIREKTORI PENGGUNA PLATFORM</span>
              <h2 class="font-display text-2xl text-neutral-950 dark:text-soft-white">AKUN PENONTON, PROMOTOR & ADMIN</h2>
            </div>
            <form id="adm-users-filter-form" class="flex flex-wrap items-center gap-2">
              <select id="adm-users-role" class="px-3 py-2 rounded-xl bg-neutral-50 dark:bg-void-black border border-neutral-300 dark:border-white/15 text-xs font-mono text-neutral-950 dark:text-soft-white">
                <option value="">Semua Role</option>
                <option value="3">Penonton (USER)</option>
                <option value="2">Promotor (ORGANIZER)</option>
                <option value="1">Admin (ADMIN)</option>
              </select>
              <input id="adm-users-search" type="text" placeholder="Cari nama / email..." class="px-3.5 py-2 rounded-xl bg-neutral-50 dark:bg-void-black border border-neutral-300 dark:border-white/15 text-xs font-mono text-neutral-950 dark:text-soft-white placeholder:text-neutral-400" />
              <button type="submit" class="px-4 py-2 rounded-xl bg-electric-magenta text-white text-xs font-bold uppercase">Cari</button>
            </form>
          </div>
          <div class="overflow-x-auto">
            <table class="w-full text-xs font-mono">
              <thead>
                <tr class="text-left text-neutral-500 dark:text-muted-gray border-b border-neutral-200 dark:border-white/10">
                  <th class="pb-3">USER</th>
                  <th class="pb-3">ROLE</th>
                  <th class="pb-3">VERIFIKASI</th>
                  <th class="pb-3">ORGANISASI PROMOTOR</th>
                  <th class="pb-3 text-right">ORDER PAID</th>
                  <th class="pb-3 text-right">BERGABUNG</th>
                </tr>
              </thead>
              <tbody id="adm-users-tbody" class="divide-y divide-neutral-200 dark:divide-white/5"></tbody>
            </table>
          </div>
        </div>
      </section>

      <!-- TAB 6: AUDIT LOGS & CRON JOBS -->
      <section id="adm-panel-audit" class="adm-panel hidden space-y-8">
        <!-- Manual Worker Triggers -->
        <div class="p-6 sm:p-8 rounded-3xl bg-white dark:bg-dark-plum/85 border border-neutral-200 dark:border-white/15 shadow-sm dark:shadow-none space-y-4">
          <div>
            <span class="text-[10px] font-mono uppercase tracking-wider text-electric-magenta font-bold block">AUTOMATION & UKK DEMO WORKERS</span>
            <h2 class="font-display text-2xl text-neutral-950 dark:text-soft-white mt-0.5">TRIGGER BACKGROUND CRON JOBS MANUAL</h2>
          </div>

          <div class="flex flex-wrap gap-3" id="adm-jobs-buttons">
            {[
              { name: 'expire-orders', label: '1. Expire Orders (>15m)' },
              { name: 'transition-events', label: '2. Transition Event Lifecycle' },
              { name: 'settle-escrow', label: '3. Auto-Settle Escrow H+1' },
              { name: 'dispatch-emails', label: '4. Dispatch Email Outbox' },
              { name: 'cleanup-auth', label: '5. Cleanup Expired OTP/Tokens' },
            ].map((j) => (
              <button
                type="button"
                data-trigger-job={j.name}
                class="adm-job-btn px-4 py-2.5 rounded-xl bg-neutral-50 dark:bg-void-black border border-neutral-300 dark:border-white/15 hover:border-electric-magenta hover:text-electric-magenta text-xs font-mono font-bold text-neutral-950 dark:text-soft-white transition-all"
              >
                {j.label}
              </button>
            ))}
          </div>

          <pre id="adm-job-output" class="hidden p-4 rounded-2xl bg-neutral-50 dark:bg-void-black border border-emerald-300 dark:border-emerald-500/30 text-[11px] font-mono text-emerald-800 dark:text-emerald-300 overflow-x-auto"></pre>
        </div>

        <!-- Audit Logs Explorer -->
        <div class="p-6 sm:p-8 rounded-3xl bg-white dark:bg-dark-plum/85 border border-neutral-200 dark:border-white/15 shadow-sm dark:shadow-none space-y-5">
          <div class="flex flex-col md:flex-row md:items-end justify-between gap-4">
            <h2 class="font-display text-2xl text-neutral-950 dark:text-soft-white">JEJAK AUDIT FINANSIAL & KEAMANAN</h2>
            <form id="adm-audit-filter-form" class="flex flex-wrap items-center gap-2">
              <input id="audit-action-input" type="text" placeholder="Filter Action (mis. ORDER_PAID)" class="px-3.5 py-2 rounded-xl bg-neutral-50 dark:bg-void-black border border-neutral-300 dark:border-white/15 text-xs font-mono text-neutral-950 dark:text-soft-white placeholder:text-neutral-400" />
              <input id="audit-target-input" type="text" placeholder="Target (mis. orders)" class="px-3.5 py-2 rounded-xl bg-neutral-50 dark:bg-void-black border border-neutral-300 dark:border-white/15 text-xs font-mono text-neutral-950 dark:text-soft-white placeholder:text-neutral-400" />
              <button type="submit" class="px-4 py-2 rounded-xl bg-electric-magenta text-white text-xs font-bold uppercase">
                Filter Logs
              </button>
            </form>
          </div>

          <div class="overflow-x-auto">
            <table class="w-full text-xs font-mono">
              <thead>
                <tr class="text-left text-neutral-600 dark:text-muted-gray border-b border-neutral-200 dark:border-white/10">
                  <th class="pb-3">WAKTU</th>
                  <th class="pb-3">AKSI</th>
                  <th class="pb-3">TARGET</th>
                  <th class="pb-3">PELAKU</th>
                  <th class="pb-3">IP & DETAIL</th>
                </tr>
              </thead>
              <tbody id="adm-audit-tbody" class="divide-y divide-neutral-200 dark:divide-white/5"></tbody>
            </table>
          </div>
        </div>
      </section>
    </div>
  </div>

  <!-- REASON INPUT MODAL (Reject / Cancel Actions) -->
  <div id="admin-reason-modal" class="fixed inset-0 z-[70] hidden items-center justify-center p-4 bg-black/60 dark:bg-black/80 backdrop-blur-md">
    <div class="w-full max-w-md rounded-3xl bg-white dark:bg-dark-plum border border-neutral-200 dark:border-white/15 p-6 space-y-4 shadow-2xl">
      <div>
        <span class="text-[10px] font-mono uppercase tracking-wider text-electric-magenta font-bold block">KONFIRMASI TINDAKAN ADMIN</span>
        <h3 id="adm-reason-title" class="font-display text-2xl text-neutral-950 dark:text-soft-white mt-1">ALASAN PENOLAKAN</h3>
        <p id="adm-reason-desc" class="text-xs text-neutral-600 dark:text-muted-gray mt-1"></p>
      </div>
      <form id="adm-reason-form" class="space-y-4">
        <textarea id="adm-reason-input" rows="3" minlength="5" maxlength="250" required placeholder="Masukkan alasan resmi minimal 5 karakter..." class="w-full px-4 py-3 rounded-xl bg-neutral-50 dark:bg-void-black border border-neutral-300 dark:border-white/15 text-xs text-neutral-950 dark:text-soft-white placeholder:text-neutral-400 focus:outline-none focus:border-electric-magenta"></textarea>
        <div class="flex gap-3">
          <button type="button" id="adm-reason-cancel" class="flex-1 py-2.5 rounded-xl bg-neutral-100 dark:bg-white/5 border border-neutral-200 dark:border-white/10 text-xs font-bold uppercase text-neutral-600 dark:text-muted-gray hover:text-neutral-950 dark:hover:text-soft-white">Batal</button>
          <button type="submit" id="adm-reason-confirm" class="flex-1 py-2.5 rounded-xl bg-red-600 hover:bg-red-500 text-xs font-bold uppercase text-white">Konfirmasi</button>
        </div>
      </form>
    </div>
  </div>

  <Footer />
</RootLayout>

<script define:vars={{ initialTab }}>
  window.__adminInitialTab = initialTab;
</script>

<script>
  import { api, resolveAssetUrl } from '../../lib/api';
  import { renderDailyRevenueChartSvg } from '../../lib/charts';
  import { getStoredUser, isAdmin, isAuthenticated } from '../../lib/auth';
  import { escapeHtml, formatDateIndo, formatRupiah } from '../../lib/formatters';

  function initAdminCommandCenter() {
    const accessGuard = document.getElementById('admin-access-guard');
    const guardTitle = document.getElementById('admin-guard-title');
    const guardDesc = document.getElementById('admin-guard-desc');
    const loginBtn = document.getElementById('admin-login-btn');
    const workspace = document.getElementById('admin-workspace');
    const operatorBadge = document.getElementById('admin-operator-badge');
    const refreshBtn = document.getElementById('admin-refresh-current-btn');
    const toastEl = document.getElementById('admin-toast');

    const tabBtns = document.querySelectorAll<HTMLButtonElement>('.adm-tab-btn');
    const panels = document.querySelectorAll<HTMLElement>('.adm-panel');

    const orgFilter = document.getElementById('adm-org-filter') as HTMLSelectElement | null;
    const evFilter = document.getElementById('adm-ev-filter') as HTMLSelectElement | null;
    const payoutFilter = document.getElementById('adm-payout-filter') as HTMLSelectElement | null;
    const refundFilter = document.getElementById('adm-refund-filter') as HTMLSelectElement | null;

    // Reason modal
    const reasonModal = document.getElementById('admin-reason-modal');
    const reasonTitle = document.getElementById('adm-reason-title');
    const reasonDesc = document.getElementById('adm-reason-desc');
    const reasonForm = document.getElementById('adm-reason-form') as HTMLFormElement | null;
    const reasonInput = document.getElementById('adm-reason-input') as HTMLTextAreaElement | null;
    const reasonCancel = document.getElementById('adm-reason-cancel');

    let currentTab: string = (window as any).__adminInitialTab || 'pulse';
    let pendingReasonHandler: ((reason: string) => Promise<void>) | null = null;
    let isDisposed = false;

    loginBtn?.addEventListener('click', () => {
      if (typeof (window as any).openAuthModal === 'function') (window as any).openAuthModal();
      else window.location.href = '/masuk';
    });

    function showToast(msg: string, isErr = false) {
      if (!toastEl) return;
      toastEl.textContent = msg;
      toastEl.className = `p-4 rounded-2xl border text-xs font-mono ${
        isErr
          ? 'bg-red-50 dark:bg-red-500/10 border-red-200 dark:border-red-500/30 text-red-700 dark:text-red-300'
          : 'bg-emerald-50 dark:bg-emerald-500/10 border-emerald-200 dark:border-emerald-500/30 text-emerald-700 dark:text-emerald-300'
      }`;
      toastEl.classList.remove('hidden');
      setTimeout(() => {
        if (!isDisposed) toastEl.classList.add('hidden');
      }, 5000);
    }

    function openReasonPrompt(title: string, desc: string, onConfirm: (reason: string) => Promise<void>) {
      if (reasonTitle) reasonTitle.textContent = title;
      if (reasonDesc) reasonDesc.textContent = desc;
      if (reasonInput) reasonInput.value = '';
      pendingReasonHandler = onConfirm;
      reasonModal?.classList.remove('hidden');
      reasonModal?.classList.add('flex');
      reasonInput?.focus();
    }

    reasonCancel?.addEventListener('click', () => {
      pendingReasonHandler = null;
      reasonModal?.classList.add('hidden');
      reasonModal?.classList.remove('flex');
    });

    reasonForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const val = reasonInput?.value.trim() || '';
      if (val.length < 5 || !pendingReasonHandler) return;
      const handler = pendingReasonHandler;
      pendingReasonHandler = null;
      reasonModal?.classList.add('hidden');
      reasonModal?.classList.remove('flex');
      await handler(val);
    });

    function activateTab(tab: string) {
      currentTab = tab;
      window.history.replaceState(null, '', `${window.location.pathname}?tab=${encodeURIComponent(tab)}`);
      tabBtns.forEach((b) => {
        const active = b.dataset.tab === tab;
        b.classList.toggle('bg-electric-magenta', active);
        b.classList.toggle('text-white', active);
        b.classList.toggle('shadow-magenta-glow', active);
        b.classList.toggle('text-neutral-600', !active);
        b.classList.toggle('dark:text-muted-gray', !active);
      });
      panels.forEach((p) => p.classList.toggle('hidden', p.id !== `adm-panel-${tab}`));
      loadActiveTab();
    }

    function loadActiveTab() {
      if (currentTab === 'pulse') loadPulse();
      if (currentTab === 'organizers') loadOrganizers();
      if (currentTab === 'events') loadEvents();
      if (currentTab === 'escrow') {
        loadSettleCandidates();
        loadPayouts();
      }
      if (currentTab === 'refunds') loadRefunds();
      if (currentTab === 'orders') loadAdminOrders();
      if (currentTab === 'users') loadAdminUsers();
      if (currentTab === 'audit') loadAuditLogs();
    }

    tabBtns.forEach((b) => b.addEventListener('click', () => activateTab(b.dataset.tab || 'pulse')));
    refreshBtn?.addEventListener('click', loadActiveTab);

    // TAB 1: PULSE
    async function loadPulse() {
      const kpiWrap = document.getElementById('adm-pulse-kpis');
      const escrowWrap = document.getElementById('adm-escrow-summary-grid');
      const chartWrap = document.getElementById('adm-revenue-chart-wrap');
      const chartSummary = document.getElementById('adm-revenue-summary');
      const acWrap = document.getElementById('adm-action-center');
      const topEventsTbody = document.getElementById('adm-top-events-tbody');
      if (!kpiWrap || !acWrap) return;

      try {
        const dash = await api.get<any>('/admin/dashboard');
        if (isDisposed) return;
        const fin = dash.financials || {};
        const stats = dash.platform_stats || {};
        const ac = dash.action_center || {};
        const es = dash.escrow_summary || {};
        const revSeries = Array.isArray(dash.revenue_series) ? dash.revenue_series : [];
        const topEvents = Array.isArray(dash.top_events) ? dash.top_events : [];

        kpiWrap.innerHTML = [
          { label: 'Total GMV Platform', val: formatRupiah(fin.total_gmv || 0), sub: `Diskon voucher: ${formatRupiah(fin.total_discounts || 0)}` },
          { label: 'Laba Platform Fee (5%)', val: formatRupiah(fin.total_platform_fee || 0), sub: 'Akumulasi order paid', accent: true },
          { label: 'Ekosistem Pengguna', val: `${Number(stats.total_users || 0)} Akun`, sub: `${Number(stats.total_verified_organizers || 0)} Promotor • ${Number(stats.total_events || 0)} Konser` },
        ]
          .map(
            (k) => `
            <div class="p-6 rounded-3xl bg-white dark:bg-dark-plum/90 border shadow-sm dark:shadow-none ${k.accent ? 'border-electric-magenta/45' : 'border-neutral-200 dark:border-white/15'}">
              <span class="text-[11px] font-mono uppercase text-neutral-600 dark:text-muted-gray block">${escapeHtml(k.label)}</span>
              <strong class="font-display text-4xl text-neutral-950 dark:text-soft-white mt-1 block">${escapeHtml(k.val)}</strong>
              <span class="text-xs font-mono text-electric-magenta mt-1 block">${escapeHtml(k.sub)}</span>
            </div>
          `
          )
          .join('');

        if (escrowWrap) {
          escrowWrap.innerHTML = [
            { label: 'Escrow Tertahan (Pending)', val: formatRupiah(es.total_pending_balance || 0), sub: 'Menunggu konser selesai H+1', tone: 'text-amber-600 dark:text-amber-300' },
            { label: 'Saldo Siap Tarik Promotor', val: formatRupiah(es.total_withdrawable_balance || 0), sub: `Payout pending: ${formatRupiah(es.pending_payouts_amount || 0)}`, tone: 'text-emerald-600 dark:text-emerald-400' },
            { label: 'Total Payout Sudah Cair', val: formatRupiah(es.completed_payouts_amount || 0), sub: `Total ditarik saldo: ${formatRupiah(es.total_withdrawn_amount || 0)}`, tone: 'text-neutral-950 dark:text-soft-white' },
            { label: 'Antrean Refund Pembeli', val: formatRupiah(es.pending_refunds_amount || 0), sub: `Sudah direfund: ${formatRupiah(es.completed_refunds_amount || 0)}`, tone: 'text-electric-magenta' },
          ]
            .map(
              (c) => `
              <div class="p-4 rounded-2xl bg-neutral-50 dark:bg-void-black/60 border border-neutral-200 dark:border-white/10">
                <span class="text-[10px] font-mono uppercase text-neutral-500 dark:text-muted-gray block">${escapeHtml(c.label)}</span>
                <strong class="font-display text-2xl ${c.tone} mt-1 block">${escapeHtml(c.val)}</strong>
                <span class="text-[11px] font-mono text-neutral-600 dark:text-muted-gray mt-1 block">${escapeHtml(c.sub)}</span>
              </div>
            `
            )
            .join('');
        }

        if (chartWrap) {
          const gmv14 = revSeries.reduce((s: number, d: any) => s + Number(d.gmv_total || 0), 0);
          const fee14 = revSeries.reduce((s: number, d: any) => s + Number(d.platform_fee_total || 0), 0);
          const ord14 = revSeries.reduce((s: number, d: any) => s + Number(d.orders_count || 0), 0);
          if (chartSummary) {
            chartSummary.textContent = `14 Hari: ${ord14} order lunas • GMV ${formatRupiah(gmv14)} • Fee ${formatRupiah(fee14)}`;
          }
          chartWrap.innerHTML = renderDailyRevenueChartSvg(
            revSeries.map((d: any) => ({
              label: d.label || String(d.date || '').slice(5),
              primary: Number(d.gmv_total || 0),
              secondary: Number(d.platform_fee_total || 0),
              count: Number(d.orders_count || 0),
            })),
            { primaryLabel: 'GMV Penjualan', secondaryLabel: 'Platform Fee 5%' }
          );
        }

        acWrap.innerHTML = [
          { tab: 'organizers', count: ac.pending_organizers || 0, title: 'Promotor Pending', desc: 'Verifikasi KYC & rekening bank' },
          { tab: 'events', count: ac.pending_events || 0, title: 'Event Review', desc: 'Kurasi konser sebelum publikasi' },
          { tab: 'escrow', count: ac.pending_payouts || 0, title: 'Payout Queue', desc: 'Persetujuan transfer dana' },
          { tab: 'refunds', count: ac.pending_refunds || 0, title: 'Refund Queue', desc: 'Antrean pengembalian dana user' },
        ]
          .map(
            (item) => `
            <button
              type="button"
              data-jump-tab="${item.tab}"
              class="text-left p-5 rounded-3xl bg-white dark:bg-dark-plum/85 border shadow-sm dark:shadow-none ${Number(item.count) > 0 ? 'border-amber-400 dark:border-amber-500/45 hover:border-electric-magenta' : 'border-neutral-200 dark:border-white/10 hover:border-neutral-300 dark:hover:border-white/25'} transition-all group"
            >
              <div class="flex items-center justify-between mb-2">
                <span class="text-[10px] font-mono uppercase text-neutral-600 dark:text-muted-gray">${escapeHtml(item.title)}</span>
                <span class="px-2.5 py-0.5 rounded-full text-xs font-mono font-bold ${Number(item.count) > 0 ? 'bg-amber-50 dark:bg-amber-500/20 text-amber-700 dark:text-amber-300' : 'bg-neutral-100 dark:bg-white/10 text-neutral-600 dark:text-muted-gray'}">
                  ${Number(item.count)}
                </span>
              </div>
              <p class="text-xs text-neutral-950 dark:text-soft-white group-hover:text-electric-magenta transition-colors">${escapeHtml(item.desc)} →</p>
            </button>
          `
          )
          .join('');

        acWrap.querySelectorAll<HTMLButtonElement>('[data-jump-tab]').forEach((b) => {
          b.addEventListener('click', () => {
            const targetTab = b.dataset.jumpTab || 'pulse';
            if (targetTab === 'organizers' && orgFilter) orgFilter.value = 'pending';
            if (targetTab === 'events' && evFilter) evFilter.value = 'pending';
            if (targetTab === 'escrow' && payoutFilter) payoutFilter.value = 'pending';
            if (targetTab === 'refunds' && refundFilter) refundFilter.value = 'pending';
            activateTab(targetTab);
          });
        });

        if (topEventsTbody) {
          topEventsTbody.innerHTML =
            topEvents.length === 0
              ? `<tr><td colspan="6" class="py-6 text-center font-mono text-neutral-500 dark:text-muted-gray">Belum ada konser dengan transaksi berbayar.</td></tr>`
              : topEvents
                  .map(
                    (ev: any) => `
                  <tr>
                    <td class="py-3">
                      <a href="/events/${ev.event_id}" target="_blank" class="font-bold text-neutral-950 dark:text-soft-white hover:text-electric-magenta block">${escapeHtml(ev.nama_event)}</a>
                      <span class="text-[11px] font-mono text-neutral-500 dark:text-muted-gray">${escapeHtml(ev.organization_name || '-')}</span>
                    </td>
                    <td class="py-3 font-mono text-[11px] uppercase text-electric-magenta">${escapeHtml(ev.status)}</td>
                    <td class="py-3 text-right font-mono text-neutral-950 dark:text-soft-white">${Number(ev.paid_orders_count || 0)}</td>
                    <td class="py-3 text-right font-mono text-neutral-600 dark:text-muted-gray">${Number(ev.sold_quota || 0)} / ${Number(ev.total_quota || 0)}</td>
                    <td class="py-3 text-right font-mono font-bold text-neutral-950 dark:text-soft-white">${escapeHtml(formatRupiah(ev.gmv_total || 0))}</td>
                    <td class="py-3 text-right font-mono font-bold text-emerald-600 dark:text-emerald-400">${escapeHtml(formatRupiah(ev.platform_fee_total || 0))}</td>
                  </tr>
                `
                  )
                  .join('');
        }
      } catch (err: any) {
        showToast(err?.message || 'Gagal memuat dashboard Admin.', true);
      }
    }

    // TAB 2: ORGANIZERS
    async function loadOrganizers() {
      const listEl = document.getElementById('adm-organizers-list');
      if (!listEl) return;
      const st = orgFilter?.value || '';
      const q = st ? `?verification_status=${encodeURIComponent(st)}` : '';
      listEl.innerHTML = `<div class="p-8 rounded-2xl bg-white dark:bg-dark-plum/60 border border-neutral-200 dark:border-white/10 text-xs font-mono text-neutral-600 dark:text-muted-gray">Memuat antrean promotor...</div>`;
      try {
        const rows = await api.get<any[]>(`/get/organizer${q}`);
        if (isDisposed) return;
        const list = Array.isArray(rows) ? rows : [];
        if (list.length === 0) {
          listEl.innerHTML = `<div class="p-10 rounded-3xl bg-white dark:bg-dark-plum/50 border border-neutral-200 dark:border-white/10 text-center text-sm text-neutral-600 dark:text-muted-gray">Tidak ada pendaftaran promotor pada status ini.</div>`;
          return;
        }
        listEl.innerHTML = list
          .map(
            (o) => `
            <div class="p-5 sm:p-6 rounded-3xl bg-white dark:bg-dark-plum/85 border border-neutral-200 dark:border-white/12 shadow-sm dark:shadow-none space-y-3">
              <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
                <div>
                  <div class="flex items-center gap-2 mb-1">
                    <span class="font-mono text-xs text-neutral-500 dark:text-muted-gray">ORG #${o.id} (User #${o.user_id})</span>
                    <span class="px-2.5 py-0.5 rounded-full text-[10px] font-mono font-bold uppercase ${
                      o.verification_status === 'verified' ? 'bg-emerald-50 dark:bg-emerald-500/20 text-emerald-700 dark:text-emerald-300' : o.verification_status === 'rejected' ? 'bg-red-50 dark:bg-red-500/15 text-red-700 dark:text-red-300' : 'bg-amber-50 dark:bg-amber-500/20 text-amber-700 dark:text-amber-300'
                    }">${escapeHtml(o.verification_status)}</span>
                  </div>
                  <h3 class="font-display text-2xl text-neutral-950 dark:text-soft-white">${escapeHtml(o.organization_name)}</h3>
                  <p class="text-xs font-mono text-neutral-600 dark:text-muted-gray">Diajukan: ${escapeHtml(formatDateIndo(o.created_at))}</p>
                  ${o.rejection_reason ? `<p class="text-xs font-mono text-red-600 dark:text-red-300 mt-1">Alasan Tolak: ${escapeHtml(o.rejection_reason)}</p>` : ''}
                </div>
                <div class="flex flex-wrap gap-2 shrink-0">
                  <button type="button" data-org-detail="${o.id}" class="px-3.5 py-2 rounded-xl bg-neutral-100 hover:bg-neutral-200 border border-neutral-200 text-neutral-900 dark:bg-white/10 dark:hover:bg-white/20 dark:border-transparent dark:text-soft-white text-xs font-mono uppercase transition-colors">
                    Lihat Bank & Pemilik
                  </button>
                  ${o.verification_status !== 'verified' ? `
                    <button type="button" data-org-approve="${o.id}" class="px-4 py-2 rounded-xl bg-emerald-50 dark:bg-emerald-500/20 border border-emerald-300 dark:border-emerald-500/40 text-emerald-700 dark:text-emerald-300 text-xs font-bold uppercase">
                      Approve
                    </button>
                  ` : ''}
                  ${o.verification_status === 'pending' ? `
                    <button type="button" data-org-reject="${o.id}" class="px-4 py-2 rounded-xl bg-red-50 dark:bg-red-500/15 border border-red-200 dark:border-red-500/30 text-red-700 dark:text-red-300 text-xs font-bold uppercase">
                      Tolak
                    </button>
                  ` : ''}
                </div>
              </div>
              <div id="org-detail-box-${o.id}" class="hidden p-4 rounded-2xl bg-neutral-50 dark:bg-void-black/70 border border-neutral-200 dark:border-white/10 text-xs font-mono text-neutral-600 dark:text-muted-gray"></div>
            </div>
          `
          )
          .join('');
      } catch (err: any) {
        listEl.innerHTML = `<div class="p-6 rounded-2xl bg-red-50 dark:bg-red-500/10 border border-red-200 dark:border-red-500/30 text-xs font-mono text-red-700 dark:text-red-300">${escapeHtml(err?.message || 'Gagal memuat promotor.')}</div>`;
      }
    }

    orgFilter?.addEventListener('change', loadOrganizers);
    document.getElementById('adm-organizers-list')?.addEventListener('click', async (e) => {
      const target = e.target as HTMLElement;
      const detailBtn = target.closest('[data-org-detail]') as HTMLButtonElement | null;
      if (detailBtn) {
        const id = Number(detailBtn.dataset.orgDetail);
        const box = document.getElementById(`org-detail-box-${id}`);
        if (!box) return;
        box.classList.remove('hidden');
        box.textContent = 'Mengambil info bank terproteksi...';
        try {
          const d = await api.get<any>(`/get/organizer/${id}`);
          box.innerHTML = `
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
              <div><span class="block text-[10px]">PEMILIK AKUN:</span><strong class="text-neutral-950 dark:text-soft-white">${escapeHtml(d.user_username || '-')} (${escapeHtml(d.user_email || '-')})</strong></div>
              <div><span class="block text-[10px]">BANK PENCAIRAN:</span><strong class="text-neutral-950 dark:text-soft-white">${escapeHtml(d.bank_account || '-')}</strong></div>
              <div><span class="block text-[10px]">NO. REKENING:</span><strong class="text-electric-magenta">${escapeHtml(d.account_number || '-')}</strong></div>
            </div>
          `;
        } catch (err: any) {
          box.textContent = err?.message || 'Gagal memuat detail promotor.';
        }
        return;
      }

      const appBtn = target.closest('[data-org-approve]') as HTMLButtonElement | null;
      if (appBtn) {
        const id = Number(appBtn.dataset.orgApprove);
        if (!confirm(`Verifikasi & promosikan Organizer #${id} menjadi ORGANIZER aktif?`)) return;
        try {
          await api.patch(`/update-organizer-status/${id}`, { verification_status: 'verified' });
          showToast(`Organizer #${id} berhasil diverifikasi!`);
          await loadOrganizers();
        } catch (err: any) {
          showToast(err?.message || 'Gagal menyetujui organizer.', true);
        }
        return;
      }

      const rejBtn = target.closest('[data-org-reject]') as HTMLButtonElement | null;
      if (rejBtn) {
        const id = Number(rejBtn.dataset.orgReject);
        openReasonPrompt(`TOLAK PROMOTOR #${id}`, 'Alasan akan dikirimkan ke dashboard pendaftar agar dapat diperbaiki.', async (reason) => {
          try {
            await api.patch(`/update-organizer-status/${id}`, { verification_status: 'rejected', rejection_reason: reason });
            showToast(`Organizer #${id} ditolak.`);
            await loadOrganizers();
          } catch (err: any) {
            showToast(err?.message || 'Gagal menolak organizer.', true);
          }
        });
      }
    });

    // TAB 3: EVENT CURATION
    async function loadEvents() {
      const listEl = document.getElementById('adm-events-list');
      if (!listEl) return;
      const st = evFilter?.value || '';
      const q = st ? `?status=${encodeURIComponent(st)}` : '';
      listEl.innerHTML = `<div class="p-8 rounded-2xl bg-white dark:bg-dark-plum/60 border border-neutral-200 dark:border-white/10 text-xs font-mono text-neutral-600 dark:text-muted-gray">Memuat antrean kurasi event...</div>`;
      try {
        const rows = await api.get<any[]>(`/events${q}`);
        if (isDisposed) return;
        const list = Array.isArray(rows) ? rows : [];
        if (list.length === 0) {
          listEl.innerHTML = `<div class="p-10 rounded-3xl bg-white dark:bg-dark-plum/50 border border-neutral-200 dark:border-white/10 text-center text-sm text-neutral-600 dark:text-muted-gray">Tidak ada event pada filter status ini.</div>`;
          return;
        }
        listEl.innerHTML = list
          .map((ev) => {
            const canApprove = ev.status === 'pending' || ev.status === 'draft';
            const canSettle = ev.status === 'selesai' && !ev.escrow_settled_at;
            const canCancel = ev.status === 'published' || ev.status === 'ongoing';

            return `
              <div class="p-5 sm:p-6 rounded-3xl bg-white dark:bg-dark-plum/85 border border-neutral-200 dark:border-white/12 shadow-sm dark:shadow-none flex flex-col lg:flex-row lg:items-center justify-between gap-4">
                <div class="flex items-start gap-4">
                  <img src="${escapeHtml(resolveAssetUrl(ev.poster_url))}" alt="${escapeHtml(ev.nama_event)}" class="w-20 h-20 rounded-2xl object-cover bg-neutral-100 dark:bg-void-black border border-neutral-200 dark:border-white/10 shrink-0" />
                  <div class="space-y-1">
                    <div class="flex flex-wrap items-center gap-2">
                      <span class="px-2.5 py-0.5 rounded-full text-[10px] font-mono font-bold uppercase bg-neutral-100 dark:bg-white/10 text-neutral-900 dark:text-soft-white">${escapeHtml(ev.status)}</span>
                      <span class="text-xs font-mono text-electric-magenta">${escapeHtml(ev.organization_name || `Org #${ev.organizer_id}`)}</span>
                      <span class="text-xs font-mono text-neutral-500 dark:text-muted-gray">Event #${ev.id}</span>
                      ${ev.escrow_settled_at ? `<span class="px-2 py-0.5 rounded-full text-[10px] font-mono font-bold uppercase bg-emerald-50 dark:bg-emerald-500/20 text-emerald-700 dark:text-emerald-300">Escrow Settled</span>` : ''}
                    </div>
                    <h3 class="font-display text-2xl text-neutral-950 dark:text-soft-white">${escapeHtml(ev.nama_event)}</h3>
                    <p class="text-xs text-neutral-600 dark:text-muted-gray">${escapeHtml(ev.artis)} • ${escapeHtml(formatDateIndo(ev.tanggal_mulai))} • ${escapeHtml(ev.alamat)}</p>
                    <p class="text-[11px] font-mono text-neutral-500 dark:text-muted-gray">Terjual ${Number(ev.sold_quota || 0)} / ${Number(ev.total_quota || 0)} • Mulai ${escapeHtml(formatRupiah(ev.min_price || 0))}</p>
                  </div>
                </div>
                <div class="flex flex-wrap gap-2 shrink-0">
                  <a href="/events/${ev.id}" target="_blank" class="px-3.5 py-2 rounded-xl bg-neutral-100 hover:bg-neutral-200 border border-neutral-200 text-neutral-900 dark:bg-white/10 dark:hover:bg-white/20 dark:border-transparent dark:text-soft-white text-xs font-mono uppercase transition-colors">Preview</a>
                  ${canApprove ? `
                    <button type="button" data-ev-publish="${ev.id}" class="px-4 py-2 rounded-xl bg-emerald-50 dark:bg-emerald-500/20 border border-emerald-300 dark:border-emerald-500/40 text-emerald-700 dark:text-emerald-300 text-xs font-bold uppercase">Publish</button>
                    <button type="button" data-ev-reject="${ev.id}" class="px-4 py-2 rounded-xl bg-red-50 dark:bg-red-500/15 border border-red-200 dark:border-red-500/30 text-red-700 dark:text-red-300 text-xs font-bold uppercase">Reject</button>
                  ` : ''}
                  ${canSettle ? `<button type="button" data-ev-settle="${ev.id}" class="px-3.5 py-2 rounded-xl bg-cyan-50 dark:bg-cyan-500/15 border border-cyan-200 dark:border-cyan-500/30 text-cyan-700 dark:text-cyan-300 text-xs font-bold uppercase">Settle H+1</button>` : ''}
                  ${canCancel ? `<button type="button" data-ev-cancel="${ev.id}" class="px-3.5 py-2 rounded-xl bg-red-50 dark:bg-red-500/15 border border-red-200 dark:border-red-500/30 text-red-700 dark:text-red-300 text-xs font-bold uppercase">Cancel & Refund</button>` : ''}
                </div>
              </div>
            `;
          })
          .join('');
      } catch (err: any) {
        listEl.innerHTML = `<div class="p-6 rounded-2xl bg-red-50 dark:bg-red-500/10 border border-red-200 dark:border-red-500/30 text-xs font-mono text-red-700 dark:text-red-300">${escapeHtml(err?.message || 'Gagal memuat daftar event.')}</div>`;
      }
