                <strong class="font-display text-3xl text-emerald-600 dark:text-emerald-400">${escapeHtml(formatRupiah(r.amount))}</strong>
                ${r.status === 'pending' ? `
                  <button type="button" data-refund-process="${r.id}" class="px-4 py-2 rounded-xl bg-electric-magenta text-white text-xs font-bold uppercase">
                    Proses Refund Selesai
                  </button>
                ` : `<span class="text-[11px] font-mono text-neutral-500 dark:text-muted-gray">Diproses: ${escapeHtml(formatDateIndo(r.processed_at))}</span>`}
              </div>
            </div>
