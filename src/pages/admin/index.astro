            const canCancel = ev.status === 'published' || ev.status === 'ongoing';

            return `
              <div class="p-5 sm:p-6 rounded-3xl bg-dark-plum/85 border border-white/12 flex flex-col lg:flex-row lg:items-center justify-between gap-4">
                <div class="flex items-start gap-4">
                  <img src="${escapeHtml(resolveAssetUrl(ev.poster_url))}" alt="${escapeHtml(ev.nama_event)}" class="w-20 h-20 rounded-2xl object-cover bg-void-black border border-white/10 shrink-0" />
                  <div class="space-y-1">
                    <div class="flex flex-wrap items-center gap-2">
                      <span class="px-2.5 py-0.5 rounded-full text-[10px] font-mono font-bold uppercase bg-white/10 text-soft-white">${escapeHtml(ev.status)}</span>
                      <span class="text-xs font-mono text-electric-magenta">${escapeHtml(ev.organization_name || `Org #${ev.organizer_id}`)}</span>
                      <span class="text-xs font-mono text-muted-gray">Event #${ev.id}</span>
                    </div>
                    <h3 class="font-display text-2xl text-soft-white">${escapeHtml(ev.nama_event)}</h3>
                    <p class="text-xs text-muted-gray">${escapeHtml(ev.artis)} • ${escapeHtml(formatDateIndo(ev.tanggal_mulai))} • ${escapeHtml(ev.alamat)}</p>
