                    <button type="button" data-ev-publish="${ev.id}" class="px-4 py-2 rounded-xl bg-emerald-500/20 border border-emerald-500/40 text-emerald-300 text-xs font-bold uppercase">Publish</button>
                    <button type="button" data-ev-reject="${ev.id}" class="px-4 py-2 rounded-xl bg-red-500/15 border border-red-500/30 text-red-300 text-xs font-bold uppercase">Reject</button>
                  ` : ''}
                  ${canSettle ? `<button type="button" data-ev-settle="${ev.id}" class="px-3.5 py-2 rounded-xl bg-cyan-500/15 border border-cyan-500/30 text-cyan-300 text-xs font-bold uppercase">Settle H+1</button>` : ''}
