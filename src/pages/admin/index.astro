    refundFilter?.addEventListener('change', loadRefunds);
    document.getElementById('adm-refunds-list')?.addEventListener('click', async (e) => {
      const btn = (e.target as HTMLElement).closest('[data-refund-process]') as HTMLButtonElement | null;
      if (!btn) return;
      const id = Number(btn.dataset.refundProcess);
      if (!confirm(`Tandai Refund #${id} telah berhasil dikembalikan ke pembeli?`)) return;
      btn.disabled = true;
      try {
        await api.post(`/admin/refunds/${id}/process`, {});
        showToast(`Refund #${id} selesai diproses.`);
        await loadRefunds();
      } catch (err: any) {
        showToast(err?.message || 'Gagal memproses refund.', true);
        btn.disabled = false;
      }
    });

    // TAB 6: GLOBAL ORDERS & PAYMENTS MONITOR
    async function loadAdminOrders() {
      const tbody = document.getElementById('adm-orders-tbody');
      if (!tbody) return;
      const status = (document.getElementById('adm-orders-status') as HTMLSelectElement | null)?.value || '';
      const lateOnly = Boolean((document.getElementById('adm-orders-late-only') as HTMLInputElement | null)?.checked);
      const q = (document.getElementById('adm-orders-search') as HTMLInputElement | null)?.value.trim() || '';

      const params = new URLSearchParams({ limit: '50', offset: '0' });
      if (status) params.set('status', status);
      if (lateOnly) params.set('late_only', 'true');
      if (q) params.set('q', q);

      tbody.innerHTML = `<tr><td colspan="5" class="py-5 text-center text-neutral-600 dark:text-muted-gray">Memuat data transaksi global...</td></tr>`;
      try {
        const rows = await api.get<any[]>(`/admin/orders?${params.toString()}`);
        if (isDisposed) return;
        const list = Array.isArray(rows) ? rows : [];
        if (list.length === 0) {
          tbody.innerHTML = `<tr><td colspan="5" class="py-6 text-center text-neutral-600 dark:text-muted-gray">Tidak ada order yang cocok dengan filter.</td></tr>`;
          return;
        }
        tbody.innerHTML = list
          .map((o: any) => {
            const stCls =
              o.status === 'paid'
                ? 'bg-emerald-50 dark:bg-emerald-500/20 text-emerald-700 dark:text-emerald-300'
                : o.status === 'pending'
                ? 'bg-amber-50 dark:bg-amber-500/20 text-amber-700 dark:text-amber-300'
                : o.status === 'refunded'
                ? 'bg-cyan-50 dark:bg-cyan-500/20 text-cyan-700 dark:text-cyan-300'
                : 'bg-neutral-100 dark:bg-white/10 text-neutral-600 dark:text-muted-gray';

            return `
              <tr>
                <td class="py-3">
                  <strong class="text-neutral-950 dark:text-soft-white block">${escapeHtml(o.order_code)}</strong>
                  <span class="text-[10px] text-neutral-500 dark:text-muted-gray block">
                    ${escapeHtml((o.payment_channel || o.payment_method || 'ONLINE').toUpperCase())}${o.xendit_invoice_id ? ` • ${escapeHtml(o.xendit_invoice_id)}` : ''}
                  </span>
                  <span class="text-[10px] text-neutral-500 dark:text-muted-gray">${escapeHtml(formatDateIndo(o.paid_at || o.created_at))}</span>
                </td>
                <td class="py-3">
                  <span class="text-neutral-950 dark:text-soft-white block">${escapeHtml(o.buyer_username || '-')}</span>
                  <span class="text-[11px] text-neutral-500 dark:text-muted-gray">${escapeHtml(o.buyer_email || '-')}</span>
                </td>
                <td class="py-3">
                  <span class="text-neutral-950 dark:text-soft-white block">${escapeHtml(o.nama_event || '-')}</span>
                  <span class="text-[11px] text-neutral-500 dark:text-muted-gray">${escapeHtml(o.organization_name || '-')}</span>
                </td>
                <td class="py-3 text-right">
                  <strong class="text-neutral-950 dark:text-soft-white block">${escapeHtml(formatRupiah(o.final_amount || 0))}</strong>
                  <span class="text-[10px] text-electric-magenta">Fee: ${escapeHtml(formatRupiah(o.platform_fee || 0))}</span>
                </td>
                <td class="py-3 text-right">
                  <span class="px-2 py-0.5 rounded-full text-[10px] font-bold uppercase ${stCls}">${escapeHtml(o.status)}</span>
                  ${o.is_late_payment ? `<span class="block text-[10px] font-bold text-amber-600 dark:text-amber-300 mt-1">LATE PAYMENT (${escapeHtml(o.refund_status || 'pending')})</span>` : ''}
                  ${o.status === 'paid' ? `<span class="block text-[10px] mt-1 ${o.escrow_settled_at ? 'text-emerald-600 dark:text-emerald-400' : 'text-neutral-500 dark:text-muted-gray'}">${o.escrow_settled_at ? 'Settled H+1' : 'Escrow Pending'}</span>` : ''}
                </td>
              </tr>
            `;
          })
          .join('');
      } catch (err: any) {
        tbody.innerHTML = `<tr><td colspan="5" class="py-5 text-center text-red-600 dark:text-red-300">${escapeHtml(err?.message || 'Gagal memuat daftar order global.')}</td></tr>`;
      }
    }

    document.getElementById('adm-orders-filter-form')?.addEventListener('submit', (e) => {
      e.preventDefault();
      loadAdminOrders();
    });
    document.getElementById('adm-orders-status')?.addEventListener('change', loadAdminOrders);
    document.getElementById('adm-orders-late-only')?.addEventListener('change', loadAdminOrders);

    // TAB 7: USERS DIRECTORY
    async function loadAdminUsers() {
      const tbody = document.getElementById('adm-users-tbody');
      if (!tbody) return;
      const roleId = (document.getElementById('adm-users-role') as HTMLSelectElement | null)?.value || '';
      const q = (document.getElementById('adm-users-search') as HTMLInputElement | null)?.value.trim() || '';

      const params = new URLSearchParams({ limit: '50', offset: '0' });
      if (roleId) params.set('role_id', roleId);
      if (q) params.set('q', q);

      tbody.innerHTML = `<tr><td colspan="6" class="py-5 text-center text-neutral-600 dark:text-muted-gray">Memuat direktori akun...</td></tr>`;
      try {
        const rows = await api.get<any[]>(`/admin/users?${params.toString()}`);
        if (isDisposed) return;
        const list = Array.isArray(rows) ? rows : [];
        if (list.length === 0) {
          tbody.innerHTML = `<tr><td colspan="6" class="py-6 text-center text-neutral-600 dark:text-muted-gray">Tidak ada akun pengguna yang sesuai.</td></tr>`;
          return;
        }
        const roleLabel = (id: number) =>
          id === 1 ? 'ADMIN' : id === 2 ? 'ORGANIZER' : 'USER';

        tbody.innerHTML = list
          .map((u: any) => {
            const rLabel = roleLabel(Number(u.role_id));
            const rCls =
              Number(u.role_id) === 1
                ? 'bg-electric-magenta/15 text-electric-magenta border-electric-magenta/40'
                : Number(u.role_id) === 2
                ? 'bg-cyan-50 dark:bg-cyan-500/15 text-cyan-700 dark:text-cyan-300 border-cyan-200 dark:border-cyan-500/30'
                : 'bg-neutral-100 dark:bg-white/10 text-neutral-700 dark:text-soft-white border-neutral-200 dark:border-white/15';

            return `
              <tr>
                <td class="py-3">
                  <strong class="text-neutral-950 dark:text-soft-white block">${escapeHtml(u.username || '-')}</strong>
                  <span class="text-[11px] text-neutral-500 dark:text-muted-gray">${escapeHtml(u.email)}</span>
                </td>
                <td class="py-3">
                  <span class="px-2 py-0.5 rounded-full text-[10px] font-bold border ${rCls}">${rLabel}</span>
                </td>
                <td class="py-3">
                  <span class="${u.is_verified ? 'text-emerald-600 dark:text-emerald-400' : 'text-amber-600 dark:text-amber-300'} font-bold">
                    ${u.is_verified ? 'TERVERIFIKASI' : 'BELUM OTP'}
                  </span>
                </td>
                <td class="py-3">
                  ${u.organization_name
                    ? `<span class="text-neutral-950 dark:text-soft-white block">${escapeHtml(u.organization_name)}</span><span class="text-[10px] text-neutral-500 dark:text-muted-gray uppercase">${escapeHtml(u.organizer_status || '-')}</span>`
                    : `<span class="text-neutral-400 dark:text-muted-gray">-</span>`}
                </td>
                <td class="py-3 text-right font-bold text-neutral-950 dark:text-soft-white">${Number(u.paid_orders_count || 0)}</td>
                <td class="py-3 text-right text-neutral-500 dark:text-muted-gray whitespace-nowrap">${escapeHtml(formatDateIndo(u.created_at, { showTime: false }))}</td>
              </tr>
            `;
          })
          .join('');
      } catch (err: any) {
        tbody.innerHTML = `<tr><td colspan="6" class="py-5 text-center text-red-600 dark:text-red-300">${escapeHtml(err?.message || 'Gagal memuat daftar pengguna.')}</td></tr>`;
      }
    }

    document.getElementById('adm-users-filter-form')?.addEventListener('submit', (e) => {
      e.preventDefault();
      loadAdminUsers();
    });
    document.getElementById('adm-users-role')?.addEventListener('change', loadAdminUsers);

    // TAB 8: AUDIT LOGS & CRON JOBS
    document.getElementById('adm-jobs-buttons')?.addEventListener('click', async (e) => {
      const btn = (e.target as HTMLElement).closest('[data-trigger-job]') as HTMLButtonElement | null;
      if (!btn) return;
      const jobName = btn.dataset.triggerJob;
      if (!jobName) return;
      const outEl = document.getElementById('adm-job-output');
      btn.disabled = true;
      try {
        const res = await api.post(`/admin/jobs/trigger/${jobName}`, {});
        if (outEl) {
          outEl.textContent = JSON.stringify({ job: jobName, timestamp: new Date().toISOString(), result: res }, null, 2);
          outEl.classList.remove('hidden');
        }
        showToast(`Worker "${jobName}" selesai dieksekusi.`);
      } catch (err: any) {
        showToast(err?.message || `Gagal menjalankan worker ${jobName}.`, true);
      } finally {
        btn.disabled = false;
      }
    });

    async function loadAuditLogs() {
      const tbody = document.getElementById('adm-audit-tbody');
      if (!tbody) return;
      const action = (document.getElementById('audit-action-input') as HTMLInputElement | null)?.value.trim() || '';
      const target = (document.getElementById('audit-target-input') as HTMLInputElement | null)?.value.trim() || '';
      const params = new URLSearchParams({ limit: '50', offset: '0' });
      if (action) params.set('action', action);
      if (target) params.set('target_type', target);

      tbody.innerHTML = `<tr><td colspan="5" class="py-5 text-center text-neutral-600 dark:text-muted-gray">Memuat jejak audit...</td></tr>`;
      try {
        const rows = await api.get<any[]>(`/admin/audit-logs?${params.toString()}`);
        if (isDisposed) return;
        const list = Array.isArray(rows) ? rows : [];
        if (list.length === 0) {
          tbody.innerHTML = `<tr><td colspan="5" class="py-6 text-center text-neutral-600 dark:text-muted-gray">Belum ada catatan audit log sesuai filter.</td></tr>`;
          return;
        }
        tbody.innerHTML = list
          .map(
            (l) => `
            <tr>
              <td class="py-2.5 text-neutral-600 dark:text-muted-gray whitespace-nowrap">${escapeHtml(formatDateIndo(l.created_at))}</td>
              <td class="py-2.5 text-electric-magenta font-bold">${escapeHtml(l.action)}</td>
              <td class="py-2.5 text-neutral-950 dark:text-soft-white">${escapeHtml(l.target_type)}${l.target_id ? `#${l.target_id}` : ''}</td>
              <td class="py-2.5 text-neutral-600 dark:text-muted-gray">${escapeHtml(l.username || l.email || (l.user_id ? `User #${l.user_id}` : 'SYSTEM'))}</td>
              <td class="py-2.5 text-neutral-600 dark:text-muted-gray max-w-xs truncate">${escapeHtml(l.ip_address || '-')} • ${escapeHtml(l.details ? JSON.stringify(l.details) : '-')}</td>
            </tr>
          `
          )
          .join('');
      } catch (err: any) {
        tbody.innerHTML = `<tr><td colspan="5" class="py-5 text-center text-red-600 dark:text-red-300">${escapeHtml(err?.message || 'Gagal memuat audit logs.')}</td></tr>`;
      }
    }

    document.getElementById('adm-audit-filter-form')?.addEventListener('submit', (e) => {
      e.preventDefault();
      loadAuditLogs();
    });

    function syncAdminAccess() {
      const loggedIn = isAuthenticated();
      const adminOk = loggedIn && isAdmin();
      if (!adminOk) {
        workspace?.classList.add('hidden');
        accessGuard?.classList.remove('hidden');
        if (loggedIn) {
          if (guardTitle) guardTitle.textContent = 'AKSES DITOLAK (BUKAN ADMIN)';
          if (guardDesc) guardDesc.textContent = 'Akun yang sedang login tidak memiliki hak akses Administrator platform.';
          loginBtn?.classList.add('hidden');
        } else {
          if (guardTitle) guardTitle.textContent = 'AKSES KHUSUS ADMINISTRATOR';
          if (guardDesc) guardDesc.textContent = 'Masuk menggunakan akun Administrator (admin@soundtix.id) untuk membuka pusat kontrol platform.';
          loginBtn?.classList.remove('hidden');
        }
        return;
      }

      accessGuard?.classList.add('hidden');
      workspace?.classList.remove('hidden');
      const user = getStoredUser();
      if (operatorBadge && user) operatorBadge.textContent = `OPERATOR: ${user.email}`;
      activateTab(currentTab);
    }

    const onAuthChanged = () => syncAdminAccess();
    window.addEventListener('afterglow-auth-changed', onAuthChanged);
    syncAdminAccess();

    return () => {
      isDisposed = true;
      window.removeEventListener('afterglow-auth-changed', onAuthChanged);
    };
  }

  let adminCleanup: (() => void) | undefined;
  document.addEventListener('astro:page-load', () => {
    if (adminCleanup) adminCleanup();
    adminCleanup = initAdminCommandCenter();
  });
</script>
