      listEl.innerHTML = `<div class="p-8 rounded-2xl bg-white dark:bg-dark-plum/60 border border-neutral-200 dark:border-white/10 text-xs font-mono text-neutral-600 dark:text-muted-gray">Memuat antrean refund...</div>`;
      try {
        const rows = await api.get<any[]>(`/admin/refunds${q}`);
        if (isDisposed) return;
        const list = Array.isArray(rows) ? rows : [];
        if (list.length === 0) {
          listEl.innerHTML = `<div class="p-10 rounded-3xl bg-white dark:bg-dark-plum/50 border border-neutral-200 dark:border-white/10 text-center text-sm text-neutral-600 dark:text-muted-gray">Tidak ada antrean refund pada filter ini.</div>`;
