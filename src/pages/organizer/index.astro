                <input id="vch-f-end" type="datetime-local" required class="w-full px-3 py-2 rounded-xl bg-white dark:bg-void-black border border-neutral-300 dark:border-white/15 focus:outline-none focus:border-electric-magenta focus:ring-2 focus:ring-electric-magenta/20 text-xs text-neutral-950 dark:text-soft-white" />
