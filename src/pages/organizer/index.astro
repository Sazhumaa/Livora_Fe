            Koordinat: <code id="ev-footer-coord-readout" class="text-neutral-900 dark:text-soft-white font-bold">-6.2186,106.8026</code>
          </span>
          <span id="ev-footer-step-hint" class="hidden text-[11px] font-mono text-neutral-500 dark:text-muted-gray"></span>
        </div>

        <div class="flex flex-wrap items-center gap-2.5">
          <button id="ev-info-save-stay-btn" type="submit" form="ev-info-form" data-ev-save-mode="stay" class="hidden px-4 py-2.5 rounded-xl bg-white dark:bg-white/5 border border-neutral-200 dark:border-white/15 text-xs font-bold uppercase text-neutral-800 dark:text-soft-white hover:border-electric-magenta transition-colors">
            Simpan Saja
          </button>
          <button id="ev-info-save-btn" type="submit" form="ev-info-form" data-ev-save-mode="next" class="px-6 py-2.5 rounded-xl bg-electric-magenta text-white text-xs font-bold uppercase tracking-wider hover:shadow-magenta-glow transition-all">
            Simpan Konser
          </button>
          <button id="ev-goto-step3-btn" type="button" class="hidden px-5 py-2.5 rounded-xl bg-electric-magenta text-white text-xs font-bold uppercase tracking-wider hover:shadow-magenta-glow transition-all">
            Lanjut ke Voucher &amp; Review →
          </button>
          <button id="ev-finish-btn" type="button" class="hidden px-4 py-2.5 rounded-xl bg-white dark:bg-white/5 border border-neutral-200 dark:border-white/15 text-xs font-bold uppercase text-neutral-800 dark:text-soft-white hover:border-electric-magenta transition-colors">
            Simpan Draft
          </button>
          <button id="ev-submit-review-btn" type="button" class="hidden px-5 py-2.5 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-bold uppercase tracking-wider transition-all shadow-sm">
            Ajukan Review ke Admin ✓
