---
export const prerender = false;

import RootLayout from '../../layouts/RootLayout.astro';
import Footer from '../../components/landing/Footer.astro';
import VenueMapPicker from '../../components/organizer/VenueMapPicker.astro';

const rawTab = Astro.url.searchParams.get('tab') || 'overview';
const initialTab = ['overview', 'events', 'orders', 'gate', 'finance'].includes(rawTab) ? rawTab : 'overview';
---

<RootLayout 
  title="Studio Promotor Konser — AFTERGLOW Organizer Console" 
  description="Kelola event konser, kuota kategori tiket, voucher promo, monitor gate scanner, dan pencairan dana escrow."
>
  <div class="relative pt-28 pb-24 px-4 sm:px-6 lg:px-12 max-w-7xl mx-auto w-full">
    
    <!-- Auth Guard -->
    <div id="org-auth-guard" class="hidden text-center py-24 rounded-3xl bg-white dark:bg-dark-plum/60 border border-neutral-200 dark:border-white/10 shadow-sm dark:shadow-none">
      <span class="text-xs font-mono font-bold tracking-[0.25em] text-electric-magenta uppercase block mb-2">
        ORGANIZER CONSOLE
      </span>
      <h1 class="font-display text-4xl sm:text-5xl text-neutral-950 dark:text-soft-white mb-3">MASUK KE STUDIO PROMOTOR</h1>
      <p class="text-sm text-neutral-600 dark:text-muted-gray max-w-lg mx-auto mb-6">
        Login dengan akun AFTERGLOW untuk mendaftar sebagai penyelenggara konser atau mengelola event & pencairan escrow milikmu.
      </p>
      <button id="org-login-btn" type="button" class="px-7 py-3 rounded-full bg-electric-magenta text-white font-bold text-xs uppercase tracking-wider hover:shadow-magenta-glow transition-all">
        Masuk / Daftar OTP
      </button>
    </div>

    <!-- Admin Notice (Role 3 cannot use Organizer roleGuard routes directly without Organizer profile) -->
    <div id="org-admin-notice" class="hidden text-center py-20 rounded-3xl bg-white dark:bg-dark-plum/70 border border-amber-300 dark:border-amber-500/35 shadow-sm dark:shadow-none">
      <span class="px-3 py-1 rounded-full bg-amber-50 dark:bg-amber-500/20 text-amber-700 dark:text-amber-300 font-mono text-[10px] font-bold uppercase">AKUN ADMIN PLATFORM</span>
      <h2 class="font-display text-4xl text-neutral-950 dark:text-soft-white mt-3 mb-2">KAMU LOGIN SEBAGAI ADMINISTRATOR</h2>
      <p class="text-sm text-neutral-600 dark:text-muted-gray max-w-lg mx-auto mb-6">
        Untuk mereview promotor, mempublikasikan event, menyetujui payout, atau memproses refund massal, gunakan Admin Command Center.
      </p>
      <a href="/admin" class="px-7 py-3 rounded-full bg-electric-magenta text-white font-bold text-xs uppercase tracking-wider hover:shadow-magenta-glow transition-all">
        Buka Admin Command Center →
      </a>
    </div>

    <!-- Loading -->
    <div id="org-loading" class="animate-pulse space-y-6">
      <div class="h-32 rounded-3xl bg-neutral-200/70 dark:bg-dark-plum/60 border border-neutral-200 dark:border-white/10"></div>
      <div class="h-72 rounded-3xl bg-neutral-200/70 dark:bg-dark-plum/60 border border-neutral-200 dark:border-white/10"></div>
    </div>

    <!-- STATE A: NOT APPLIED YET -> ONBOARDING FORM -->
    <div id="org-apply-state" class="hidden grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">
      <div class="lg:col-span-5 space-y-6">
        <span class="px-3 py-1 rounded-full bg-electric-magenta/10 dark:bg-electric-magenta/15 border border-electric-magenta/30 text-electric-magenta font-mono text-[11px] font-bold uppercase">
          JADI PROMOTOR RESMI
        </span>
        <h1 class="font-display text-5xl sm:text-6xl text-neutral-950 dark:text-soft-white leading-none">
          GELAR KONSER BESARMU DI SINI
        </h1>
        <p class="text-sm text-neutral-600 dark:text-muted-gray leading-relaxed">
          Tinggalkan sistem pencatatan manual. AFTERGLOW menyediakan atomic inventory anti-oversell, gate scanner anti-duplikasi, dan pencairan dana escrow H+1 transparan.
        </p>
        <div class="space-y-3 text-xs font-mono">
          <div class="p-4 rounded-2xl bg-white dark:bg-dark-plum/70 border border-neutral-200 dark:border-white/10 shadow-sm dark:shadow-none">
            <strong class="text-neutral-950 dark:text-soft-white block mb-1">Biaya Platform Transparan 5%</strong>
            <span class="text-neutral-600 dark:text-muted-gray">Ditanggung pada transaksi tiket. Dana tiket bersih masuk otomatis ke escrow organizer.</span>
          </div>
          <div class="p-4 rounded-2xl bg-white dark:bg-dark-plum/70 border border-neutral-200 dark:border-white/10 shadow-sm dark:shadow-none">
            <strong class="text-neutral-950 dark:text-soft-white block mb-1">Anti-Calo & Audit Trail Real-Time</strong>
            <span class="text-neutral-600 dark:text-muted-gray">Pembatasan kuantitas per akun, CSPRNG QR secret, dan ekspor CSV penonton kapan saja.</span>
          </div>
        </div>
      </div>

      <div class="lg:col-span-7 p-7 sm:p-9 rounded-3xl bg-white dark:bg-dark-plum/90 border border-neutral-200 dark:border-white/15 shadow-xl dark:shadow-2xl">
        <h2 class="font-display text-2xl text-neutral-950 dark:text-soft-white mb-1">FORMULIR PENGAJUAN PROMOTOR</h2>
        <p class="text-xs text-neutral-600 dark:text-muted-gray mb-6">Lengkapi nama organisasi promotor dan rekening bank resmi untuk pencairan hasil tiket.</p>

        <form id="org-apply-form" class="space-y-4">
          <div>
            <label for="apply-org-name" class="text-xs font-mono text-neutral-600 dark:text-muted-gray block mb-1.5">Nama Brand / Organisasi Promotor (5–50 karakter)</label>
            <input id="apply-org-name" type="text" minlength="5" maxlength="50" required placeholder="Contoh: Afterglow Live Promotions" class="w-full px-4 py-3 rounded-xl bg-neutral-50 dark:bg-void-black border border-neutral-300 dark:border-white/15 text-sm text-neutral-950 dark:text-soft-white focus:outline-none focus:border-electric-magenta" />
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label for="apply-bank-name" class="text-xs font-mono text-neutral-600 dark:text-muted-gray block mb-1.5">Nama Bank Pencairan</label>
              <input id="apply-bank-name" type="text" minlength="2" maxlength="50" required placeholder="Bank Central Asia (BCA)" class="w-full px-4 py-3 rounded-xl bg-neutral-50 dark:bg-void-black border border-neutral-300 dark:border-white/15 text-sm text-neutral-950 dark:text-soft-white focus:outline-none focus:border-electric-magenta" />
            </div>
            <div>
              <label for="apply-acc-number" class="text-xs font-mono text-neutral-600 dark:text-muted-gray block mb-1.5">Nomor Rekening (Hanya Angka)</label>
              <input id="apply-acc-number" type="text" minlength="4" maxlength="20" pattern="[0-9]+" required placeholder="1234567890" class="w-full px-4 py-3 rounded-xl bg-neutral-50 dark:bg-void-black border border-neutral-300 dark:border-white/15 text-sm font-mono text-neutral-950 dark:text-soft-white focus:outline-none focus:border-electric-magenta" />
            </div>
          </div>

          <div id="apply-feedback" class="hidden p-3.5 rounded-xl border text-xs font-mono"></div>

          <button id="apply-submit-btn" type="submit" class="w-full py-3.5 rounded-xl bg-electric-magenta text-white text-xs font-bold uppercase tracking-wider hover:shadow-magenta-glow transition-all">
            Ajukan Pendaftaran Promotor →
          </button>
        </form>
      </div>
    </div>

    <!-- STATE B: PENDING / REJECTED APPLICATION -->
    <div id="org-status-state" class="hidden max-w-2xl mx-auto p-7 sm:p-9 rounded-3xl bg-white dark:bg-dark-plum/90 border border-neutral-200 dark:border-white/15 shadow-sm dark:shadow-none space-y-6">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <div>
          <span id="status-pill-badge" class="px-3 py-1 rounded-full text-[10px] font-mono font-bold uppercase"></span>
          <h2 id="status-headline" class="font-display text-3xl text-neutral-950 dark:text-soft-white mt-2"></h2>
        </div>
        <button id="status-refresh-btn" type="button" class="px-4 py-2 rounded-xl bg-neutral-100 hover:bg-neutral-200 border border-neutral-200 text-neutral-800 dark:bg-white/10 dark:hover:bg-white/20 dark:border-transparent text-xs font-mono dark:text-soft-white">
          Cek Status Terbaru
        </button>
      </div>

      <div id="status-rejection-box" class="hidden p-4 rounded-2xl bg-red-50 dark:bg-red-500/10 border border-red-200 dark:border-red-500/30 text-xs font-mono text-red-700 dark:text-red-300"></div>

      <div id="status-pending-info" class="hidden p-5 rounded-2xl bg-neutral-50 dark:bg-void-black/70 border border-neutral-200 dark:border-white/10 space-y-2 text-xs font-mono">
        <div class="flex justify-between"><span class="text-neutral-500 dark:text-muted-gray">Organisasi:</span><strong id="pending-org-name" class="text-neutral-950 dark:text-soft-white"></strong></div>
        <div class="flex justify-between"><span class="text-neutral-500 dark:text-muted-gray">Bank:</span><strong id="pending-bank-name" class="text-neutral-950 dark:text-soft-white"></strong></div>
        <div class="flex justify-between"><span class="text-neutral-500 dark:text-muted-gray">No. Rekening:</span><strong id="pending-acc-num" class="text-neutral-950 dark:text-soft-white"></strong></div>
      </div>

      <!-- Resubmit Form (Shown when rejected) -->
      <form id="org-resubmit-form" class="hidden space-y-4 pt-2 border-t border-neutral-200 dark:border-white/10">
        <p class="text-xs text-neutral-600 dark:text-muted-gray">Perbaiki data profil/rekening di bawah lalu kirim ulang ke tim verifikasi Admin.</p>
        <div>
          <label for="resubmit-org-name" class="text-xs font-mono text-neutral-600 dark:text-muted-gray block mb-1.5">Nama Organisasi</label>
          <input id="resubmit-org-name" type="text" minlength="3" maxlength="50" required class="w-full px-4 py-3 rounded-xl bg-neutral-50 dark:bg-void-black border border-neutral-300 dark:border-white/15 text-sm text-neutral-950 dark:text-soft-white focus:outline-none focus:border-electric-magenta" />
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label for="resubmit-bank-name" class="text-xs font-mono text-neutral-600 dark:text-muted-gray block mb-1.5">Nama Bank</label>
            <input id="resubmit-bank-name" type="text" minlength="2" maxlength="50" required class="w-full px-4 py-3 rounded-xl bg-neutral-50 dark:bg-void-black border border-neutral-300 dark:border-white/15 text-sm text-neutral-950 dark:text-soft-white focus:outline-none focus:border-electric-magenta" />
          </div>
          <div>
            <label for="resubmit-acc-number" class="text-xs font-mono text-neutral-600 dark:text-muted-gray block mb-1.5">Nomor Rekening</label>
            <input id="resubmit-acc-number" type="text" minlength="4" maxlength="20" pattern="[0-9]+" required class="w-full px-4 py-3 rounded-xl bg-neutral-50 dark:bg-void-black border border-neutral-300 dark:border-white/15 text-sm font-mono text-neutral-950 dark:text-soft-white focus:outline-none focus:border-electric-magenta" />
          </div>
        </div>
        <div id="resubmit-feedback" class="hidden p-3.5 rounded-xl border text-xs font-mono"></div>
        <button id="resubmit-submit-btn" type="submit" class="w-full py-3 rounded-xl bg-electric-magenta text-white text-xs font-bold uppercase tracking-wider hover:shadow-magenta-glow transition-all">
          Perbaiki & Ajukan Ulang →
        </button>
      </form>
    </div>

    <!-- STATE C: VERIFIED ORGANIZER STUDIO WORKSPACE -->
    <div id="org-studio-workspace" class="hidden space-y-8">
      <!-- Studio Top Header -->
      <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-6">
        <div>
          <div class="flex items-center gap-2 mb-2">
            <span data-i18n="organizerPage.badge" class="px-2.5 py-0.5 rounded bg-emerald-50 dark:bg-emerald-500/20 border border-emerald-200 dark:border-emerald-500/40 text-emerald-700 dark:text-emerald-300 font-mono text-[10px] font-bold uppercase">
              PROMOTOR TERVERIFIKASI
            </span>
            <span id="studio-org-id-badge" class="text-[11px] font-mono text-neutral-500 dark:text-muted-gray"></span>
            <a id="studio-public-link" href="/events" target="_blank" class="hidden text-[11px] font-mono text-electric-magenta hover:underline">
              Profil Publik -&gt;
            </a>
          </div>
          <h1 id="studio-org-title" data-i18n="organizerPage.title" class="font-display text-4xl sm:text-6xl text-neutral-950 dark:text-soft-white tracking-wide">
            PROMOTOR STUDIO
          </h1>
        </div>

        <div class="flex flex-wrap items-center gap-3">
          <button id="open-create-event-btn" type="button" data-i18n="organizerPage.newEventBtn" class="px-5 py-3 rounded-full bg-electric-magenta text-white text-xs font-bold uppercase tracking-wider hover:shadow-magenta-glow transition-all">
            + Buat Konser Baru (Draft)
          </button>
          <a href="/scanner" class="px-5 py-3 rounded-full bg-neutral-100 hover:bg-neutral-200 border border-neutral-200 text-neutral-900 dark:bg-white/10 dark:hover:bg-white/20 dark:border-transparent dark:text-soft-white text-xs font-bold uppercase tracking-wider transition-all">
            Gate Scanner →
          </a>
        </div>
      </div>

      <!-- Navigation Tabs -->
      <div class="flex flex-wrap gap-2 p-1.5 rounded-2xl bg-white dark:bg-dark-plum border border-neutral-200 dark:border-white/10 shadow-sm dark:shadow-none w-fit" id="org-studio-tabs">
        <button data-tab="overview" class="org-tab-btn px-4 py-2 rounded-xl text-xs font-mono font-bold uppercase transition-all">Overview & KPIs</button>
        <button data-tab="events" class="org-tab-btn px-4 py-2 rounded-xl text-xs font-mono font-bold uppercase transition-all">Manajemen Konser</button>
        <button data-tab="orders" class="org-tab-btn px-4 py-2 rounded-xl text-xs font-mono font-bold uppercase transition-all">Order Masuk</button>
        <button data-tab="gate" class="org-tab-btn px-4 py-2 rounded-xl text-xs font-mono font-bold uppercase transition-all">Gate & Kehadiran</button>
        <button data-tab="finance" class="org-tab-btn px-4 py-2 rounded-xl text-xs font-mono font-bold uppercase transition-all">Rekening & Payout</button>
      </div>

      <!-- TAB 1: OVERVIEW -->
      <section id="org-panel-overview" class="org-panel hidden space-y-8">
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5" id="org-kpi-grid">
          <!-- Injected KPI cards -->
        </div>

        <!-- 14-Day Revenue Chart (Custom SVG) -->
        <div class="p-6 sm:p-8 rounded-3xl bg-white dark:bg-dark-plum/85 border border-neutral-200 dark:border-white/15 shadow-sm dark:shadow-none space-y-4">
          <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-3">
            <div>
              <span class="text-[10px] font-mono uppercase tracking-wider text-electric-magenta font-bold block">TRAFIK PENDAPATAN 14 HARI</span>
              <h2 class="font-display text-2xl text-neutral-950 dark:text-soft-white">ARUS PENJUALAN & NET REVENUE PROMOTOR</h2>
            </div>
            <div id="org-revenue-summary" class="text-xs font-mono text-neutral-600 dark:text-muted-gray"></div>
          </div>
          <div id="org-revenue-chart-wrap" class="w-full overflow-x-auto">
            <p class="text-xs font-mono text-neutral-500 dark:text-muted-gray py-6">Memuat grafik pendapatan...</p>
          </div>
        </div>

        <!-- Per-Event Financial & Escrow Breakdown -->
        <div class="p-6 sm:p-8 rounded-3xl bg-white dark:bg-dark-plum/85 border border-neutral-200 dark:border-white/15 shadow-sm dark:shadow-none">
          <div class="flex items-center justify-between mb-4">
            <div>
              <span class="text-[10px] font-mono uppercase tracking-wider text-electric-magenta font-bold block">LAPORAN FINANSIAL PER KONSER</span>
              <h2 class="font-display text-2xl text-neutral-950 dark:text-soft-white">ALOKASI ESCROW & DANA SIAP TARIK</h2>
            </div>
            <button type="button" id="goto-events-tab-btn" class="text-xs font-mono text-electric-magenta hover:underline">Kelola Semua Konser →</button>
          </div>
          <div class="overflow-x-auto">
            <table class="w-full text-xs">
              <thead>
                <tr class="text-left text-neutral-500 dark:text-muted-gray font-mono border-b border-neutral-200 dark:border-white/10">
                  <th class="pb-3">KONSER & STATUS</th>
                  <th class="pb-3 text-right">TERJUAL</th>
                  <th class="pb-3 text-right">OMZET BERSIH (NET)</th>
                  <th class="pb-3 text-right">ESCROW PENDING</th>
                  <th class="pb-3 text-right">SIAP PAYOUT</th>
                  <th class="pb-3 text-right">SUDAH DITARIK</th>
                </tr>
              </thead>
              <tbody id="org-event-financials-tbody" class="divide-y divide-neutral-200 dark:divide-white/5"></tbody>
            </table>
          </div>
        </div>

        <div class="p-6 sm:p-8 rounded-3xl bg-white dark:bg-dark-plum/85 border border-neutral-200 dark:border-white/15 shadow-sm dark:shadow-none">
          <div class="flex items-center justify-between mb-4">
            <h2 class="font-display text-2xl text-neutral-950 dark:text-soft-white">RINGKASAN KONSER TERBARU</h2>
          </div>
          <div class="overflow-x-auto">
            <table class="w-full text-xs">
              <thead>
                <tr class="text-left text-neutral-500 dark:text-muted-gray font-mono border-b border-neutral-200 dark:border-white/10">
                  <th class="pb-3">KONSER</th>
                  <th class="pb-3">STATUS</th>
                  <th class="pb-3">JADWAL</th>
                  <th class="pb-3 text-right">TERJUAL / KUOTA</th>
                </tr>
              </thead>
              <tbody id="org-recent-events-tbody" class="divide-y divide-neutral-200 dark:divide-white/5"></tbody>
            </table>
          </div>
        </div>
      </section>

      <!-- TAB 2: EVENTS CRUD -->
      <section id="org-panel-events" class="org-panel hidden space-y-6">
        <div class="flex flex-wrap items-center justify-between gap-4">
          <div class="flex flex-wrap gap-2" id="org-events-status-filters">
            {['', 'draft', 'pending', 'published', 'ongoing', 'selesai', 'rejected', 'dibatalkan'].map((st) => (
              <button data-status={st} class={`org-ev-filter px-3.5 py-1.5 rounded-full text-[11px] font-mono uppercase transition-all ${st === '' ? 'bg-electric-magenta text-white font-bold' : 'bg-white dark:bg-dark-plum border border-neutral-200 dark:border-white/10 text-neutral-600 dark:text-muted-gray hover:text-neutral-950 dark:hover:text-soft-white'}`}>
                {st === '' ? 'Semua' : st}
              </button>
            ))}
          </div>
        </div>

        <div id="org-events-list" class="space-y-4"></div>
      </section>

      <!-- TAB 3: ORDERS MONITOR -->
      <section id="org-panel-orders" class="org-panel hidden space-y-6">
        <div class="p-6 rounded-3xl bg-white dark:bg-dark-plum/85 border border-neutral-200 dark:border-white/15 shadow-sm dark:shadow-none space-y-4">
          <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-4">
            <div>
              <span class="text-[10px] font-mono uppercase tracking-wider text-electric-magenta font-bold block">MONITOR TRANSAKSI PEMBELI</span>
              <h2 class="font-display text-2xl text-neutral-950 dark:text-soft-white">DAFTAR ORDER TIKET MASUK</h2>
            </div>
            <form id="org-orders-filter-form" class="flex flex-wrap items-center gap-2">
              <select id="org-orders-event-filter" class="px-3.5 py-2 rounded-xl bg-neutral-50 dark:bg-void-black border border-neutral-300 dark:border-white/15 text-xs font-mono text-neutral-950 dark:text-soft-white focus:outline-none focus:border-electric-magenta">
                <option value="">Semua Konser</option>
              </select>
              <select id="org-orders-status-filter" class="px-3.5 py-2 rounded-xl bg-neutral-50 dark:bg-void-black border border-neutral-300 dark:border-white/15 text-xs font-mono text-neutral-950 dark:text-soft-white focus:outline-none focus:border-electric-magenta">
                <option value="">Semua Status</option>
                <option value="paid">Paid (Lunas)</option>
                <option value="pending">Pending</option>
                <option value="expired">Expired</option>
                <option value="cancelled">Cancelled</option>
                <option value="refunded">Refunded</option>
              </select>
              <input id="org-orders-search" type="text" placeholder="Cari kode / pembeli..." class="px-3.5 py-2 rounded-xl bg-neutral-50 dark:bg-void-black border border-neutral-300 dark:border-white/15 text-xs font-mono text-neutral-950 dark:text-soft-white placeholder:text-neutral-400 focus:outline-none focus:border-electric-magenta" />
              <button type="submit" class="px-4 py-2 rounded-xl bg-electric-magenta text-white text-xs font-bold uppercase">Filter</button>
            </form>
          </div>

          <div class="overflow-x-auto">
            <table class="w-full text-xs font-mono">
              <thead>
                <tr class="text-left text-neutral-500 dark:text-muted-gray border-b border-neutral-200 dark:border-white/10">
                  <th class="pb-3">KODE ORDER & ITEM</th>
                  <th class="pb-3">KONSER</th>
                  <th class="pb-3">PEMBELI</th>
                  <th class="pb-3">CHANNEL</th>
                  <th class="pb-3 text-right">NET PROMOTOR</th>
                  <th class="pb-3 text-right">STATUS</th>
                </tr>
              </thead>
              <tbody id="org-orders-tbody" class="divide-y divide-neutral-200 dark:divide-white/5"></tbody>
            </table>
          </div>

          <div id="org-orders-pagination" class="flex flex-wrap items-center justify-between gap-3 pt-4 border-t border-neutral-200 dark:border-white/10 text-xs font-mono">
            <span id="org-orders-page-info" class="text-neutral-500 dark:text-muted-gray">Halaman 1</span>
            <div class="flex items-center gap-2">
              <button id="org-orders-prev-btn" type="button" disabled class="px-3.5 py-1.5 rounded-xl bg-neutral-100 dark:bg-white/10 border border-neutral-200 dark:border-white/15 text-neutral-800 dark:text-soft-white hover:border-electric-magenta disabled:opacity-40 disabled:pointer-events-none transition-all">
                ← Sebelumnya
              </button>
              <button id="org-orders-next-btn" type="button" disabled class="px-3.5 py-1.5 rounded-xl bg-neutral-100 dark:bg-white/10 border border-neutral-200 dark:border-white/15 text-neutral-800 dark:text-soft-white hover:border-electric-magenta disabled:opacity-40 disabled:pointer-events-none transition-all">
                Berikutnya →
              </button>
            </div>
          </div>
        </div>
      </section>

      <!-- TAB 4: GATE & ATTENDANCE -->
      <section id="org-panel-gate" class="org-panel hidden space-y-6">
        <div class="p-6 rounded-3xl bg-white dark:bg-dark-plum/85 border border-neutral-200 dark:border-white/15 shadow-sm dark:shadow-none space-y-5">
          <div class="flex flex-col md:flex-row md:items-end justify-between gap-4">
            <div class="flex-1 max-w-md">
              <label for="gate-event-select" class="text-xs font-mono text-neutral-600 dark:text-muted-gray block mb-1.5">Pilih Event untuk Monitor Kehadiran</label>
