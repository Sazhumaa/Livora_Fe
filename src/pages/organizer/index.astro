            <div id="vch-feedback" class="hidden p-2.5 rounded-xl border text-xs font-mono"></div>
            <button type="submit" class="px-5 py-2.5 rounded-xl bg-electric-magenta text-white text-xs font-bold uppercase tracking-wider hover:shadow-magenta-glow transition-all">
              + Simpan Voucher Promo
            </button>
