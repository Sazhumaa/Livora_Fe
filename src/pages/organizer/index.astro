        </div>
      </div>

      <!-- Unified Persistent 3-Step Wizard Footer -->
      <div id="ev-modal-footer" class="px-5 sm:px-6 py-4 border-t border-neutral-200 dark:border-white/10 bg-neutral-50/95 dark:bg-void-black/80 flex flex-wrap items-center justify-between gap-3 shrink-0">
        <div class="flex flex-wrap items-center gap-2.5">
          <button id="cancel-ev-modal-btn" type="button" class="px-4 py-2.5 rounded-xl bg-white dark:bg-white/5 border border-neutral-200 dark:border-white/15 text-xs font-bold uppercase text-neutral-700 dark:text-muted-gray hover:text-neutral-950 dark:hover:text-soft-white hover:border-neutral-300 dark:hover:border-white/25 transition-colors">
            Tutup
