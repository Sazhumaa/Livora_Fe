  </div>

  <Footer />
</RootLayout>

<script define:vars={{ initialTab }}>
  window.__orgInitialTab = initialTab;
</script>

<script>
  import { api, resolveAssetUrl } from '../../lib/api';
  import { renderDailyRevenueChartSvg } from '../../lib/charts';
  import { fetchCurrentUser, isAdmin, isAuthenticated } from '../../lib/auth';
  import { escapeHtml, formatDateIndo, formatRupiah } from '../../lib/formatters';
  import { mountVenueMapPicker } from '../../scripts/venueMapPicker';

  function toLocalInputValue(iso?: string): string {
    if (!iso) return '';
    const d = new Date(iso);
    if (isNaN(d.getTime())) return '';
    const pad = (n: number) => String(n).padStart(2, '0');
    return `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}T${pad(d.getHours())}:${pad(d.getMinutes())}`;
  }

  function showInlineMsg(el: HTMLElement | null, msg: string, isErr = false) {
    if (!el) return;
    el.textContent = msg;
    el.className = `p-3 rounded-xl border text-xs font-mono ${
      isErr ? 'bg-red-50 dark:bg-red-500/10 border-red-200 dark:border-red-500/30 text-red-700 dark:text-red-300' : 'bg-emerald-50 dark:bg-emerald-500/10 border-emerald-200 dark:border-emerald-500/30 text-emerald-700 dark:text-emerald-300'
    }`;
    el.classList.remove('hidden');
  }

  function initOrganizerStudio() {
    const authGuard = document.getElementById('org-auth-guard');
    const adminNotice = document.getElementById('org-admin-notice');
    const loadingEl = document.getElementById('org-loading');
    const applyState = document.getElementById('org-apply-state');
    const statusState = document.getElementById('org-status-state');
    const studioWorkspace = document.getElementById('org-studio-workspace');

    const loginBtn = document.getElementById('org-login-btn');
    const applyForm = document.getElementById('org-apply-form') as HTMLFormElement | null;
    const resubmitForm = document.getElementById('org-resubmit-form') as HTMLFormElement | null;
    const statusRefreshBtn = document.getElementById('status-refresh-btn');

    const tabBtns = document.querySelectorAll<HTMLButtonElement>('.org-tab-btn');
    const panels = document.querySelectorAll<HTMLElement>('.org-panel');

    const kpiGrid = document.getElementById('org-kpi-grid');
    const revenueSummaryEl = document.getElementById('org-revenue-summary');
    const revenueChartWrap = document.getElementById('org-revenue-chart-wrap');
    const eventFinancialsTbody = document.getElementById('org-event-financials-tbody');
    const recentTbody = document.getElementById('org-recent-events-tbody');
    const eventsListEl = document.getElementById('org-events-list');
    const evStatusFilterBtns = document.querySelectorAll<HTMLButtonElement>('.org-ev-filter');

    const ordersFilterForm = document.getElementById('org-orders-filter-form') as HTMLFormElement | null;
    const ordersEventFilter = document.getElementById('org-orders-event-filter') as HTMLSelectElement | null;
    const ordersStatusFilter = document.getElementById('org-orders-status-filter') as HTMLSelectElement | null;
    const ordersSearchInput = document.getElementById('org-orders-search') as HTMLInputElement | null;
    const ordersTbody = document.getElementById('org-orders-tbody');

    const gateEventSelect = document.getElementById('gate-event-select') as HTMLSelectElement | null;
    const gateAttendanceBox = document.getElementById('gate-attendance-container');
    const gateExportBtn = document.getElementById('gate-export-csv-btn') as HTMLButtonElement | null;
    const gateScannerLink = document.getElementById('gate-open-scanner-link') as HTMLAnchorElement | null;
    const gateCurrentPinEl = document.getElementById('gate-current-pin');
    const gateTogglePinBtn = document.getElementById('gate-toggle-pin-btn');
    const gatePinForm = document.getElementById('gate-pin-update-form') as HTMLFormElement | null;
    const gateNewPinInput = document.getElementById('gate-new-pin-input') as HTMLInputElement | null;
    const gatePinFeedback = document.getElementById('gate-pin-feedback');

    const finWithdrawable = document.getElementById('fin-withdrawable');
    const finPending = document.getElementById('fin-pending');
    const finCooldownBanner = document.getElementById('fin-cooldown-banner');
    const finBankName = document.getElementById('fin-bank-name');
    const finAccNumber = document.getElementById('fin-acc-number');
    const finWithdrawnTotal = document.getElementById('fin-withdrawn-total');
    const payoutForm = document.getElementById('payout-request-form') as HTMLFormElement | null;
    const payoutEventSelect = document.getElementById('payout-event-select') as HTMLSelectElement | null;
    const payoutAmountInput = document.getElementById('payout-amount-input') as HTMLInputElement | null;
    const payoutEventHint = document.getElementById('payout-event-hint');
    const payoutSubmitBtn = document.getElementById('payout-submit-btn') as HTMLButtonElement | null;
    const payoutHistoryTbody = document.getElementById('payout-history-tbody');
    const bankUpdateForm = document.getElementById('bank-update-form') as HTMLFormElement | null;

    // Modal elements
    const evModal = document.getElementById('event-studio-modal');
    const openCreateBtn = document.getElementById('open-create-event-btn');
    const closeEvModalBtn = document.getElementById('close-ev-modal-btn');
    const cancelEvModalBtn = document.getElementById('cancel-ev-modal-btn') as HTMLButtonElement | null;
    const evModalTitle = document.getElementById('ev-modal-title');
    const evModalSubtabs = document.getElementById('ev-modal-subtabs');
    const evModalScrollBody = document.getElementById('ev-modal-scroll-body');
    const evModalFooter = document.getElementById('ev-modal-footer');
    const evSubtabBtns = document.querySelectorAll<HTMLButtonElement>('.ev-subtab-btn');
    const evSubpanels = document.querySelectorAll<HTMLElement>('.ev-subpanel');
    const evWizardToast = document.getElementById('ev-wizard-toast');
    const evWizardToastMsg = document.getElementById('ev-wizard-toast-msg');
    const evWizardToastBack = document.getElementById('ev-wizard-toast-back') as HTMLButtonElement | null;
    const evWizardToastClose = document.getElementById('ev-wizard-toast-close') as HTMLButtonElement | null;
    const evFooterCoordWrap = document.getElementById('ev-footer-coord-wrap');
    const evFooterStepHint = document.getElementById('ev-footer-step-hint');
    const evInfoSaveStayBtn = document.getElementById('ev-info-save-stay-btn') as HTMLButtonElement | null;
    const evInfoSaveBtn = document.getElementById('ev-info-save-btn') as HTMLButtonElement | null;
    const evGotoStep3Btn = document.getElementById('ev-goto-step3-btn') as HTMLButtonElement | null;
    const evFinishBtn = document.getElementById('ev-finish-btn') as HTMLButtonElement | null;
    const posterBox = document.getElementById('ev-poster-upload-box');
    const posterPreview = document.getElementById('ev-poster-preview') as HTMLImageElement | null;
    const posterFileInput = document.getElementById('ev-poster-file-input') as HTMLInputElement | null;
    const posterUploadBtn = document.getElementById('ev-poster-upload-btn') as HTMLButtonElement | null;
    const evInfoForm = document.getElementById('ev-info-form') as HTMLFormElement | null;
    const evSubmitReviewBtn = document.getElementById('ev-submit-review-btn') as HTMLButtonElement | null;
    const venueMap = mountVenueMapPicker();
    const evLineupRowsEl = document.getElementById('ev-lineup-rows');
    const evAddLineupBtn = document.getElementById('ev-add-lineup-btn');
    const evRundownRowsEl = document.getElementById('ev-rundown-rows');
    const evAddRundownBtn = document.getElementById('ev-add-rundown-btn');
    const evCategoriesList = document.getElementById('ev-categories-list');
    const evEditCatForm = document.getElementById('ev-edit-cat-form') as HTMLFormElement | null;
    const evAddCatForm = document.getElementById('ev-add-cat-form') as HTMLFormElement | null;
    const evVouchersList = document.getElementById('ev-vouchers-list');
    const evEditVoucherForm = document.getElementById('ev-edit-voucher-form') as HTMLFormElement | null;
    const evAddVoucherForm = document.getElementById('ev-add-voucher-form') as HTMLFormElement | null;

    let currentTab: string = (window as any).__orgInitialTab || 'overview';
    let currentEvFilter = '';
    let myProfile: any = null;
    let myEvents: any[] = [];
    let eventFinancialsMap = new Map<number, any>();
    let currentBankCooldown = false;
    let currentGatePinValue = '';
    let isGatePinVisible = false;
    let editingEventId: number | null = null;
    let editingEventDetail: any = null;
    let editingCategoryId: number | null = null;
    let editingVoucherId: number | null = null;
    let activeModalSubtab: 'info' | 'categories' | 'vouchers' = 'info';
    let previousAutoSubtab: 'info' | 'categories' | 'vouchers' | null = null;
    let payoutIdempotencyKey = crypto.randomUUID();
    let isDisposed = false;

    loginBtn?.addEventListener('click', () => {
      if (typeof (window as any).openAuthModal === 'function') (window as any).openAuthModal();
      else window.location.href = '/masuk';
    });

    function activateTab(tab: string) {
      currentTab = tab;
      window.history.replaceState(null, '', `${window.location.pathname}?tab=${encodeURIComponent(tab)}`);
      tabBtns.forEach((b) => {
        const active = b.dataset.tab === tab;
        b.classList.toggle('bg-electric-magenta', active);
        b.classList.toggle('text-white', active);
        b.classList.toggle('shadow-magenta-glow', active);
        b.classList.toggle('text-neutral-600', !active);
        b.classList.toggle('dark:text-muted-gray', !active);
      });
      panels.forEach((p) => p.classList.toggle('hidden', p.id !== `org-panel-${tab}`));

      if (tab === 'overview') loadOverview();
      if (tab === 'events') loadOrganizerEvents();
      if (tab === 'orders') loadOrganizerOrdersTab();
      if (tab === 'gate') loadGateTab();
      if (tab === 'finance') loadFinanceTab();
    }

    tabBtns.forEach((b) => b.addEventListener('click', () => activateTab(b.dataset.tab || 'overview')));
    document.getElementById('goto-events-tab-btn')?.addEventListener('click', () => activateTab('events'));

    function hideAllRootStates() {
      authGuard?.classList.add('hidden');
      adminNotice?.classList.add('hidden');
      loadingEl?.classList.add('hidden');
      applyState?.classList.add('hidden');
      statusState?.classList.add('hidden');
      studioWorkspace?.classList.add('hidden');
    }

    async function bootstrapOrganizer() {
      if (!isAuthenticated()) {
        myProfile = null;
        hideAllRootStates();
        authGuard?.classList.remove('hidden');
        return;
      }

      if (isAdmin()) {
        hideAllRootStates();
        adminNotice?.classList.remove('hidden');
        return;
      }

      const workspaceAlreadyOpen = Boolean(myProfile && studioWorkspace && !studioWorkspace.classList.contains('hidden'));
      if (!workspaceAlreadyOpen) {
        hideAllRootStates();
        loadingEl?.classList.remove('hidden');
      }

      try {
        myProfile = await api.get('/organizer/me');
        if (isDisposed) return;
        loadingEl?.classList.add('hidden');

        if (!myProfile) {
          hideAllRootStates();
          applyState?.classList.remove('hidden');
          return;
        }

        if (myProfile.verification_status === 'verified') {
          await fetchCurrentUser(); // ensure role_id === 2 synced in localStorage
          if (isDisposed) return;
          hideAllRootStates();
          studioWorkspace?.classList.remove('hidden');
          const titleEl = document.getElementById('studio-org-title');
          const idBadge = document.getElementById('studio-org-id-badge');
          const pubLink = document.getElementById('studio-public-link') as HTMLAnchorElement | null;
          if (titleEl) titleEl.textContent = myProfile.organization_name || 'PROMOTOR STUDIO';
          if (idBadge) idBadge.textContent = `ORGANIZER #${myProfile.id}`;
          if (pubLink && myProfile.id) {
            pubLink.href = `/organizers/${myProfile.id}`;
            pubLink.classList.remove('hidden');
          }
          activateTab(currentTab);
        } else {
          hideAllRootStates();
          renderPendingOrRejectedState(myProfile);
        }
      } catch (err: any) {
        if (isDisposed) return;
        loadingEl?.classList.add('hidden');
        if (workspaceAlreadyOpen) return;
        hideAllRootStates();
        applyState?.classList.remove('hidden');
        showInlineMsg(document.getElementById('apply-feedback'), err?.message || 'Gagal mengecek profil organizer.', true);
      }
    }

    function renderPendingOrRejectedState(profile: any) {
      statusState?.classList.remove('hidden');
      const badge = document.getElementById('status-pill-badge');
      const headline = document.getElementById('status-headline');
      const rejBox = document.getElementById('status-rejection-box');
      const pendingInfo = document.getElementById('status-pending-info');

      if (profile.verification_status === 'rejected') {
        if (badge) {
          badge.className = 'px-3 py-1 rounded-full text-[10px] font-mono font-bold uppercase bg-red-50 dark:bg-red-500/20 border border-red-200 dark:border-red-500/40 text-red-700 dark:text-red-300';
          badge.textContent = 'PENGAJUAN DITOLAK';
        }
        if (headline) headline.textContent = 'PERLU PERBAIKAN DATA PROMOTOR';
        if (rejBox) {
          rejBox.textContent = `Alasan Penolakan Admin: ${profile.rejection_reason || 'Data organisasi atau rekening belum valid.'}`;
          rejBox.classList.remove('hidden');
        }
        pendingInfo?.classList.add('hidden');
        resubmitForm?.classList.remove('hidden');
        (document.getElementById('resubmit-org-name') as HTMLInputElement).value = profile.organization_name || '';
        (document.getElementById('resubmit-bank-name') as HTMLInputElement).value = profile.bank_account || '';
        (document.getElementById('resubmit-acc-number') as HTMLInputElement).value = profile.account_number || '';
      } else {
        if (badge) {
          badge.className = 'px-3 py-1 rounded-full text-[10px] font-mono font-bold uppercase bg-amber-50 dark:bg-amber-500/20 border border-amber-200 dark:border-amber-500/40 text-amber-700 dark:text-amber-300';
          badge.textContent = 'MENUNGGU VERIFIKASI ADMIN';
        }
        if (headline) headline.textContent = 'PENGAJUAN SEDANG DITINJAU';
        rejBox?.classList.add('hidden');
        resubmitForm?.classList.add('hidden');
        pendingInfo?.classList.remove('hidden');
        const pName = document.getElementById('pending-org-name');
        const pBank = document.getElementById('pending-bank-name');
        const pAcc = document.getElementById('pending-acc-num');
        if (pName) pName.textContent = profile.organization_name || '-';
        if (pBank) pBank.textContent = profile.bank_account || '-';
        if (pAcc) pAcc.textContent = profile.account_number || '-';
      }
    }

    statusRefreshBtn?.addEventListener('click', async () => {
      await fetchCurrentUser();
      await bootstrapOrganizer();
    });

    applyForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const btn = document.getElementById('apply-submit-btn') as HTMLButtonElement | null;
      const fb = document.getElementById('apply-feedback');
      if (btn) btn.disabled = true;
      try {
        await api.post('/create-organizer', {
          organization_name: (document.getElementById('apply-org-name') as HTMLInputElement).value.trim(),
          bank_account: (document.getElementById('apply-bank-name') as HTMLInputElement).value.trim(),
          account_number: (document.getElementById('apply-acc-number') as HTMLInputElement).value.trim(),
        });
        await bootstrapOrganizer();
      } catch (err: any) {
        showInlineMsg(fb, err?.message || 'Gagal mengajukan pendaftaran organizer.', true);
      } finally {
        if (btn) btn.disabled = false;
      }
    });

    resubmitForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const btn = document.getElementById('resubmit-submit-btn') as HTMLButtonElement | null;
      const fb = document.getElementById('resubmit-feedback');
      if (btn) btn.disabled = true;
      try {
        await api.patch('/organizer/me', {
          organization_name: (document.getElementById('resubmit-org-name') as HTMLInputElement).value.trim(),
          bank_account: (document.getElementById('resubmit-bank-name') as HTMLInputElement).value.trim(),
          account_number: (document.getElementById('resubmit-acc-number') as HTMLInputElement).value.trim(),
          resubmit: true,
        });
        await bootstrapOrganizer();
      } catch (err: any) {
        showInlineMsg(fb, err?.message || 'Gagal mengajukan ulang aplikasi.', true);
      } finally {
        if (btn) btn.disabled = false;
      }
    });

    // TAB 1: OVERVIEW
    async function loadOverview() {
      if (!kpiGrid || !recentTbody) return;
      try {
        const dash = await api.get<any>('/organizer/dashboard');
        if (isDisposed) return;
        const f = dash.financials || {};
        const ev = dash.events_summary || {};
        const tk = dash.tickets_summary || {};
        const series = Array.isArray(dash.revenue_series) ? dash.revenue_series : [];
        const financials = Array.isArray(dash.event_financials) ? dash.event_financials : [];

        eventFinancialsMap.clear();
        financials.forEach((ef: any) => eventFinancialsMap.set(Number(ef.event_id), ef));

        kpiGrid.innerHTML = [
          { label: 'Omzet Kotor Tiket', val: formatRupiah(f.total_revenue || 0), sub: `Fee platform: ${formatRupiah(f.platform_fee || 0)}` },
          { label: 'Saldo Siap Tarik', val: formatRupiah(f.withdrawable_balance || 0), sub: `Pending escrow: ${formatRupiah(f.pending_balance || 0)}`, highlight: true },
          { label: 'Total Konser', val: `${Number(ev.total_events || 0)}`, sub: `${Number(ev.published_events || 0)} published • ${Number(ev.completed_events || 0)} selesai` },
          { label: 'Tiket Terjual / Hadir', val: `${Number(tk.total_tickets_sold || 0)}`, sub: `${Number(tk.total_tickets_attended || 0)} sudah check-in gate` },
        ]
          .map(
            (k) => `
            <div class="p-5 rounded-3xl bg-white dark:bg-dark-plum/85 border ${k.highlight ? 'border-electric-magenta/40' : 'border-neutral-200 dark:border-white/12'} shadow-sm dark:shadow-none">
              <span class="text-[10px] font-mono uppercase tracking-wider text-neutral-500 dark:text-muted-gray block">${escapeHtml(k.label)}</span>
              <strong class="font-display text-3xl text-neutral-950 dark:text-soft-white mt-1 block">${escapeHtml(k.val)}</strong>
              <span class="text-[11px] font-mono text-electric-magenta mt-1 block">${escapeHtml(k.sub)}</span>
            </div>
          `
          )
          .join('');

        if (revenueChartWrap) {
          const totalNet14 = series.reduce((sum: number, d: any) => sum + Number(d.net_revenue || 0), 0);
          const totalOrders14 = series.reduce((sum: number, d: any) => sum + Number(d.orders_count || 0), 0);
          if (revenueSummaryEl) {
            revenueSummaryEl.textContent = `14 Hari Terakhir: ${totalOrders14} order lunas • Net ${formatRupiah(totalNet14)}`;
          }
          revenueChartWrap.innerHTML = renderDailyRevenueChartSvg(
            series.map((d: any) => ({
              label: d.label || String(d.date || '').slice(5),
              primary: Number(d.net_revenue || 0),
              count: Number(d.orders_count || 0),
            })),
            { primaryLabel: 'Net Revenue Promotor' }
          );
        }

        if (eventFinancialsTbody) {
          eventFinancialsTbody.innerHTML =
            financials.length === 0
              ? `<tr><td colspan="6" class="py-6 text-center text-neutral-500 dark:text-muted-gray font-mono">Belum ada data finansial konser.</td></tr>`
              : financials
                  .map(
                    (ef: any) => `
                  <tr>
                    <td class="py-3">
                      <span class="font-bold text-neutral-950 dark:text-soft-white block">${escapeHtml(ef.nama_event)}</span>
                      <span class="text-[10px] font-mono uppercase ${ef.escrow_settled_at ? 'text-emerald-600 dark:text-emerald-400' : 'text-amber-600 dark:text-amber-300'}">${escapeHtml(ef.status)} • ${ef.escrow_settled_at ? 'Settled H+1' : 'Escrow Hold'}</span>
                    </td>
                    <td class="py-3 text-right font-mono text-neutral-950 dark:text-soft-white">${Number(ef.sold_tickets || 0)} / ${Number(ef.total_capacity || 0)}</td>
                    <td class="py-3 text-right font-mono font-bold text-neutral-950 dark:text-soft-white">${escapeHtml(formatRupiah(ef.net_revenue || 0))}</td>
                    <td class="py-3 text-right font-mono text-amber-600 dark:text-amber-300">${escapeHtml(formatRupiah(ef.unsettled_net || 0))}</td>
                    <td class="py-3 text-right font-mono font-bold text-emerald-600 dark:text-emerald-400">${escapeHtml(formatRupiah(ef.payout_available || 0))}</td>
                    <td class="py-3 text-right font-mono text-neutral-600 dark:text-muted-gray">${escapeHtml(formatRupiah(ef.payout_used || 0))}</td>
                  </tr>
                `
                  )
                  .join('');
        }

        const recents = Array.isArray(dash.recent_events) ? dash.recent_events : [];
        recentTbody.innerHTML =
          recents.length === 0
            ? `<tr><td colspan="4" class="py-6 text-center text-neutral-500 dark:text-muted-gray font-mono">Belum ada konser yang dibuat.</td></tr>`
            : recents
                .map(
                  (r: any) => `
                <tr>
                  <td class="py-3 font-bold text-neutral-950 dark:text-soft-white">${escapeHtml(r.nama_event)}</td>
                  <td class="py-3 font-mono text-[11px] uppercase text-electric-magenta">${escapeHtml(r.status)}</td>
                  <td class="py-3 text-neutral-600 dark:text-muted-gray font-mono">${escapeHtml(formatDateIndo(r.tanggal_mulai, { showTime: false }))}</td>
                  <td class="py-3 text-right font-mono text-neutral-950 dark:text-soft-white">${Number(r.total_sold || 0)} / ${Number(r.total_capacity || r.kapasitas_venue || 0)}</td>
                </tr>
              `
                )
                .join('');
      } catch (err: any) {
        kpiGrid.innerHTML = `<div class="col-span-full p-5 rounded-2xl bg-red-50 dark:bg-red-500/10 border border-red-200 dark:border-red-500/30 text-xs font-mono text-red-700 dark:text-red-300">${escapeHtml(err?.message || 'Gagal memuat dashboard organizer.')}</div>`;
      }
    }

    // TAB 3: ORGANIZER ORDERS MONITOR
    async function loadOrganizerOrdersTab() {
      if (ordersEventFilter && ordersEventFilter.options.length <= 1) {
        try {
          const evs = myEvents.length > 0 ? myEvents : await api.get<any[]>('/events');
          if (isDisposed) return;
          if (Array.isArray(evs)) {
            myEvents = evs;
            ordersEventFilter.innerHTML =
              `<option value="">Semua Konser</option>` +
              evs.map((ev) => `<option value="${ev.id}">#${ev.id} — ${escapeHtml(ev.nama_event)}</option>`).join('');
          }
        } catch {}
      }
      await loadOrganizerOrders();
    }

    let orgOrdersOffset = 0;
    const ORG_ORDERS_LIMIT = 50;

    async function loadOrganizerOrders() {
      if (!ordersTbody) return;
      const prevBtn = document.getElementById('org-orders-prev-btn') as HTMLButtonElement | null;
      const nextBtn = document.getElementById('org-orders-next-btn') as HTMLButtonElement | null;
      const pageInfo = document.getElementById('org-orders-page-info');
      const params = new URLSearchParams({ limit: String(ORG_ORDERS_LIMIT), offset: String(orgOrdersOffset) });
      const evId = ordersEventFilter?.value || '';
      const status = ordersStatusFilter?.value || '';
      const q = ordersSearchInput?.value.trim() || '';
      if (evId) params.set('event_id', evId);
      if (status) params.set('status', status);
      if (q) params.set('q', q);

      ordersTbody.innerHTML = `<tr><td colspan="6" class="py-6 text-center text-neutral-500 dark:text-muted-gray">Memuat daftar transaksi pembeli...</td></tr>`;
      try {
        const rows = await api.get<any[]>(`/organizer/orders?${params.toString()}`);
        if (isDisposed) return;
        const list = Array.isArray(rows) ? rows : [];
        const currentPage = Math.floor(orgOrdersOffset / ORG_ORDERS_LIMIT) + 1;
        if (pageInfo) {
          pageInfo.textContent =
            list.length > 0
              ? `Halaman ${currentPage} (${orgOrdersOffset + 1}–${orgOrdersOffset + list.length})`
              : `Halaman ${currentPage}`;
        }
        if (prevBtn) prevBtn.disabled = orgOrdersOffset <= 0;
        if (nextBtn) nextBtn.disabled = list.length < ORG_ORDERS_LIMIT;

        if (list.length === 0) {
          ordersTbody.innerHTML = `<tr><td colspan="6" class="py-8 text-center text-neutral-500 dark:text-muted-gray">Belum ada order masuk sesuai filter.</td></tr>`;
          return;
        }
        ordersTbody.innerHTML = list
          .map((o: any) => {
            const stCls =
              o.status === 'paid'
                ? 'bg-emerald-50 dark:bg-emerald-500/20 text-emerald-700 dark:text-emerald-300'
                : o.status === 'pending'
                ? 'bg-amber-50 dark:bg-amber-500/20 text-amber-700 dark:text-amber-300'
                : o.status === 'refunded'
                ? 'bg-cyan-50 dark:bg-cyan-500/20 text-cyan-700 dark:text-cyan-300'
                : 'bg-neutral-100 dark:bg-white/10 text-neutral-600 dark:text-muted-gray';

            return `
              <tr>
                <td class="py-3">
                  <strong class="text-neutral-950 dark:text-soft-white block">${escapeHtml(o.order_code)}</strong>
                  <span class="text-[11px] text-neutral-600 dark:text-muted-gray block">${escapeHtml(o.item_summary || '-')}</span>
                  ${o.kode_voucher ? `<span class="text-[10px] text-electric-magenta">Voucher: ${escapeHtml(o.kode_voucher)} (-${escapeHtml(formatRupiah(o.diskon_amount || 0))})</span>` : ''}
                </td>
                <td class="py-3 text-neutral-950 dark:text-soft-white">${escapeHtml(o.nama_event || '-')}</td>
                <td class="py-3">
                  <span class="text-neutral-950 dark:text-soft-white block">${escapeHtml(o.buyer_name || '-')}</span>
                  <span class="text-[11px] text-neutral-500 dark:text-muted-gray">${escapeHtml(o.buyer_email || '-')}</span>
                </td>
                <td class="py-3 text-neutral-600 dark:text-muted-gray">
                  <span class="block">${escapeHtml((o.payment_channel || o.payment_method || 'ONLINE').toUpperCase())}</span>
                  <span class="text-[10px]">${escapeHtml(o.paid_at ? formatDateIndo(o.paid_at) : formatDateIndo(o.created_at))}</span>
                </td>
                <td class="py-3 text-right">
                  <strong class="text-emerald-600 dark:text-emerald-400 block">${escapeHtml(formatRupiah(o.organizer_net || 0))}</strong>
                  <span class="text-[10px] text-neutral-500 dark:text-muted-gray">Gross: ${escapeHtml(formatRupiah(o.final_amount || 0))}</span>
                </td>
                <td class="py-3 text-right">
                  <span class="px-2 py-0.5 rounded-full text-[10px] font-bold uppercase ${stCls}">${escapeHtml(o.status)}</span>
                  ${o.status === 'paid' ? `<span class="block text-[10px] mt-1 ${o.escrow_settled_at ? 'text-emerald-600 dark:text-emerald-400' : 'text-amber-600 dark:text-amber-300'}">${o.escrow_settled_at ? 'Settled H+1' : 'Escrow Hold'}</span>` : ''}
                </td>
              </tr>
            `;
          })
          .join('');
      } catch (err: any) {
        ordersTbody.innerHTML = `<tr><td colspan="6" class="py-6 text-center text-red-600 dark:text-red-300">${escapeHtml(err?.message || 'Gagal memuat order masuk.')}</td></tr>`;
      }
    }

    ordersFilterForm?.addEventListener('submit', (e) => {
      e.preventDefault();
      orgOrdersOffset = 0;
      loadOrganizerOrders();
    });
    ordersEventFilter?.addEventListener('change', () => {
      orgOrdersOffset = 0;
      loadOrganizerOrders();
    });
    ordersStatusFilter?.addEventListener('change', () => {
      orgOrdersOffset = 0;
      loadOrganizerOrders();
    });
    document.getElementById('org-orders-prev-btn')?.addEventListener('click', () => {
      if (orgOrdersOffset >= ORG_ORDERS_LIMIT) {
        orgOrdersOffset -= ORG_ORDERS_LIMIT;
        loadOrganizerOrders();
      }
    });
    document.getElementById('org-orders-next-btn')?.addEventListener('click', () => {
      orgOrdersOffset += ORG_ORDERS_LIMIT;
      loadOrganizerOrders();
    });

    // TAB 2: EVENTS CRUD
    async function loadOrganizerEvents() {
      if (!eventsListEl) return;
      eventsListEl.innerHTML = `<div class="p-8 rounded-2xl bg-white dark:bg-dark-plum/60 border border-neutral-200 dark:border-white/10 shadow-sm dark:shadow-none text-xs font-mono text-neutral-600 dark:text-muted-gray">Memuat daftar konser...</div>`;
      const q = currentEvFilter ? `?status=${encodeURIComponent(currentEvFilter)}` : '';
      try {
        const list = await api.get<any[]>(`/events${q}`);
        if (isDisposed) return;
        myEvents = Array.isArray(list) ? list : [];

        if (myEvents.length === 0) {
          eventsListEl.innerHTML = `<div class="p-10 rounded-3xl bg-white dark:bg-dark-plum/50 border border-neutral-200 dark:border-white/10 shadow-sm dark:shadow-none text-center text-sm text-neutral-600 dark:text-muted-gray">Tidak ada event pada filter status ini.</div>`;
          return;
        }

        eventsListEl.innerHTML = myEvents
          .map((ev) => {
            const canDelete = ev.status === 'draft' || ev.status === 'rejected';
            const canSubmit = ev.status === 'draft' || ev.status === 'rejected';
            const canCancel = ev.status === 'published' || ev.status === 'ongoing';

            return `
              <div class="p-5 sm:p-6 rounded-3xl bg-white dark:bg-dark-plum/85 border border-neutral-200 dark:border-white/12 shadow-sm dark:shadow-none flex flex-col lg:flex-row lg:items-center justify-between gap-5">
                <div class="flex items-start gap-4">
                  <img src="${escapeHtml(resolveAssetUrl(ev.poster_url))}" alt="${escapeHtml(ev.nama_event)}" class="w-20 h-20 rounded-2xl object-cover bg-neutral-100 dark:bg-void-black border border-neutral-200 dark:border-white/10 shrink-0" />
                  <div class="space-y-1">
                    <div class="flex flex-wrap items-center gap-2">
                      <span class="px-2.5 py-0.5 rounded-full text-[10px] font-mono font-bold uppercase bg-neutral-100 dark:bg-white/10 text-neutral-800 dark:text-soft-white">${escapeHtml(ev.status)}</span>
                      ${ev.is_paused ? `<span class="px-2 py-0.5 rounded-full text-[10px] font-mono font-bold uppercase bg-amber-50 dark:bg-amber-500/20 border border-amber-300 dark:border-amber-500/35 text-amber-700 dark:text-amber-300">PENJUALAN DIJEDA</span>` : ''}
                      ${ev.genre ? `<span class="px-2 py-0.5 rounded-full text-[10px] font-mono uppercase bg-electric-magenta/10 text-electric-magenta">${escapeHtml(ev.genre)}</span>` : ''}
                      ${ev.kota ? `<span class="px-2 py-0.5 rounded-full text-[10px] font-mono uppercase bg-neutral-100 dark:bg-white/10 text-neutral-600 dark:text-muted-gray">${escapeHtml(ev.kota)}</span>` : ''}
                      <span class="text-[11px] font-mono text-neutral-500 dark:text-muted-gray">ID #${ev.id}</span>
                      ${ev.escrow_settled_at ? `<span class="px-2 py-0.5 rounded-full text-[10px] font-mono font-bold uppercase bg-emerald-50 dark:bg-emerald-500/20 text-emerald-700 dark:text-emerald-300">Escrow H+1 Settled</span>` : ''}
                    </div>
                    <h3 class="font-display text-2xl text-neutral-950 dark:text-soft-white">${escapeHtml(ev.nama_event)}</h3>
                    <p class="text-xs text-neutral-600 dark:text-muted-gray">${escapeHtml(formatDateIndo(ev.tanggal_mulai))} • ${escapeHtml(ev.alamat)}</p>
                    ${ev.rejection_reason ? `<p class="text-[11px] font-mono text-red-700 dark:text-red-300">Catatan Admin: ${escapeHtml(ev.rejection_reason)}</p>` : ''}
                    <p class="text-xs font-mono text-electric-magenta">Terjual: ${Number(ev.sold_quota || 0)} / ${Number(ev.total_quota || 0)} • Mulai ${escapeHtml(formatRupiah(ev.min_price || 0))}</p>
                  </div>
                </div>

                <div class="flex flex-wrap items-center gap-2 shrink-0">
                  <a href="/events/${ev.id}" target="_blank" class="px-3.5 py-2 rounded-xl bg-neutral-100 hover:bg-neutral-200 border border-neutral-200 text-neutral-900 dark:bg-white/10 dark:hover:bg-white/20 dark:border-transparent dark:text-soft-white text-xs font-mono uppercase transition-colors">
                    Preview Publik
                  </a>
                  <button type="button" data-manage-ev="${ev.id}" class="px-4 py-2 rounded-xl bg-electric-magenta text-white text-xs font-bold uppercase">
                    Kelola / Kategori / Voucher
                  </button>
                  ${canSubmit ? `<button type="button" data-submit-ev="${ev.id}" class="px-4 py-2 rounded-xl bg-emerald-50 dark:bg-emerald-500/20 border border-emerald-200 dark:border-emerald-500/40 text-emerald-700 dark:text-emerald-300 text-xs font-bold uppercase">Ajukan Review</button>` : ''}
                  ${canDelete ? `<button type="button" data-delete-ev="${ev.id}" class="px-3.5 py-2 rounded-xl bg-red-50 dark:bg-red-500/15 border border-red-200 dark:border-red-500/30 text-red-700 dark:text-red-300 text-xs font-bold uppercase">Hapus</button>` : ''}
                  ${canCancel ? `
                    <button type="button" data-toggle-pause-ev="${ev.id}" data-next-pause="${ev.is_paused ? '0' : '1'}" class="px-3.5 py-2 rounded-xl bg-amber-50 dark:bg-amber-500/15 border border-amber-200 dark:border-amber-500/35 text-amber-800 dark:text-amber-300 text-xs font-bold uppercase">${ev.is_paused ? 'Lanjutkan Penjualan' : 'Jeda Penjualan'}</button>
                    <a href="/scanner?event_id=${ev.id}" class="px-3.5 py-2 rounded-xl bg-neutral-100 hover:bg-neutral-200 border border-neutral-200 text-neutral-900 dark:bg-white/10 dark:hover:bg-white/20 dark:border-transparent dark:text-soft-white text-xs font-bold uppercase">Scanner</a>
                    <button type="button" data-cancel-ev="${ev.id}" class="px-3.5 py-2 rounded-xl bg-red-50 dark:bg-red-500/15 border border-red-200 dark:border-red-500/30 text-red-700 dark:text-red-300 text-xs font-bold uppercase">Batalkan Konser</button>
                  ` : ''}
                </div>
              </div>
            `;
          })
          .join('');
      } catch (err: any) {
        eventsListEl.innerHTML = `<div class="p-6 rounded-2xl bg-red-50 dark:bg-red-500/10 border border-red-200 dark:border-red-500/30 text-xs font-mono text-red-700 dark:text-red-300">${escapeHtml(err?.message || 'Gagal memuat daftar konser.')}</div>`;
      }
    }

    evStatusFilterBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        currentEvFilter = btn.dataset.status || '';
        evStatusFilterBtns.forEach((b) => {
          const active = (b.dataset.status || '') === currentEvFilter;
          b.className = `org-ev-filter px-3.5 py-1.5 rounded-full text-[11px] font-mono uppercase transition-all ${
            active ? 'bg-electric-magenta text-white font-bold' : 'bg-white dark:bg-dark-plum border border-neutral-200 dark:border-white/10 text-neutral-600 dark:text-muted-gray hover:text-neutral-950 dark:hover:text-soft-white'
          }`;
        });
        loadOrganizerEvents();
      });
    });

    eventsListEl?.addEventListener('click', async (e) => {
      const target = e.target as HTMLElement;
      const manageBtn = target.closest('[data-manage-ev]') as HTMLButtonElement | null;
      if (manageBtn) {
        await openEventModal(Number(manageBtn.dataset.manageEv));
        return;
      }

      const submitBtn = target.closest('[data-submit-ev]') as HTMLButtonElement | null;
      if (submitBtn) {
        const id = Number(submitBtn.dataset.submitEv);
        if (!confirm('Ajukan konser ini untuk direview & dipublikasikan Admin? Pastikan minimal 1 kategori tiket & poster sudah terisi.')) return;
        submitBtn.disabled = true;
        try {
          await api.patch(`/events/${id}/submit`, {});
          await loadOrganizerEvents();
        } catch (err: any) {
          alert(err?.message || 'Gagal mengajukan event ke Admin.');
          submitBtn.disabled = false;
        }
        return;
      }

      const deleteBtn = target.closest('[data-delete-ev]') as HTMLButtonElement | null;
      if (deleteBtn) {
        const id = Number(deleteBtn.dataset.deleteEv);
        if (!confirm('Hapus konser draft/ditolak ini secara permanen?')) return;
        try {
          await api.delete(`/events/${id}`);
          await loadOrganizerEvents();
        } catch (err: any) {
          alert(err?.message || 'Gagal menghapus konser.');
        }
        return;
      }

      const pauseBtn = target.closest('[data-toggle-pause-ev]') as HTMLButtonElement | null;
      if (pauseBtn) {
        const id = Number(pauseBtn.dataset.togglePauseEv);
        const nextPaused = pauseBtn.dataset.nextPause === '1';
        pauseBtn.disabled = true;
        try {
          await api.patch(`/organizer/events/${id}/pause`, { is_paused: nextPaused });
          await loadOrganizerEvents();
        } catch (err: any) {
          alert(err?.message || 'Gagal mengubah status jeda penjualan.');
          pauseBtn.disabled = false;
        }
        return;
      }

      const cancelBtn = target.closest('[data-cancel-ev]') as HTMLButtonElement | null;
      if (cancelBtn) {
        const id = Number(cancelBtn.dataset.cancelEv);
        const reason = prompt('Masukkan alasan pembatalan resmi konser (min. 5 karakter). Seluruh order lunas akan otomatis masuk antrean refund:', '');
        if (!reason || reason.trim().length < 5) return;
        try {
          await api.post(`/events/${id}/cancel`, { reason: reason.trim() });
          alert('Konser dibatalkan & antrean refund massal telah dibuat.');
          await loadOrganizerEvents();
        } catch (err: any) {
          alert(err?.message || 'Gagal membatalkan konser.');
        }
      }
    });

    // MODAL MANAGEMENT
    function parseJsonArrayField(val: any): any[] {
      if (Array.isArray(val)) return val;
      if (typeof val === 'string' && val.trim()) {
        try {
          const parsed = JSON.parse(val);
          return Array.isArray(parsed) ? parsed : [];
        } catch {
          return [];
        }
      }
      return [];
    }

    function appendLineupRow(item: any = { name: '', role: '', time: '' }) {
      if (!evLineupRowsEl) return;
      const row = document.createElement('div');
      row.className = 'lineup-item-row grid grid-cols-12 gap-1.5 items-center';
      row.innerHTML = `
        <input type="text" data-f="name" value="${escapeHtml(item.name || '')}" placeholder="Artis / Band" class="col-span-5 px-2.5 py-1.5 rounded-lg bg-neutral-50 dark:bg-void-black border border-neutral-300 dark:border-white/15 text-[11px] text-neutral-950 dark:text-soft-white" />
        <input type="text" data-f="role" value="${escapeHtml(item.role || '')}" placeholder="Role (Headliner)" class="col-span-4 px-2.5 py-1.5 rounded-lg bg-neutral-50 dark:bg-void-black border border-neutral-300 dark:border-white/15 text-[11px] text-neutral-950 dark:text-soft-white" />
        <input type="text" data-f="time" value="${escapeHtml(item.time || '')}" placeholder="21:00" class="col-span-2 px-2 py-1.5 rounded-lg bg-neutral-50 dark:bg-void-black border border-neutral-300 dark:border-white/15 text-[11px] font-mono text-neutral-950 dark:text-soft-white" />
        <button type="button" class="remove-dyn-row col-span-1 h-7 rounded-lg bg-red-50 dark:bg-red-500/15 text-red-600 dark:text-red-300 text-xs font-bold">✕</button>
      `;
      row.querySelector('.remove-dyn-row')?.addEventListener('click', () => row.remove());
      evLineupRowsEl.appendChild(row);
    }

    function appendRundownRow(item: any = { time: '', title: '', description: '' }) {
      if (!evRundownRowsEl) return;
      const row = document.createElement('div');
      row.className = 'rundown-item-row grid grid-cols-12 gap-1.5 items-center';
      row.innerHTML = `
        <input type="text" data-f="time" value="${escapeHtml(item.time || '')}" placeholder="19:00" class="col-span-3 px-2 py-1.5 rounded-lg bg-neutral-50 dark:bg-void-black border border-neutral-300 dark:border-white/15 text-[11px] font-mono text-neutral-950 dark:text-soft-white" />
        <input type="text" data-f="title" value="${escapeHtml(item.title || '')}" placeholder="Sesi Panggung" class="col-span-4 px-2.5 py-1.5 rounded-lg bg-neutral-50 dark:bg-void-black border border-neutral-300 dark:border-white/15 text-[11px] text-neutral-950 dark:text-soft-white" />
        <input type="text" data-f="description" value="${escapeHtml(item.description || '')}" placeholder="Keterangan" class="col-span-4 px-2.5 py-1.5 rounded-lg bg-neutral-50 dark:bg-void-black border border-neutral-300 dark:border-white/15 text-[11px] text-neutral-950 dark:text-soft-white" />
        <button type="button" class="remove-dyn-row col-span-1 h-7 rounded-lg bg-red-50 dark:bg-red-500/15 text-red-600 dark:text-red-300 text-xs font-bold">✕</button>
      `;
      row.querySelector('.remove-dyn-row')?.addEventListener('click', () => row.remove());
      evRundownRowsEl.appendChild(row);
    }

    function readLineupRows() {
      if (!evLineupRowsEl) return [];
      return Array.from(evLineupRowsEl.querySelectorAll<HTMLElement>('.lineup-item-row'))
        .map((row) => ({
          name: (row.querySelector('[data-f="name"]') as HTMLInputElement)?.value.trim() || '',
          role: (row.querySelector('[data-f="role"]') as HTMLInputElement)?.value.trim() || 'Guest Performer',
          time: (row.querySelector('[data-f="time"]') as HTMLInputElement)?.value.trim() || '-',
        }))
        .filter((x) => x.name.length > 0);
    }

    function readRundownRows() {
      if (!evRundownRowsEl) return [];
      return Array.from(evRundownRowsEl.querySelectorAll<HTMLElement>('.rundown-item-row'))
        .map((row) => ({
          time: (row.querySelector('[data-f="time"]') as HTMLInputElement)?.value.trim() || '-',
          title: (row.querySelector('[data-f="title"]') as HTMLInputElement)?.value.trim() || '',
          description: (row.querySelector('[data-f="description"]') as HTMLInputElement)?.value.trim() || '',
        }))
        .filter((x) => x.title.length > 0);
    }

    evAddLineupBtn?.addEventListener('click', () => appendLineupRow());
    evAddRundownBtn?.addEventListener('click', () => appendRundownRow());

    let modalVouchersCache: any[] = [];

    function hideWizardToast() {
      evWizardToast?.classList.add('hidden');
      evWizardToastBack?.classList.add('hidden');
      previousAutoSubtab = null;
    }

    function showWizardToast(msg: string, backToSubtab: 'info' | 'categories' | 'vouchers' | null = null) {
      if (!evWizardToast || !evWizardToastMsg) return;
      evWizardToastMsg.textContent = msg;
      previousAutoSubtab = backToSubtab;
      if (evWizardToastBack) {
        if (backToSubtab) {
          const backLabel = backToSubtab === 'info' ? '← Kembali ke Step 1 (Detail & Poster)' : '← Kembali ke Step 2 (Kategori Tiket)';
          evWizardToastBack.textContent = backLabel;
          evWizardToastBack.classList.remove('hidden');
        } else {
          evWizardToastBack.classList.add('hidden');
        }
      }
      evWizardToast.classList.remove('hidden');
    }

    function refreshLivePricePreviews() {
      const addPrice = Number((document.getElementById('cat-f-price') as HTMLInputElement | null)?.value || 0);
      const addPreview = document.getElementById('cat-price-preview');
      if (addPreview) addPreview.textContent = formatRupiah(Math.max(0, addPrice));

      const editPrice = Number((document.getElementById('edit-cat-f-price') as HTMLInputElement | null)?.value || 0);
      const editPreview = document.getElementById('edit-cat-price-preview');
      if (editPreview) editPreview.textContent = formatRupiah(Math.max(0, editPrice));

      const vchType = (document.getElementById('vch-f-type') as HTMLSelectElement | null)?.value || 'persen';
      const vchVal = Number((document.getElementById('vch-f-val') as HTMLInputElement | null)?.value || 0);
      const vchPreview = document.getElementById('vch-val-preview');
      if (vchPreview) {
        vchPreview.textContent = vchType === 'persen' ? `${Math.max(0, vchVal)}% OFF` : `${formatRupiah(Math.max(0, vchVal))} OFF`;
      }
    }

    document.getElementById('cat-f-price')?.addEventListener('input', refreshLivePricePreviews);
    document.getElementById('edit-cat-f-price')?.addEventListener('input', refreshLivePricePreviews);
    document.getElementById('vch-f-val')?.addEventListener('input', refreshLivePricePreviews);
    document.getElementById('vch-f-type')?.addEventListener('change', refreshLivePricePreviews);

    function applyDefaultVoucherDates() {
      const startEl = document.getElementById('vch-f-start') as HTMLInputElement | null;
      const endEl = document.getElementById('vch-f-end') as HTMLInputElement | null;
      if (startEl && !startEl.value) {
        startEl.value = toLocalInputValue(new Date().toISOString());
      }
      if (endEl && !endEl.value) {
        const fallbackEnd = editingEventDetail?.tanggal_mulai || new Date(Date.now() + 14 * 86400000).toISOString();
        endEl.value = toLocalInputValue(fallbackEnd);
      }
    }

    function setChecklistItem(prefix: string, done: boolean, noteText: string, optional = false) {
      const iconEl = document.getElementById(`ev-ready-${prefix}-icon`);
      const noteEl = document.getElementById(`ev-ready-${prefix}-note`);
      if (iconEl) {
        iconEl.textContent = done ? '✓' : '○';
        iconEl.className = done
          ? 'w-5 h-5 rounded-full bg-emerald-500/15 text-emerald-600 dark:text-emerald-300 font-mono text-[11px] font-bold flex items-center justify-center shrink-0'
          : optional
            ? 'w-5 h-5 rounded-full bg-neutral-200 dark:bg-white/10 text-neutral-500 dark:text-muted-gray font-mono text-[11px] font-bold flex items-center justify-center shrink-0'
            : 'w-5 h-5 rounded-full bg-amber-500/15 text-amber-600 dark:text-amber-300 font-mono text-[11px] font-bold flex items-center justify-center shrink-0';
      }
      if (noteEl) noteEl.textContent = noteText;
    }

    function syncWizardChrome() {
      const hasDraft = Boolean(editingEventId);
      const hasPoster = Boolean(editingEventDetail?.poster_url);
      const catsList = Array.isArray(editingEventDetail?.categories) ? editingEventDetail.categories : [];
      const hasCategories = catsList.length > 0;
      const vchCount = modalVouchersCache.length;
      const canSubmit = Boolean(editingEventDetail && (editingEventDetail.status === 'draft' || editingEventDetail.status === 'rejected'));

      // 1. Update visual 3-step dots & buttons
      const stepConfigs: Array<{ key: 'info' | 'categories' | 'vouchers'; dotId: string; num: string; done: boolean }> = [
        { key: 'info', dotId: 'ev-step-dot-1', num: '1', done: hasDraft && hasPoster },
        { key: 'categories', dotId: 'ev-step-dot-2', num: '2', done: hasCategories },
        { key: 'vouchers', dotId: 'ev-step-dot-3', num: '3', done: vchCount > 0 },
      ];
      evSubtabBtns.forEach((b) => {
        const key = (b.dataset.subtab || 'info') as 'info' | 'categories' | 'vouchers';
        const isActive = key === activeModalSubtab;
        const cfg = stepConfigs.find((s) => s.key === key);
        b.classList.toggle('border-electric-magenta', isActive);
        b.classList.toggle('bg-electric-magenta/10', isActive);
        b.classList.toggle('dark:bg-electric-magenta/15', isActive);
        b.classList.toggle('border-neutral-200', !isActive);
        b.classList.toggle('dark:border-white/10', !isActive);
        b.classList.toggle('bg-white', !isActive);
        b.classList.toggle('dark:bg-white/[0.03]', !isActive);
        const dotEl = cfg ? document.getElementById(cfg.dotId) : null;
        if (dotEl && cfg) {
          dotEl.textContent = cfg.done ? '✓' : cfg.num;
          dotEl.className = isActive
            ? 'w-6 h-6 rounded-full bg-electric-magenta text-white text-[11px] font-mono font-bold flex items-center justify-center shrink-0'
            : cfg.done
              ? 'w-6 h-6 rounded-full bg-emerald-500/20 text-emerald-700 dark:text-emerald-300 text-[11px] font-mono font-bold flex items-center justify-center shrink-0'
              : 'w-6 h-6 rounded-full bg-neutral-200 dark:bg-white/10 text-neutral-600 dark:text-muted-gray text-[11px] font-mono font-bold flex items-center justify-center shrink-0';
        }
      });

      // 2. Venue capacity strip in Step 2
      const capTotal = Number(editingEventDetail?.kapasitas_venue || (document.getElementById('ev-f-cap') as HTMLInputElement | null)?.value || 0);
      const capUsed = catsList.reduce((acc: number, c: any) => acc + Number(c.kuota_total || 0) + Number(c.kuota_komplimen || 0), 0);
      const capUsedEl = document.getElementById('ev-cap-used');
      const capTotalEl = document.getElementById('ev-cap-total');
      const catBadgeEl = document.getElementById('ev-cat-count-badge');
      const capBarEl = document.getElementById('ev-cap-bar');
      if (capUsedEl) capUsedEl.textContent = capUsed.toLocaleString('id-ID');
      if (capTotalEl) capTotalEl.textContent = capTotal.toLocaleString('id-ID');
      if (catBadgeEl) catBadgeEl.textContent = `${catsList.length} tier aktif`;
      if (capBarEl) {
        const pct = capTotal > 0 ? Math.min(100, Math.round((capUsed / capTotal) * 100)) : 0;
        capBarEl.style.width = `${pct}%`;
        capBarEl.classList.toggle('bg-red-500', capTotal > 0 && capUsed > capTotal);
        capBarEl.classList.toggle('bg-electric-magenta', !(capTotal > 0 && capUsed > capTotal));
      }

      // 3. Publish readiness checklist in Step 3
      setChecklistItem('info', hasDraft, hasDraft ? 'Info & koordinat OK' : 'Belum disimpan');
      setChecklistItem('poster', hasPoster, hasPoster ? 'Poster terpasang' : 'Wajib unggah poster');
      setChecklistItem('cats', hasCategories, hasCategories ? `${catsList.length} kategori siap` : 'Min. 1 kategori tiket');
      setChecklistItem('vch', vchCount > 0, vchCount > 0 ? `${vchCount} voucher dibuat` : 'Opsional (boleh kosong)', true);
      const readySummaryBadge = document.getElementById('ev-ready-summary-badge');
      if (readySummaryBadge) {
        const isReady = hasDraft && hasPoster && hasCategories;
        readySummaryBadge.textContent = isReady ? 'Siap Ajukan Review ✓' : 'Lengkapi Poster & Kategori';
        readySummaryBadge.className = isReady
          ? 'px-2.5 py-1 rounded-full border border-emerald-300 dark:border-emerald-500/40 bg-emerald-50 dark:bg-emerald-500/15 text-[11px] font-mono text-emerald-700 dark:text-emerald-300 font-bold'
          : 'px-2.5 py-1 rounded-full border border-amber-300 dark:border-amber-500/40 bg-amber-50 dark:bg-amber-500/15 text-[11px] font-mono text-amber-700 dark:text-amber-300';
      }

      // 4. Unified persistent sticky footer buttons
      evModalFooter?.classList.remove('hidden');
      if (cancelEvModalBtn) {
        cancelEvModalBtn.textContent =
          activeModalSubtab === 'categories'
            ? '← Kembali ke Step 1'
            : activeModalSubtab === 'vouchers'
              ? '← Kembali ke Step 2'
              : 'Tutup';
      }
      if (evFooterCoordWrap && evFooterStepHint) {
        if (activeModalSubtab === 'info') {
          evFooterCoordWrap.classList.remove('hidden');
          evFooterCoordWrap.classList.add('sm:inline-flex');
          evFooterStepHint.classList.add('hidden');
        } else {
          evFooterCoordWrap.classList.add('hidden');
          evFooterCoordWrap.classList.remove('sm:inline-flex');
          evFooterStepHint.classList.remove('hidden');
          evFooterStepHint.textContent =
            activeModalSubtab === 'categories'
              ? hasCategories
                ? `${catsList.length} tier siap • lanjut ke Step 3 atau tambah tier`
                : 'Isi formulir di atas untuk menambah kategori tiket pertama'
              : vchCount > 0
                ? `${vchCount} voucher aktif • siap diajukan ke Admin`
                : 'Voucher opsional — langsung ajukan review atau simpan draft';
        }
      }
      evInfoSaveStayBtn?.classList.toggle('hidden', !(activeModalSubtab === 'info' && hasDraft));
      evInfoSaveBtn?.classList.toggle('hidden', activeModalSubtab !== 'info');
      if (evInfoSaveBtn) {
        evInfoSaveBtn.textContent = hasDraft ? 'Simpan & Lanjut ke Kategori →' : 'Buat Draft & Lanjut →';
      }
      evGotoStep3Btn?.classList.toggle('hidden', activeModalSubtab !== 'categories');
      evFinishBtn?.classList.toggle('hidden', activeModalSubtab !== 'vouchers');
      evSubmitReviewBtn?.classList.toggle('hidden', !(hasDraft && canSubmit && (activeModalSubtab === 'vouchers' || (hasPoster && hasCategories))));
    }

    function activateModalSubtab(
      subtab: 'info' | 'categories' | 'vouchers',
      opts: { scrollTop?: boolean; autoToastFrom?: 'info' | 'categories' | 'vouchers'; toastMsg?: string } = {}
    ) {
      activeModalSubtab = subtab;
      evSubpanels.forEach((p) => p.classList.toggle('hidden', p.id !== `ev-subpanel-${subtab}`));
      syncWizardChrome();
      if (subtab === 'info') venueMap.resize();
      if (subtab === 'vouchers') applyDefaultVoucherDates();
      if (opts.scrollTop !== false && evModalScrollBody) {
        evModalScrollBody.scrollTo({ top: 0, behavior: 'smooth' });
      }
      if (opts.autoToastFrom) {
        showWizardToast(opts.toastMsg || 'Berhasil disimpan & diarahkan ke step berikutnya.', opts.autoToastFrom);
      }
    }

    evSubtabBtns.forEach((b) =>
      b.addEventListener('click', () => {
        hideWizardToast();
        activateModalSubtab((b.dataset.subtab as 'info' | 'categories' | 'vouchers') || 'info');
      })
    );
    document.querySelectorAll<HTMLButtonElement>('[data-jump-subtab]').forEach((b) =>
      b.addEventListener('click', () => {
        hideWizardToast();
        activateModalSubtab((b.dataset.jumpSubtab as 'info' | 'categories' | 'vouchers') || 'info');
      })
    );
    evWizardToastBack?.addEventListener('click', () => {
      const target = previousAutoSubtab || 'info';
      hideWizardToast();
      activateModalSubtab(target);
    });
    evWizardToastClose?.addEventListener('click', hideWizardToast);
    evGotoStep3Btn?.addEventListener('click', () => {
      hideWizardToast();
      activateModalSubtab('vouchers');
    });

    function closeEventModal() {
      evModal?.classList.add('hidden');
      evModal?.classList.remove('flex');
      editingCategoryId = null;
      editingVoucherId = null;
      hideWizardToast();
      evEditCatForm?.classList.add('hidden');
      evEditVoucherForm?.classList.add('hidden');
    }
    evFinishBtn?.addEventListener('click', closeEventModal);
    closeEvModalBtn?.addEventListener('click', closeEventModal);
    cancelEvModalBtn?.addEventListener('click', () => {
      hideWizardToast();
      if (activeModalSubtab === 'categories') {
        activateModalSubtab('info');
        return;
      }
      if (activeModalSubtab === 'vouchers') {
        activateModalSubtab('categories');
        return;
      }
      closeEventModal();
    });
    evModal?.addEventListener('click', (e) => {
      if (e.target === evModal) closeEventModal();
    });

    const onEscClose = (e: KeyboardEvent) => {
      if (e.key === 'Escape' && evModal && !evModal.classList.contains('hidden')) {
        closeEventModal();
      }
    };
    document.addEventListener('keydown', onEscClose);

    openCreateBtn?.addEventListener('click', () => openEventModal(null));

    async function openEventModal(evId: number | null) {
      editingEventId = evId;
      editingEventDetail = null;
      editingCategoryId = null;
      editingVoucherId = null;
      modalVouchersCache = [];
      hideWizardToast();
      evEditCatForm?.classList.add('hidden');
      evEditVoucherForm?.classList.add('hidden');
      evModal?.classList.remove('hidden');
      evModal?.classList.add('flex');
      document.getElementById('ev-info-feedback')?.classList.add('hidden');
      document.getElementById('ev-poster-msg')?.classList.add('hidden');
      document.getElementById('cat-feedback')?.classList.add('hidden');
      document.getElementById('vch-feedback')?.classList.add('hidden');
      activateModalSubtab('info', { scrollTop: false });
      if (evModalScrollBody) evModalScrollBody.scrollTop = 0;

      if (!evId) {
        if (evModalTitle) evModalTitle.textContent = 'BUAT KONSER BARU (DRAFT)';
        evModalSubtabs?.classList.add('hidden');
        posterBox?.classList.add('hidden');
        evInfoForm?.reset();
        if (evLineupRowsEl) evLineupRowsEl.innerHTML = '';
        if (evRundownRowsEl) evRundownRowsEl.innerHTML = '';
        appendLineupRow();
        appendRundownRow({ time: '18:00 WIB', title: 'Open Gate', description: 'Penukaran gelang digital & akses arena' });
        (document.getElementById('ev-f-lokasi') as HTMLInputElement).value = '-6.2186,106.8026';
        (document.getElementById('ev-f-cap') as HTMLInputElement).value = '5000';
        const d1 = new Date(Date.now() + 14 * 86400000);
        const d2 = new Date(d1.getTime() + 4 * 3600000);
        (document.getElementById('ev-f-start') as HTMLInputElement).value = toLocalInputValue(d1.toISOString());
        (document.getElementById('ev-f-end') as HTMLInputElement).value = toLocalInputValue(d2.toISOString());
        venueMap.syncFromInput(false);
        refreshLivePricePreviews();
        syncWizardChrome();
        return;
      }

      if (evModalTitle) evModalTitle.textContent = `STUDIO KONSER #${evId}`;
      evModalSubtabs?.classList.remove('hidden');
      posterBox?.classList.remove('hidden');
      venueMap.resize();
      await hydrateModalEventDetail(evId);
      refreshLivePricePreviews();
    }

    async function hydrateModalEventDetail(evId: number) {
      try {
        const detail = await api.get<any>(`/events/${evId}`);
        editingEventDetail = detail;
        if (evModalTitle) evModalTitle.textContent = `STUDIO #${evId} — ${detail.nama_event} (${detail.status})`;
        if (posterPreview) posterPreview.src = resolveAssetUrl(detail.poster_url);
        (document.getElementById('ev-f-name') as HTMLInputElement).value = detail.nama_event || '';
        (document.getElementById('ev-f-artis') as HTMLInputElement).value = detail.artis || '';
        (document.getElementById('ev-f-genre') as HTMLInputElement).value = detail.genre || '';
        (document.getElementById('ev-f-kota') as HTMLInputElement).value = detail.kota || '';
        (document.getElementById('ev-f-alamat') as HTMLInputElement).value = detail.alamat || '';
        (document.getElementById('ev-f-lokasi') as HTMLInputElement).value = detail.lat && detail.lng ? `${detail.lat},${detail.lng}` : '-6.2186,106.8026';
        venueMap.syncFromInput(true);
        (document.getElementById('ev-f-start') as HTMLInputElement).value = toLocalInputValue(detail.tanggal_mulai);
        (document.getElementById('ev-f-end') as HTMLInputElement).value = toLocalInputValue(detail.tanggal_selesai);
        (document.getElementById('ev-f-cap') as HTMLInputElement).value = String(detail.kapasitas_venue || 5000);
        (document.getElementById('ev-f-pin') as HTMLInputElement).value = detail.scanner_pin || '';
        (document.getElementById('ev-f-desc') as HTMLTextAreaElement).value = detail.deskripsi || '';
        (document.getElementById('ev-f-facilities') as HTMLTextAreaElement).value = parseJsonArrayField(detail.facilities).join('\n');
        (document.getElementById('ev-f-rules') as HTMLTextAreaElement).value = parseJsonArrayField(detail.rules).join('\n');

        if (evLineupRowsEl) {
          evLineupRowsEl.innerHTML = '';
          const lineups = parseJsonArrayField(detail.lineup);
          if (lineups.length > 0) lineups.forEach((l: any) => appendLineupRow(l));
          else appendLineupRow();
        }
        if (evRundownRowsEl) {
          evRundownRowsEl.innerHTML = '';
          const rundowns = parseJsonArrayField(detail.rundown);
          if (rundowns.length > 0) rundowns.forEach((r: any) => appendRundownRow(r));
          else appendRundownRow();
        }

        renderModalCategories(detail);
        await loadModalVouchers(evId);
        syncWizardChrome();
      } catch (err: any) {
        showInlineMsg(document.getElementById('ev-info-feedback'), err?.message || 'Gagal memuat detail konser.', true);
      }
    }

    evInfoForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const submitter = (e as SubmitEvent).submitter as HTMLButtonElement | null;
      const saveMode = submitter?.dataset.evSaveMode || 'next';
      const fb = document.getElementById('ev-info-feedback');
      const startVal = (document.getElementById('ev-f-start') as HTMLInputElement).value;
      const endVal = (document.getElementById('ev-f-end') as HTMLInputElement).value;
      const pinVal = (document.getElementById('ev-f-pin') as HTMLInputElement).value.trim();

      const facilities = (document.getElementById('ev-f-facilities') as HTMLTextAreaElement).value
        .split('\n').map((s) => s.trim()).filter(Boolean);
      const rules = (document.getElementById('ev-f-rules') as HTMLTextAreaElement).value
        .split('\n').map((s) => s.trim()).filter(Boolean);
      const lineup = readLineupRows();
      const rundown = readRundownRows();

      const genreVal = (document.getElementById('ev-f-genre') as HTMLInputElement | null)?.value.trim() || '';
      const kotaVal = (document.getElementById('ev-f-kota') as HTMLInputElement | null)?.value.trim() || '';

      const payload: any = {
        nama_event: (document.getElementById('ev-f-name') as HTMLInputElement).value.trim(),
        artis: (document.getElementById('ev-f-artis') as HTMLInputElement).value.trim(),
        ...(genreVal ? { genre: genreVal } : {}),
        ...(kotaVal ? { kota: kotaVal } : {}),
        alamat: (document.getElementById('ev-f-alamat') as HTMLInputElement).value.trim(),
        lokasi: (document.getElementById('ev-f-lokasi') as HTMLInputElement).value.trim(),
        tanggal_mulai: new Date(startVal).toISOString(),
        tanggal_selesai: new Date(endVal).toISOString(),
        kapasitas_venue: Number((document.getElementById('ev-f-cap') as HTMLInputElement).value || 5000),
        deskripsi: (document.getElementById('ev-f-desc') as HTMLTextAreaElement).value.trim(),
        ...(pinVal ? { scanner_pin: pinVal } : {}),
        ...(editingEventId || lineup.length > 0 ? { lineup } : {}),
        ...(editingEventId || rundown.length > 0 ? { rundown } : {}),
        ...(editingEventId || facilities.length > 0 ? { facilities } : {}),
        ...(editingEventId || rules.length > 0 ? { rules } : {}),
      };

      if (evInfoSaveBtn) evInfoSaveBtn.disabled = true;
      if (evInfoSaveStayBtn) evInfoSaveStayBtn.disabled = true;
      try {
        if (!editingEventId) {
          const created = await api.post<any>('/create/event', payload);
          const newId = Number(created.id || created.event_id);
          editingEventId = newId;
          evModalSubtabs?.classList.remove('hidden');
          posterBox?.classList.remove('hidden');
          await hydrateModalEventDetail(newId);
          showInlineMsg(fb, 'Draft konser dibuat! Silakan unggah poster resmi konser di bagian atas.');
          showWizardToast('Draft konser tersimpan! Unggah poster resmi di atas atau langsung atur Kategori Tiket.', null);
          evModalScrollBody?.scrollTo({ top: 0, behavior: 'smooth' });
          await loadOrganizerEvents();
        } else {
          await api.patch(`/events/${editingEventId}`, payload);
          await hydrateModalEventDetail(editingEventId);
          await loadOrganizerEvents();
          if (saveMode === 'next') {
            activateModalSubtab('categories', {
              autoToastFrom: 'info',
              toastMsg: 'Detail konser disimpan! Lanjut atur Kategori Tiket.',
            });
          } else {
            showInlineMsg(fb, 'Informasi konser berhasil diperbarui!');
            showWizardToast('Perubahan Detail & Peta tersimpan.', null);
          }
        }
      } catch (err: any) {
        showInlineMsg(fb, err?.message || 'Gagal menyimpan konser.', true);
      } finally {
        if (evInfoSaveBtn) evInfoSaveBtn.disabled = false;
        if (evInfoSaveStayBtn) evInfoSaveStayBtn.disabled = false;
      }
    });

    posterUploadBtn?.addEventListener('click', async () => {
      if (!editingEventId || !posterFileInput?.files?.[0]) {
        showInlineMsg(document.getElementById('ev-poster-msg'), 'Pilih file gambar JPG/PNG/WEBP terlebih dahulu.', true);
        return;
      }
      const fd = new FormData();
      fd.append('poster', posterFileInput.files[0]);
      posterUploadBtn.disabled = true;
      posterUploadBtn.textContent = 'Mengunggah...';
      try {
        const res = await api.upload<any>(`/events/${editingEventId}/poster`, fd);
        if (posterPreview && res?.poster_url) posterPreview.src = resolveAssetUrl(res.poster_url);
        if (editingEventDetail && res?.poster_url) editingEventDetail.poster_url = res.poster_url;
        showInlineMsg(document.getElementById('ev-poster-msg'), 'Poster berhasil diunggah!');
        await loadOrganizerEvents();
        const noCatsYet = !Array.isArray(editingEventDetail?.categories) || editingEventDetail.categories.length === 0;
        if (noCatsYet) {
          activateModalSubtab('categories', {
            autoToastFrom: 'info',
            toastMsg: 'Poster resmi diunggah! Lanjut buat Kategori Tiket.',
          });
        } else {
          syncWizardChrome();
          showWizardToast('Poster resmi berhasil diperbarui!', null);
        }
      } catch (err: any) {
        showInlineMsg(document.getElementById('ev-poster-msg'), err?.message || 'Gagal mengunggah poster (cek format/ukuran 2MB).', true);
      } finally {
        posterUploadBtn.disabled = false;
        posterUploadBtn.textContent = 'Upload Poster';
      }
    });

    evSubmitReviewBtn?.addEventListener('click', async () => {
      if (!editingEventId) return;
      evSubmitReviewBtn.disabled = true;
      try {
        await api.patch(`/events/${editingEventId}/submit`, {});
        showInlineMsg(document.getElementById('ev-info-feedback'), 'Event berhasil diajukan ke antrean review Admin!');
        showWizardToast('Event berhasil diajukan ke antrean review Admin! Status kini Menunggu Review.', null);
        await hydrateModalEventDetail(editingEventId);
        await loadOrganizerEvents();
      } catch (err: any) {
        const errMsg = err?.message || 'Gagal mengajukan review event.';
        showInlineMsg(document.getElementById('ev-info-feedback'), errMsg, true);
        showWizardToast(`Gagal ajukan review: ${errMsg}`, null);
      } finally {
        evSubmitReviewBtn.disabled = false;
      }
    });

    function renderModalCategories(detail: any) {
      if (!evCategoriesList) return;
      const cats = Array.isArray(detail.categories) ? detail.categories : [];
      if (cats.length === 0) {
        evCategoriesList.innerHTML = `<p class="text-xs font-mono text-neutral-600 dark:text-muted-gray">Belum ada kategori tiket. Tambahkan di formulir bawah.</p>`;
        return;
      }
      evCategoriesList.innerHTML = cats
        .map(
          (c: any) => `
          <div class="p-4 rounded-2xl bg-neutral-50 dark:bg-void-black/70 border border-neutral-200 dark:border-white/10 flex flex-wrap items-center justify-between gap-3 text-xs">
            <div>
              <strong class="text-neutral-950 dark:text-soft-white text-sm">${escapeHtml(c.nama_kategori)}</strong>
              <span class="block font-mono text-neutral-600 dark:text-muted-gray mt-0.5">
                ${escapeHtml(formatRupiah(c.harga))} • Sisa ${Number(c.kuota_tersedia)} / ${Number(c.kuota_total)} • Komplimen ${Number(c.kuota_komplimen || 0)} • Maks ${Number(c.max_per_transaksi ?? 4)}/akun
              </span>
            </div>
            <div class="flex items-center gap-2">
              <button type="button" data-edit-cat="${c.id}" class="px-3 py-1.5 rounded-lg bg-white dark:bg-white/10 border border-neutral-200 dark:border-transparent text-neutral-800 dark:text-soft-white font-mono text-[11px]">
                Edit
              </button>
              <button type="button" data-del-cat="${c.id}" class="px-3 py-1.5 rounded-lg bg-red-50 dark:bg-red-500/15 border border-red-200 dark:border-red-500/30 text-red-700 dark:text-red-300 font-mono text-[11px]">
                Hapus
              </button>
            </div>
          </div>
        `
        )
        .join('');
    }

    document.getElementById('edit-cat-cancel-btn')?.addEventListener('click', () => {
      editingCategoryId = null;
      evEditCatForm?.classList.add('hidden');
    });

    evCategoriesList?.addEventListener('click', async (e) => {
      const target = e.target as HTMLElement;
      const editBtn = target.closest('[data-edit-cat]') as HTMLButtonElement | null;
      if (editBtn && editingEventDetail) {
        const catId = Number(editBtn.dataset.editCat);
        const cat = (editingEventDetail.categories || []).find((x: any) => Number(x.id) === catId);
        if (!cat) return;
        editingCategoryId = catId;
        const label = document.getElementById('edit-cat-id-label');
        if (label) label.textContent = String(catId);
        (document.getElementById('edit-cat-f-name') as HTMLInputElement).value = cat.nama_kategori || '';
        const priceEl = document.getElementById('edit-cat-f-price') as HTMLInputElement;
        priceEl.value = String(Number(cat.harga || 0));
        const priceLocked = editingEventDetail.status !== 'draft' && editingEventDetail.status !== 'rejected';
        priceEl.disabled = priceLocked;
        document.getElementById('edit-cat-price-lock-note')?.classList.toggle('hidden', !priceLocked);
        (document.getElementById('edit-cat-f-quota') as HTMLInputElement).value = String(Number(cat.kuota_total || 1));
        (document.getElementById('edit-cat-f-compliment') as HTMLInputElement).value = String(Number(cat.kuota_komplimen || 0));
        (document.getElementById('edit-cat-f-max') as HTMLInputElement).value = String(Number(cat.max_per_transaksi ?? 4));
        refreshLivePricePreviews();
        evEditCatForm?.classList.remove('hidden');
        return;
      }

      const btn = target.closest('[data-del-cat]') as HTMLButtonElement | null;
      if (!btn || !editingEventId) return;
      const catId = Number(btn.dataset.delCat);
      if (!confirm('Hapus kategori tiket ini?')) return;
      try {
        await api.delete(`/events/${editingEventId}/categories/${catId}`);
        await hydrateModalEventDetail(editingEventId);
        await loadOrganizerEvents();
      } catch (err: any) {
        showInlineMsg(document.getElementById('cat-feedback'), err?.message || 'Gagal menghapus kategori.', true);
      }
    });

    evEditCatForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!editingEventId || !editingCategoryId) return;
      const fb = document.getElementById('cat-feedback');
      const priceEl = document.getElementById('edit-cat-f-price') as HTMLInputElement;
      const payload: any = {
        nama_kategori: (document.getElementById('edit-cat-f-name') as HTMLInputElement).value.trim(),
        kuota_total: Number((document.getElementById('edit-cat-f-quota') as HTMLInputElement).value),
        kuota_komplimen: Number((document.getElementById('edit-cat-f-compliment') as HTMLInputElement).value || 0),
        max_per_transaksi: Number((document.getElementById('edit-cat-f-max') as HTMLInputElement).value || 4),
      };
      if (!priceEl.disabled) {
        payload.harga = Number(priceEl.value);
      }
      try {
        await api.patch(`/events/${editingEventId}/categories/${editingCategoryId}`, payload);
        editingCategoryId = null;
        evEditCatForm.classList.add('hidden');
        showInlineMsg(fb, 'Kategori tiket berhasil diperbarui!');
        await hydrateModalEventDetail(editingEventId);
        await loadOrganizerEvents();
      } catch (err: any) {
        showInlineMsg(fb, err?.message || 'Gagal memperbarui kategori.', true);
      }
    });

    evAddCatForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!editingEventId) return;
      const submitter = (e as SubmitEvent).submitter as HTMLButtonElement | null;
      const mode = submitter?.dataset.catMode || 'stay';
      const stayBtn = document.getElementById('cat-add-stay-btn') as HTMLButtonElement | null;
      const nextBtn = document.getElementById('cat-add-next-btn') as HTMLButtonElement | null;
      const fb = document.getElementById('cat-feedback');
      const catName = (document.getElementById('cat-f-name') as HTMLInputElement).value.trim();
      if (stayBtn) stayBtn.disabled = true;
      if (nextBtn) nextBtn.disabled = true;
      try {
        await api.post(`/events/${editingEventId}/categories`, {
          nama_kategori: catName,
          harga: Number((document.getElementById('cat-f-price') as HTMLInputElement).value),
          kuota_total: Number((document.getElementById('cat-f-quota') as HTMLInputElement).value),
          kuota_komplimen: Number((document.getElementById('cat-f-compliment') as HTMLInputElement).value || 0),
          max_per_transaksi: Number((document.getElementById('cat-f-max') as HTMLInputElement).value || 4),
        });
        evAddCatForm.reset();
        (document.getElementById('cat-f-compliment') as HTMLInputElement).value = '0';
        (document.getElementById('cat-f-max') as HTMLInputElement).value = '4';
        refreshLivePricePreviews();
        await hydrateModalEventDetail(editingEventId);
        await loadOrganizerEvents();
        if (mode === 'next') {
          activateModalSubtab('vouchers', {
            autoToastFrom: 'categories',
            toastMsg: `Kategori "${catName}" tersimpan! Lanjut atur Voucher Promo atau Ajukan Review.`,
          });
        } else {
          showInlineMsg(fb, `Kategori "${catName}" ditambahkan! Tambah tier lain atau lanjut ke Voucher & Review.`);
          showWizardToast(`Kategori "${catName}" ditambahkan ke tier penjualan.`, null);
        }
      } catch (err: any) {
        showInlineMsg(fb, err?.message || 'Gagal menambah kategori.', true);
      } finally {
        if (stayBtn) stayBtn.disabled = false;
        if (nextBtn) nextBtn.disabled = false;
      }
    });

    async function loadModalVouchers(evId: number) {
      if (!evVouchersList) return;
      try {
        const list = await api.get<any[]>(`/events/${evId}/vouchers`);
        const rows = Array.isArray(list) ? list : [];
        modalVouchersCache = rows;
        if (rows.length === 0) {
          evVouchersList.innerHTML = `<p class="text-xs font-mono text-neutral-600 dark:text-muted-gray">Belum ada voucher diskon untuk event ini.</p>`;
          syncWizardChrome();
          return;
        }
        evVouchersList.innerHTML = rows
          .map((v) => {
            const discText = v.diskon_persen ? `${v.diskon_persen}%` : formatRupiah(v.diskon_nominal || 0);
            const maxCap = Number(v.max_diskon || 0) > 0 ? ` • Maks ${formatRupiah(v.max_diskon)}` : '';
            return `
              <div class="p-4 rounded-2xl bg-neutral-50 dark:bg-void-black/70 border border-neutral-200 dark:border-white/10 flex flex-wrap items-center justify-between gap-3 text-xs font-mono">
                <div>
                  <strong class="text-electric-magenta text-sm">${escapeHtml(v.kode_voucher)}</strong>
                  <span class="ml-2 px-2 py-0.5 rounded text-[10px] ${v.is_active ? 'bg-emerald-50 dark:bg-emerald-500/20 text-emerald-700 dark:text-emerald-300' : 'bg-neutral-200 dark:bg-white/10 text-neutral-600 dark:text-muted-gray'}">${v.is_active ? 'AKTIF' : 'NONAKTIF'}</span>
                  <span class="block text-neutral-600 dark:text-muted-gray mt-1">
                    Potongan: ${escapeHtml(discText)}${escapeHtml(maxCap)} • Terpakai ${Number(v.kuota_terpakai || 0)}/${Number(v.kuota_total)} • s.d. ${escapeHtml(formatDateIndo(v.berlaku_sampai, { showTime: false }))}
                  </span>
                </div>
                <div class="flex items-center gap-2">
                  <button type="button" data-edit-vch="${v.id}" class="px-3 py-1.5 rounded-lg bg-white dark:bg-white/10 border border-neutral-200 dark:border-transparent text-neutral-800 dark:text-soft-white">
                    Edit
                  </button>
                  <button type="button" data-toggle-vch="${v.id}" data-active="${v.is_active ? '1' : '0'}" class="px-3 py-1.5 rounded-lg bg-white dark:bg-white/10 border border-neutral-200 dark:border-transparent text-neutral-800 dark:text-soft-white">
                    ${v.is_active ? 'Nonaktifkan' : 'Aktifkan'}
                  </button>
                  <button type="button" data-del-vch="${v.id}" class="px-3 py-1.5 rounded-lg bg-red-50 dark:bg-red-500/15 text-red-700 dark:text-red-300">
                    Hapus
                  </button>
                </div>
              </div>
            `;
          })
          .join('');
        syncWizardChrome();
      } catch {}
    }

    document.getElementById('edit-vch-cancel-btn')?.addEventListener('click', () => {
      editingVoucherId = null;
      evEditVoucherForm?.classList.add('hidden');
    });

    evVouchersList?.addEventListener('click', async (e) => {
      if (!editingEventId) return;
      const target = e.target as HTMLElement;
      const editBtn = target.closest('[data-edit-vch]') as HTMLButtonElement | null;
      if (editBtn) {
        const vid = Number(editBtn.dataset.editVch);
        const v = modalVouchersCache.find((item) => Number(item.id) === vid);
        if (!v) return;
        editingVoucherId = vid;
        const lbl = document.getElementById('edit-vch-code-label');
        if (lbl) lbl.textContent = String(v.kode_voucher || '');
        (document.getElementById('edit-vch-f-quota') as HTMLInputElement).value = String(Number(v.kuota_total || 1));
        (document.getElementById('edit-vch-f-min') as HTMLInputElement).value = String(Number(v.min_transaksi || 0));
        (document.getElementById('edit-vch-f-max-disc') as HTMLInputElement).value = String(Number(v.max_diskon || 0));
        (document.getElementById('edit-vch-f-end') as HTMLInputElement).value = toLocalInputValue(v.berlaku_sampai);
        evEditVoucherForm?.classList.remove('hidden');
        return;
      }

      const toggleBtn = target.closest('[data-toggle-vch]') as HTMLButtonElement | null;
      if (toggleBtn) {
        const vid = Number(toggleBtn.dataset.toggleVch);
        const curActive = toggleBtn.dataset.active === '1';
        try {
          await api.patch(`/events/${editingEventId}/vouchers/${vid}`, { is_active: !curActive });
          await loadModalVouchers(editingEventId);
        } catch (err: any) {
          showInlineMsg(document.getElementById('vch-feedback'), err?.message || 'Gagal update voucher.', true);
        }
        return;
      }

      const delBtn = target.closest('[data-del-vch]') as HTMLButtonElement | null;
      if (delBtn) {
        const vid = Number(delBtn.dataset.delVch);
        if (!confirm('Hapus voucher ini? (Hanya bisa dihapus bila pemakaian 0)')) return;
        try {
          await api.delete(`/events/${editingEventId}/vouchers/${vid}`);
          await loadModalVouchers(editingEventId);
        } catch (err: any) {
          showInlineMsg(document.getElementById('vch-feedback'), err?.message || 'Gagal menghapus voucher.', true);
        }
      }
    });

    evEditVoucherForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!editingEventId || !editingVoucherId) return;
      const fb = document.getElementById('vch-feedback');
      const endVal = (document.getElementById('edit-vch-f-end') as HTMLInputElement).value;
      try {
        await api.patch(`/events/${editingEventId}/vouchers/${editingVoucherId}`, {
          kuota_total: Number((document.getElementById('edit-vch-f-quota') as HTMLInputElement).value),
          min_transaksi: Number((document.getElementById('edit-vch-f-min') as HTMLInputElement).value || 0),
          max_diskon: Number((document.getElementById('edit-vch-f-max-disc') as HTMLInputElement).value || 0),
          berlaku_sampai: new Date(endVal).toISOString(),
        });
        editingVoucherId = null;
        evEditVoucherForm.classList.add('hidden');
        showInlineMsg(fb, 'Voucher berhasil diperbarui!');
        await loadModalVouchers(editingEventId);
      } catch (err: any) {
        showInlineMsg(fb, err?.message || 'Gagal memperbarui voucher.', true);
      }
    });

    evAddVoucherForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!editingEventId) return;
      const fb = document.getElementById('vch-feedback');
      const vType = (document.getElementById('vch-f-type') as HTMLSelectElement).value;
      const vVal = Number((document.getElementById('vch-f-val') as HTMLInputElement).value);
      const maxDiscVal = Number((document.getElementById('vch-f-max-disc') as HTMLInputElement).value || 0);
      const startVal = (document.getElementById('vch-f-start') as HTMLInputElement).value;
      const endVal = (document.getElementById('vch-f-end') as HTMLInputElement).value;

      try {
        await api.post(`/events/${editingEventId}/vouchers`, {
          kode_voucher: (document.getElementById('vch-f-code') as HTMLInputElement).value.trim().toUpperCase(),
          ...(vType === 'persen' ? { diskon_persen: vVal } : { diskon_nominal: vVal }),
          kuota_total: Number((document.getElementById('vch-f-quota') as HTMLInputElement).value),
          min_transaksi: Number((document.getElementById('vch-f-min') as HTMLInputElement).value || 0),
          ...(maxDiscVal > 0 ? { max_diskon: maxDiscVal } : {}),
          berlaku_mulai: new Date(startVal).toISOString(),
          berlaku_sampai: new Date(endVal).toISOString(),
        });
        evAddVoucherForm.reset();
        (document.getElementById('vch-f-quota') as HTMLInputElement).value = '50';
        (document.getElementById('vch-f-min') as HTMLInputElement).value = '0';
        applyDefaultVoucherDates();
        refreshLivePricePreviews();
        showInlineMsg(fb, 'Voucher diskon berhasil dibuat!');
        await loadModalVouchers(editingEventId);
        showWizardToast('Voucher promo ditambahkan! Klik "Ajukan Review ke Admin ✓" bila event siap.', null);
      } catch (err: any) {
        showInlineMsg(fb, err?.message || 'Gagal membuat voucher.', true);
      }
    });

    // TAB 4: GATE & ATTENDANCE
    function paintGatePinUi() {
      if (!gateCurrentPinEl || !gateTogglePinBtn) return;
      if (!currentGatePinValue) {
        gateCurrentPinEl.textContent = '(Belum diatur / Default)';
        gateTogglePinBtn.classList.add('hidden');
        return;
      }
      gateTogglePinBtn.classList.remove('hidden');
      gateCurrentPinEl.textContent = isGatePinVisible ? currentGatePinValue : '••••••';
      gateTogglePinBtn.textContent = isGatePinVisible ? 'Sembunyikan' : 'Tampilkan';
    }

    gateTogglePinBtn?.addEventListener('click', () => {
      isGatePinVisible = !isGatePinVisible;
      paintGatePinUi();
    });

    gatePinForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const evId = Number(gateEventSelect?.value || 0);
      const nextPin = gateNewPinInput?.value.trim() || '';
      if (!evId || nextPin.length < 4) return;
      const saveBtn = document.getElementById('gate-pin-save-btn') as HTMLButtonElement | null;
      if (saveBtn) saveBtn.disabled = true;
      try {
        await api.patch(`/events/${evId}`, { scanner_pin: nextPin });
        currentGatePinValue = nextPin;
        isGatePinVisible = true;
        paintGatePinUi();
        if (gateNewPinInput) gateNewPinInput.value = '';
        showInlineMsg(gatePinFeedback, `PIN Gate Scanner Event #${evId} diperbarui!`);
      } catch (err: any) {
        showInlineMsg(gatePinFeedback, err?.message || 'Gagal memperbarui PIN Gate.', true);
      } finally {
        if (saveBtn) saveBtn.disabled = false;
      }
    });

    async function loadGateTab() {
      if (!gateEventSelect) return;
      try {
        const events = await api.get<any[]>('/events');
        if (isDisposed) return;
        const rows = Array.isArray(events) ? events : [];
        if (rows.length === 0) {
          gateEventSelect.innerHTML = `<option value="">Belum ada konser</option>`;
          currentGatePinValue = '';
          paintGatePinUi();
          return;
        }
        gateEventSelect.innerHTML = rows
          .map((ev) => `<option value="${ev.id}">#${ev.id} — ${escapeHtml(ev.nama_event)} (${escapeHtml(ev.status)})</option>`)
          .join('');
        await renderGateAttendance(Number(gateEventSelect.value));
      } catch {}
    }

    async function renderGateAttendance(evId: number) {
      if (!evId || !gateAttendanceBox) return;
      if (gateScannerLink) gateScannerLink.href = `/scanner?event_id=${evId}`;
      gatePinFeedback?.classList.add('hidden');
      try {
        const [data, evDetail] = await Promise.all([
          api.get<any>(`/organizer/events/${evId}/attendance`),
          api.get<any>(`/events/${evId}`).catch(() => null),
        ]);
        if (isDisposed) return;
        currentGatePinValue = evDetail?.scanner_pin || '';
        isGatePinVisible = false;
        paintGatePinUi();

        const s = data.summary || {};
        const breakdown = Array.isArray(data.gate_breakdown) ? data.gate_breakdown : [];
        const checkins = Array.isArray(data.recent_checkins) ? data.recent_checkins : [];
        const totalScannedForBars = Math.max(1, breakdown.reduce((acc: number, g: any) => acc + Number(g.count || 0), 0));

        const breakdownHtml =
          breakdown.length === 0
            ? `<p class="text-xs font-mono text-neutral-500 dark:text-muted-gray">Belum ada log masuk per gate untuk event ini.</p>`
            : breakdown
                .map((g: any) => {
                  const pct = Math.min(100, Math.round((Number(g.count || 0) / totalScannedForBars) * 100));
                  return `
                  <div class="space-y-1">
                    <div class="flex justify-between text-[11px] font-mono">
                      <span class="text-neutral-900 dark:text-soft-white font-bold">${escapeHtml(g.gate || 'Main Gate')}</span>
                      <span class="text-electric-magenta">${Number(g.count || 0)} tiket (${pct}%)</span>
                    </div>
                    <div class="w-full h-2 rounded-full bg-neutral-200 dark:bg-void-black overflow-hidden">
                      <div class="h-full bg-electric-magenta rounded-full" style="width: ${pct}%;"></div>
                    </div>
                  </div>
                `;
                })
                .join('');

        gateAttendanceBox.innerHTML = `
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
            <div class="p-4 rounded-2xl bg-neutral-50 dark:bg-void-black/70 border border-neutral-200 dark:border-white/10">
              <span class="text-[10px] font-mono text-neutral-500 dark:text-muted-gray block">TOTAL TIKET</span>
              <strong class="font-display text-3xl text-neutral-950 dark:text-soft-white">${Number(s.total_tickets || 0)}</strong>
            </div>
            <div class="p-4 rounded-2xl bg-neutral-50 dark:bg-void-black/70 border border-neutral-200 dark:border-white/10">
              <span class="text-[10px] font-mono text-neutral-500 dark:text-muted-gray block">CHECK-IN</span>
              <strong class="font-display text-3xl text-emerald-600 dark:text-emerald-400">${Number(s.checked_in || 0)}</strong>
            </div>
            <div class="p-4 rounded-2xl bg-neutral-50 dark:bg-void-black/70 border border-neutral-200 dark:border-white/10">
              <span class="text-[10px] font-mono text-neutral-500 dark:text-muted-gray block">BELUM MASUK</span>
              <strong class="font-display text-3xl text-neutral-950 dark:text-soft-white">${Number(s.remaining || 0)}</strong>
            </div>
            <div class="p-4 rounded-2xl bg-neutral-50 dark:bg-void-black/70 border border-neutral-200 dark:border-white/10">
              <span class="text-[10px] font-mono text-neutral-500 dark:text-muted-gray block">KEHADIRAN</span>
              <strong class="font-display text-3xl text-electric-magenta">${Number(s.checkin_percentage || 0)}%</strong>
            </div>
          </div>

          <div class="p-4 rounded-2xl bg-neutral-50 dark:bg-void-black/50 border border-neutral-200 dark:border-white/10 space-y-3">
            <span class="text-[10px] font-mono uppercase tracking-wider text-electric-magenta font-bold block">DISTRIBUSI CHECK-IN PER GATE PINTU</span>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
              ${breakdownHtml}
            </div>
          </div>

          <div class="overflow-x-auto pt-2">
            <table class="w-full text-xs font-mono">
              <thead>
                <tr class="text-left text-neutral-500 dark:text-muted-gray border-b border-neutral-200 dark:border-white/10">
                  <th class="pb-2">WAKTU</th>
                  <th class="pb-2">KODE TIKET</th>
                  <th class="pb-2">PEMEGANG</th>
                  <th class="pb-2">KATEGORI</th>
                  <th class="pb-2">GATE</th>
                  <th class="pb-2">PETUGAS</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-neutral-200 dark:divide-white/5">
                ${checkins.length === 0
                  ? `<tr><td colspan="6" class="py-5 text-center text-neutral-500 dark:text-muted-gray">Belum ada penonton yang dipindai pada konser ini.</td></tr>`
                  : checkins.map((c: any) => `
                    <tr>
                      <td class="py-2.5 text-neutral-600 dark:text-muted-gray">${escapeHtml(formatDateIndo(c.scanned_at))}</td>
                      <td class="py-2.5 text-neutral-950 dark:text-soft-white font-bold">${escapeHtml(c.ticket_code)}</td>
                      <td class="py-2.5 text-neutral-950 dark:text-soft-white">${escapeHtml(c.owner_name)}</td>
                      <td class="py-2.5 text-electric-magenta">${escapeHtml(c.nama_kategori)}</td>
                      <td class="py-2.5 text-neutral-600 dark:text-muted-gray">${escapeHtml(c.gate || 'Main Gate')}</td>
                      <td class="py-2.5 text-neutral-700 dark:text-soft-white">${escapeHtml(c.scanned_by_name || '-')}</td>
                    </tr>
                  `).join('')}
              </tbody>
            </table>
          </div>
        `;
      } catch (err: any) {
        gateAttendanceBox.innerHTML = `<p class="text-xs font-mono text-red-700 dark:text-red-300">${escapeHtml(err?.message || 'Gagal memuat absensi gate.')}</p>`;
      }
    }

    gateEventSelect?.addEventListener('change', () => renderGateAttendance(Number(gateEventSelect.value)));
    gateExportBtn?.addEventListener('click', async () => {
      const evId = Number(gateEventSelect?.value || 0);
      if (!evId) return;
      gateExportBtn.disabled = true;
      try {
        await api.downloadBlob(`/organizer/events/${evId}/export-csv?type=attendance`, `attendance-event-${evId}.csv`);
      } catch (err: any) {
        alert(err?.message || 'Gagal mengunduh CSV kehadiran.');
      } finally {
        gateExportBtn.disabled = false;
      }
    });
    const gateExportSalesBtn = document.getElementById('gate-export-sales-btn') as HTMLButtonElement | null;
    gateExportSalesBtn?.addEventListener('click', async () => {
      const evId = Number(gateEventSelect?.value || 0);
      if (!evId) return;
      gateExportSalesBtn.disabled = true;
      try {
        await api.downloadBlob(`/organizer/events/${evId}/export-csv?type=sales`, `sales-event-${evId}.csv`);
      } catch (err: any) {
        alert(err?.message || 'Gagal mengunduh CSV penjualan.');
      } finally {
        gateExportSalesBtn.disabled = false;
      }
    });

    // TAB 5: FINANCE & PAYOUTS
    function updatePayoutEventHint() {
      if (!payoutEventSelect || !payoutEventHint || !payoutSubmitBtn) return;
      const evId = Number(payoutEventSelect.value || 0);
      const fin = eventFinancialsMap.get(evId);
      if (!fin) {
        payoutEventHint.classList.add('hidden');
        payoutSubmitBtn.disabled = currentBankCooldown;
        return;
      }
      const avail = Number(fin.payout_available || 0);
      const eligible = Boolean(fin.is_payout_eligible);
      payoutEventHint.classList.remove('hidden');
      if (!eligible) {
        payoutEventHint.innerHTML = `
          <span class="text-amber-700 dark:text-amber-300">Status event "${escapeHtml(fin.status)}" belum dirilis escrow H+1. Payout terbuka setelah konser selesai & settle.</span>
        `;
        payoutSubmitBtn.disabled = true;
      } else {
        payoutEventHint.innerHTML = `
          <span class="text-neutral-700 dark:text-soft-white">Dana siap cair untuk event ini: <strong class="text-emerald-600 dark:text-emerald-400">${escapeHtml(formatRupiah(avail))}</strong></span>
          ${avail >= 50000 ? `<button type="button" id="payout-fill-max-btn" class="px-2.5 py-1 rounded-lg bg-electric-magenta/10 text-electric-magenta font-bold hover:bg-electric-magenta hover:text-white transition-colors">Isi Maksimal</button>` : ''}
        `;
        document.getElementById('payout-fill-max-btn')?.addEventListener('click', () => {
          if (payoutAmountInput) payoutAmountInput.value = String(Math.floor(avail));
        });
        payoutSubmitBtn.disabled = currentBankCooldown || avail < 50000;
      }
    }

    payoutEventSelect?.addEventListener('change', updatePayoutEventHint);

    async function loadFinanceTab() {
      try {
        const [profile, bal, events, payouts, dash] = await Promise.all([
          api.get<any>('/organizer/me'),
          api.get<any>('/organizer/balance'),
          api.get<any[]>('/events'),
          api.get<any[]>('/organizer/payouts'),
          api.get<any>('/organizer/dashboard').catch(() => null),
        ]);
        if (isDisposed) return;

        if (finWithdrawable) finWithdrawable.textContent = formatRupiah(bal?.withdrawable_balance || 0);
        if (finPending) finPending.textContent = formatRupiah(bal?.pending_balance || 0);
        if (finWithdrawnTotal) finWithdrawnTotal.textContent = formatRupiah(bal?.withdrawn_amount || 0);

        if (finBankName) finBankName.textContent = profile?.bank_account || '-';
        if (finAccNumber) finAccNumber.textContent = profile?.account_number || '-';
        (document.getElementById('update-org-name') as HTMLInputElement).value = profile?.organization_name || '';
        (document.getElementById('update-bank-name') as HTMLInputElement).value = profile?.bank_account || '';
        (document.getElementById('update-acc-number') as HTMLInputElement).value = profile?.account_number || '';

        const cooldown = profile?.bank_cooldown;
        currentBankCooldown = Boolean(cooldown?.in_cooldown);
        if (currentBankCooldown && finCooldownBanner && payoutSubmitBtn) {
          finCooldownBanner.textContent = `Keamanan Akun Aktif: Penarikan dana dikunci sementara selama ${cooldown.hours_remaining} jam setelah perubahan rekening terakhir.`;
          finCooldownBanner.classList.remove('hidden');
          payoutSubmitBtn.disabled = true;
        } else {
          finCooldownBanner?.classList.add('hidden');
          if (payoutSubmitBtn) payoutSubmitBtn.disabled = false;
        }

        eventFinancialsMap.clear();
        const financials = Array.isArray(dash?.event_financials) ? dash.event_financials : [];
        financials.forEach((ef: any) => eventFinancialsMap.set(Number(ef.event_id), ef));

        if (payoutEventSelect) {
          const evOptionsSource = financials.length > 0 ? financials : Array.isArray(events) ? events : [];
          payoutEventSelect.innerHTML =
            evOptionsSource.length === 0
              ? `<option value="">Belum ada event</option>`
              : evOptionsSource
                  .map((ev: any) => {
                    const id = ev.event_id ?? ev.id;
                    const availStr = ev.payout_available !== undefined ? ` • Tersedia ${formatRupiah(ev.payout_available)}` : '';
                    return `<option value="${id}">#${id} — ${escapeHtml(ev.nama_event)} (${escapeHtml(ev.status)})${escapeHtml(availStr)}</option>`;
                  })
                  .join('');
          updatePayoutEventHint();
        }

        if (payoutHistoryTbody) {
          const rows = Array.isArray(payouts) ? payouts : [];
          payoutHistoryTbody.innerHTML =
            rows.length === 0
              ? `<tr><td colspan="5" class="py-6 text-center text-neutral-500 dark:text-muted-gray">Belum ada riwayat penarikan dana.</td></tr>`
              : rows
                  .map(
                    (p: any) => `
                  <tr>
                    <td class="py-3 text-neutral-600 dark:text-muted-gray">${escapeHtml(formatDateIndo(p.created_at))}</td>
                    <td class="py-3 text-neutral-950 dark:text-soft-white">${escapeHtml(p.nama_event || `Event #${p.event_id}`)}</td>
                    <td class="py-3 font-bold text-neutral-950 dark:text-soft-white">${escapeHtml(formatRupiah(p.amount))}</td>
                    <td class="py-3 uppercase font-bold ${p.status === 'completed' ? 'text-emerald-600 dark:text-emerald-400' : p.status === 'failed' ? 'text-red-600 dark:text-red-400' : 'text-amber-600 dark:text-amber-300'}">${escapeHtml(p.status)}</td>
                    <td class="py-3 text-neutral-600 dark:text-muted-gray">${escapeHtml(p.rejection_reason || p.reference_code || '-')}</td>
                  </tr>
                `
                  )
                  .join('');
        }
      } catch (err: any) {
        showInlineMsg(document.getElementById('payout-feedback'), err?.message || 'Gagal memuat data keuangan organizer.', true);
      }
    }

    payoutForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!payoutSubmitBtn) return;
      payoutSubmitBtn.disabled = true;
      const fb = document.getElementById('payout-feedback');
      try {
        await api.post(
          '/organizer/payouts',
          {
            event_id: Number(payoutEventSelect?.value || 0),
            amount: Number(payoutAmountInput?.value || 0),
            idempotency_key: payoutIdempotencyKey,
          },
          { idempotencyKey: payoutIdempotencyKey }
        );
        payoutIdempotencyKey = crypto.randomUUID();
        if (payoutAmountInput) payoutAmountInput.value = '';
        showInlineMsg(fb, 'Permintaan payout dikirim ke antrean persetujuan Admin!');
        await loadFinanceTab();
      } catch (err: any) {
        showInlineMsg(fb, err?.message || 'Gagal mengajukan penarikan dana.', true);
      } finally {
        payoutSubmitBtn.disabled = false;
      }
    });

    document.getElementById('org-profile-update-form')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const btn = document.getElementById('org-profile-save-btn') as HTMLButtonElement | null;
      const fb = document.getElementById('org-profile-feedback');
      const orgName = (document.getElementById('update-org-name') as HTMLInputElement).value.trim();
      if (!orgName || orgName.length < 3) return;
      if (btn) btn.disabled = true;
      try {
        await api.patch('/organizer/me', { organization_name: orgName });
        const titleEl = document.getElementById('studio-org-title');
        if (titleEl) titleEl.textContent = orgName;
        showInlineMsg(fb, 'Nama organisasi promotor berhasil diperbarui!');
      } catch (err: any) {
        showInlineMsg(fb, err?.message || 'Gagal memperbarui profil organisasi.', true);
      } finally {
        if (btn) btn.disabled = false;
      }
    });

    bankUpdateForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!confirm('Mengubah rekening bank akan membekukan fitur penarikan dana selama 48 jam demi keamanan. Lanjutkan?')) return;
      const btn = document.getElementById('bank-update-btn') as HTMLButtonElement | null;
      const fb = document.getElementById('bank-update-feedback');
      if (btn) btn.disabled = true;
      try {
        await api.put('/organizer/bank-account', {
          bank_account: (document.getElementById('update-bank-name') as HTMLInputElement).value.trim(),
          account_number: (document.getElementById('update-acc-number') as HTMLInputElement).value.trim(),
        });
        showInlineMsg(fb, 'Rekening bank diperbarui. Cooldown keamanan 48 jam aktif.');
        await loadFinanceTab();
      } catch (err: any) {
        showInlineMsg(fb, err?.message || 'Gagal memperbarui rekening bank.', true);
      } finally {
        if (btn) btn.disabled = false;
      }
    });

    const onAuthChanged = () => bootstrapOrganizer();
    window.addEventListener('afterglow-auth-changed', onAuthChanged);
    bootstrapOrganizer();

    return () => {
      isDisposed = true;
      window.removeEventListener('afterglow-auth-changed', onAuthChanged);
      document.removeEventListener('keydown', onEscClose);
      venueMap.destroy();
    };
  }

  let orgCleanup: (() => void) | undefined;
  document.addEventListener('astro:before-swap', () => {
    if (orgCleanup) {
      orgCleanup();
      orgCleanup = undefined;
    }
  });
  document.addEventListener('astro:page-load', () => {
    if (orgCleanup) orgCleanup();
    orgCleanup = initOrganizerStudio();
  });
</script>
