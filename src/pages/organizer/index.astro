---
import RootLayout from '../../layouts/RootLayout.astro';
import Footer from '../../components/landing/Footer.astro';
---

<RootLayout 
  title="Create & Manage Concerts — AFTERGLOW Organizer" 
  description="Daftarkan event konser Anda di AFTERGLOW. Dapatkan sistem ticketing berkecepatan tinggi, proteksi calo, analitik realtime, dan dana aman."
>
  <div class="pt-32 pb-24 px-6 lg:px-12 max-w-6xl mx-auto w-full">
    <div class="p-10 md:p-16 rounded-3xl bg-dark-plum/70 border border-white/10 backdrop-blur-xl relative overflow-hidden">
      <!-- Glow accent -->
      <div class="absolute -right-20 -top-20 w-80 h-80 rounded-full bg-electric-magenta/20 blur-3xl pointer-events-none"></div>

      <div class="relative z-10 max-w-2xl">
        <span class="text-xs font-bold tracking-[0.25em] text-electric-magenta uppercase block mb-3">
          PROMOTER CONSOLE
        </span>
        <h1 class="font-display text-5xl sm:text-7xl text-soft-white tracking-wide mb-6">
          LAUNCH YOUR CONCERT ON AFTERGLOW.
        </h1>
        <p class="text-muted-gray text-base sm:text-lg leading-relaxed mb-8">
          Kekuatan arsitektur Bun + Redis siap mengawal war tiket puluhan ribu penonton tanpa downtime. Dashboard analitik realtime, verifikasi gate scanner, dan pencairan dana transparan.
        </p>

        <div class="flex flex-col sm:flex-row items-center gap-4">
          <button class="w-full sm:w-auto px-8 py-4 rounded-full bg-electric-magenta text-soft-white font-semibold text-sm tracking-wide hover:shadow-magenta-glow transition-all hover:scale-105 active:scale-95">
            MULAI BUAT EVENT
          </button>
          <a href="/#contact" class="w-full sm:w-auto px-8 py-4 rounded-full border border-white/20 text-soft-white font-medium text-sm tracking-wide hover:bg-white/5 text-center transition-colors">
            KONSULTASI TIM PROMOTOR
          </a>
        </div>
      </div>
    </div>
  </div>

  <Footer />
</RootLayout>
