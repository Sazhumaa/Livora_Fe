---
import RootLayout from '../layouts/RootLayout.astro';
import Footer from '../components/landing/Footer.astro';

Astro.response.status = 404;
---

<RootLayout title="Halaman Tidak Ditemukan (404) — AFTERGLOW" description="Panggung atau tautan konser yang kamu cari tidak ditemukan di AFTERGLOW.">
  <main class="relative min-h-[82vh] flex items-center justify-center px-6 pt-28 pb-20 overflow-hidden">
    <div class="absolute top-1/3 left-1/2 -translate-x-1/2 w-[520px] h-[520px] bg-electric-magenta/15 dark:bg-electric-magenta/20 rounded-full blur-[160px] pointer-events-none"></div>

    <div class="relative z-10 max-w-2xl w-full text-center space-y-6">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-electric-magenta/10 border border-electric-magenta/30 text-electric-magenta font-mono text-xs font-bold uppercase tracking-widest">
        <span class="w-2 h-2 rounded-full bg-electric-magenta animate-ping"></span>
        <span data-i18n="error404.badge">ERROR 404 // PANGGUNG KOSONG</span>
      </div>

      <h1 class="font-display text-7xl sm:text-8xl md:text-9xl text-neutral-950 dark:text-soft-white tracking-wider leading-none select-none">
        4<span class="text-electric-magenta">0</span>4
      </h1>

      <h2 data-i18n="error404.title" class="font-display text-3xl sm:text-4xl text-neutral-900 dark:text-soft-white tracking-wide">
        LAMPU PANGGUNG PADAM DI SINI
      </h2>

      <p data-i18n="error404.desc" class="text-sm sm:text-base text-neutral-600 dark:text-muted-gray max-w-lg mx-auto leading-relaxed">
        Tautan konser atau halaman yang kamu tuju sudah dipindahkan, berakhir, atau salah ketik. Tenang—panggung utama masih ramai dan tiket resmi menunggumu.
      </p>

      <div class="flex flex-wrap items-center justify-center gap-4 pt-4">
        <a
          href="/events"
          data-i18n="error404.ctaEvents"
          class="px-7 py-3.5 rounded-full bg-electric-magenta text-white font-bold text-sm uppercase tracking-wider shadow-magenta-glow hover:bg-electric-magenta/90 transition-all"
        >
          Jelajahi Konser Aktif →
        </a>
        <a
          href="/"
          data-i18n="error404.ctaHome"
          class="px-7 py-3.5 rounded-full border border-neutral-300 dark:border-white/20 text-neutral-800 dark:text-soft-white hover:border-electric-magenta/60 font-semibold text-sm uppercase tracking-wider transition-all"
        >
          Kembali ke Beranda
        </a>
      </div>
    </div>
  </main>
  <Footer />
</RootLayout>
