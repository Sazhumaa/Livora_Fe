---
import RootLayout from '../../layouts/RootLayout.astro';
import Footer from '../../components/landing/Footer.astro';
---

<RootLayout 
  title="Kru Gate Scanner // Pemindaian Tiket Masuk — AFTERGLOW" 
  description="Antarmuka validasi tiket konser di pintu gerbang venue dengan proteksi anti-double scan."
>
  <div class="relative pt-28 pb-24 px-4 sm:px-6 lg:px-12 max-w-4xl mx-auto w-full">
    
    <!-- Top Header -->
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-6 mb-10">
      <div>
        <span class="text-xs font-mono font-bold tracking-[0.25em] text-electric-magenta uppercase block mb-2">
          KRU GATE // VALIDATOR PEMINDAI
        </span>
        <h1 class="font-display text-4xl sm:text-6xl text-soft-white tracking-wide">
          GATE SCANNER ARENA
        </h1>
        <p class="text-sm text-muted-gray mt-1">
          Validasi tiket konser resmi di pintu gerbang. Proteksi anti-double scan & anti cross-event aktif.
        </p>
      </div>

      <!-- Quick PIN & Gate Settings -->
      <div class="flex items-center gap-3 p-3 rounded-2xl bg-dark-plum border border-white/10 shrink-0 text-xs font-mono">
        <div>
          <span class="text-muted-gray block text-[10px]">SCANNER PIN:</span>
          <strong id="scanner-pin-display" class="text-electric-magenta">888999</strong>
        </div>
        <div class="h-6 w-px bg-white/10"></div>
        <div>
          <span class="text-muted-gray block text-[10px]">PINTU GATE:</span>
          <strong id="scanner-gate-display" class="text-soft-white">VIP Gate 1</strong>
        </div>
      </div>
    </div>

    <!-- Scanner Interactive Console Card -->
    <div class="rounded-3xl bg-dark-plum/90 border border-white/15 p-6 sm:p-10 shadow-2xl backdrop-blur-2xl space-y-8">
      
      <!-- Input Mode Form -->
      <form id="scanner-form" class="space-y-4">
        <div>
          <label for="scanner-ticket-input" class="block text-xs font-mono font-bold uppercase tracking-wider text-muted-gray mb-2">
            Arahkan Scanner Barcode atau Ketik Kode Tiket
          </label>
          <div class="relative">
            <input 
              type="text" 
              id="scanner-ticket-input" 
              placeholder="Scan barcode atau ketik TKT-..." 
              autocomplete="off"
              required 
              class="w-full px-5 py-4 pl-12 rounded-2xl bg-void-black/80 border border-white/20 text-base sm:text-lg font-mono text-soft-white placeholder-muted-gray/50 focus:outline-none focus:border-electric-magenta focus:ring-2 focus:ring-electric-magenta/40 focus:shadow-magenta-glow transition-all"
              autofocus 
            />
            <svg class="w-6 h-6 text-muted-gray absolute left-4 top-1/2 -translate-y-1/2 pointer-events-none" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v1m6 11h2m-6 0h-2v4m0-11v3m0 0h.01M12 12h4.01M16 20h4M4 12h4m12 0h.01M5 8h2a1 1 0 001-1V5a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1zm12 0h2a1 1 0 001-1V5a1 1 0 00-1-1h-2a1 1 0 00-1 1v2a1 1 0 001 1zM5 20h2a1 1 0 001-1v-2a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1z" />
            </svg>
          </div>
        </div>

        <div class="flex flex-col sm:flex-row items-center justify-between gap-3">
          <div class="flex items-center gap-2 text-xs font-mono text-muted-gray">
            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
            <span>Scanner Siap Memindai Otomatis</span>
          </div>

          <button 
            type="submit" 
            id="scanner-submit-btn" 
            class="w-full sm:w-auto px-8 py-3.5 rounded-xl bg-electric-magenta text-soft-white font-bold text-xs uppercase tracking-wider hover:shadow-magenta-glow transition-all hover:scale-105 active:scale-95"
          >
            VALIDASI TIKET (ENTER)
          </button>
        </div>
      </form>

      <!-- Scan Feedback Result Display Box -->
      <div id="scan-result-box" class="hidden p-6 sm:p-8 rounded-2xl border transition-all duration-300">
        <div class="flex items-start gap-4">
          <div id="scan-result-icon-disc" class="w-14 h-14 rounded-2xl flex items-center justify-center shrink-0 shadow-lg">
            <!-- Icon injected dynamically -->
          </div>
          <div class="space-y-1 flex-1">
            <span id="scan-result-status-tag" class="text-xs font-mono font-bold tracking-widest uppercase block"></span>
            <h2 id="scan-result-title" class="font-display text-3xl sm:text-4xl text-soft-white"></h2>
            <p id="scan-result-desc" class="text-xs sm:text-sm text-muted-gray"></p>
            <div id="scan-result-meta" class="pt-2 flex flex-wrap gap-4 text-xs font-mono"></div>
          </div>
        </div>
      </div>

      <!-- Recent Scan Logs Table -->
      <div class="pt-6 border-t border-white/10">
        <div class="flex items-center justify-between mb-4">
          <h3 class="font-display text-xl text-soft-white">RIWAYAT 10 SCAN TERAKHIR</h3>
          <span class="text-xs font-mono text-muted-gray">Gate: VIP Gate 1</span>
        </div>

        <div class="overflow-x-auto">
          <table class="w-full text-xs font-mono">
            <thead>
              <tr class="text-muted-gray border-b border-white/10 text-left">
                <th class="pb-2">WAKTU</th>
                <th class="pb-2">KODE TIKET</th>
                <th class="pb-2">STATUS</th>
                <th class="pb-2 text-right">CATATAN</th>
              </tr>
            </thead>
            <tbody id="scan-history-tbody" class="divide-y divide-white/5">
              <tr>
                <td colspan="4" class="py-4 text-center text-muted-gray">Belum ada aktivitas pemindaian.</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

    </div>

  </div>

  <Footer />
</RootLayout>

<script>
  import { api } from '../../lib/api';
  import { isAuthenticated } from '../../lib/auth';

  function initScannerPage() {
    const form = document.getElementById('scanner-form') as HTMLFormElement;
    const input = document.getElementById('scanner-ticket-input') as HTMLInputElement;
    const submitBtn = document.getElementById('scanner-submit-btn') as HTMLButtonElement;
    const resultBox = document.getElementById('scan-result-box');
    const resultIconDisc = document.getElementById('scan-result-icon-disc');
    const resultStatusTag = document.getElementById('scan-result-status-tag');
    const resultTitle = document.getElementById('scan-result-title');
    const resultDesc = document.getElementById('scan-result-desc');
    const resultMeta = document.getElementById('scan-result-meta');
    const historyTbody = document.getElementById('scan-history-tbody');

    const historyItems: any[] = [];
    const scannerPin = '888999';
    const gateName = 'VIP Gate 1';
    const eventId = 1; // Default demo event

    if (!form || !input) return;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const code = input.value.trim();
      if (!code) return;

      submitBtn.disabled = true;

      try {
        const res = await api.post('/tickets/scan', {
          event_id: eventId,
          ticket_code: code,
          scanner_pin: scannerPin,
          gate: gateName,
          device_info: navigator.userAgent
        });

        // 🟢 VALID TICKET
        showScanResult(true, {
          title: 'TIKET VALID // SILAKAN MASUK',
          desc: `Pemegang tiket terverifikasi sah. Silakan beri gelang kategori ${res.category_name || 'VIP PANGGUNG'}.`,
          owner: res.owner_name || 'Penonton',
          category: res.category_name || 'VIP PANGGUNG',
          code: code
        });

        addHistory(code, 'VALID', res.category_name || 'VIP PANGGUNG');
      } catch (err: any) {
        // 🔴 INVALID TICKET
        const errMsg = err.message || 'Tiket tidak valid atau barcode salah.';
        showScanResult(false, {
          title: 'TIKET TIDAK VALID // DITOLAK',
          desc: errMsg,
          code: code
        });

        addHistory(code, 'INVALID', errMsg);
      } finally {
        submitBtn.disabled = false;
        input.value = '';
        input.focus();
      }
    });

    function showScanResult(isValid: boolean, data: any) {
      if (!resultBox || !resultIconDisc || !resultStatusTag || !resultTitle || !resultDesc || !resultMeta) return;

      resultBox.classList.remove('hidden');

      if (isValid) {
        resultBox.className = 'p-6 sm:p-8 rounded-2xl border transition-all duration-300 bg-emerald-950/40 border-emerald-500/60 shadow-lg';
        resultIconDisc.className = 'w-14 h-14 rounded-2xl flex items-center justify-center shrink-0 shadow-lg bg-emerald-500 text-white';
        resultIconDisc.innerHTML = `
          <svg class="w-8 h-8" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
          </svg>
        `;
        resultStatusTag.textContent = 'STATUS: BERHASIL DIVERIFIKASI (200 OK)';
        resultStatusTag.className = 'text-xs font-mono font-bold tracking-widest uppercase block text-emerald-400';
        resultTitle.textContent = data.title;
        resultDesc.textContent = data.desc;
        resultMeta.innerHTML = `
          <span class="text-soft-white">Pemilik: <strong>${data.owner}</strong></span>
          <span class="text-soft-white">Kategori: <strong>${data.category}</strong></span>
          <span class="text-muted-gray">Kode: ${data.code}</span>
        `;
      } else {
        resultBox.className = 'p-6 sm:p-8 rounded-2xl border transition-all duration-300 bg-red-950/40 border-red-500/60 shadow-lg';
        resultIconDisc.className = 'w-14 h-14 rounded-2xl flex items-center justify-center shrink-0 shadow-lg bg-red-600 text-white';
        resultIconDisc.innerHTML = `
          <svg class="w-8 h-8" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        `;
        resultStatusTag.textContent = 'STATUS: AKSES DITOLAK (REJECTED)';
        resultStatusTag.className = 'text-xs font-mono font-bold tracking-widest uppercase block text-red-400';
        resultTitle.textContent = data.title;
        resultDesc.textContent = data.desc;
        resultMeta.innerHTML = `
          <span class="text-red-300">Peringatan: Verifikasi identitas fisik penonton secara manual.</span>
        `;
      }
    }

    function addHistory(code: string, status: 'VALID' | 'INVALID', note: string) {
      if (!historyTbody) return;

      const now = new Date();
      const timeStr = `${String(now.getHours()).padStart(2, '0')}:${String(now.getMinutes()).padStart(2, '0')}:${String(now.getSeconds()).padStart(2, '0')}`;

      historyItems.unshift({ time: timeStr, code, status, note });
      if (historyItems.length > 10) historyItems.pop();

      historyTbody.innerHTML = historyItems.map((item) => `
        <tr class="py-2.5">
          <td class="py-2.5 text-muted-gray">${item.time}</td>
          <td class="py-2.5 text-soft-white font-bold">${item.code}</td>
          <td class="py-2.5">
            <span class="px-2 py-0.5 rounded text-[10px] font-bold ${
              item.status === 'VALID' ? 'bg-emerald-500/20 text-emerald-400' : 'bg-red-500/20 text-red-400'
            }">
              ${item.status}
            </span>
          </td>
          <td class="py-2.5 text-right text-muted-gray truncate max-w-[150px]">${item.note}</td>
        </tr>
      `).join('');
    }
  }

  document.addEventListener('astro:page-load', initScannerPage);
</script>
