---
import RootLayout from '../layouts/RootLayout.astro';
import Footer from '../components/landing/Footer.astro';
---

<RootLayout 
  title="Masuk Arena // Akses Passwordless — AFTERGLOW" 
  description="Masuk ke arena konser AFTERGLOW menggunakan kode akses email OTP resmi."
>
  <div class="relative min-h-[90vh] flex items-center justify-center px-4 sm:px-6 py-28 overflow-hidden">
    <!-- Ambient Stage Glow Accents -->
    <div class="absolute top-1/4 left-1/2 -translate-x-1/2 w-[550px] h-[550px] bg-electric-magenta/15 rounded-full blur-[140px] pointer-events-none animate-pulse"></div>
    <div class="absolute bottom-10 left-10 w-96 h-96 bg-deep-magenta/20 rounded-full blur-[120px] pointer-events-none"></div>

    <!-- Centered Stage Card Container -->
    <div class="relative z-10 w-full max-w-lg rounded-3xl bg-dark-plum/90 border border-white/15 p-8 sm:p-12 shadow-2xl backdrop-blur-2xl text-soft-white overflow-hidden">
      <!-- Animated Neon Edge -->
      <div class="absolute top-0 left-0 right-0 h-[2px] bg-gradient-to-r from-transparent via-electric-magenta to-transparent animate-pulse"></div>

      <!-- Stage Equalizer & Brand Header -->
      <div class="flex items-center gap-4 mb-8">
        <div class="relative w-16 h-16 rounded-2xl bg-void-black border border-electric-magenta/50 flex items-center justify-center shadow-magenta-glow shrink-0 overflow-hidden">
          <div class="flex items-end gap-1.5 h-7">
            <span class="w-1 bg-electric-magenta rounded-full animate-[soundbar_0.8s_ease-in-out_infinite_alternate] h-2"></span>
            <span class="w-1 bg-electric-magenta rounded-full animate-[soundbar_1.2s_ease-in-out_infinite_alternate-reverse] h-6"></span>
            <span class="w-1 bg-soft-white rounded-full animate-[soundbar_0.7s_ease-in-out_infinite_alternate] h-7"></span>
            <span class="w-1 bg-electric-magenta rounded-full animate-[soundbar_1s_ease-in-out_infinite_alternate-reverse] h-3"></span>
            <span class="w-1 bg-electric-magenta rounded-full animate-[soundbar_0.9s_ease-in-out_infinite_alternate] h-5"></span>
          </div>
        </div>

        <div>
          <span class="text-xs font-bold tracking-[0.25em] text-electric-magenta uppercase block font-mono">
            AKSES GERBANG // PASSWORDLESS
          </span>
          <h1 class="font-display text-4xl sm:text-5xl text-soft-white tracking-wide">
            MASUK KE ARENA
          </h1>
        </div>
      </div>

      <!-- Alert Notification -->
      <div id="page-auth-alert" class="hidden mb-6 p-4 rounded-xl text-xs font-medium border flex items-start gap-3 transition-all">
        <svg class="w-4 h-4 shrink-0 mt-0.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
        </svg>
        <span id="page-auth-alert-text" class="flex-1"></span>
      </div>

      <!-- Dev Mode Quick Pill -->
      <div id="page-auth-dev-pill" class="hidden mb-6 p-3 rounded-xl bg-electric-magenta/15 border border-electric-magenta/40 flex items-center justify-between gap-2 text-xs">
        <div class="flex items-center gap-2 font-mono text-[11px] text-electric-magenta">
          <span class="w-2 h-2 rounded-full bg-electric-magenta animate-ping"></span>
          <span>DEV KODE OTP: <strong id="page-dev-otp-code" class="text-soft-white tracking-widest text-base">------</strong></span>
        </div>
        <button 
          id="page-dev-autofill-btn" 
          type="button" 
          class="px-3 py-1 rounded-md bg-electric-magenta text-soft-white font-bold text-[10px] uppercase tracking-wider hover:brightness-110 active:scale-95 transition-all"
        >
          Isi Otomatis
        </button>
      </div>

      <!-- STEP 1: REQUEST OTP FORM -->
      <form id="page-step1-form" class="space-y-5">
        <div>
          <label for="page-email-input" class="block text-xs font-semibold uppercase tracking-wider text-muted-gray mb-2 font-mono">
            Alamat Email Terdaftar / Baru <span class="text-electric-magenta">*</span>
          </label>
          <div class="relative">
            <input 
              type="email" 
              id="page-email-input" 
              required 
              placeholder="nama@email.com" 
              autocomplete="email" 
              class="w-full px-4 py-3.5 pl-11 rounded-xl bg-void-black/70 border border-white/15 text-sm text-soft-white placeholder-muted-gray/60 focus:outline-none focus:border-electric-magenta focus:ring-1 focus:ring-electric-magenta transition-all"
            />
            <svg class="w-4 h-4 text-muted-gray absolute left-4 top-1/2 -translate-y-1/2 pointer-events-none" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M16 12a4 4 0 10-8 0 4 4 0 008 0zm0 0v1.5a2.5 2.5 0 005 0V12a9 9 0 10-9 9m4.5-1.206a8.959 8.959 0 01-4.5 1.206" />
            </svg>
          </div>
          <p class="text-[11px] text-muted-gray mt-1.5">Kode akses 6-digit akan dikirimkan langsung ke email Anda tanpa password.</p>
        </div>

        <div>
          <label for="page-username-input" class="block text-xs font-semibold uppercase tracking-wider text-muted-gray mb-2 font-mono">
            Nama Lengkap Penonton <span class="text-muted-gray/60 text-[10px]">(Opsional jika baru)</span>
          </label>
          <div class="relative">
            <input 
              type="text" 
              id="page-username-input" 
              placeholder="Contoh: Budi Santoso" 
              autocomplete="name" 
              class="w-full px-4 py-3.5 pl-11 rounded-xl bg-void-black/70 border border-white/15 text-sm text-soft-white placeholder-muted-gray/60 focus:outline-none focus:border-electric-magenta focus:ring-1 focus:ring-electric-magenta transition-all"
            />
            <svg class="w-4 h-4 text-muted-gray absolute left-4 top-1/2 -translate-y-1/2 pointer-events-none" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
            </svg>
          </div>
        </div>

        <button 
          type="submit" 
          id="page-submit-step1-btn" 
          class="w-full py-4 px-6 rounded-xl bg-electric-magenta text-soft-white font-bold text-sm tracking-wider uppercase flex items-center justify-center gap-2 hover:shadow-magenta-glow transition-all duration-300 hover:scale-[1.01] active:scale-[0.99] disabled:opacity-50"
        >
          <span class="btn-text">DAPATKAN KODE AKSES PANGGUNG</span>
          <svg class="w-4 h-4 btn-spinner hidden animate-spin" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
          </svg>
        </button>

        <!-- Quick Fill Buttons -->
        <div class="pt-5 border-t border-white/10 text-center">
          <span class="text-[11px] text-muted-gray block mb-2 font-mono">Pilih Akun Demo Uji Cepat:</span>
          <div class="flex flex-wrap items-center justify-center gap-2">
            <button type="button" data-fill="buyer@soundtix.id" class="px-3 py-1.5 rounded-lg bg-white/5 border border-white/10 text-[11px] font-mono text-muted-gray hover:text-soft-white hover:border-electric-magenta/60 transition-colors">
              buyer@soundtix.id
            </button>
            <button type="button" data-fill="organizer@soundtix.id" class="px-3 py-1.5 rounded-lg bg-white/5 border border-white/10 text-[11px] font-mono text-muted-gray hover:text-soft-white hover:border-electric-magenta/60 transition-colors">
              organizer@soundtix.id
            </button>
            <button type="button" data-fill="gatecrew@soundtix.id" class="px-3 py-1.5 rounded-lg bg-white/5 border border-white/10 text-[11px] font-mono text-muted-gray hover:text-soft-white hover:border-electric-magenta/60 transition-colors">
              gatecrew@soundtix.id
            </button>
          </div>
        </div>
      </form>

      <!-- STEP 2: VERIFY OTP FORM -->
      <form id="page-step2-form" class="space-y-6 hidden">
        <div class="p-4 rounded-xl bg-void-black/60 border border-white/10 flex items-center justify-between text-xs">
          <div class="truncate">
            <span class="text-[10px] text-muted-gray block font-mono">KODE TERKIRIM KE:</span>
            <span id="page-sent-email" class="font-semibold text-soft-white truncate block"></span>
          </div>
          <button 
            id="page-change-email-btn" 
            type="button" 
            class="text-electric-magenta hover:underline text-[11px] font-semibold shrink-0 ml-2"
          >
            Ganti Email
          </button>
        </div>

        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-muted-gray mb-3 font-mono text-center">
            Masukkan 6-Digit Kode Verifikasi
          </label>
          
          <div class="flex justify-between gap-2 sm:gap-3" id="page-otp-group">
            <input type="text" inputmode="numeric" maxlength="1" pattern="[0-9]" data-idx="0" class="page-otp-box w-12 h-16 sm:w-14 sm:h-18 text-center font-display text-3xl bg-void-black/80 border border-white/20 rounded-xl text-soft-white focus:outline-none focus:border-electric-magenta focus:shadow-magenta-glow transition-all" autofocus />
            <input type="text" inputmode="numeric" maxlength="1" pattern="[0-9]" data-idx="1" class="page-otp-box w-12 h-16 sm:w-14 sm:h-18 text-center font-display text-3xl bg-void-black/80 border border-white/20 rounded-xl text-soft-white focus:outline-none focus:border-electric-magenta focus:shadow-magenta-glow transition-all" />
            <input type="text" inputmode="numeric" maxlength="1" pattern="[0-9]" data-idx="2" class="page-otp-box w-12 h-16 sm:w-14 sm:h-18 text-center font-display text-3xl bg-void-black/80 border border-white/20 rounded-xl text-soft-white focus:outline-none focus:border-electric-magenta focus:shadow-magenta-glow transition-all" />
            <input type="text" inputmode="numeric" maxlength="1" pattern="[0-9]" data-idx="3" class="page-otp-box w-12 h-16 sm:w-14 sm:h-18 text-center font-display text-3xl bg-void-black/80 border border-white/20 rounded-xl text-soft-white focus:outline-none focus:border-electric-magenta focus:shadow-magenta-glow transition-all" />
            <input type="text" inputmode="numeric" maxlength="1" pattern="[0-9]" data-idx="4" class="page-otp-box w-12 h-16 sm:w-14 sm:h-18 text-center font-display text-3xl bg-void-black/80 border border-white/20 rounded-xl text-soft-white focus:outline-none focus:border-electric-magenta focus:shadow-magenta-glow transition-all" />
            <input type="text" inputmode="numeric" maxlength="1" pattern="[0-9]" data-idx="5" class="page-otp-box w-12 h-16 sm:w-14 sm:h-18 text-center font-display text-3xl bg-void-black/80 border border-white/20 rounded-xl text-soft-white focus:outline-none focus:border-electric-magenta focus:shadow-magenta-glow transition-all" />
          </div>
        </div>

        <div class="text-center text-xs">
          <span id="page-resend-countdown" class="text-muted-gray font-mono">
            Kirim ulang kode dalam <strong id="page-timer-sec" class="text-electric-magenta font-bold">60</strong>s
          </span>
          <button 
            id="page-resend-btn" 
            type="button" 
            class="hidden text-electric-magenta hover:underline font-bold uppercase tracking-wider text-[11px]"
          >
            Kirim Ulang Kode Sekarang
          </button>
        </div>

        <button 
          type="submit" 
          id="page-submit-step2-btn" 
          class="w-full py-4 px-6 rounded-xl bg-electric-magenta text-soft-white font-bold text-sm tracking-wider uppercase flex items-center justify-center gap-2 hover:shadow-magenta-glow transition-all duration-300 hover:scale-[1.01] active:scale-[0.99] disabled:opacity-50"
        >
          <span class="btn-text">VERIFIKASI & MASUK ARENA</span>
          <svg class="w-4 h-4 btn-spinner hidden animate-spin" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
          </svg>
        </button>
      </form>
    </div>
  </div>

  <Footer />
</RootLayout>

<style>
  @keyframes soundbar {
    0% { height: 4px; }
    100% { height: 28px; }
  }
</style>

<script>
  import { requestOtp, verifyOtp } from '../lib/auth';

  function setupMasukPage() {
    const step1Form = document.getElementById('page-step1-form') as HTMLFormElement;
    const step2Form = document.getElementById('page-step2-form') as HTMLFormElement;
    const emailInput = document.getElementById('page-email-input') as HTMLInputElement;
    const usernameInput = document.getElementById('page-username-input') as HTMLInputElement;
    const alertBox = document.getElementById('page-auth-alert');
    const alertText = document.getElementById('page-auth-alert-text');
    const devPill = document.getElementById('page-auth-dev-pill');
    const devOtpCode = document.getElementById('page-dev-otp-code');
    const devAutofillBtn = document.getElementById('page-dev-autofill-btn');
    const step1Btn = document.getElementById('page-submit-step1-btn') as HTMLButtonElement;
    const step2Btn = document.getElementById('page-submit-step2-btn') as HTMLButtonElement;
    const sentEmailSpan = document.getElementById('page-sent-email');
    const changeEmailBtn = document.getElementById('page-change-email-btn');
    const resendBtn = document.getElementById('page-resend-btn');
    const resendCountdown = document.getElementById('page-resend-countdown');
    const timerSec = document.getElementById('page-timer-sec');
    const otpBoxes = document.querySelectorAll<HTMLInputElement>('.page-otp-box');

    if (!step1Form) return;

    let email = '';
    let username = '';
    let timerInterval: any = null;
    let secondsLeft = 60;

    // Quick fill
    document.querySelectorAll<HTMLButtonElement>('[data-fill]').forEach((btn) => {
      btn.addEventListener('click', () => {
        if (emailInput && btn.dataset.fill) {
          emailInput.value = btn.dataset.fill;
          emailInput.focus();
        }
      });
    });

    function showAlert(msg: string, isError = true) {
      if (!alertBox || !alertText) return;
      if (!msg) {
        alertBox.classList.add('hidden');
        return;
      }
      alertBox.classList.remove('hidden');
      alertText.textContent = msg;
      if (isError) {
        alertBox.className = 'mb-6 p-4 rounded-xl text-xs font-medium border flex items-start gap-3 transition-all bg-red-950/40 border-red-500/40 text-red-200';
      } else {
        alertBox.className = 'mb-6 p-4 rounded-xl text-xs font-medium border flex items-start gap-3 transition-all bg-emerald-950/40 border-emerald-500/40 text-emerald-200';
      }
    }

    function setBtnLoading(btn: HTMLButtonElement, loading: boolean) {
      btn.disabled = loading;
      const text = btn.querySelector('.btn-text');
      const spinner = btn.querySelector('.btn-spinner');
      if (loading) {
        text?.classList.add('opacity-50');
        spinner?.classList.remove('hidden');
      } else {
        text?.classList.remove('opacity-50');
        spinner?.classList.add('hidden');
      }
    }

    // Step 1: Request OTP
    step1Form.addEventListener('submit', async (e) => {
      e.preventDefault();
      showAlert('');
      email = emailInput.value.trim().toLowerCase();
      username = usernameInput.value.trim();

      if (!email) return;

      setBtnLoading(step1Btn, true);
      try {
        const res = await requestOtp(email, username);
        step1Form.classList.add('hidden');
        step2Form.classList.remove('hidden');
        if (sentEmailSpan) sentEmailSpan.textContent = email;

        if (res.otp && devPill && devOtpCode) {
          devOtpCode.textContent = res.otp;
          devPill.classList.remove('hidden');
          devAutofillBtn?.addEventListener('click', () => fillOtp(res.otp!), { once: true });
        }

        startTimer();
        otpBoxes[0]?.focus();
      } catch (err: any) {
        showAlert(err.message || 'Gagal mengirim kode OTP.', true);
      } finally {
        setBtnLoading(step1Btn, false);
      }
    });

    // Step 2: Verify OTP
    step2Form.addEventListener('submit', async (e) => {
      e.preventDefault();
      showAlert('');

      const otp = Array.from(otpBoxes).map((b) => b.value).join('');
      if (otp.length !== 6) {
        showAlert('Silakan masukkan 6 digit kode OTP secara lengkap.', true);
        return;
      }

      setBtnLoading(step2Btn, true);
      try {
        const verifyRes = await verifyOtp(email, otp, username);
        showAlert(`Autentikasi berhasil! Mengarahkan ke arena konser, ${verifyRes.user.username || 'Sobat Musik'}...`, false);

        setTimeout(() => {
          const params = new URLSearchParams(window.location.search);
          const next = params.get('next') || '/';
          window.location.href = next;
        }, 1000);
      } catch (err: any) {
        showAlert(err.message || 'Kode OTP tidak valid.', true);
        otpBoxes.forEach((b) => (b.value = ''));
        otpBoxes[0]?.focus();
      } finally {
        setBtnLoading(step2Btn, false);
      }
    });

    changeEmailBtn?.addEventListener('click', () => {
      step2Form.classList.add('hidden');
      step1Form.classList.remove('hidden');
      devPill?.classList.add('hidden');
      clearInterval(timerInterval);
      emailInput.focus();
    });

    function startTimer() {
      clearInterval(timerInterval);
      secondsLeft = 60;
      resendBtn?.classList.add('hidden');
      resendCountdown?.classList.remove('hidden');
      if (timerSec) timerSec.textContent = '60';

      timerInterval = setInterval(() => {
        secondsLeft--;
        if (timerSec) timerSec.textContent = String(secondsLeft);
        if (secondsLeft <= 0) {
          clearInterval(timerInterval);
          resendCountdown?.classList.add('hidden');
          resendBtn?.classList.remove('hidden');
        }
      }, 1000);
    }

    resendBtn?.addEventListener('click', async () => {
      try {
        showAlert('Mengirim kode baru...');
        const res = await requestOtp(email, username);
        showAlert('Kode OTP baru telah dikirim!', false);
        if (res.otp && devOtpCode) {
          devOtpCode.textContent = res.otp;
          devPill?.classList.remove('hidden');
        }
        startTimer();
      } catch (err: any) {
        showAlert(err.message || 'Gagal mengirim ulang OTP.', true);
      }
    });

    otpBoxes.forEach((box, idx) => {
      box.addEventListener('input', (e: any) => {
        const val = e.target.value.replace(/[^0-9]/g, '');
        box.value = val ? val[val.length - 1] : '';
        if (box.value && idx < otpBoxes.length - 1) {
          otpBoxes[idx + 1].focus();
        }
        const fullOtp = Array.from(otpBoxes).map((b) => b.value).join('');
        if (fullOtp.length === 6) {
          step2Btn.click();
        }
      });

      box.addEventListener('keydown', (e) => {
        if (e.key === 'Backspace' && !box.value && idx > 0) {
          otpBoxes[idx - 1].focus();
        }
      });

      box.addEventListener('paste', (e) => {
        e.preventDefault();
        const text = e.clipboardData?.getData('text').trim() || '';
        const digits = text.replace(/[^0-9]/g, '').slice(0, 6);
        fillOtp(digits);
      });
    });

    function fillOtp(code: string) {
      code.split('').forEach((ch, i) => {
        if (otpBoxes[i]) otpBoxes[i].value = ch;
      });
      if (code.length === 6) {
        step2Btn.click();
      } else if (otpBoxes[code.length]) {
        otpBoxes[code.length].focus();
      }
    }
  }

  document.addEventListener('astro:page-load', setupMasukPage);
</script>
