---
export const prerender = false;

import RootLayout from '../../layouts/RootLayout.astro';
import Footer from '../../components/landing/Footer.astro';
import { MOCK_CATEGORIES } from '../../data/mockCategories';
import { CATEGORY_SEARCH_MAP, fetchEvents, type BackendEvent } from '../../lib/events';
import { formatRupiah, formatDateIndo } from '../../lib/formatters';

const searchParams = Astro.url.searchParams;
const initialQuery = searchParams.get('q') || '';
const initialCity = searchParams.get('city') || '';
const rawSort = searchParams.get('sort') || 'terdekat';
const initialSort: 'terdekat' | 'terbaru' | 'termurah' =
  rawSort === 'terbaru' || rawSort === 'termurah' ? rawSort : 'terdekat';
const initialCategory = searchParams.get('category') || 'all';

const effectiveInitialQuery =
  initialQuery.trim() ||
  (initialCategory !== 'all' ? (CATEGORY_SEARCH_MAP[initialCategory] || '') : '');

const CITY_PRESETS = ['Jakarta', 'Bandung', 'Surabaya', 'Bali', 'Yogyakarta', 'Medan'];
const hasCustomCity = Boolean(initialCity && !CITY_PRESETS.some((c) => c.toLowerCase() === initialCity.toLowerCase()));

// Initial SSR data matching query string
const initialEvents = await fetchEvents({
  q: effectiveInitialQuery || undefined,
  city: initialCity || undefined,
  sort: initialSort,
  scope: 'public',
  limit: 24,
});

function getEventStatus(event: BackendEvent) {
  const isSoldOut = Boolean(event.is_sold_out || Number(event.available_quota) <= 0);
  const isAlmostSold = !isSoldOut && Number(event.occupancy_percent || 0) >= 80;
  return { isSoldOut, isAlmostSold };
}
---

<RootLayout 
  title="Jadwal & Tiket Konser — AFTERGLOW" 
  description="Cari musisi favoritmu dan beli tiket konser musik resmi di Indonesia."
>
  <div class="pt-32 pb-24 px-6 lg:px-12 max-w-7xl mx-auto w-full">
    <!-- Header Banner -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-12">
      <div>
        <span class="text-xs font-bold tracking-[0.25em] text-electric-magenta uppercase block mb-2 font-mono">
          KATALOG RESMI // JADWAL TUR
        </span>
        <h1 class="font-display text-5xl sm:text-7xl text-neutral-950 dark:text-soft-white tracking-wide">
          JADWAL & TIKET KONSER
        </h1>
        <p class="text-neutral-600 dark:text-muted-gray text-base mt-2 max-w-xl">
          Amankan tiket konser resmi dari promotor terpercaya. Tanpa calo, transaksi transparan, dan garansi masuk venue 100%.
        </p>
      </div>

      <!-- Quick Search Bar (Debounced) -->
      <div class="relative w-full md:w-96">
        <input 
          type="text" 
          id="events-search-input"
          value={initialQuery}
          placeholder="Cari artis, konser, atau kota..." 
          class="w-full px-5 py-3.5 pl-12 rounded-full bg-white dark:bg-dark-plum border border-neutral-300 dark:border-white/15 text-sm text-neutral-950 dark:text-soft-white placeholder-neutral-400 dark:placeholder-muted-gray focus:outline-none focus:border-electric-magenta focus:ring-1 focus:ring-electric-magenta focus:shadow-magenta-glow transition-all shadow-sm dark:shadow-none"
        />
        <svg class="w-4 h-4 text-neutral-400 dark:text-muted-gray absolute left-4.5 top-1/2 -translate-y-1/2 pointer-events-none" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
      </div>
    </div>

    <!-- Category, City & Sort Controls Bar -->
    <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4 mb-10 pb-4 border-b border-neutral-200 dark:border-white/10">
      <!-- Category Filter Tabs -->
      <div class="flex items-center gap-2 overflow-x-auto pb-2 lg:pb-0 no-scrollbar" id="category-filter-group">
        <button 
          data-category="all" 
          class={`cat-filter-btn px-5 py-2 rounded-full text-xs shrink-0 transition-all ${
            initialCategory === 'all'
              ? 'font-semibold bg-electric-magenta text-white shadow-magenta-glow'
              : 'font-medium bg-white dark:bg-dark-plum border border-neutral-200 dark:border-white/10 text-neutral-600 dark:text-muted-gray hover:text-neutral-950 dark:hover:text-soft-white hover:border-neutral-300 dark:hover:border-white/20'
          }`}
        >
          Semua Genre
        </button>
        {MOCK_CATEGORIES.map((cat) => {
          const isActive = initialCategory === cat.slug;
          return (
            <button 
              data-category={cat.slug} 
              class={`cat-filter-btn px-5 py-2 rounded-full text-xs shrink-0 transition-colors ${
                isActive
                  ? 'font-semibold bg-electric-magenta text-white shadow-magenta-glow'
                  : 'font-medium bg-white dark:bg-dark-plum border border-neutral-200 dark:border-white/10 text-neutral-600 dark:text-muted-gray hover:text-neutral-950 dark:hover:text-soft-white hover:border-neutral-300 dark:hover:border-white/20'
              }`}
            >
              {cat.name}
            </button>
          );
        })}
      </div>

      <!-- City & Sort Selection -->
      <div class="flex flex-wrap items-center gap-3 shrink-0">
        <div class="flex items-center gap-2">
          <span class="text-xs text-neutral-500 dark:text-muted-gray font-mono uppercase">Kota:</span>
          <select 
            id="events-city-select" 
            class="px-3.5 py-1.5 rounded-xl bg-white dark:bg-dark-plum border border-neutral-300 dark:border-white/15 text-xs text-neutral-900 dark:text-soft-white focus:outline-none focus:border-electric-magenta font-medium"
          >
            <option value="" selected={!initialCity}>Semua Kota</option>
            {hasCustomCity && <option value={initialCity} selected>{initialCity}</option>}
            {CITY_PRESETS.map((city) => (
              <option value={city} selected={initialCity.toLowerCase() === city.toLowerCase()}>{city}</option>
            ))}
          </select>
        </div>

        <div class="flex items-center gap-2">
          <span class="text-xs text-neutral-500 dark:text-muted-gray font-mono uppercase">Urutkan:</span>
          <select 
            id="events-sort-select" 
            class="px-3.5 py-1.5 rounded-xl bg-white dark:bg-dark-plum border border-neutral-300 dark:border-white/15 text-xs text-neutral-900 dark:text-soft-white focus:outline-none focus:border-electric-magenta font-medium"
          >
            <option value="terdekat" selected={initialSort === 'terdekat'}>Terdekat</option>
            <option value="terbaru" selected={initialSort === 'terbaru'}>Terbaru Dibuat</option>
            <option value="termurah" selected={initialSort === 'termurah'}>Harga Termurah</option>
          </select>
        </div>
      </div>
    </div>

    <!-- Catalog Grid Container -->
    <div id="events-grid-container" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {initialEvents.map((event) => {
        const { isSoldOut, isAlmostSold } = getEventStatus(event);

        return (
          <article 
            class="event-card rounded-2xl bg-white dark:bg-dark-plum border border-neutral-200 dark:border-white/[0.08] shadow-sm dark:shadow-none overflow-hidden flex flex-col group hover:border-electric-magenta/50 hover:shadow-magenta-glow transition-all duration-300"
            data-event-id={event.id}
            data-search-text={`${event.nama_event} ${event.artis} ${event.alamat}`.toLowerCase()}
          >
            <a href={`/events/${event.id}`} class="relative w-full aspect-[16/10] overflow-hidden bg-neutral-100 dark:bg-void-black block">
              <img 
                src={event.poster_url || 'https://images.unsplash.com/photo-1470225620780-dba8ba36b745?auto=format&fit=crop&w=1200&q=80'} 
                alt={event.nama_event} 
                class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-500 filter brightness-95 dark:brightness-90 contrast-110"
                loading="lazy"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/50 dark:from-dark-plum via-transparent to-transparent"></div>

              <!-- Top Right Availability Badge -->
              <div class="absolute top-4 right-4">
                {isSoldOut ? (
                  <span class="px-3 py-1 rounded-full text-[10px] font-bold tracking-wider uppercase bg-black/80 text-white/80 border border-white/15 font-mono">
                    HABIS TERJUAL
                  </span>
                ) : isAlmostSold ? (
                  <span class="px-3 py-1 rounded-full text-[10px] font-bold tracking-wider uppercase bg-electric-magenta text-white shadow-magenta-glow font-mono">
                    HAMPIR HABIS
                  </span>
                ) : (
                  <span class="px-3 py-1 rounded-full text-[10px] font-bold tracking-wider uppercase bg-black/55 backdrop-blur-md text-white border border-white/25 font-mono">
                    TERSEDIA
                  </span>
                )}
              </div>

              <!-- Top Left Promotor / Quota Badge -->
              <div class="absolute top-4 left-4">
                <span class="px-2.5 py-1 rounded-md text-[10px] font-semibold tracking-wider uppercase bg-black/65 backdrop-blur-md text-white/90 border border-white/15">
                  {event.organization_name || 'AFTERGLOW'}
                </span>
              </div>
            </a>

            <div class="p-6 flex flex-col flex-1 justify-between gap-5">
              <div>
                <div class="flex items-center gap-2 text-xs text-electric-magenta font-semibold tracking-wider uppercase mb-2">
                  <span>{formatDateIndo(event.tanggal_mulai, { showTime: false })}</span>
                  <span>•</span>
                  <span class="truncate">{event.alamat.split(',')[1] || event.alamat.split(',')[0]}</span>
                </div>

                <a href={`/events/${event.id}`} class="block group-hover:text-electric-magenta transition-colors">
                  <h3 class="font-display text-2xl text-neutral-950 dark:text-soft-white leading-tight line-clamp-2">
                    {event.nama_event}
                  </h3>
                </a>

                <p class="text-sm text-neutral-700 dark:text-muted-gray mt-2 line-clamp-1 font-medium">
                  {event.artis}
                </p>

                <p class="text-xs text-neutral-500 dark:text-muted-gray/70 mt-1 flex items-center gap-1.5 truncate">
                  <svg class="w-3.5 h-3.5 text-neutral-400 dark:text-muted-gray shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                  </svg>
                  <span class="truncate">{event.alamat}</span>
                </p>
              </div>

              <div class="pt-4 border-t border-neutral-200 dark:border-white/[0.08] flex items-center justify-between">
                <div>
                  <span class="text-[10px] text-neutral-500 dark:text-muted-gray uppercase tracking-wider block font-mono">Mulai Dari</span>
                  <span class="font-display text-2xl text-neutral-950 dark:text-soft-white">
                    {formatRupiah(event.min_price)}
                  </span>
                </div>

                <div class="flex items-center gap-2">
                  <!-- Wishlist Button -->
                  <button 
                    type="button" 
                    data-bookmark-id={event.id}
                    class="bookmark-btn w-9 h-9 rounded-full bg-neutral-100 dark:bg-white/5 border border-neutral-200 dark:border-white/10 flex items-center justify-center text-neutral-500 dark:text-muted-gray hover:text-electric-magenta hover:border-electric-magenta/60 hover:bg-neutral-200/70 dark:hover:bg-white/10 transition-all"
                    aria-label="Simpan ke Wishlist"
                  >
                    <svg class="w-4 h-4 pointer-events-none" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
                    </svg>
                  </button>

                  {isSoldOut ? (
                    <button disabled class="px-5 py-2.5 rounded-full bg-neutral-100 dark:bg-white/5 text-neutral-400 dark:text-muted-gray text-xs font-semibold uppercase tracking-wider cursor-not-allowed">
                      HABIS
                    </button>
                  ) : (
                    <a 
                      href={`/events/${event.id}`} 
                      class="px-5 py-2.5 rounded-full bg-electric-magenta hover:shadow-magenta-glow text-white text-xs font-bold uppercase tracking-wider hover:scale-105 active:scale-95 transition-all"
                    >
                      WAR TIKET
                    </a>
                  )}
                </div>
              </div>
            </div>
          </article>
        );
      })}
    </div>

    <!-- Pagination: Load More -->
    <div id="events-load-more-wrap" class={`mt-12 flex flex-col items-center gap-3 ${initialEvents.length < 24 ? 'hidden' : ''}`}>
      <button
        id="events-load-more-btn"
        type="button"
        class="px-7 py-3 rounded-full bg-white dark:bg-dark-plum border border-neutral-300 dark:border-white/15 hover:border-electric-magenta text-xs font-mono font-bold uppercase tracking-wider text-neutral-900 dark:text-soft-white hover:text-electric-magenta shadow-sm dark:shadow-none transition-all"
      >
        Muat Lebih Banyak Konser ↓
      </button>
      <span id="events-pagination-info" class="text-[11px] font-mono text-neutral-500 dark:text-muted-gray"></span>
    </div>

    <!-- Empty Search State -->
    <div id="events-empty-state" class={initialEvents.length === 0 ? 'text-center py-20' : 'hidden text-center py-20'}>
      <div class="w-20 h-20 rounded-full bg-white dark:bg-dark-plum border border-neutral-200 dark:border-white/10 flex items-center justify-center mx-auto mb-4 text-neutral-400 dark:text-muted-gray shadow-sm dark:shadow-none">
        <svg class="w-8 h-8" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
      </div>
      <h3 class="font-display text-3xl text-neutral-950 dark:text-soft-white mb-2">KONSER TIDAK DITEMUKAN</h3>
      <p class="text-sm text-neutral-600 dark:text-muted-gray max-w-md mx-auto">
        Tidak ada jadwal konser yang cocok dengan kata kunci pencarianmu. Coba cari nama musisi lain atau reset filter.
      </p>
      <button
        type="button"
        id="events-reset-filter-btn"
        class="mt-6 px-6 py-2.5 rounded-full bg-neutral-900 dark:bg-white/10 hover:bg-electric-magenta text-white text-xs font-bold uppercase tracking-wider transition-all"
      >
        Reset Semua Filter
      </button>
    </div>
  </div>

  <Footer />
</RootLayout>

<script define:vars={{ initialCategory }}>
  window.__catalogInitialCategory = initialCategory;
</script>

<script>
  import { api, resolveAssetUrl } from '../../lib/api';
  import { isAuthenticated } from '../../lib/auth';
  import { CATEGORY_SEARCH_MAP, fetchEvents, toggleBookmark, type BackendEvent } from '../../lib/events';
  import { escapeHtml, formatDateIndo, formatRupiah } from '../../lib/formatters';

  function renderCatalogCard(event: BackendEvent, isSaved: boolean): string {
    const isSoldOut = Boolean(event.is_sold_out || Number(event.available_quota) <= 0);
    const isAlmostSold = !isSoldOut && Number(event.occupancy_percent || 0) >= 80;

    const statusBadge = isSoldOut
      ? `<span class="px-3 py-1 rounded-full text-[10px] font-bold tracking-wider uppercase bg-black/80 text-white/80 border border-white/15 font-mono">HABIS TERJUAL</span>`
      : isAlmostSold
      ? `<span class="px-3 py-1 rounded-full text-[10px] font-bold tracking-wider uppercase bg-electric-magenta text-white shadow-magenta-glow font-mono">HAMPIR HABIS</span>`
      : `<span class="px-3 py-1 rounded-full text-[10px] font-bold tracking-wider uppercase bg-black/55 backdrop-blur-md text-white border border-white/25 font-mono">TERSEDIA</span>`;

    const cityLabel = event.alamat.split(',')[1]?.trim() || event.alamat.split(',')[0] || '-';
    const bookmarkCls = isSaved
      ? 'text-electric-magenta border-electric-magenta'
      : 'text-neutral-500 dark:text-muted-gray border-neutral-200 dark:border-white/10';
    const bookmarkFill = isSaved ? 'currentColor' : 'none';

    const actionCta = isSoldOut
      ? `<button disabled class="px-5 py-2.5 rounded-full bg-neutral-100 dark:bg-white/5 text-neutral-400 dark:text-muted-gray text-xs font-semibold uppercase tracking-wider cursor-not-allowed">HABIS</button>`
      : `<a href="/events/${event.id}" class="px-5 py-2.5 rounded-full bg-electric-magenta hover:shadow-magenta-glow text-white text-xs font-bold uppercase tracking-wider hover:scale-105 active:scale-95 transition-all">WAR TIKET</a>`;

    return `
      <article
        class="event-card rounded-2xl bg-white dark:bg-dark-plum border border-neutral-200 dark:border-white/[0.08] shadow-sm dark:shadow-none overflow-hidden flex flex-col group hover:border-electric-magenta/50 hover:shadow-magenta-glow transition-all duration-300"
        data-event-id="${event.id}"
        data-search-text="${escapeHtml(`${event.nama_event} ${event.artis} ${event.alamat}`.toLowerCase())}"
      >
        <a href="/events/${event.id}" class="relative w-full aspect-[16/10] overflow-hidden bg-neutral-100 dark:bg-void-black block">
          <img
            src="${escapeHtml(resolveAssetUrl(event.poster_url))}"
            alt="${escapeHtml(event.nama_event)}"
            class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-500 filter brightness-95 dark:brightness-90 contrast-110"
            loading="lazy"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black/50 dark:from-dark-plum via-transparent to-transparent"></div>
          <div class="absolute top-4 right-4">${statusBadge}</div>
          <div class="absolute top-4 left-4">
            <span class="px-2.5 py-1 rounded-md text-[10px] font-semibold tracking-wider uppercase bg-black/65 backdrop-blur-md text-white/90 border border-white/15">
              ${escapeHtml(event.organization_name || 'AFTERGLOW')}
            </span>
          </div>
        </a>

        <div class="p-6 flex flex-col flex-1 justify-between gap-5">
          <div>
            <div class="flex items-center gap-2 text-xs text-electric-magenta font-semibold tracking-wider uppercase mb-2">
              <span>${escapeHtml(formatDateIndo(event.tanggal_mulai, { showTime: false }))}</span>
              <span>•</span>
              <span class="truncate">${escapeHtml(cityLabel)}</span>
            </div>

            <a href="/events/${event.id}" class="block group-hover:text-electric-magenta transition-colors">
              <h3 class="font-display text-2xl text-neutral-950 dark:text-soft-white leading-tight line-clamp-2">
                ${escapeHtml(event.nama_event)}
              </h3>
            </a>

            <p class="text-sm text-neutral-700 dark:text-muted-gray mt-2 line-clamp-1 font-medium">${escapeHtml(event.artis)}</p>
            <p class="text-xs text-neutral-500 dark:text-muted-gray/70 mt-1 flex items-center gap-1.5 truncate">
              <svg class="w-3.5 h-3.5 text-neutral-400 dark:text-muted-gray shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
              <span class="truncate">${escapeHtml(event.alamat)}</span>
            </p>
          </div>

          <div class="pt-4 border-t border-neutral-200 dark:border-white/[0.08] flex items-center justify-between">
            <div>
              <span class="text-[10px] text-neutral-500 dark:text-muted-gray uppercase tracking-wider block font-mono">Mulai Dari</span>
              <span class="font-display text-2xl text-neutral-950 dark:text-soft-white">${escapeHtml(formatRupiah(event.min_price))}</span>
            </div>
            <div class="flex items-center gap-2">
              <button
                type="button"
                data-bookmark-id="${event.id}"
                class="bookmark-btn w-9 h-9 rounded-full bg-neutral-100 dark:bg-white/5 border flex items-center justify-center ${bookmarkCls} hover:text-electric-magenta hover:border-electric-magenta/60 hover:bg-neutral-200/70 dark:hover:bg-white/10 transition-all"
                aria-label="Simpan ke Wishlist"
              >
                <svg class="w-4 h-4 pointer-events-none" fill="${bookmarkFill}" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
                </svg>
              </button>
              ${actionCta}
            </div>
          </div>
        </div>
      </article>
    `;
  }

  function initEventsCatalog() {
    const searchInput = document.getElementById('events-search-input') as HTMLInputElement | null;
    const citySelect = document.getElementById('events-city-select') as HTMLSelectElement | null;
    const sortSelect = document.getElementById('events-sort-select') as HTMLSelectElement | null;
    const catBtns = document.querySelectorAll<HTMLButtonElement>('.cat-filter-btn');
    const emptyState = document.getElementById('events-empty-state');
    const grid = document.getElementById('events-grid-container');
    const resetBtn = document.getElementById('events-reset-filter-btn');
    const loadMoreWrap = document.getElementById('events-load-more-wrap');
    const loadMoreBtn = document.getElementById('events-load-more-btn') as HTMLButtonElement | null;
    const paginationInfo = document.getElementById('events-pagination-info');

    if (!grid) return () => {};

    const PAGE_LIMIT = 24;
    let activeCategory: string = (window as any).__catalogInitialCategory || 'all';
    let currentOffset = grid.querySelectorAll('.event-card').length;
    let debounceTimer: any = null;
    let isDisposed = false;
    const bookmarkedIds = new Set<number>();

    if (paginationInfo && currentOffset > 0) {
      paginationInfo.textContent = `Menampilkan ${currentOffset} konser`;
    }

    function paintBookmarks() {
      grid!.querySelectorAll<HTMLButtonElement>('.bookmark-btn').forEach((btn) => {
        const id = Number(btn.dataset.bookmarkId || 0);
        const icon = btn.querySelector('svg');
        if (bookmarkedIds.has(id)) {
          btn.classList.add('text-electric-magenta', 'border-electric-magenta');
          btn.classList.remove('text-neutral-500', 'dark:text-muted-gray', 'border-neutral-200', 'dark:border-white/10');
          icon?.setAttribute('fill', 'currentColor');
        } else {
          btn.classList.remove('text-electric-magenta', 'border-electric-magenta');
          btn.classList.add('text-neutral-500', 'dark:text-muted-gray', 'border-neutral-200', 'dark:border-white/10');
          icon?.setAttribute('fill', 'none');
        }
      });
    }

    async function syncBookmarks() {
      bookmarkedIds.clear();
      if (isAuthenticated()) {
        try {
          const rows = await api.get<Array<{ id: number }>>('/users/bookmarks');
          if (Array.isArray(rows)) rows.forEach((r) => bookmarkedIds.add(Number(r.id)));
        } catch {}
      }
      if (!isDisposed) paintBookmarks();
    }

    function updateUrlParams() {
      const nextParams = new URLSearchParams();
      const qVal = searchInput?.value.trim() || '';
      const cityVal = citySelect?.value.trim() || '';
      const sortVal = sortSelect?.value || 'terdekat';
      if (qVal) nextParams.set('q', qVal);
      if (cityVal) nextParams.set('city', cityVal);
      if (sortVal && sortVal !== 'terdekat') nextParams.set('sort', sortVal);
      if (activeCategory && activeCategory !== 'all') nextParams.set('category', activeCategory);
      const nextUrl = `${window.location.pathname}${nextParams.toString() ? `?${nextParams.toString()}` : ''}`;
      window.history.replaceState(null, '', nextUrl);
    }

    async function reloadCatalog(append = false) {
      updateUrlParams();
      const rawQ = searchInput?.value.trim() || '';
      const catTerm = activeCategory !== 'all' ? (CATEGORY_SEARCH_MAP[activeCategory] || '') : '';
      const effectiveQ = rawQ || catTerm;
      const city = citySelect?.value.trim() || '';
      const sort = (sortSelect?.value || 'terdekat') as 'terdekat' | 'terbaru' | 'termurah';

      const requestOffset = append ? currentOffset : 0;
      if (append && loadMoreBtn) {
        loadMoreBtn.disabled = true;
        loadMoreBtn.textContent = 'Memuat Konser...';
      } else {
        grid!.classList.add('opacity-60');
      }

      try {
        const events = await fetchEvents({
          q: effectiveQ || undefined,
          city: city || undefined,
          sort,
          scope: 'public',
          limit: PAGE_LIMIT,
          offset: requestOffset,
          strict: true,
        });
        if (isDisposed) return;

        const html = events.map((ev) => renderCatalogCard(ev, bookmarkedIds.has(ev.id))).join('');
        if (append) {
          grid!.insertAdjacentHTML('beforeend', html);
          currentOffset += events.length;
        } else {
          grid!.innerHTML = html;
          currentOffset = events.length;
        }

        if (currentOffset === 0) emptyState?.classList.remove('hidden');
        else emptyState?.classList.add('hidden');

        if (loadMoreWrap) {
          loadMoreWrap.classList.toggle('hidden', events.length < PAGE_LIMIT);
        }
        if (paginationInfo) {
          paginationInfo.textContent = currentOffset > 0 ? `Menampilkan ${currentOffset} konser` : '';
        }
      } catch {
        if (append) return;
        // Fallback client-side filter over currently rendered cards if backend unreachable
        if (isDisposed) return;
        const term = effectiveQ.toLowerCase();
        const cityTerm = city.toLowerCase();
        let visible = 0;
        grid!.querySelectorAll<HTMLElement>('.event-card').forEach((card) => {
          const text = card.dataset.searchText || '';
          const okQ = !term || text.includes(term);
          const okC = !cityTerm || text.includes(cityTerm);
          if (okQ && okC) {
            card.classList.remove('hidden');
            visible++;
          } else {
            card.classList.add('hidden');
          }
        });
        if (visible === 0) emptyState?.classList.remove('hidden');
        else emptyState?.classList.add('hidden');
        loadMoreWrap?.classList.add('hidden');
      } finally {
        if (!isDisposed) {
          grid!.classList.remove('opacity-60');
          if (loadMoreBtn) {
            loadMoreBtn.disabled = false;
            loadMoreBtn.textContent = 'Muat Lebih Banyak Konser ↓';
          }
        }
      }
    }

    loadMoreBtn?.addEventListener('click', () => reloadCatalog(true));

    searchInput?.addEventListener('input', () => {
      clearTimeout(debounceTimer);
      debounceTimer = setTimeout(() => reloadCatalog(false), 300);
    });

    citySelect?.addEventListener('change', () => reloadCatalog(false));
    sortSelect?.addEventListener('change', () => reloadCatalog(false));

    const activeTabCls = ['font-semibold', 'bg-electric-magenta', 'text-white', 'shadow-magenta-glow'];
    const inactiveTabCls = ['font-medium', 'bg-white', 'dark:bg-dark-plum', 'border', 'border-neutral-200', 'dark:border-white/10', 'text-neutral-600', 'dark:text-muted-gray'];

    catBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        activeCategory = btn.dataset.category || 'all';
        catBtns.forEach((b) => {
          b.classList.remove(...activeTabCls);
          b.classList.add(...inactiveTabCls);
        });
        btn.classList.remove(...inactiveTabCls);
        btn.classList.add(...activeTabCls);
        reloadCatalog(false);
      });
    });

    resetBtn?.addEventListener('click', () => {
      if (searchInput) searchInput.value = '';
      if (citySelect) citySelect.value = '';
      if (sortSelect) sortSelect.value = 'terdekat';
      activeCategory = 'all';
      catBtns.forEach((b) => {
        const isAll = b.dataset.category === 'all';
        activeTabCls.forEach((c) => b.classList.toggle(c, isAll));
        inactiveTabCls.forEach((c) => b.classList.toggle(c, !isAll));
      });
      reloadCatalog(false);
    });

    // Event delegation for wishlist toggle across dynamic re-renders
    grid.addEventListener('click', async (e) => {
      const btn = (e.target as HTMLElement).closest('.bookmark-btn') as HTMLButtonElement | null;
      if (!btn) return;
      e.preventDefault();
      e.stopPropagation();

      if (!isAuthenticated()) {
        if (typeof (window as any).openAuthModal === 'function') (window as any).openAuthModal();
        else window.location.href = '/masuk';
        return;
      }

      const eventId = Number(btn.dataset.bookmarkId || 0);
      if (!eventId) return;

      try {
        const res = await toggleBookmark(eventId);
        const isSaved = Boolean(res.bookmarked ?? res.is_bookmarked);
        if (isSaved) bookmarkedIds.add(eventId);
        else bookmarkedIds.delete(eventId);
        paintBookmarks();
      } catch (err) {
        console.error('[Bookmark Error]:', err);
      }
    });

    const onAuthChanged = () => { syncBookmarks(); };
    window.addEventListener('afterglow-auth-changed', onAuthChanged);
    syncBookmarks();

    return () => {
      isDisposed = true;
      clearTimeout(debounceTimer);
      window.removeEventListener('afterglow-auth-changed', onAuthChanged);
    };
  }

  let catalogCleanup: (() => void) | undefined;
  document.addEventListener('astro:page-load', () => {
    if (catalogCleanup) catalogCleanup();
    catalogCleanup = initEventsCatalog();
  });
</script>
