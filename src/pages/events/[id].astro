---
export const prerender = false;

import RootLayout from '../../layouts/RootLayout.astro';
import Footer from '../../components/landing/Footer.astro';
import { ApiError } from '../../lib/api';
import { fetchEventById, getCategoryMaxLimit, type BackendEvent } from '../../lib/events';
import { formatRupiah, formatDateIndo, getGoogleMapsUrl, getGoogleCalendarUrl } from '../../lib/formatters';

const { id } = Astro.params;
let event: BackendEvent | null = null;
let loadErrorStatus = 0;
let loadErrorMessage = '';

try {
  event = await fetchEventById(id || '', true);
} catch (err: any) {
  if (err instanceof ApiError) {
    loadErrorStatus = err.status || 500;
    loadErrorMessage = err.message || 'Gagal memuat detail konser.';
  } else {
    loadErrorStatus = 503;
    loadErrorMessage = err?.message || 'Server katalog konser sedang tidak dapat dihubungi.';
  }
}

if (!event && loadErrorStatus === 0) {
  loadErrorStatus = 404;
  loadErrorMessage = 'Konser yang Anda cari tidak ditemukan atau sudah berakhir.';
}

if (!event) {
  Astro.response.status = loadErrorStatus === 404 ? 404 : 503;
}

const categories = event?.categories || [];
const firstAvailableIdx = categories.findIndex((c) => Number(c.kuota_tersedia || 0) > 0);
const mappedCategories = categories.map((cat, idx) => ({
  ...cat,
  maxLimit: getCategoryMaxLimit(cat),
  isCatSoldOut: Boolean(!cat.kuota_tersedia || Number(cat.kuota_tersedia) <= 0),
  isDefaultSelected: idx === firstAvailableIdx,
}));

const mapsUrl = event ? getGoogleMapsUrl(event.alamat, event.lat, event.lng) : '#';
const calendarUrl = event ? getGoogleCalendarUrl(event) : '#';
const isSoldOut = Boolean(event && (event.is_sold_out || Number(event.available_quota) <= 0));
const isPaused = Boolean(event?.is_paused);
const occupancyPct = event ? Math.min(100, Math.max(0, Number(event.occupancy_percent ?? 0))) : 0;
const venueCapacity = event ? Number(event.kapasitas_venue ?? event.total_quota ?? 0) : 0;
const hasCoords = Boolean(
  event &&
    event.lat !== null &&
    event.lng !== null &&
    Number.isFinite(Number(event.lat)) &&
    Number.isFinite(Number(event.lng)) &&
    !(Number(event.lat) === 0 && Number(event.lng) === 0)
);
const promoterHref = event?.organizer_id ? `/organizers/${event.organizer_id}` : '/events';
---

<RootLayout
  title={event ? `${event.nama_event} — AFTERGLOW Concert Arena` : 'Konser Tidak Ditemukan — AFTERGLOW'}
  description={event ? `Beli tiket resmi ${event.nama_event} di ${event.alamat}. Rasakan dentuman panggung live.` : 'Detail konser tidak tersedia atau tidak ditemukan.'}
>
  {!event ? (
    <div class="pt-36 pb-28 px-4 sm:px-6 lg:px-12 max-w-3xl mx-auto w-full text-center">
      <div class="p-8 sm:p-12 rounded-3xl bg-white dark:bg-dark-plum/85 border border-neutral-200 dark:border-white/15 shadow-xl space-y-5">
        <span class="inline-block px-3.5 py-1 rounded-full text-xs font-mono font-bold uppercase tracking-widest bg-electric-magenta/10 dark:bg-electric-magenta/20 text-electric-magenta border border-electric-magenta/30">
          {loadErrorStatus === 404 ? 'ERROR 404 // EVENT HILANG' : `STATUS ${loadErrorStatus} // KONEKSI`}
        </span>
        <h1 class="font-display text-4xl sm:text-6xl text-neutral-950 dark:text-soft-white tracking-wide">
          {loadErrorStatus === 404 ? 'KONSER TIDAK DITEMUKAN' : 'GAGAL MEMUAT KONSER'}
        </h1>
        <p class="text-sm sm:text-base text-neutral-600 dark:text-muted-gray max-w-xl mx-auto">
          {loadErrorMessage}
        </p>
        <div class="pt-4 flex flex-wrap justify-center gap-3">
          <a
            href="/events"
            class="px-6 py-3 rounded-full bg-electric-magenta text-white text-xs font-bold uppercase tracking-wider hover:shadow-magenta-glow transition-all"
          >
            Kembali ke Katalog Konser
          </a>
          <button
            type="button"
            onclick="window.location.reload()"
            class="px-6 py-3 rounded-full bg-neutral-100 dark:bg-white/10 border border-neutral-200 dark:border-white/15 text-xs font-bold uppercase tracking-wider text-neutral-900 dark:text-soft-white hover:border-electric-magenta transition-all"
          >
            Muat Ulang Halaman
          </button>
        </div>
      </div>
    </div>
  ) : (
    <div class="relative pt-28 pb-24 px-4 sm:px-6 lg:px-12 max-w-7xl mx-auto w-full">
      <!-- Breadcrumb -->
      <nav class="flex items-center gap-2 text-xs font-mono text-neutral-500 dark:text-muted-gray mb-8">
        <a href="/" class="hover:text-neutral-950 dark:hover:text-soft-white transition-colors">HOME</a>
        <span>/</span>
        <a href="/events" class="hover:text-neutral-950 dark:hover:text-soft-white transition-colors">KONSER</a>
        <span>/</span>
        <span class="text-electric-magenta truncate max-w-[200px] sm:max-w-md">{event.nama_event}</span>
      </nav>

      <!-- Main Hero Split (Left: Stage Poster Art, Right: Details & War Arena) -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-start">
        <!-- LEFT COLUMN: Concert Artwork, Venue Pin & Quick Info (5 cols) -->
        <div class="lg:col-span-5 flex flex-col gap-6">
          <div class="relative w-full aspect-[4/5] rounded-3xl overflow-hidden bg-void-black border border-neutral-200 dark:border-white/15 shadow-2xl group">
            <img
              src={event.poster_url || 'https://images.unsplash.com/photo-1470225620780-dba8ba36b745?auto=format&fit=crop&w=1200&q=80'}
              alt={event.nama_event}
              class="w-full h-full object-cover object-center filter brightness-95 contrast-105 group-hover:scale-105 transition-transform duration-700"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-dark-plum via-transparent to-transparent"></div>

            <!-- Availability Tag -->
            <div class="absolute top-5 right-5">
              {isSoldOut ? (
                <span class="px-3.5 py-1.5 rounded-full text-xs font-mono font-bold tracking-wider uppercase bg-black/85 text-muted-gray border border-white/10">
                  HABIS TERJUAL
                </span>
              ) : isPaused ? (
                <span class="px-3.5 py-1.5 rounded-full text-xs font-mono font-bold tracking-wider uppercase bg-amber-400 text-void-black border border-amber-200 shadow-lg">
                  PENJUALAN DIJEDA
                </span>
              ) : (
                <span class="px-3.5 py-1.5 rounded-full text-xs font-mono font-bold tracking-wider uppercase bg-electric-magenta text-white shadow-magenta-glow">
                  TIKET TERSEDIA
                </span>
              )}
            </div>

            <!-- Organizer Badge (Clickable -> Public Promoter Page) -->
            <div class="absolute top-5 left-5">
              <a
                href={promoterHref}
                class="inline-flex items-center gap-1.5 px-3 py-1 rounded-md text-xs font-semibold tracking-wider uppercase bg-void-black/85 backdrop-blur-md text-soft-white border border-white/15 hover:border-electric-magenta hover:text-electric-magenta transition-colors"
              >
                <span>{event.organization_name || 'Promotor Resmi'}</span>
                <span aria-hidden="true">-&gt;</span>
              </a>
            </div>

            <!-- Bottom Poster Text Overlay -->
            <div class="absolute bottom-6 left-6 right-6">
              <span class="text-xs font-mono text-electric-magenta uppercase tracking-wider block mb-1">HEADLINE ARTIST</span>
              <p class="font-display text-3xl text-soft-white leading-tight drop-shadow-md">
                {event.artis}
              </p>
            </div>
          </div>

          <!-- Smart Action Buttons: Google Maps & Calendar -->
          <div class="grid grid-cols-2 gap-3">
            <a
              href={mapsUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center justify-center gap-2 py-3 px-4 rounded-xl bg-white dark:bg-dark-plum border border-neutral-200 dark:border-white/10 text-xs font-semibold text-neutral-900 dark:text-soft-white hover:border-electric-magenta/60 hover:text-electric-magenta shadow-sm dark:shadow-none transition-all"
            >
              <svg class="w-4 h-4 text-electric-magenta" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
              <span data-i18n="eventsPage.mapsBtn">Rute Google Maps</span>
            </a>

            <a
              href={calendarUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center justify-center gap-2 py-3 px-4 rounded-xl bg-white dark:bg-dark-plum border border-neutral-200 dark:border-white/10 text-xs font-semibold text-neutral-900 dark:text-soft-white hover:border-electric-magenta/60 hover:text-electric-magenta shadow-sm dark:shadow-none transition-all"
            >
              <svg class="w-4 h-4 text-electric-magenta" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
              </svg>
              <span data-i18n="eventsPage.calBtn">Simpan Kalender</span>
            </a>
          </div>

          {hasCoords && (
            <div class="rounded-2xl overflow-hidden bg-white dark:bg-dark-plum border border-neutral-200 dark:border-white/15 shadow-sm dark:shadow-none">
              <div class="px-4 py-2.5 border-b border-neutral-200 dark:border-white/10 flex items-center justify-between text-[11px] font-mono">
                <span class="uppercase tracking-wider font-bold text-neutral-700 dark:text-soft-white">PIN LOKASI VENUE</span>
                <span class="text-neutral-500 dark:text-muted-gray">{Number(event.lat).toFixed(4)}, {Number(event.lng).toFixed(4)}</span>
              </div>
              <div
                id="event-venue-map"
                data-lat={String(event.lat)}
                data-lng={String(event.lng)}
                data-venue={event.alamat}
                class="w-full h-56 bg-neutral-100 dark:bg-void-black"
              ></div>
            </div>
          )}
        </div>

        <!-- RIGHT COLUMN: Concert Info & Ticket Selection (7 cols) -->
        <div class="lg:col-span-7 flex flex-col gap-8">
          <div>
            <div class="flex items-start justify-between gap-4 mb-2">
              <div>
                <div class="flex flex-wrap items-center gap-2 mb-2">
                  <span data-i18n="eventsPage.detailBadge" class="text-xs font-mono font-bold tracking-[0.25em] text-electric-magenta uppercase">
                    KONSER MUSIK LIVE // RESMI
                  </span>
                  {event.genre && (
                    <span class="px-2 py-0.5 rounded bg-electric-magenta/10 dark:bg-electric-magenta/20 text-electric-magenta text-[10px] font-mono font-bold uppercase">
                      {event.genre}
                    </span>
                  )}
                  {event.kota && (
                    <span class="px-2 py-0.5 rounded bg-neutral-100 dark:bg-white/10 text-neutral-700 dark:text-soft-white text-[10px] font-mono font-bold uppercase">
                      {event.kota}
                    </span>
                  )}
                </div>
                <h1 class="font-display text-4xl sm:text-6xl text-neutral-950 dark:text-soft-white tracking-wide leading-tight">
                  {event.nama_event}
                </h1>
              </div>
              <button
                type="button"
                id="detail-bookmark-btn"
                data-event-id={event.id}
                aria-label="Simpan ke Wishlist"
                class="shrink-0 mt-1 inline-flex items-center gap-2 px-4 py-2.5 rounded-full bg-white dark:bg-dark-plum border border-neutral-200 dark:border-white/15 text-xs font-semibold text-neutral-900 dark:text-soft-white shadow-sm dark:shadow-none hover:border-electric-magenta hover:text-electric-magenta transition-all"
              >
                <svg class="w-4 h-4 pointer-events-none" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
                </svg>
                <span id="detail-bookmark-label">Simpan</span>
              </button>
            </div>

            <!-- Date & Venue Highlights -->
            <div class="flex flex-wrap items-center gap-4 text-sm text-neutral-600 dark:text-muted-gray mt-4 mb-6">
              <div class="flex items-center gap-2">
                <svg class="w-4 h-4 text-electric-magenta" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                </svg>
                <span class="text-neutral-900 dark:text-soft-white font-medium">{formatDateIndo(event.tanggal_mulai)}</span>
              </div>
              <span>•</span>
              <div class="flex items-center gap-2">
                <svg class="w-4 h-4 text-electric-magenta" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                </svg>
                <span class="text-neutral-900 dark:text-soft-white font-medium">{event.alamat}</span>
              </div>
              {event.organizer_id && (
                <>
                  <span>•</span>
                  <a href={promoterHref} class="text-xs font-mono text-electric-magenta hover:underline font-semibold">
                    Promotor: {event.organization_name || `ID #${event.organizer_id}`}
                  </a>
                </>
              )}
            </div>

            <p class="text-sm sm:text-base text-neutral-600 dark:text-muted-gray leading-relaxed mb-6">
              {event.deskripsi}
            </p>

            <!-- Venue Physical Occupancy Gauge -->
            <div class="p-4 rounded-2xl bg-white dark:bg-dark-plum/70 border border-neutral-200 dark:border-white/10 shadow-sm dark:shadow-none mb-8">
              <div class="flex items-center justify-between text-xs font-mono mb-2">
                <span class="text-neutral-500 dark:text-muted-gray uppercase">Okupansi Venue & Kuota Panggung:</span>
                <span class="text-electric-magenta font-bold">{occupancyPct}% Terisi</span>
              </div>
              <div class="w-full h-2 rounded-full bg-neutral-200 dark:bg-void-black overflow-hidden">
                <div
                  class="h-full bg-gradient-to-r from-electric-magenta to-deep-magenta rounded-full transition-all duration-1000"
                  style={`width: ${occupancyPct}%;`}
                ></div>
              </div>
              <div class="flex items-center justify-between text-[11px] text-neutral-600 dark:text-muted-gray mt-2">
                <span>Kapasitas Gedung: <strong>{venueCapacity.toLocaleString('id-ID')} Penonton</strong></span>
                <span>Sisa Kuota: <strong>{event.available_quota} Tiket</strong></span>
              </div>
            </div>
          </div>

          <!-- ============================================== -->
          <!-- WAR TIKET ARENA: MULTI-TIER QUANTITY CART      -->
          <!-- ============================================== -->
          <div
            id="war-arena-box"
            data-event-id={event.id}
            data-event-paused={isPaused ? '1' : '0'}
            class="rounded-3xl bg-white dark:bg-dark-plum/90 border border-neutral-200 dark:border-white/15 p-6 sm:p-8 backdrop-blur-xl shadow-xl"
          >
            <div class="flex items-center justify-between mb-6 pb-4 border-b border-neutral-200 dark:border-white/10">
              <div>
                <h2 class="font-display text-2xl text-neutral-950 dark:text-soft-white">PILIH KATEGORI TIKET</h2>
                <p class="text-xs text-neutral-600 dark:text-muted-gray">Atur jumlah tiket tiap kelas dalam satu checkout sekaligus.</p>
              </div>
              <span class="px-2.5 py-1 rounded bg-electric-magenta/10 dark:bg-electric-magenta/15 border border-electric-magenta/30 dark:border-electric-magenta/40 text-electric-magenta font-mono text-[10px] font-bold">
                BIAYA TRANSPARAN 5%
              </span>
            </div>

            {isPaused && (
              <div class="mb-6 p-4 rounded-2xl bg-amber-50 dark:bg-amber-500/10 border border-amber-300 dark:border-amber-500/35">
                <span class="text-[11px] font-mono font-bold uppercase tracking-wider text-amber-800 dark:text-amber-300 block mb-1">
                  PENJUALAN TIKET DIJEDA SEMENTARA
                </span>
                <p class="text-xs text-amber-900 dark:text-amber-200 leading-relaxed">
                  Promotor sedang menjeda sesi penjualan tiket konser ini untuk sementara. Tombol checkout dinonaktifkan hingga penjualan dibuka kembali.
                </p>
              </div>
            )}

            <!-- Multi-Tier Category Options List -->
            <div class="space-y-4 mb-6" id="ticket-categories-list">
              {mappedCategories.map((cat) => {
                const initialQty = cat.isDefaultSelected && !isPaused ? 1 : 0;
                const maxAllowed = Math.max(0, Math.min(cat.maxLimit, Number(cat.kuota_tersedia || 0)));
                return (
                  <div
                    class={`category-card p-4 sm:p-5 rounded-2xl border transition-all ${
                      cat.isCatSoldOut
                        ? 'opacity-50 bg-neutral-100 dark:bg-void-black/40 border-neutral-200 dark:border-white/5 pointer-events-none'
                        : initialQty > 0
                        ? 'bg-electric-magenta/[0.06] dark:bg-void-black/80 border-electric-magenta shadow-magenta-glow'
                        : 'bg-neutral-50 dark:bg-void-black/50 border-neutral-200 dark:border-white/10 hover:border-neutral-400 dark:hover:border-white/25'
                    }`}
                    data-cat-id={cat.id}
                    data-cat-price={cat.harga}
                    data-cat-name={cat.nama_kategori}
                    data-cat-max={maxAllowed}
                    data-cat-limit={cat.maxLimit}
                    data-cat-available={cat.kuota_tersedia}
                    data-cat-qty={initialQty}
                  >
                    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                      <div class="flex-1">
                        <div class="flex flex-wrap items-center gap-2 mb-1">
                          <span class="w-2.5 h-2.5 rounded-full cat-indicator bg-electric-magenta"></span>
                          <h3 class="font-bold text-base text-neutral-950 dark:text-soft-white">{cat.nama_kategori}</h3>
                          {cat.isCatSoldOut ? (
                            <span class="px-2 py-0.5 rounded text-[9px] font-mono font-bold bg-neutral-200 dark:bg-black text-neutral-600 dark:text-muted-gray border border-neutral-300 dark:border-white/10">
                              HABIS
                            </span>
                          ) : (
                            <span class="px-2 py-0.5 rounded text-[9px] font-mono font-bold bg-electric-magenta/10 dark:bg-electric-magenta/20 text-electric-magenta">
                              Sisa {cat.kuota_tersedia} Tiket
                            </span>
                          )}
                        </div>
                        <p class="text-xs text-neutral-600 dark:text-muted-gray">{cat.deskripsi || 'Akses resmi arena konser AFTERGLOW.'}</p>
                        <span class="text-[10px] font-mono text-neutral-500 dark:text-muted-gray mt-1 inline-block">
                          Maks {cat.maxLimit} tiket / akun • {formatRupiah(cat.harga)} / tiket
                        </span>
                      </div>

                      <div class="flex sm:flex-col items-center sm:items-end justify-between gap-3 shrink-0">
                        <div class="text-left sm:text-right">
                          <span class="font-display text-2xl text-neutral-950 dark:text-soft-white block">
                            {formatRupiah(cat.harga)}
                          </span>
                        </div>

                        <div class="flex items-center gap-2.5">
                          <button
                            type="button"
                            class="cat-qty-minus w-8 h-8 rounded-lg bg-white dark:bg-white/5 border border-neutral-300 dark:border-white/15 text-neutral-900 dark:text-soft-white font-bold flex items-center justify-center hover:border-electric-magenta active:scale-95 transition-all disabled:opacity-35 disabled:pointer-events-none"
                            data-cat-id={cat.id}
                            disabled={cat.isCatSoldOut || isPaused}
                            aria-label={`Kurangi jumlah ${cat.nama_kategori}`}
                          >
                            -
                          </button>
                          <span
                            class="cat-qty-value font-display text-2xl text-neutral-950 dark:text-soft-white w-7 text-center"
                            data-cat-id={cat.id}
                          >
                            {initialQty}
                          </span>
                          <button
                            type="button"
                            class="cat-qty-plus w-8 h-8 rounded-lg bg-white dark:bg-white/5 border border-neutral-300 dark:border-white/15 text-neutral-900 dark:text-soft-white font-bold flex items-center justify-center hover:border-electric-magenta active:scale-95 transition-all disabled:opacity-35 disabled:pointer-events-none"
                            data-cat-id={cat.id}
                            disabled={cat.isCatSoldOut || isPaused}
                            aria-label={`Tambah jumlah ${cat.nama_kategori}`}
                          >
                            +
                          </button>
                        </div>
                      </div>
                    </div>
                  </div>
                );
              })}
            </div>

            <!-- Selected Cart Items Breakdown -->
            <div class="p-4 rounded-2xl bg-neutral-50 dark:bg-void-black/60 border border-neutral-200 dark:border-white/10 mb-6">
              <div class="flex items-center justify-between text-xs font-mono mb-2">
                <span class="font-bold text-neutral-950 dark:text-soft-white uppercase">Ringkasan Pilihan Tiket</span>
                <span id="summary-total-qty" class="text-electric-magenta font-bold">0 Tiket</span>
              </div>
              <div id="selected-items-breakdown" class="space-y-1.5 text-xs text-neutral-600 dark:text-muted-gray">
                <span>Pilih minimal 1 tiket dari kategori di atas.</span>
              </div>
            </div>

            <!-- Voucher Promo Preview Input -->
            <div class="p-4 rounded-2xl bg-neutral-50 dark:bg-void-black/60 border border-neutral-200 dark:border-white/10 mb-6">
              <label for="detail-voucher-input" class="text-xs font-bold text-neutral-950 dark:text-soft-white block mb-2">
                Punya Kode Voucher Konser?
              </label>
              <div class="flex gap-2">
                <input
                  type="text"
                  id="detail-voucher-input"
                  placeholder="MASUKKAN KODE VOUCHER"
                  class="flex-1 px-4 py-2.5 rounded-xl bg-white dark:bg-void-black border border-neutral-300 dark:border-white/15 text-xs font-mono uppercase text-neutral-950 dark:text-soft-white placeholder-neutral-400 dark:placeholder-muted-gray/60 focus:outline-none focus:border-electric-magenta"
                />
                <button
                  type="button"
                  id="detail-voucher-btn"
                  disabled={isPaused}
                  class="px-4 py-2.5 rounded-xl bg-neutral-900 hover:bg-electric-magenta dark:bg-white/10 dark:hover:bg-electric-magenta text-white dark:text-soft-white text-xs font-bold uppercase tracking-wider transition-all disabled:opacity-40"
                >
                  Pakai
                </button>
                <button
                  type="button"
                  id="detail-voucher-clear"
                  class="hidden px-3 py-2.5 rounded-xl bg-red-50 dark:bg-red-500/15 border border-red-200 dark:border-red-500/30 text-red-700 dark:text-red-300 hover:bg-red-100 dark:hover:bg-red-500/25 text-xs font-bold uppercase tracking-wider transition-all"
                >
                  Hapus
                </button>
              </div>
              <p id="detail-voucher-msg" class="hidden text-[11px] font-mono mt-2"></p>
            </div>

            <!-- Price Summary (Transparent 5% Fee Breakdown) -->
            <div class="space-y-2 py-4 border-t border-b border-neutral-200 dark:border-white/10 text-xs font-mono mb-6">
              <div class="flex justify-between text-neutral-600 dark:text-muted-gray">
                <span>Subtotal Tiket:</span>
                <span id="summary-subtotal" class="text-neutral-950 dark:text-soft-white">Rp 0</span>
              </div>
              <div id="summary-discount-row" class="hidden flex justify-between text-emerald-600 dark:text-emerald-400">
                <span>Diskon Voucher (<span id="summary-discount-code"></span>):</span>
                <span id="summary-discount">-Rp 0</span>
              </div>
              <div class="flex justify-between text-neutral-600 dark:text-muted-gray">
                <span>Platform &amp; Convenience Fee (5%):</span>
                <span id="summary-platform-fee" class="text-neutral-950 dark:text-soft-white">Rp 0</span>
              </div>
              <div class="flex justify-between text-sm font-bold pt-2 border-t border-neutral-200 dark:border-white/10">
                <span class="text-neutral-950 dark:text-soft-white font-sans">Total Tagihan Lunas:</span>
                <span id="summary-grand-total" class="font-display text-2xl text-electric-magenta">Rp 0</span>
              </div>
            </div>

            <!-- Inline Checkout Error & Pending Conflict Resolution -->
            <div id="checkout-error-box" class="hidden mb-4 p-4 rounded-2xl bg-red-50 dark:bg-red-500/10 border border-red-200 dark:border-red-500/30 text-xs text-red-700 dark:text-red-300 font-mono"></div>

            <div id="pending-order-conflict-box" class="hidden mb-5 p-5 rounded-2xl bg-amber-50 dark:bg-amber-500/10 border border-amber-300 dark:border-amber-500/35">
              <div class="flex items-start justify-between gap-3 mb-3">
                <div>
                  <span class="text-[10px] font-mono uppercase tracking-wider text-amber-700 dark:text-amber-300 font-bold block">
                    Order Aktif Masih Berlangsung
                  </span>
                  <p id="conflict-order-text" class="text-xs text-neutral-800 dark:text-soft-white mt-1 leading-relaxed">
                    Kamu masih memiliki order pending untuk konser ini. Selesaikan atau batalkan sebelum membuat order baru.
                  </p>
                </div>
                <span id="conflict-order-code" class="px-2.5 py-1 rounded bg-amber-100 dark:bg-amber-500/20 text-amber-800 dark:text-amber-300 font-mono text-[10px] font-bold shrink-0"></span>
              </div>
              <div class="flex flex-wrap gap-2">
                <a
                  id="conflict-continue-btn"
                  href="/account?tab=orders"
                  class="px-4 py-2 rounded-xl bg-amber-400 hover:bg-amber-300 text-void-black text-xs font-bold uppercase tracking-wider transition-all"
                >
                  Lanjutkan Pembayaran
                </a>
                <button
                  type="button"
                  id="conflict-cancel-btn"
                  class="px-4 py-2 rounded-xl bg-red-50 dark:bg-red-500/15 border border-red-200 dark:border-red-500/30 text-red-700 dark:text-red-300 hover:bg-red-100 dark:hover:bg-red-500/25 text-xs font-bold uppercase tracking-wider transition-all"
                >
                  Batalkan Order Sebelumnya
                </button>
              </div>
            </div>

            <!-- Checkout CTA Button -->
            <button
              id="checkout-trigger-btn"
              type="button"
              class="w-full py-4 px-8 rounded-2xl bg-electric-magenta text-white font-bold text-base tracking-wider uppercase flex items-center justify-center gap-3 hover:shadow-magenta-glow transition-all duration-300 hover:scale-[1.01] active:scale-[0.99] disabled:opacity-50 disabled:pointer-events-none"
              disabled={isSoldOut || isPaused || mappedCategories.length === 0}
            >
              <span class="btn-text">
                {isPaused ? 'PENJUALAN DIJEDA SEMENTARA' : 'WAR TIKET SEKARANG // LANJUTKAN CHECKOUT'}
              </span>
              <svg class="w-5 h-5 btn-spinner hidden animate-spin" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
              </svg>
            </button>
          </div>
        </div>
      </div>

      <!-- LOWER SECTION: Lineup, Rundown, Facilities, Rules -->
      <div class="mt-20 space-y-16">
        {event.lineup && event.lineup.length > 0 && (
          <section>
            <div class="mb-8">
              <span class="text-xs font-mono font-bold tracking-[0.25em] text-electric-magenta uppercase block mb-1">
                SUSUNAN PENGISI ACARA
              </span>
              <h2 class="font-display text-3xl sm:text-4xl text-neutral-950 dark:text-soft-white">LINEUP MUSISI PANGGUNG</h2>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6">
              {event.lineup.map((performer) => (
                <div class="p-5 rounded-2xl bg-white dark:bg-dark-plum border border-neutral-200 dark:border-white/10 shadow-sm dark:shadow-none flex items-center gap-4 group hover:border-electric-magenta/60 transition-all">
                  <div class="w-14 h-14 rounded-full bg-neutral-50 dark:bg-void-black border border-neutral-200 dark:border-white/15 flex items-center justify-center font-display text-xl text-electric-magenta shrink-0 group-hover:scale-110 transition-transform">
                    {performer.name.charAt(0)}
                  </div>
                  <div>
                    <span class="text-[10px] font-mono font-bold px-2 py-0.5 rounded bg-electric-magenta/10 dark:bg-electric-magenta/20 text-electric-magenta uppercase">
                      {performer.role || 'Artist'}
                    </span>
                    <h4 class="font-bold text-base text-neutral-950 dark:text-soft-white mt-1">{performer.name}</h4>
                    <p class="text-xs text-neutral-600 dark:text-muted-gray">{performer.time || 'Waktu TBA'}</p>
                  </div>
                </div>
              ))}
            </div>
          </section>
        )}

        {event.rundown && event.rundown.length > 0 && (
          <section>
            <div class="mb-8">
              <span class="text-xs font-mono font-bold tracking-[0.25em] text-electric-magenta uppercase block mb-1">
                JADWAL &amp; WAKTU ACARA
              </span>
              <h2 class="font-display text-3xl sm:text-4xl text-neutral-950 dark:text-soft-white">RUNDOWN PANGGUNG KONSER</h2>
            </div>

            <div class="space-y-4">
              {event.rundown.map((item) => (
                <div class="p-5 rounded-2xl bg-white dark:bg-dark-plum/70 border border-neutral-200 dark:border-white/10 shadow-sm dark:shadow-none flex items-start gap-5">
                  <div class="px-3 py-1.5 rounded-xl bg-neutral-50 dark:bg-void-black border border-electric-magenta/40 text-electric-magenta font-mono text-xs font-bold shrink-0">
                    {item.time}
                  </div>
                  <div>
                    <h4 class="font-bold text-sm text-neutral-950 dark:text-soft-white">{item.title}</h4>
                    <p class="text-xs text-neutral-600 dark:text-muted-gray mt-0.5">{item.description}</p>
                  </div>
                </div>
              ))}
            </div>
          </section>
        )}

        {event.facilities && event.facilities.length > 0 && (
          <section>
            <div class="mb-6">
              <span class="text-xs font-mono font-bold tracking-[0.25em] text-electric-magenta uppercase block mb-1">
                KENYAMANAN PENONTON
              </span>
              <h2 class="font-display text-3xl sm:text-4xl text-neutral-950 dark:text-soft-white">FASILITAS VENUE GEDUNG</h2>
            </div>

            <div class="flex flex-wrap gap-3">
              {event.facilities.map((fac) => (
                <span class="px-4 py-2.5 rounded-xl bg-white dark:bg-dark-plum border border-neutral-200 dark:border-white/10 shadow-sm dark:shadow-none text-xs font-medium text-neutral-900 dark:text-soft-white flex items-center gap-2">
                  <span class="w-2 h-2 rounded-full bg-electric-magenta"></span>
                  <span>{fac}</span>
                </span>
              ))}
            </div>
          </section>
        )}

        {event.rules && event.rules.length > 0 && (
          <section class="p-8 rounded-3xl bg-white dark:bg-dark-plum/50 border border-neutral-200 dark:border-white/10 shadow-sm dark:shadow-none">
            <h3 class="font-display text-2xl text-neutral-950 dark:text-soft-white mb-4">SYARAT &amp; KETENTUAN MASUK VENUE</h3>
            <ul class="space-y-2.5 text-xs text-neutral-600 dark:text-muted-gray list-disc pl-5">
              {event.rules.map((rule) => (
                <li>{rule}</li>
              ))}
            </ul>
          </section>
        )}
      </div>
    </div>
  )}

  <Footer />
</RootLayout>

<script>
  import { AttributionControl, Map as MapLibreMap, Marker, NavigationControl, type StyleSpecification } from 'maplibre-gl';
  import 'maplibre-gl/dist/maplibre-gl.css';
  import { api, ApiError } from '../../lib/api';
  import { isAuthenticated } from '../../lib/auth';
  import { calculatePlatformFee, toggleBookmark, validateVoucher } from '../../lib/events';
  import { escapeHtml, formatRupiah } from '../../lib/formatters';

  const CARTO_DARK_STYLE = 'https://basemaps.cartocdn.com/gl/dark-matter-gl-style/style.json';
  const CARTO_LIGHT_STYLE = 'https://basemaps.cartocdn.com/gl/positron-gl-style/style.json';
  const OSM_RASTER_FALLBACK: StyleSpecification = {
    version: 8,
    sources: {
      osm: {
        type: 'raster',
        tiles: ['https://tile.openstreetmap.org/{z}/{x}/{y}.png'],
        tileSize: 256,
        attribution: '© OpenStreetMap contributors',
      },
    },
    layers: [{ id: 'osm-tiles', type: 'raster', source: 'osm' }],
  };

  interface TierCartItem {
    categoryId: number;
    name: string;
    price: number;
    max: number;
    qty: number;
  }

  function initWarArena() {
    const arenaBox = document.getElementById('war-arena-box');
    const eventId = Number(arenaBox?.dataset.eventId || window.location.pathname.split('/').filter(Boolean).pop() || 0);
    const isPaused = arenaBox?.dataset.eventPaused === '1';

    let venueMap: MapLibreMap | null = null;
    const mapContainer = document.getElementById('event-venue-map');
    if (mapContainer) {
      const lat = Number(mapContainer.dataset.lat);
      const lng = Number(mapContainer.dataset.lng);
      if (Number.isFinite(lat) && Number.isFinite(lng)) {
        const isDark = document.documentElement.classList.contains('dark');
        try {
          venueMap = new MapLibreMap({
            container: mapContainer,
            style: isDark ? CARTO_DARK_STYLE : CARTO_LIGHT_STYLE,
            center: [lng, lat],
            zoom: 14,
            attributionControl: false,
          });
          venueMap.addControl(new AttributionControl({ compact: true }), 'bottom-right');
          venueMap.addControl(new NavigationControl({ showCompass: false }), 'top-right');
          new Marker({ color: '#D14D91', draggable: false }).setLngLat([lng, lat]).addTo(venueMap);
          let fallbackApplied = false;
          venueMap.on('error', () => {
            if (!fallbackApplied && venueMap) {
              fallbackApplied = true;
              venueMap.setStyle(OSM_RASTER_FALLBACK);
            }
          });
        } catch (mapErr) {
          console.warn('[Venue Map Init Error]:', mapErr);
        }
      }
    }

    if (!arenaBox) {
      return () => {
        if (venueMap) venueMap.remove();
      };
    }

    const categoryCards = document.querySelectorAll<HTMLElement>('.category-card');
    const summaryTotalQty = document.getElementById('summary-total-qty');
    const breakdownBox = document.getElementById('selected-items-breakdown');
    const subtotalDisplay = document.getElementById('summary-subtotal');
    const discountRow = document.getElementById('summary-discount-row');
    const discountCodeSpan = document.getElementById('summary-discount-code');
    const discountDisplay = document.getElementById('summary-discount');
    const feeDisplay = document.getElementById('summary-platform-fee');
    const grandTotalDisplay = document.getElementById('summary-grand-total');
    const checkoutBtn = document.getElementById('checkout-trigger-btn') as HTMLButtonElement | null;

    const voucherInput = document.getElementById('detail-voucher-input') as HTMLInputElement | null;
    const voucherBtn = document.getElementById('detail-voucher-btn') as HTMLButtonElement | null;
    const voucherClearBtn = document.getElementById('detail-voucher-clear') as HTMLButtonElement | null;
    const voucherMsg = document.getElementById('detail-voucher-msg');

    const errorBox = document.getElementById('checkout-error-box');
    const conflictBox = document.getElementById('pending-order-conflict-box');
    const conflictCodeBadge = document.getElementById('conflict-order-code');
    const conflictText = document.getElementById('conflict-order-text');
    const conflictContinueBtn = document.getElementById('conflict-continue-btn') as HTMLAnchorElement | null;
    const conflictCancelBtn = document.getElementById('conflict-cancel-btn') as HTMLButtonElement | null;

    const bookmarkBtn = document.getElementById('detail-bookmark-btn') as HTMLButtonElement | null;
    const bookmarkLabel = document.getElementById('detail-bookmark-label');

    const cartMap = new Map<number, TierCartItem>();
    categoryCards.forEach((card) => {
      const catId = Number(card.dataset.catId || 0);
      if (!catId) return;
      cartMap.set(catId, {
        categoryId: catId,
        name: card.dataset.catName || `Tier #${catId}`,
        price: Number(card.dataset.catPrice || 0),
        max: Number(card.dataset.catMax || 0),
        qty: Number(card.dataset.catQty || 0),
      });
    });

    let appliedVoucherCode = '';
    let appliedDiscountAmount = 0;
    let appliedPlatformFee: number | null = null;

    let cartSignature = '';
    let idempotencyKey = crypto.randomUUID();
    let conflictOrderCode = '';

    function getActiveItems(): TierCartItem[] {
      return Array.from(cartMap.values()).filter((item) => item.qty > 0);
    }

    function getCartSubtotal(): number {
      return getActiveItems().reduce((sum, item) => sum + item.price * item.qty, 0);
    }

    function refreshIdempotencyKey() {
      const tierSig = getActiveItems()
        .map((i) => `${i.categoryId}:${i.qty}`)
        .sort()
        .join('|');
      const nextSig = `${eventId}:${tierSig}:${appliedVoucherCode}`;
      if (nextSig !== cartSignature) {
        cartSignature = nextSig;
        idempotencyKey = crypto.randomUUID();
      }
    }

    function setVoucherFeedback(text: string, type: 'success' | 'error' | 'hidden') {
      if (!voucherMsg) return;
      if (type === 'hidden') {
        voucherMsg.className = 'hidden text-[11px] font-mono mt-2';
        voucherMsg.textContent = '';
        return;
      }
      voucherMsg.textContent = text;
      voucherMsg.className = `text-[11px] font-mono mt-2 ${
        type === 'success' ? 'text-emerald-600 dark:text-emerald-400' : 'text-red-600 dark:text-red-400'
      }`;
    }

    function clearErrorAndConflict() {
      errorBox?.classList.add('hidden');
      if (errorBox) errorBox.textContent = '';
      conflictBox?.classList.add('hidden');
    }

    function setBookmarkUi(saved: boolean) {
      if (!bookmarkBtn) return;
      const svg = bookmarkBtn.querySelector('svg');
      if (saved) {
        bookmarkBtn.classList.add('border-electric-magenta', 'text-electric-magenta');
        svg?.setAttribute('fill', 'currentColor');
        if (bookmarkLabel) bookmarkLabel.textContent = 'Tersimpan';
      } else {
        bookmarkBtn.classList.remove('border-electric-magenta', 'text-electric-magenta');
        svg?.setAttribute('fill', 'none');
        if (bookmarkLabel) bookmarkLabel.textContent = 'Simpan';
      }
    }

    async function syncBookmarkStatus() {
      if (!isAuthenticated() || !eventId) {
        setBookmarkUi(false);
        return;
      }
      try {
        const rows = await api.get<Array<{ id: number }>>('/users/bookmarks');
        const saved = Array.isArray(rows) && rows.some((r) => Number(r.id) === eventId);
        setBookmarkUi(saved);
      } catch {}
    }

    bookmarkBtn?.addEventListener('click', async () => {
      if (!isAuthenticated()) {
        if (typeof (window as any).openAuthModal === 'function') (window as any).openAuthModal();
        else window.location.href = '/masuk';
        return;
      }
      if (!eventId) return;
      try {
        const res = await toggleBookmark(eventId);
        setBookmarkUi(Boolean(res.bookmarked ?? res.is_bookmarked));
      } catch (err: any) {
        console.error('[Bookmark Error]:', err);
      }
    });

    async function revalidateAppliedVoucherIfNeeded() {
      if (!appliedVoucherCode) return;
      const subtotal = getCartSubtotal();
      if (subtotal <= 0) {
        appliedDiscountAmount = 0;
        appliedPlatformFee = null;
        return;
      }
      try {
        const res = await validateVoucher(appliedVoucherCode, eventId, subtotal);
        appliedDiscountAmount = Number(res.diskon_amount || 0);
        appliedPlatformFee = res.platform_fee !== undefined ? Number(res.platform_fee) : null;
        setVoucherFeedback(
          `Voucher ${res.kode_voucher} aktif — Hemat ${formatRupiah(appliedDiscountAmount)}`,
          'success'
        );
      } catch (err: any) {
        appliedVoucherCode = '';
        appliedDiscountAmount = 0;
        appliedPlatformFee = null;
        voucherClearBtn?.classList.add('hidden');
        setVoucherFeedback(err?.message || 'Voucher tidak lagi memenuhi syarat subtotal baru.', 'error');
      }
    }

    function paintCategoryCards() {
      categoryCards.forEach((card) => {
        const catId = Number(card.dataset.catId || 0);
        const item = cartMap.get(catId);
        if (!item) return;

        card.dataset.catQty = String(item.qty);
        const qtySpan = card.querySelector<HTMLElement>('.cat-qty-value');
        const minusBtn = card.querySelector<HTMLButtonElement>('.cat-qty-minus');
        const plusBtn = card.querySelector<HTMLButtonElement>('.cat-qty-plus');

        if (qtySpan) qtySpan.textContent = String(item.qty);
        if (minusBtn) minusBtn.disabled = isPaused || item.max <= 0 || item.qty <= 0;
        if (plusBtn) plusBtn.disabled = isPaused || item.max <= 0 || item.qty >= item.max;

        if (item.max <= 0) return;

        if (item.qty > 0) {
          card.classList.remove('bg-neutral-50', 'dark:bg-void-black/50', 'border-neutral-200', 'dark:border-white/10');
          card.classList.add('bg-electric-magenta/[0.06]', 'dark:bg-void-black/80', 'border-electric-magenta', 'shadow-magenta-glow');
        } else {
          card.classList.remove('bg-electric-magenta/[0.06]', 'dark:bg-void-black/80', 'border-electric-magenta', 'shadow-magenta-glow');
          card.classList.add('bg-neutral-50', 'dark:bg-void-black/50', 'border-neutral-200', 'dark:border-white/10');
        }
      });
    }

    function updateTotals() {
      paintCategoryCards();
      const activeItems = getActiveItems();
      const totalQty = activeItems.reduce((sum, item) => sum + item.qty, 0);
      const subtotal = getCartSubtotal();
      const safeDiscount = Math.min(subtotal, Math.max(0, appliedDiscountAmount));
      const netSubtotal = Math.max(0, subtotal - safeDiscount);
      const platformFee =
        activeItems.length === 0
          ? 0
          : appliedPlatformFee !== null
          ? appliedPlatformFee
          : calculatePlatformFee(netSubtotal);
      const grandTotal = netSubtotal + platformFee;

      if (summaryTotalQty) summaryTotalQty.textContent = `${totalQty} Tiket`;
      if (breakdownBox) {
        if (activeItems.length === 0) {
          breakdownBox.innerHTML = '<span>Pilih minimal 1 tiket dari kategori di atas.</span>';
        } else {
          breakdownBox.innerHTML = activeItems
            .map(
              (item) => `
              <div class="flex items-center justify-between gap-2 text-neutral-800 dark:text-soft-white font-mono">
                <span>${item.qty}x ${escapeHtml(item.name)}</span>
                <span class="font-semibold">${escapeHtml(formatRupiah(item.price * item.qty))}</span>
              </div>`
            )
            .join('');
        }
      }

      if (subtotalDisplay) subtotalDisplay.textContent = formatRupiah(subtotal);
      if (discountRow && discountDisplay && discountCodeSpan) {
        if (appliedVoucherCode && safeDiscount > 0) {
          discountRow.classList.remove('hidden');
          discountCodeSpan.textContent = appliedVoucherCode;
          discountDisplay.textContent = `-${formatRupiah(safeDiscount)}`;
        } else {
          discountRow.classList.add('hidden');
        }
      }
      if (feeDisplay) feeDisplay.textContent = formatRupiah(platformFee);
      if (grandTotalDisplay) grandTotalDisplay.textContent = formatRupiah(grandTotal);

      if (checkoutBtn) {
        checkoutBtn.disabled = isPaused || activeItems.length === 0;
      }
      refreshIdempotencyKey();
    }

    async function adjustTierQty(catId: number, delta: number) {
      if (isPaused) return;
      const item = cartMap.get(catId);
      if (!item || item.max <= 0) return;
      const nextQty = Math.max(0, Math.min(item.max, item.qty + delta));
      if (nextQty === item.qty) return;
      item.qty = nextQty;
      appliedPlatformFee = null;
      await revalidateAppliedVoucherIfNeeded();
      updateTotals();
    }

    categoryCards.forEach((card) => {
      const catId = Number(card.dataset.catId || 0);
      const minusBtn = card.querySelector<HTMLButtonElement>('.cat-qty-minus');
      const plusBtn = card.querySelector<HTMLButtonElement>('.cat-qty-plus');

      minusBtn?.addEventListener('click', (e) => {
        e.stopPropagation();
        adjustTierQty(catId, -1);
      });
      plusBtn?.addEventListener('click', (e) => {
        e.stopPropagation();
        adjustTierQty(catId, 1);
      });
    });

    voucherBtn?.addEventListener('click', async () => {
      if (!isAuthenticated()) {
        if (typeof (window as any).openAuthModal === 'function') (window as any).openAuthModal();
        else window.location.href = '/masuk';
        return;
      }
      const code = voucherInput?.value.trim().toUpperCase() || '';
      if (!code) {
        setVoucherFeedback('Masukkan kode voucher terlebih dahulu.', 'error');
        return;
      }
      const subtotal = getCartSubtotal();
      if (subtotal <= 0) {
        setVoucherFeedback('Pilih minimal 1 tiket sebelum menerapkan voucher.', 'error');
        return;
      }

      voucherBtn.disabled = true;
      voucherBtn.textContent = '...';
      try {
        const res = await validateVoucher(code, eventId, subtotal);
        appliedVoucherCode = res.kode_voucher;
        appliedDiscountAmount = Number(res.diskon_amount || 0);
        appliedPlatformFee = res.platform_fee !== undefined ? Number(res.platform_fee) : null;
        if (voucherInput) voucherInput.value = appliedVoucherCode;
        voucherClearBtn?.classList.remove('hidden');
        setVoucherFeedback(
          `Voucher ${appliedVoucherCode} valid — Diskon ${formatRupiah(appliedDiscountAmount)}`,
          'success'
        );
        updateTotals();
      } catch (err: any) {
        appliedVoucherCode = '';
        appliedDiscountAmount = 0;
        appliedPlatformFee = null;
        voucherClearBtn?.classList.add('hidden');
        setVoucherFeedback(err?.message || 'Kode voucher tidak valid atau kuota habis.', 'error');
        updateTotals();
      } finally {
        voucherBtn.disabled = isPaused;
        voucherBtn.textContent = 'Pakai';
      }
    });

    voucherClearBtn?.addEventListener('click', () => {
      appliedVoucherCode = '';
      appliedDiscountAmount = 0;
      appliedPlatformFee = null;
      if (voucherInput) voucherInput.value = '';
      voucherClearBtn.classList.add('hidden');
      setVoucherFeedback('', 'hidden');
      updateTotals();
    });

    conflictCancelBtn?.addEventListener('click', async () => {
      if (!conflictOrderCode) return;
      conflictCancelBtn.disabled = true;
      conflictCancelBtn.textContent = 'Membatalkan...';
      try {
        await api.post(`/orders/${conflictOrderCode}/cancel`, {});
        conflictBox?.classList.add('hidden');
        conflictOrderCode = '';
        idempotencyKey = crypto.randomUUID();
        window.dispatchEvent(new CustomEvent('afterglow-order-updated'));
        if (errorBox) {
          errorBox.className = 'mb-4 p-4 rounded-2xl bg-emerald-50 dark:bg-emerald-500/10 border border-emerald-200 dark:border-emerald-500/30 text-xs text-emerald-700 dark:text-emerald-300 font-mono';
          errorBox.textContent = 'Order sebelumnya berhasil dibatalkan. Klik tombol War Tiket sekarang untuk membuat pesanan baru.';
          errorBox.classList.remove('hidden');
        }
      } catch (err: any) {
        if (errorBox) {
          errorBox.className = 'mb-4 p-4 rounded-2xl bg-red-50 dark:bg-red-500/10 border border-red-200 dark:border-red-500/30 text-xs text-red-700 dark:text-red-300 font-mono';
          errorBox.textContent = err?.message || 'Gagal membatalkan order aktif.';
          errorBox.classList.remove('hidden');
        }
      } finally {
        conflictCancelBtn.disabled = false;
        conflictCancelBtn.textContent = 'Batalkan Order Sebelumnya';
      }
    });

    updateTotals();
    syncBookmarkStatus();
    const onAuthChanged = () => { syncBookmarkStatus(); };
    window.addEventListener('afterglow-auth-changed', onAuthChanged);

    checkoutBtn?.addEventListener('click', async () => {
      if (isPaused) return;
      if (!isAuthenticated()) {
        if (typeof (window as any).openAuthModal === 'function') (window as any).openAuthModal();
        else window.location.href = '/masuk';
        return;
      }

      clearErrorAndConflict();

      const items = getActiveItems().map((item) => ({
        category_id: item.categoryId,
        qty: item.qty,
      }));

      if (items.length === 0) {
        if (errorBox) {
          errorBox.className = 'mb-4 p-4 rounded-2xl bg-red-50 dark:bg-red-500/10 border border-red-200 dark:border-red-500/30 text-xs text-red-700 dark:text-red-300 font-mono';
          errorBox.textContent = 'Silakan pilih minimal 1 tiket dari kategori yang tersedia.';
          errorBox.classList.remove('hidden');
        }
        return;
      }

      checkoutBtn.disabled = true;
      const text = checkoutBtn.querySelector('.btn-text');
      const spinner = checkoutBtn.querySelector('.btn-spinner');
      text?.classList.add('opacity-50');
      spinner?.classList.remove('hidden');

      try {
        const res = await api.post(
          '/orders/checkout',
          {
            event_id: eventId,
            items,
            ...(appliedVoucherCode ? { voucher_code: appliedVoucherCode } : {}),
            idempotency_key: idempotencyKey,
          },
          { idempotencyKey }
        );

        window.dispatchEvent(new CustomEvent('afterglow-order-updated'));
        window.location.href = `/orders/${res.order_code}`;
      } catch (err: any) {
        const msg = String(err?.message || 'Gagal memproses pemesanan tiket.');
        const isConflict =
          (err instanceof ApiError && err.status === 409) ||
          (msg.toLowerCase().includes('order') && msg.toLowerCase().includes('pending')) ||
          /ORD-[A-Z0-9-]+/i.test(msg);

        if (isConflict) {
          let activeCode = msg.match(/ORD-[A-Z0-9-]+/i)?.[0] || '';
          try {
            const active = await api.get<{ order_code?: string; nama_event?: string } | null>('/users/active-order');
            if (active?.order_code) activeCode = active.order_code;
          } catch {}

          if (activeCode && conflictBox) {
            conflictOrderCode = activeCode;
            if (conflictCodeBadge) conflictCodeBadge.textContent = activeCode;
            if (conflictText) conflictText.textContent = msg;
            if (conflictContinueBtn) conflictContinueBtn.href = `/orders/${activeCode}`;
            conflictBox.classList.remove('hidden');
          } else if (errorBox) {
            errorBox.className = 'mb-4 p-4 rounded-2xl bg-red-50 dark:bg-red-500/10 border border-red-200 dark:border-red-500/30 text-xs text-red-700 dark:text-red-300 font-mono';
            errorBox.textContent = msg;
            errorBox.classList.remove('hidden');
          }
        } else if (errorBox) {
          errorBox.className = 'mb-4 p-4 rounded-2xl bg-red-50 dark:bg-red-500/10 border border-red-200 dark:border-red-500/30 text-xs text-red-700 dark:text-red-300 font-mono';
          errorBox.textContent = msg;
          errorBox.classList.remove('hidden');
        }

        checkoutBtn.disabled = isPaused || getActiveItems().length === 0;
        text?.classList.remove('opacity-50');
        spinner?.classList.add('hidden');
      }
    });

    return () => {
      window.removeEventListener('afterglow-auth-changed', onAuthChanged);
      if (venueMap) venueMap.remove();
    };
  }

  let warArenaCleanup: (() => void) | undefined;
  document.addEventListener('astro:page-load', () => {
    if (warArenaCleanup) warArenaCleanup();
    warArenaCleanup = initWarArena();
  });
</script>
