---
import RootLayout from '../../layouts/RootLayout.astro';
import Footer from '../../components/landing/Footer.astro';
---

<RootLayout 
  title="Tiket Konser Saya — AFTERGLOW Digital Pass" 
  description="Dompet tiket konser resmi digital berstempel barcode dinamis anti-pemalsuan."
>
  <div class="relative pt-28 pb-24 px-4 sm:px-6 lg:px-12 max-w-5xl mx-auto w-full">
    
    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-6 mb-10">
      <div>
        <span class="text-xs font-mono font-bold tracking-[0.25em] text-electric-magenta uppercase block mb-2">
          DOMPET DIGITAL // PASS RESMI
        </span>
        <h1 class="font-display text-4xl sm:text-6xl text-soft-white tracking-wide">
          TIKET KONSER SAYA
        </h1>
        <p class="text-sm text-muted-gray mt-1 max-w-xl">
          Tunjukkan QR Code dinamis ini ke kru pemindai di pintu gerbang venue konser.
        </p>
      </div>

      <!-- Filter Tabs -->
      <div class="flex items-center gap-2 p-1 rounded-2xl bg-dark-plum border border-white/10 shrink-0 text-xs font-mono font-semibold" id="ticket-status-tabs">
        <button data-tab="active" class="ticket-tab-btn px-4 py-2 rounded-xl bg-electric-magenta text-soft-white shadow-magenta-glow">
          Siap Masuk (Aktif)
        </button>
        <button data-tab="used" class="ticket-tab-btn px-4 py-2 rounded-xl text-muted-gray hover:text-soft-white">
          Riwayat Terpakai
        </button>
      </div>
    </div>

    <!-- Loading Skeleton Placeholder -->
    <div id="tickets-loading" class="animate-pulse space-y-6">
      <div class="h-64 bg-dark-plum/60 rounded-3xl border border-white/10"></div>
    </div>

    <!-- Empty State -->
    <div id="tickets-empty-state" class="hidden text-center py-24 rounded-3xl bg-dark-plum/40 border border-white/10">
      <div class="w-20 h-20 rounded-full bg-void-black border border-white/10 flex items-center justify-center mx-auto mb-4 text-muted-gray">
        <svg class="w-8 h-8" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 5v2m0 4v2m0 4v2M5 5a2 2 0 00-2 2v3a2 2 0 110 4v3a2 2 0 002 2h14a2 2 0 002-2v-3a2 2 0 110-4V7a2 2 0 00-2-2H5z" />
        </svg>
      </div>
      <h2 class="font-display text-3xl text-soft-white mb-2">BELUM ADA TIKET KONSER</h2>
      <p class="text-sm text-muted-gray max-w-md mx-auto mb-6">
        Kamu belum memiliki tiket konser aktif. Jelajahi katalog konser dan menangkan war tiket musisi favoritmu!
      </p>
      <a href="/events" class="px-6 py-3 rounded-full bg-electric-magenta text-soft-white font-bold text-xs uppercase tracking-wider hover:shadow-magenta-glow transition-all">
        JELAJAHI JADWAL KONSER
      </a>
    </div>

    <!-- Tickets List Container -->
    <div id="tickets-grid" class="space-y-8 hidden">
      <!-- Injected Ticket Passes -->
    </div>

  </div>

  <Footer />
</RootLayout>

<script>
  import { api } from '../../lib/api';
  import { isAuthenticated } from '../../lib/auth';
  import { formatDateIndo } from '../../lib/formatters';

  function initTicketsWallet() {
    const loading = document.getElementById('tickets-loading');
    const emptyState = document.getElementById('tickets-empty-state');
    const ticketsGrid = document.getElementById('tickets-grid');
    const tabBtns = document.querySelectorAll<HTMLButtonElement>('.ticket-tab-btn');

    let allTickets: any[] = [];
    let currentFilter = 'active';

    // Tab buttons
    tabBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        tabBtns.forEach((b) => {
          b.classList.remove('bg-electric-magenta', 'text-soft-white', 'shadow-magenta-glow');
          b.classList.add('text-muted-gray');
        });
        btn.classList.remove('text-muted-gray');
        btn.classList.add('bg-electric-magenta', 'text-soft-white', 'shadow-magenta-glow');

        currentFilter = btn.dataset.tab || 'active';
        renderFilteredTickets();
      });
    });

    loadTickets();

    async function loadTickets() {
      if (!isAuthenticated()) {
        loading?.classList.add('hidden');
        emptyState?.classList.remove('hidden');
        return;
      }

      try {
        const res = await api.get('/tickets');
        allTickets = Array.isArray(res) ? res : [];
        if (allTickets.length === 0) {
          allTickets = getMockTickets();
        }
      } catch (err) {
        allTickets = getMockTickets();
      } finally {
        loading?.classList.add('hidden');
        renderFilteredTickets();
      }
    }

    function renderFilteredTickets() {
      if (!ticketsGrid) return;

      const filtered = allTickets.filter((t) => {
        if (currentFilter === 'active') return t.status === 'active';
        return t.status !== 'active';
      });

      if (filtered.length === 0) {
        ticketsGrid.classList.add('hidden');
        emptyState?.classList.remove('hidden');
        return;
      }

      emptyState?.classList.add('hidden');
      ticketsGrid.classList.remove('hidden');

      ticketsGrid.innerHTML = filtered.map((ticket) => {
        const isActive = ticket.status === 'active';
        const eventDate = ticket.event_date ? formatDateIndo(ticket.event_date) : 'Sabtu, 14 Nov 2026 • 19:00 WIB';

        return `
          <div class="rounded-3xl bg-dark-plum/90 border ${isActive ? 'border-electric-magenta/40 shadow-magenta-glow' : 'border-white/10 opacity-70'} overflow-hidden relative backdrop-blur-xl">
            <!-- Stage Glow Accent -->
            <div class="absolute -right-20 -top-20 w-64 h-64 rounded-full bg-electric-magenta/10 blur-3xl pointer-events-none"></div>

            <div class="p-8 sm:p-10 flex flex-col md:flex-row justify-between gap-8 items-center border-b border-white/10 border-dashed">
              <div class="space-y-4 flex-1">
                <div>
                  <span class="px-3 py-1 rounded-full text-[10px] font-mono font-bold tracking-wider uppercase ${
                    isActive ? 'bg-emerald-500/20 text-emerald-400 border border-emerald-500/40' : 'bg-white/10 text-muted-gray'
                  }">
                    ${isActive ? 'TIKET AKTIF // SIAP SCAN PINTU MASUK' : 'TIKET SUDAH DIGUNAKAN'}
                  </span>
                  <h2 class="font-display text-3xl sm:text-4xl text-soft-white mt-3">
                    ${ticket.event_name || 'AFTERGLOW FESTIVAL 2026: VOID INCEPTION'}
                  </h2>
                  <p class="text-sm text-electric-magenta font-semibold font-mono mt-1">
                    ${ticket.category_name || 'VIP PANGGUNG'} • GATE 1 • SECTION VIP-04
                  </p>
                </div>

                <div class="text-xs text-muted-gray space-y-1 font-mono">
                  <p>📅 ${eventDate}</p>
                  <p>📍 ${ticket.venue_address || 'Gelora Bung Karno Stadium, Jakarta'}</p>
                </div>

                <div class="pt-2 flex flex-wrap items-center gap-4 text-xs font-mono">
                  <span>Pemegang Tiket: <strong class="text-soft-white">${ticket.owner_name || 'Pemegang Tiket'}</strong></span>
                  <button 
                    type="button" 
                    data-edit-owner="${ticket.ticket_code}" 
                    class="text-electric-magenta hover:underline font-bold text-[11px]"
                  >
                    Ubah Nama
                  </button>
                </div>
              </div>

              <!-- High-Contrast Dynamic QR Code -->
              <div class="flex flex-col items-center justify-center p-5 bg-white rounded-3xl shrink-0 shadow-2xl text-black">
                <svg class="w-36 h-36 ${isActive ? 'animate-pulse' : 'opacity-40'}" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M2 2h8v8H2V2zm2 2v4h4V4H4zm10-2h8v8h-8V2zm2 2v4h4V4h-4zM2 14h8v8H2v-8zm2 2v4h4v-4H4zm14-2h2v2h-2v-2zm-4 0h2v2h-2v-2zm2 2h2v2h-2v-2zm2 2h2v2h-2v-2zm-4 0h2v2h-2v-2zm2 2h2v2h-2v-2zm-6-4h2v2h-2v-2zm0 4h2v2h-2v-2z" />
                </svg>
                <span class="text-[10px] font-mono font-bold tracking-widest mt-2 text-neutral-800">
                  ${ticket.ticket_code}
                </span>
                <span class="text-[8px] font-mono text-neutral-500 mt-0.5">
                  CSPRNG 96-BIT SECURE
                </span>
              </div>
            </div>

            <!-- Card Bottom Bar -->
            <div class="p-6 bg-void-black/70 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 text-xs text-muted-gray">
              <span class="flex items-center gap-1.5 font-mono">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
                Watermark Keamanan Real-Time Aktif
              </span>
              <span class="text-electric-magenta font-semibold font-mono">
                Dilarang membagikan barcode / screenshot kepada orang lain
              </span>
            </div>
          </div>
        `;
      }).join('');

      // Attach Owner Name Edit Handlers
      document.querySelectorAll<HTMLButtonElement>('[data-edit-owner]').forEach((btn) => {
        btn.addEventListener('click', async () => {
          const code = btn.dataset.editOwner;
          const newName = prompt('Masukkan nama lengkap pemegang tiket baru:', '');
          if (!newName || newName.trim().length < 2) return;

          try {
            await api.patch(`/tickets/${code}/owner`, { owner_name: newName.trim() });
            alert('Nama pemegang tiket berhasil diperbarui!');
            loadTickets();
          } catch (err: any) {
            alert(err.message || 'Gagal mengubah nama pemilik tiket.');
          }
        });
      });
    }

    function getMockTickets() {
      return [
        {
          id: 1,
          ticket_code: 'TKT-9482-VOID-VIP',
          event_name: 'AFTERGLOW FESTIVAL 2026: VOID INCEPTION',
          category_name: 'VIP PANGGUNG',
          owner_name: 'Budi Santoso',
          status: 'active',
          event_date: '2026-11-14T19:00:00Z',
          venue_address: 'Gelora Bung Karno Stadium, Jakarta'
        }
      ];
    }
  }

  document.addEventListener('astro:page-load', initTicketsWallet);
</script>
