---
import RootLayout from '../../layouts/RootLayout.astro';
import Footer from '../../components/landing/Footer.astro';
---

<RootLayout 
  title="Tiket Konser Saya — AFTERGLOW Digital Pass" 
  description="Dompet tiket konser resmi digital berstempel barcode dinamis anti-pemalsuan."
>
  <div id="tickets-page-main" class="relative pt-28 pb-24 px-4 sm:px-6 lg:px-12 max-w-5xl mx-auto w-full print:hidden">
    
    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-6 mb-10">
      <div>
        <span data-i18n="ticketsPage.badge" class="text-xs font-mono font-bold tracking-[0.25em] text-electric-magenta uppercase block mb-2">
          DOMPET DIGITAL // PASS RESMI
        </span>
        <h1 data-i18n="ticketsPage.title" class="font-display text-4xl sm:text-6xl text-neutral-950 dark:text-soft-white tracking-wide">
          TIKET KONSER SAYA
        </h1>
        <p data-i18n="ticketsPage.subtitle" class="text-sm text-neutral-600 dark:text-muted-gray mt-1 max-w-xl">
          Buka Boarding Pass QR resmi dan tunjukkan ke kru pemindai di pintu gerbang venue konser.
        </p>
      </div>

      <!-- Filter Tabs -->
      <div class="flex flex-wrap items-center gap-1.5 p-1 rounded-2xl bg-white dark:bg-dark-plum border border-neutral-200 dark:border-white/10 shadow-sm dark:shadow-none shrink-0 text-xs font-mono font-semibold" id="ticket-status-tabs">
        <button data-tab="active" data-i18n="ticketsPage.tabActive" class="ticket-tab-btn px-4 py-2 rounded-xl bg-electric-magenta text-white shadow-magenta-glow">
          Siap Masuk
        </button>
        <button data-tab="used" data-i18n="ticketsPage.tabUsed" class="ticket-tab-btn px-4 py-2 rounded-xl text-neutral-600 dark:text-muted-gray hover:text-neutral-950 dark:hover:text-soft-white">
          Sudah Dipindai
        </button>
        <button data-tab="cancelled" data-i18n="ticketsPage.tabCancelled" class="ticket-tab-btn px-4 py-2 rounded-xl text-neutral-600 dark:text-muted-gray hover:text-neutral-950 dark:hover:text-soft-white">
          Dibatalkan
        </button>
      </div>
    </div>

    <!-- Loading Skeleton Placeholder -->
    <div id="tickets-loading" class="animate-pulse space-y-6">
      <div class="h-56 bg-neutral-200/70 dark:bg-dark-plum/60 rounded-3xl border border-neutral-200 dark:border-white/10"></div>
      <div class="h-56 bg-neutral-200/70 dark:bg-dark-plum/60 rounded-3xl border border-neutral-200 dark:border-white/10"></div>
    </div>

    <!-- Unauthenticated State -->
    <div id="tickets-auth-state" class="hidden text-center py-24 rounded-3xl bg-white dark:bg-dark-plum/40 border border-neutral-200 dark:border-white/10 shadow-sm dark:shadow-none">
      <div class="w-20 h-20 rounded-full bg-neutral-50 dark:bg-void-black border border-neutral-200 dark:border-white/10 flex items-center justify-center mx-auto mb-4 text-electric-magenta">
        <svg class="w-8 h-8" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
        </svg>
      </div>
      <h2 class="font-display text-3xl text-neutral-950 dark:text-soft-white mb-2">MASUK UNTUK MELIHAT E-TIKET</h2>
      <p class="text-sm text-neutral-600 dark:text-muted-gray max-w-md mx-auto mb-6">
        E-tiket dan QR secret gate bersifat pribadi dan hanya tersedia saat kamu masuk menggunakan akun pembeli.
      </p>
      <button id="tickets-login-btn" type="button" class="px-6 py-3 rounded-full bg-electric-magenta text-white font-bold text-xs uppercase tracking-wider hover:shadow-magenta-glow transition-all">
        Masuk Ke Akun Saya
      </button>
    </div>

    <!-- Error State -->
    <div id="tickets-error-state" class="hidden text-center py-20 rounded-3xl bg-red-50 dark:bg-red-500/5 border border-red-200 dark:border-red-500/20">
      <h2 class="font-display text-3xl text-neutral-950 dark:text-soft-white mb-2">GAGAL MEMUAT E-TIKET</h2>
      <p id="tickets-error-msg" class="text-xs font-mono text-red-700 dark:text-red-300 max-w-md mx-auto mb-6"></p>
      <button id="tickets-retry-btn" type="button" class="px-6 py-2.5 rounded-full bg-white hover:bg-neutral-100 border border-neutral-200 text-neutral-900 dark:bg-white/10 dark:hover:bg-white/20 dark:border-transparent dark:text-soft-white text-xs font-bold uppercase tracking-wider transition-all">
        Coba Muat Ulang
      </button>
    </div>

    <!-- Empty State -->
    <div id="tickets-empty-state" class="hidden text-center py-24 rounded-3xl bg-white dark:bg-dark-plum/40 border border-neutral-200 dark:border-white/10 shadow-sm dark:shadow-none">
      <div class="w-20 h-20 rounded-full bg-neutral-50 dark:bg-void-black border border-neutral-200 dark:border-white/10 flex items-center justify-center mx-auto mb-4 text-neutral-500 dark:text-muted-gray">
        <svg class="w-8 h-8" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 5v2m0 4v2m0 4v2M5 5a2 2 0 00-2 2v3a2 2 0 110 4v3a2 2 0 002 2h14a2 2 0 002-2v-3a2 2 0 110-4V7a2 2 0 00-2-2H5z" />
        </svg>
      </div>
      <h2 id="empty-state-title" class="font-display text-3xl text-neutral-950 dark:text-soft-white mb-2">BELUM ADA TIKET KONSER</h2>
      <p id="empty-state-desc" class="text-sm text-neutral-600 dark:text-muted-gray max-w-md mx-auto mb-6">
        Kamu belum memiliki tiket pada kategori ini. Jelajahi jadwal konser dan amankan tiket resmimu!
      </p>
      <a href="/events" class="px-6 py-3 rounded-full bg-electric-magenta text-white font-bold text-xs uppercase tracking-wider hover:shadow-magenta-glow transition-all">
        JELAJAHI JADWAL KONSER
      </a>
    </div>

    <!-- Tickets List Container -->
    <div id="tickets-grid" class="space-y-6 hidden"></div>
  </div>

  <!-- BOARDING PASS QR MODAL (Printable!) -->
  <div id="boarding-pass-modal" class="fixed inset-0 z-[70] hidden items-center justify-center p-4 bg-black/60 dark:bg-black/80 backdrop-blur-md print:static print:block print:bg-white print:p-0">
    <div id="boarding-pass-card" class="relative w-full max-w-lg rounded-3xl bg-white dark:bg-dark-plum border border-electric-magenta/50 shadow-magenta-glow overflow-hidden text-neutral-950 dark:text-soft-white print:max-w-none print:bg-white print:text-black print:border print:border-black/20 print:shadow-none">
      <!-- Top Controls -->
      <div class="flex items-center justify-between px-6 py-4 border-b border-neutral-200 dark:border-white/10 print:border-black/15">
        <span class="font-mono text-[11px] font-bold tracking-widest uppercase text-electric-magenta print:text-pink-700">
          E-BOARDING PASS // CSPRNG GATE QR
        </span>
        <button id="close-pass-modal-btn" type="button" class="print:hidden w-8 h-8 rounded-full bg-neutral-100 hover:bg-neutral-200 dark:bg-white/10 dark:hover:bg-white/20 flex items-center justify-center text-neutral-700 dark:text-soft-white">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

      <!-- Loading -->
      <div id="pass-modal-loading" class="p-10 text-center text-xs font-mono text-neutral-500 dark:text-muted-gray">
        Mengambil QR Secret terenkripsi dari server...
      </div>

      <!-- Pass Content -->
      <div id="pass-modal-body" class="hidden p-6 sm:p-8 space-y-6 max-h-[82vh] overflow-y-auto print:max-h-none">
        <div>
          <div class="flex items-center justify-between gap-2 mb-2">
            <span id="pass-status-pill" class="px-3 py-1 rounded-full text-[10px] font-mono font-bold uppercase"></span>
            <span id="pass-order-code" class="text-[11px] font-mono text-neutral-500 dark:text-muted-gray print:text-neutral-600"></span>
          </div>
          <h2 id="pass-event-title" class="font-display text-3xl text-neutral-950 dark:text-soft-white print:text-black leading-tight"></h2>
          <p id="pass-category-name" class="text-xs font-mono font-bold text-electric-magenta print:text-pink-700 mt-1"></p>
          <p id="pass-event-date" class="text-xs text-neutral-600 dark:text-muted-gray print:text-neutral-600 mt-2"></p>
          <p id="pass-event-addr" class="text-xs text-neutral-600 dark:text-muted-gray print:text-neutral-600 mt-0.5"></p>
        </div>

        <!-- Scannable Real QR Box -->
        <div class="p-5 rounded-3xl bg-white text-black flex flex-col items-center justify-center shadow-inner border border-neutral-200">
          <div id="pass-qr-svg" class="w-48 h-48 flex items-center justify-center [&>svg]:w-full [&>svg]:h-full"></div>
          <span id="pass-ticket-code" class="font-mono text-sm font-bold tracking-widest mt-3 text-black"></span>
          <span id="pass-qr-secret-hint" class="font-mono text-[10px] text-neutral-500 mt-1 break-all text-center"></span>
          <button id="copy-ticket-code-btn" type="button" class="print:hidden mt-3 px-3 py-1 rounded-full bg-neutral-900 text-white text-[10px] font-mono uppercase hover:bg-electric-magenta transition-colors">
            Salin Payload QR
          </button>
        </div>

        <!-- Holder Meta -->
        <div class="p-4 rounded-2xl bg-neutral-50 dark:bg-void-black/60 print:bg-neutral-100 border border-neutral-200 dark:border-white/10 print:border-black/15 flex items-center justify-between text-xs font-mono">
          <div>
            <span class="text-neutral-500 dark:text-muted-gray print:text-neutral-600 block text-[10px] uppercase">Pemegang Tiket Sah</span>
            <strong id="pass-owner-name" class="text-neutral-950 dark:text-soft-white print:text-black text-sm"></strong>
          </div>
          <span id="pass-price-val" class="font-bold text-electric-magenta print:text-pink-700"></span>
        </div>

        <!-- Scan History -->
        <div id="pass-scans-section" class="space-y-2">
          <span class="text-[10px] font-mono uppercase tracking-wider text-neutral-500 dark:text-muted-gray print:text-neutral-600 block">
            Log Pemindaian Pintu Gerbang (Gate Scan)
          </span>
          <div id="pass-scans-list" class="space-y-2 text-xs font-mono"></div>
        </div>

        <!-- Actions -->
        <div class="grid grid-cols-2 gap-3 pt-2 print:hidden">
          <button id="print-pass-btn" type="button" class="py-3 px-4 rounded-xl bg-electric-magenta text-white font-bold text-xs uppercase tracking-wider hover:shadow-magenta-glow transition-all">
            Cetak / Save PDF
          </button>
          <a id="pass-receipt-link" href="/account?tab=orders" data-i18n="ticketsPage.viewReceipt" class="py-3 px-4 rounded-xl bg-neutral-100 hover:bg-neutral-200 border border-neutral-200 text-neutral-900 dark:bg-white/10 dark:hover:bg-white/20 dark:border-transparent dark:text-soft-white font-bold text-xs uppercase tracking-wider text-center transition-all">
            Lihat Kuitansi
          </a>
        </div>
      </div>
    </div>
  </div>

  <!-- OWNER NAME RENAME MODAL -->
  <div id="rename-owner-modal" class="fixed inset-0 z-[70] hidden items-center justify-center p-4 bg-black/60 dark:bg-black/80 backdrop-blur-md print:hidden">
    <div class="w-full max-w-md rounded-3xl bg-white dark:bg-dark-plum border border-neutral-200 dark:border-white/15 p-6 sm:p-7 space-y-5 shadow-2xl">
      <div>
        <span class="text-[10px] font-mono uppercase tracking-wider text-electric-magenta font-bold block">Identitas Gelang Konser</span>
        <h3 class="font-display text-2xl text-neutral-950 dark:text-soft-white mt-1">UBAH NAMA PEMEGANG TIKET</h3>
        <p class="text-xs text-neutral-600 dark:text-muted-gray mt-1">Nama harus sesuai dengan kartu identitas (KTP/SIM) saat verifikasi di gerbang.</p>
      </div>
      <form id="rename-owner-form" class="space-y-4">
        <input type="hidden" id="rename-ticket-code" />
        <div>
          <label for="rename-owner-input" class="text-xs font-mono text-neutral-600 dark:text-muted-gray block mb-1.5">Nama Lengkap Baru</label>
          <input
            id="rename-owner-input"
            type="text"
            minlength="2"
            maxlength="100"
            required
            class="w-full px-4 py-3 rounded-xl bg-neutral-50 dark:bg-void-black border border-neutral-300 dark:border-white/15 text-sm text-neutral-950 dark:text-soft-white focus:outline-none focus:border-electric-magenta"
            placeholder="Sesuai KTP/Identitas"
          />
        </div>
        <p id="rename-owner-err" class="hidden text-xs font-mono text-red-600 dark:text-red-400"></p>
        <div class="flex gap-3">
          <button type="button" id="cancel-rename-btn" class="flex-1 py-2.5 rounded-xl bg-neutral-100 dark:bg-white/5 border border-neutral-200 dark:border-white/10 text-xs font-bold uppercase text-neutral-600 dark:text-muted-gray hover:text-neutral-950 dark:hover:text-soft-white">
            Batal
          </button>
          <button type="submit" id="save-rename-btn" class="flex-1 py-2.5 rounded-xl bg-electric-magenta text-xs font-bold uppercase text-white hover:shadow-magenta-glow">
            Simpan Nama
          </button>
        </div>
      </form>
    </div>
  </div>

  <Footer />
</RootLayout>

<script>
  import { api, resolveAssetUrl } from '../../lib/api';
  import { isAuthenticated } from '../../lib/auth';
  import { generateQrSvg } from '../../lib/qr';
  import { escapeHtml, formatDateIndo, formatRupiah, getGoogleCalendarUrl, getGoogleMapsUrl } from '../../lib/formatters';

  function initTicketsWallet() {
    const loading = document.getElementById('tickets-loading');
    const authState = document.getElementById('tickets-auth-state');
    const errorState = document.getElementById('tickets-error-state');
    const errorMsg = document.getElementById('tickets-error-msg');
    const emptyState = document.getElementById('tickets-empty-state');
    const emptyTitle = document.getElementById('empty-state-title');
    const emptyDesc = document.getElementById('empty-state-desc');
    const ticketsGrid = document.getElementById('tickets-grid');
    const tabBtns = document.querySelectorAll<HTMLButtonElement>('.ticket-tab-btn');

    const loginBtn = document.getElementById('tickets-login-btn');
    const retryBtn = document.getElementById('tickets-retry-btn');

    // Pass Modal Elements
    const passModal = document.getElementById('boarding-pass-modal');
    const closePassBtn = document.getElementById('close-pass-modal-btn');
    const passLoading = document.getElementById('pass-modal-loading');
    const passBody = document.getElementById('pass-modal-body');
    const passStatusPill = document.getElementById('pass-status-pill');
    const passOrderCode = document.getElementById('pass-order-code');
    const passEventTitle = document.getElementById('pass-event-title');
    const passCatName = document.getElementById('pass-category-name');
    const passEventDate = document.getElementById('pass-event-date');
    const passEventAddr = document.getElementById('pass-event-addr');
    const passQrSvg = document.getElementById('pass-qr-svg');
    const passTicketCode = document.getElementById('pass-ticket-code');
    const passSecretHint = document.getElementById('pass-qr-secret-hint');
    const passOwnerName = document.getElementById('pass-owner-name');
    const passPriceVal = document.getElementById('pass-price-val');
    const passScansList = document.getElementById('pass-scans-list');
    const passReceiptLink = document.getElementById('pass-receipt-link') as HTMLAnchorElement | null;
    const printPassBtn = document.getElementById('print-pass-btn');
    const copyQrBtn = document.getElementById('copy-ticket-code-btn') as HTMLButtonElement | null;

    // Rename Modal Elements
    const renameModal = document.getElementById('rename-owner-modal');
    const renameForm = document.getElementById('rename-owner-form') as HTMLFormElement | null;
    const renameCodeInput = document.getElementById('rename-ticket-code') as HTMLInputElement | null;
    const renameNameInput = document.getElementById('rename-owner-input') as HTMLInputElement | null;
    const renameErr = document.getElementById('rename-owner-err');
    const cancelRenameBtn = document.getElementById('cancel-rename-btn');
    const saveRenameBtn = document.getElementById('save-rename-btn') as HTMLButtonElement | null;

    let allTickets: any[] = [];
    let currentFilter = 'active';
    let currentPayloadToCopy = '';
    let isDisposed = false;

    loginBtn?.addEventListener('click', () => {
      if (typeof (window as any).openAuthModal === 'function') (window as any).openAuthModal();
      else window.location.href = '/masuk';
    });

    retryBtn?.addEventListener('click', () => loadTickets());

    tabBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        tabBtns.forEach((b) => {
          b.classList.remove('bg-electric-magenta', 'text-white', 'shadow-magenta-glow');
          b.classList.add('text-neutral-600', 'dark:text-muted-gray', 'hover:text-neutral-950', 'dark:hover:text-soft-white');
        });
        btn.classList.remove('text-neutral-600', 'dark:text-muted-gray', 'hover:text-neutral-950', 'dark:hover:text-soft-white');
        btn.classList.add('bg-electric-magenta', 'text-white', 'shadow-magenta-glow');
        currentFilter = btn.dataset.tab || 'active';
        renderFilteredTickets();
      });
    });

    function closePassModal() {
      passModal?.classList.add('hidden');
      passModal?.classList.remove('flex');
    }

    closePassBtn?.addEventListener('click', closePassModal);
    passModal?.addEventListener('click', (e) => {
      if (e.target === passModal) closePassModal();
    });
    printPassBtn?.addEventListener('click', () => window.print());

    copyQrBtn?.addEventListener('click', async () => {
      if (!currentPayloadToCopy || !copyQrBtn) return;
      try {
        await navigator.clipboard.writeText(currentPayloadToCopy);
        copyQrBtn.textContent = 'Tersalin!';
        setTimeout(() => {
          if (copyQrBtn) copyQrBtn.textContent = 'Salin Payload QR';
        }, 1800);
      } catch {}
    });

    cancelRenameBtn?.addEventListener('click', () => {
      renameModal?.classList.add('hidden');
      renameModal?.classList.remove('flex');
    });

    renameForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const code = renameCodeInput?.value || '';
      const newName = renameNameInput?.value.trim() || '';
      if (!code || newName.length < 2) return;

      if (saveRenameBtn) {
        saveRenameBtn.disabled = true;
        saveRenameBtn.textContent = 'Menyimpan...';
      }
      renameErr?.classList.add('hidden');

      try {
        await api.patch(`/tickets/${code}/owner`, { owner_name: newName });
        renameModal?.classList.add('hidden');
        renameModal?.classList.remove('flex');
        await loadTickets();
      } catch (err: any) {
        if (renameErr) {
          renameErr.textContent = err?.message || 'Gagal memperbarui nama pemegang tiket.';
          renameErr.classList.remove('hidden');
        }
      } finally {
        if (saveRenameBtn) {
          saveRenameBtn.disabled = false;
          saveRenameBtn.textContent = 'Simpan Nama';
        }
      }
    });

    async function openPassModal(ticketCode: string) {
      passModal?.classList.remove('hidden');
      passModal?.classList.add('flex');
      passLoading?.classList.remove('hidden');
      passBody?.classList.add('hidden');

      try {
        const detail = await api.get(`/tickets/${ticketCode}`);
        if (isDisposed) return;

        const payload = detail.qr_payload || `${detail.ticket_code}${detail.qr_secret ? `|${detail.qr_secret}` : ''}`;
        currentPayloadToCopy = payload;

        if (passStatusPill) {
          if (detail.status === 'active') {
            passStatusPill.className = 'px-3 py-1 rounded-full text-[10px] font-mono font-bold uppercase bg-emerald-50 dark:bg-emerald-500/20 text-emerald-700 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-500/40 print:text-emerald-700 print:border-emerald-600';
            passStatusPill.textContent = 'AKTIF // SIAP GATE';
          } else if (detail.status === 'used') {
            passStatusPill.className = 'px-3 py-1 rounded-full text-[10px] font-mono font-bold uppercase bg-neutral-100 dark:bg-white/10 text-neutral-600 dark:text-muted-gray border border-neutral-200 dark:border-white/15 print:text-neutral-700 print:border-neutral-400';
            passStatusPill.textContent = 'CHECKED IN // TERPAKAI';
          } else {
            passStatusPill.className = 'px-3 py-1 rounded-full text-[10px] font-mono font-bold uppercase bg-red-50 dark:bg-red-500/15 text-red-700 dark:text-red-300 border border-red-200 dark:border-red-500/30';
            passStatusPill.textContent = 'DIBATALKAN';
          }
        }

        if (passOrderCode) passOrderCode.textContent = detail.order_code ? `ORDER ${detail.order_code}` : '';
        if (passEventTitle) passEventTitle.textContent = detail.nama_event || 'AFTERGLOW Concert';
        if (passCatName) passCatName.textContent = detail.nama_kategori || 'TIKET KONSER';
        if (passEventDate) passEventDate.textContent = `Jadwal: ${formatDateIndo(detail.tanggal_mulai)}`;
        if (passEventAddr) passEventAddr.textContent = `Venue: ${detail.alamat || '-'}`;

        if (passQrSvg) passQrSvg.innerHTML = generateQrSvg(payload, 6, 2);
        if (passTicketCode) passTicketCode.textContent = detail.ticket_code;
        if (passSecretHint) {
          passSecretHint.textContent = detail.qr_secret
            ? `SECRET: ${detail.qr_secret}`
            : 'QR GATE VERIFIED PASS';
        }

        if (passOwnerName) passOwnerName.textContent = detail.owner_name || '-';
        if (passPriceVal) passPriceVal.textContent = detail.harga ? formatRupiah(detail.harga) : '';
        if (passReceiptLink && detail.order_code) {
          passReceiptLink.href = `/orders/${detail.order_code}/receipt`;
        }

        if (passScansList) {
          const scans = Array.isArray(detail.scans) ? detail.scans : [];
          if (scans.length === 0) {
            passScansList.innerHTML = `<p class="text-neutral-500 dark:text-muted-gray/80 print:text-neutral-500">Belum ada riwayat pemindaian di gerbang masuk.</p>`;
          } else {
            passScansList.innerHTML = scans
              .map(
                (s: any) => `
                <div class="p-3 rounded-xl bg-neutral-50 dark:bg-void-black/60 print:bg-neutral-100 border border-neutral-200 dark:border-white/10 flex items-center justify-between gap-2">
                  <div>
                    <strong class="text-neutral-950 dark:text-soft-white print:text-black block">Gate: ${escapeHtml(s.gate || 'Main Gate')}</strong>
                    <span class="text-[11px] text-neutral-600 dark:text-muted-gray print:text-neutral-600">Petugas: ${escapeHtml(s.scanned_by_name || 'Gate Crew')}</span>
                  </div>
                  <span class="text-[11px] text-electric-magenta print:text-pink-700">${escapeHtml(formatDateIndo(s.scanned_at))}</span>
                </div>
              `
              )
              .join('');
          }
        }

        passLoading?.classList.add('hidden');
        passBody?.classList.remove('hidden');
      } catch (err: any) {
        if (passLoading) {
          passLoading.textContent = err?.message || 'Gagal memuat detail QR Boarding Pass.';
        }
      }
    }

    async function loadTickets() {
      if (!isAuthenticated()) {
        allTickets = [];
        loading?.classList.add('hidden');
        errorState?.classList.add('hidden');
        emptyState?.classList.add('hidden');
        ticketsGrid?.classList.add('hidden');
        authState?.classList.remove('hidden');
        return;
      }

      const hasRenderedTickets = allTickets.length > 0 && !ticketsGrid?.classList.contains('hidden');
      if (!hasRenderedTickets) {
        loading?.classList.remove('hidden');
        ticketsGrid?.classList.add('hidden');
      }
      authState?.classList.add('hidden');
      errorState?.classList.add('hidden');
      emptyState?.classList.add('hidden');

      try {
        const res = await api.get('/tickets');
        if (isDisposed) return;
        allTickets = Array.isArray(res) ? res : [];
        loading?.classList.add('hidden');
        renderFilteredTickets();
      } catch (err: any) {
        if (isDisposed) return;
        loading?.classList.add('hidden');
        if (hasRenderedTickets) return;
        if (errorMsg) errorMsg.textContent = err?.message || 'Terjadi gangguan koneksi ke server tiket.';
        errorState?.classList.remove('hidden');
      }
    }

    function renderFilteredTickets() {
      if (!ticketsGrid) return;

      const filtered = allTickets.filter((t) => {
        if (currentFilter === 'active') return t.status === 'active';
        if (currentFilter === 'used') return t.status === 'used';
        return t.status === 'cancelled';
      });

      if (filtered.length === 0) {
        ticketsGrid.classList.add('hidden');
        emptyState?.classList.remove('hidden');
        if (emptyTitle && emptyDesc) {
          if (currentFilter === 'used') {
            emptyTitle.textContent = 'BELUM ADA RIWAYAT CHECK-IN';
            emptyDesc.textContent = 'Tiket yang sudah dipindai di pintu masuk venue akan tampil di sini sebagai arsip konsermu.';
          } else if (currentFilter === 'cancelled') {
            emptyTitle.textContent = 'TIDAK ADA TIKET DIBATALKAN';
            emptyDesc.textContent = 'Tidak ada tiket dengan status pembatalan atau pengembalian dana.';
          } else {
            emptyTitle.textContent = 'BELUM ADA TIKET KONSER AKTIF';
            emptyDesc.textContent = 'Kamu belum memiliki tiket konser aktif. Jelajahi katalog konser dan menangkan war tiket musisi favoritmu!';
          }
        }
        return;
      }

      emptyState?.classList.add('hidden');
      ticketsGrid.classList.remove('hidden');

      ticketsGrid.innerHTML = filtered
        .map((ticket) => {
          const isActive = ticket.status === 'active';
          const isUsed = ticket.status === 'used';

          const statusBadge = isActive
            ? `<span class="px-3 py-1 rounded-full text-[10px] font-mono font-bold tracking-wider uppercase bg-emerald-50 dark:bg-emerald-500/20 text-emerald-700 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-500/40">TIKET AKTIF // SIAP MASUK</span>`
            : isUsed
            ? `<span class="px-3 py-1 rounded-full text-[10px] font-mono font-bold tracking-wider uppercase bg-neutral-100 dark:bg-white/10 text-neutral-600 dark:text-muted-gray border border-neutral-200 dark:border-white/15">SUDAH DIGUNAKAN</span>`
            : `<span class="px-3 py-1 rounded-full text-[10px] font-mono font-bold tracking-wider uppercase bg-red-50 dark:bg-red-500/15 text-red-700 dark:text-red-300 border border-red-200 dark:border-red-500/30">DIBATALKAN</span>`;

          const mapsUrl = getGoogleMapsUrl(ticket.alamat || '', ticket.lat, ticket.lng);
          const calUrl = ticket.tanggal_mulai
            ? getGoogleCalendarUrl(
                {
                  nama_event: ticket.nama_event,
                  tanggal_mulai: ticket.tanggal_mulai,
                  tanggal_selesai: ticket.tanggal_selesai,
                  alamat: ticket.alamat || '',
                },
                { nama_kategori: ticket.nama_kategori, kode_tiket: ticket.ticket_code }
              )
            : '#';

          return `
            <div class="rounded-3xl bg-white dark:bg-dark-plum/90 border ${isActive ? 'border-electric-magenta/40 shadow-magenta-glow' : 'border-neutral-200 dark:border-white/10 opacity-85'} shadow-sm dark:shadow-none overflow-hidden relative backdrop-blur-xl">
              <div class="absolute -right-20 -top-20 w-64 h-64 rounded-full bg-electric-magenta/10 blur-3xl pointer-events-none"></div>

              <div class="p-6 sm:p-8 flex flex-col lg:flex-row justify-between gap-6 items-stretch lg:items-center border-b border-neutral-200 dark:border-white/10 border-dashed">
                <div class="flex flex-col sm:flex-row gap-5 flex-1">
                  <div class="w-24 h-24 sm:w-28 sm:h-28 rounded-2xl overflow-hidden bg-neutral-100 dark:bg-void-black border border-neutral-200 dark:border-white/10 shrink-0">
                    <img
                      src="${escapeHtml(resolveAssetUrl(ticket.poster_url))}"
                      alt="${escapeHtml(ticket.nama_event)}"
                      class="w-full h-full object-cover"
                    />
                  </div>

                  <div class="space-y-2.5 flex-1">
                    <div class="flex flex-wrap items-center gap-2">
                      ${statusBadge}
                      ${ticket.order_code ? `<span class="px-2.5 py-0.5 rounded bg-neutral-100 dark:bg-white/5 border border-neutral-200 dark:border-white/10 font-mono text-[10px] text-neutral-600 dark:text-muted-gray">${escapeHtml(ticket.order_code)}</span>` : ''}
                    </div>

                    <h2 class="font-display text-3xl text-neutral-950 dark:text-soft-white leading-tight">
                      ${escapeHtml(ticket.nama_event || 'AFTERGLOW Concert')}
                    </h2>

                    <p class="text-xs text-electric-magenta font-semibold font-mono">
                      ${escapeHtml(ticket.nama_kategori || 'Tiket Resmi')} • ${escapeHtml(formatRupiah(ticket.harga || 0))}
                    </p>

                    <div class="text-xs text-neutral-600 dark:text-muted-gray space-y-1 font-mono">
                      <p>Jadwal: ${escapeHtml(formatDateIndo(ticket.tanggal_mulai))}</p>
                      <p>Venue: ${escapeHtml(ticket.alamat || '-')}</p>
                    </div>

                    <div class="pt-1 flex flex-wrap items-center gap-3 text-xs font-mono text-neutral-600 dark:text-muted-gray">
                      <span>Pemegang: <strong class="text-neutral-950 dark:text-soft-white">${escapeHtml(ticket.owner_name || '-')}</strong></span>
                      ${isActive ? `
                        <button
                          type="button"
                          data-edit-owner="${escapeHtml(ticket.ticket_code)}"
                          data-current-owner="${escapeHtml(ticket.owner_name || '')}"
                          class="text-electric-magenta hover:underline font-bold text-[11px]"
                        >
                          Ubah Nama
                        </button>
                      ` : ''}
                    </div>
                  </div>
                </div>

                <!-- Pass Stub & Trigger -->
                <div class="flex flex-col items-stretch sm:items-center justify-center p-5 rounded-2xl bg-neutral-50 dark:bg-void-black/80 border border-neutral-200 dark:border-white/15 shrink-0 min-w-[210px] gap-3">
                  <div class="text-center">
                    <span class="text-[10px] font-mono text-neutral-500 dark:text-muted-gray uppercase block">KODE E-TIKET</span>
                    <strong class="font-mono text-sm tracking-widest text-neutral-950 dark:text-soft-white">${escapeHtml(ticket.ticket_code)}</strong>
                  </div>
                  <button
                    type="button"
                    data-open-pass="${escapeHtml(ticket.ticket_code)}"
                    class="w-full py-2.5 px-4 rounded-xl bg-electric-magenta hover:shadow-magenta-glow text-white text-xs font-bold uppercase tracking-wider transition-all"
                  >
                    Buka QR Pass
                  </button>
                </div>
              </div>

              <!-- Quick Action Footer -->
              <div class="px-6 py-4 bg-neutral-50 dark:bg-void-black/70 flex flex-wrap items-center justify-between gap-3 text-xs">
                <div class="flex flex-wrap items-center gap-4 font-mono text-neutral-600 dark:text-muted-gray">
                  <a href="${escapeHtml(mapsUrl)}" target="_blank" rel="noopener noreferrer" class="hover:text-electric-magenta transition-colors">
                    Rute Venue →
                  </a>
                  ${ticket.tanggal_mulai ? `
                    <a href="${escapeHtml(calUrl)}" target="_blank" rel="noopener noreferrer" class="hover:text-electric-magenta transition-colors">
                      Simpan Kalender →
                    </a>
                  ` : ''}
                  ${ticket.order_code ? `
                    <a href="/orders/${escapeHtml(ticket.order_code)}/receipt" class="hover:text-electric-magenta transition-colors">
                      Kuitansi Resmi →
                    </a>
                  ` : ''}
                </div>
                <span class="text-[11px] font-mono text-electric-magenta">
                  ${isActive ? 'Jangan bagikan QR Secret kepada siapapun' : 'Arsip Tiket Resmi AFTERGLOW'}
                </span>
              </div>
            </div>
          `;
        })
        .join('');
    }

    // Delegated click handlers inside ticketsGrid
    ticketsGrid?.addEventListener('click', (e) => {
      const passBtn = (e.target as HTMLElement).closest('[data-open-pass]') as HTMLButtonElement | null;
      if (passBtn) {
        const code = passBtn.dataset.openPass;
        if (code) openPassModal(code);
        return;
      }

      const renameBtn = (e.target as HTMLElement).closest('[data-edit-owner]') as HTMLButtonElement | null;
      if (renameBtn) {
        const code = renameBtn.dataset.editOwner || '';
        const current = renameBtn.dataset.currentOwner || '';
        if (renameCodeInput) renameCodeInput.value = code;
        if (renameNameInput) renameNameInput.value = current;
        renameErr?.classList.add('hidden');
        renameModal?.classList.remove('hidden');
        renameModal?.classList.add('flex');
      }
    });

    const onAuthChanged = () => loadTickets();
    window.addEventListener('afterglow-auth-changed', onAuthChanged);
    loadTickets();

    return () => {
      isDisposed = true;
      window.removeEventListener('afterglow-auth-changed', onAuthChanged);
    };
  }

  let ticketsCleanup: (() => void) | undefined;
  document.addEventListener('astro:page-load', () => {
    if (ticketsCleanup) ticketsCleanup();
    ticketsCleanup = initTicketsWallet();
  });
</script>
