---
export const prerender = false;

import RootLayout from '../../layouts/RootLayout.astro';
import Footer from '../../components/landing/Footer.astro';
import { api, ApiError } from '../../lib/api';
import { fetchEvents, type BackendEvent } from '../../lib/events';
import { formatDateIndo, formatRupiah } from '../../lib/formatters';

interface PublicOrganizer {
  id: number;
  organization_name: string;
  verification_status: string;
  created_at: string;
}

const { id } = Astro.params;
const organizerId = Number(id || 0);

let organizer: PublicOrganizer | null = null;
let events: BackendEvent[] = [];
let errorStatus = 0;
let errorMessage = '';

if (!Number.isFinite(organizerId) || organizerId <= 0) {
  errorStatus = 404;
  errorMessage = 'ID promotor tidak valid.';
} else {
  const [orgRes, evRes] = await Promise.allSettled([
    api.get<PublicOrganizer>(`/organizers/${organizerId}`),
    fetchEvents({ organizer_id: organizerId, scope: 'public', limit: 50, strict: true }),
  ]);

  if (orgRes.status === 'fulfilled' && orgRes.value) {
    organizer = orgRes.value;
    events = evRes.status === 'fulfilled' ? evRes.value : [];
  } else {
    const reason: any = orgRes.status === 'rejected' ? orgRes.reason : null;
    if (reason instanceof ApiError) {
      errorStatus = reason.status || 500;
      errorMessage = reason.message || 'Promotor tidak ditemukan atau belum terverifikasi.';
    } else {
      errorStatus = 503;
      errorMessage = reason?.message || 'Gagal menghubungi server promotor.';
    }
  }
}

if (!organizer) {
  Astro.response.status = errorStatus === 404 ? 404 : 503;
}

const joinedYear = organizer?.created_at
  ? new Date(organizer.created_at).getFullYear()
  : new Date().getFullYear();

const eventCards = events.map((ev) => ({
  ...ev,
  isSoldOut: Boolean(ev.is_sold_out || Number(ev.available_quota) <= 0),
  isPaused: Boolean(ev.is_paused),
  displayCity: ev.kota || ev.alamat.split(',')[1]?.trim() || ev.alamat.split(',')[0],
}));
---

<RootLayout
  title={organizer ? `${organizer.organization_name} — Promotor Resmi AFTERGLOW` : 'Promotor Tidak Ditemukan — AFTERGLOW'}
  description={organizer ? `Jelajahi jadwal konser resmi yang diselenggarakan oleh ${organizer.organization_name}.` : 'Halaman profil promotor resmi AFTERGLOW.'}
>
  {!organizer ? (
    <div class="pt-36 pb-28 px-4 sm:px-6 lg:px-12 max-w-3xl mx-auto w-full text-center">
      <div class="p-8 sm:p-12 rounded-3xl bg-white dark:bg-dark-plum/85 border border-neutral-200 dark:border-white/15 shadow-xl space-y-5">
        <span class="inline-block px-3.5 py-1 rounded-full text-xs font-mono font-bold uppercase tracking-widest bg-electric-magenta/10 dark:bg-electric-magenta/20 text-electric-magenta border border-electric-magenta/30">
          {errorStatus === 404 ? 'ERROR 404 // PROMOTOR TIDAK DITEMUKAN' : `STATUS ${errorStatus}`}
        </span>
        <h1 class="font-display text-4xl sm:text-6xl text-neutral-950 dark:text-soft-white tracking-wide">
          {errorStatus === 404 ? 'PROMOTOR BELUM TERDAFTAR' : 'GAGAL MEMUAT PROMOTOR'}
        </h1>
        <p class="text-sm sm:text-base text-neutral-600 dark:text-muted-gray max-w-xl mx-auto">
          {errorMessage}
        </p>
        <div class="pt-4 flex flex-wrap justify-center gap-3">
          <a href="/events" class="px-6 py-3 rounded-full bg-electric-magenta text-white text-xs font-bold uppercase tracking-wider hover:shadow-magenta-glow transition-all">
            Jelajahi Semua Konser
          </a>
          <button type="button" onclick="window.location.reload()" class="px-6 py-3 rounded-full bg-neutral-100 dark:bg-white/10 border border-neutral-200 dark:border-white/15 text-xs font-bold uppercase tracking-wider text-neutral-900 dark:text-soft-white">
            Muat Ulang
          </button>
        </div>
      </div>
    </div>
  ) : (
    <div class="pt-32 pb-24 px-6 lg:px-12 max-w-7xl mx-auto w-full space-y-12">
      <!-- Verified Promoter Header -->
      <div class="p-8 sm:p-10 rounded-3xl bg-white dark:bg-dark-plum/90 border border-neutral-200 dark:border-white/15 shadow-sm dark:shadow-none flex flex-col md:flex-row md:items-center justify-between gap-6">
        <div class="flex items-start sm:items-center gap-5">
          <div class="w-16 h-16 sm:w-20 sm:h-20 rounded-2xl bg-electric-magenta/15 border border-electric-magenta/40 flex items-center justify-center font-display text-4xl text-electric-magenta shrink-0">
            {organizer.organization_name.charAt(0).toUpperCase()}
          </div>
          <div>
            <div class="flex flex-wrap items-center gap-2 mb-2">
              <span class="px-2.5 py-0.5 rounded-full bg-emerald-50 dark:bg-emerald-500/20 border border-emerald-200 dark:border-emerald-500/40 text-emerald-700 dark:text-emerald-300 text-[10px] font-mono font-bold uppercase">
                PROMOTOR RESMI TERVERIFIKASI
              </span>
              <span class="text-[11px] font-mono text-neutral-500 dark:text-muted-gray">
                Sejak {joinedYear} • ID #{organizer.id}
              </span>
            </div>
            <h1 class="font-display text-4xl sm:text-6xl text-neutral-950 dark:text-soft-white tracking-wide">
              {organizer.organization_name}
            </h1>
          </div>
        </div>

        <div class="flex items-center gap-6 px-5 py-3.5 rounded-2xl bg-neutral-50 dark:bg-void-black/70 border border-neutral-200 dark:border-white/10 shrink-0">
          <div>
            <span class="text-[10px] font-mono uppercase text-neutral-500 dark:text-muted-gray block">Konser Aktif</span>
            <strong class="font-display text-3xl text-electric-magenta">{events.length}</strong>
          </div>
          <a href="/events" class="px-4 py-2 rounded-xl bg-neutral-900 dark:bg-white/10 hover:bg-electric-magenta text-white text-xs font-bold uppercase tracking-wider transition-colors">
            Semua Konser
          </a>
        </div>
      </div>

      <!-- Promoter Active Concerts Grid -->
      {events.length === 0 ? (
        <div class="p-12 rounded-3xl bg-white dark:bg-dark-plum/60 border border-neutral-200 dark:border-white/10 text-center space-y-3">
          <h2 class="font-display text-3xl text-neutral-950 dark:text-soft-white">BELUM ADA JADWAL KONSER AKTIF</h2>
          <p class="text-sm text-neutral-600 dark:text-muted-gray max-w-md mx-auto">
            Promotor ini belum memiliki konser yang sedang dibuka untuk penjualan tiket publik saat ini.
          </p>
        </div>
      ) : (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {eventCards.map((ev) => (
            <article class="rounded-2xl bg-white dark:bg-dark-plum border border-neutral-200 dark:border-white/[0.08] shadow-sm dark:shadow-none overflow-hidden flex flex-col group hover:border-electric-magenta/50 hover:shadow-magenta-glow transition-all duration-300">
              <a href={`/events/${ev.id}`} class="relative w-full aspect-[16/10] overflow-hidden bg-neutral-100 dark:bg-void-black block">
                <img
                  src={ev.poster_url || 'https://images.unsplash.com/photo-1470225620780-dba8ba36b745?auto=format&fit=crop&w=1200&q=80'}
                  alt={ev.nama_event}
                  class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-500"
                  loading="lazy"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-black/50 dark:from-dark-plum via-transparent to-transparent"></div>
                <div class="absolute top-4 right-4">
                  {ev.isSoldOut ? (
                    <span class="px-3 py-1 rounded-full text-[10px] font-bold tracking-wider uppercase bg-black/80 text-white/80 border border-white/15 font-mono">HABIS TERJUAL</span>
                  ) : ev.isPaused ? (
                    <span class="px-3 py-1 rounded-full text-[10px] font-bold tracking-wider uppercase bg-amber-400 text-void-black border border-amber-200 font-mono">DIJEDA</span>
                  ) : (
                    <span class="px-3 py-1 rounded-full text-[10px] font-bold tracking-wider uppercase bg-electric-magenta text-white font-mono">TERSEDIA</span>
                  )}
                </div>
                {ev.genre && (
                  <div class="absolute top-4 left-4">
                    <span class="px-2.5 py-1 rounded-md text-[10px] font-mono font-bold uppercase bg-black/65 text-white border border-white/15">
                      {ev.genre}
                    </span>
                  </div>
                )}
              </a>

              <div class="p-6 flex flex-col flex-1 justify-between gap-5">
                <div>
                  <div class="flex items-center gap-2 text-xs text-electric-magenta font-semibold tracking-wider uppercase mb-2">
                    <span>{formatDateIndo(ev.tanggal_mulai, { showTime: false })}</span>
                    <span>•</span>
                    <span class="truncate">{ev.displayCity}</span>
                  </div>
                  <a href={`/events/${ev.id}`} class="block group-hover:text-electric-magenta transition-colors">
                    <h2 class="font-display text-2xl text-neutral-950 dark:text-soft-white leading-tight line-clamp-2">
                      {ev.nama_event}
                    </h2>
                  </a>
                  <p class="text-sm text-neutral-700 dark:text-muted-gray mt-2 line-clamp-1 font-medium">{ev.artis}</p>
                  <p class="text-xs text-neutral-500 dark:text-muted-gray/70 mt-1 truncate">{ev.alamat}</p>
                </div>

                <div class="pt-4 border-t border-neutral-200 dark:border-white/[0.08] flex items-center justify-between">
                  <div>
                    <span class="text-[10px] text-neutral-500 dark:text-muted-gray uppercase tracking-wider block font-mono">Mulai Dari</span>
                    <span class="font-display text-2xl text-neutral-950 dark:text-soft-white">
                      {formatRupiah(ev.min_price)}
                    </span>
                  </div>
                  <a href={`/events/${ev.id}`} class="px-5 py-2.5 rounded-full bg-electric-magenta hover:shadow-magenta-glow text-white text-xs font-bold uppercase tracking-wider hover:scale-105 active:scale-95 transition-all">
                    {ev.isSoldOut ? 'DETAIL' : ev.isPaused ? 'LIHAT' : 'WAR TIKET'}
                  </a>
                </div>
              </div>
            </article>
          ))}
        </div>
      )}
    </div>
  )}

  <Footer />
</RootLayout>
