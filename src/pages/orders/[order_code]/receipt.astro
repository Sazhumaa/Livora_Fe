---
export const prerender = false;

import RootLayout from '../../../layouts/RootLayout.astro';
import Footer from '../../../components/landing/Footer.astro';
---

<RootLayout 
  title="Kuitansi Resmi Pembayaran Tiket — AFTERGLOW" 
  description="Bukti pembayaran sah berstempel lunas untuk tiket konser musik resmi AFTERGLOW."
>
  <div class="relative pt-28 pb-24 px-4 sm:px-6 lg:px-12 max-w-3xl mx-auto w-full">

    <!-- Loading Skeleton -->
    <div id="receipt-loading" class="animate-pulse space-y-6">
      <div class="h-28 rounded-3xl bg-dark-plum/70 border border-white/10"></div>
      <div class="h-80 rounded-3xl bg-dark-plum/70 border border-white/10"></div>
    </div>

    <!-- Error / Unauthorized State -->
    <div id="receipt-error-state" class="hidden text-center py-20">
      <div class="w-20 h-20 rounded-full bg-dark-plum border border-white/15 flex items-center justify-center mx-auto mb-4 text-electric-magenta">
        <svg class="w-8 h-8" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
        </svg>
      </div>
      <h2 id="receipt-error-title" class="font-display text-4xl text-soft-white mb-2">KUITANSI TIDAK TERSEDIA</h2>
      <p id="receipt-error-desc" class="text-sm text-muted-gray max-w-md mx-auto mb-6"></p>
      <div class="flex flex-wrap justify-center gap-3">
        <button id="receipt-login-btn" type="button" class="hidden px-6 py-3 rounded-full bg-electric-magenta text-soft-white font-bold text-xs uppercase tracking-wider hover:shadow-magenta-glow transition-all">
          Masuk Ke Akun
        </button>
        <a href="/account?tab=orders" class="px-6 py-3 rounded-full bg-white/10 hover:bg-white/20 text-soft-white font-bold text-xs uppercase tracking-wider transition-all">
          Lihat Riwayat Order
        </a>
      </div>
    </div>
    
    <!-- Printable Invoice Container -->
    <div id="receipt-container" class="hidden rounded-3xl bg-dark-plum/90 border border-white/15 p-8 sm:p-12 shadow-2xl backdrop-blur-2xl text-soft-white print:bg-white print:text-black print:border-none print:shadow-none">
      
      <!-- Top Receipt Header: Brand & PAID Stamp -->
      <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6 pb-8 border-b border-white/10 print:border-black/20">
        <div>
          <span class="font-display text-4xl text-soft-white print:text-black tracking-wider block">
            AFTERGLOW
          </span>
          <span class="text-xs font-mono text-muted-gray print:text-neutral-600 block mt-0.5">
            PLATFORM TIKET KONSER RESMI BERLISENSI
          </span>
          <p class="text-[11px] text-muted-gray print:text-neutral-500 font-mono mt-1">
            NPWP: 01.345.678.9-012.000 • soundtix.id
          </p>
        </div>

        <!-- Official Status Stamp -->
        <div id="receipt-status-badge" class="flex items-center gap-3 px-5 py-2.5 rounded-2xl bg-emerald-500/15 border border-emerald-500/40 text-emerald-400 print:text-emerald-700 print:border-emerald-600 shadow-lg">
          <svg class="w-6 h-6 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <div class="leading-tight">
            <span class="text-[10px] font-mono tracking-widest uppercase block">STATUS TRANSAKSI</span>
            <span id="receipt-status-text" class="font-display text-2xl tracking-wider">LUNAS // PAID</span>
          </div>
        </div>
      </div>

      <!-- Transaction Meta Grid -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-6 py-8 border-b border-white/10 print:border-black/20 text-xs font-mono">
        <div>
          <span class="text-muted-gray print:text-neutral-500 block">KODE ORDER:</span>
          <strong id="receipt-order-code" class="text-soft-white print:text-black text-sm block mt-0.5">ORD-XXXX</strong>
        </div>
        <div>
          <span class="text-muted-gray print:text-neutral-500 block">TANGGAL LUNAS:</span>
          <strong id="receipt-paid-at" class="text-soft-white print:text-black text-sm block mt-0.5">-</strong>
        </div>
        <div>
          <span class="text-muted-gray print:text-neutral-500 block">METODE BAYAR:</span>
          <strong id="receipt-channel" class="text-soft-white print:text-black text-sm block mt-0.5">MOCK PAY</strong>
        </div>
        <div>
          <span class="text-muted-gray print:text-neutral-500 block">PEMBELI:</span>
          <strong id="receipt-buyer-email" class="text-soft-white print:text-black text-sm block mt-0.5 truncate">-</strong>
        </div>
      </div>

      <!-- Concert Info Banner -->
      <div class="py-6 border-b border-white/10 print:border-black/20">
        <span class="text-[10px] font-mono font-bold tracking-widest text-electric-magenta print:text-pink-700 uppercase block mb-1">
          DETAIL EVENT KONSER
        </span>
        <h2 id="receipt-event-title" class="font-display text-3xl text-soft-white print:text-black">
          AFTERGLOW LIVE CONCERT
        </h2>
        <p id="receipt-event-venue" class="text-xs text-muted-gray print:text-neutral-600 mt-1">-</p>
        <p id="receipt-event-date" class="text-xs text-electric-magenta print:text-pink-700 font-mono font-semibold mt-1">-</p>
      </div>

      <!-- Ticket Items Table -->
      <div class="py-6 border-b border-white/10 print:border-black/20">
        <table class="w-full text-xs">
          <thead>
            <tr class="text-muted-gray print:text-neutral-500 font-mono border-b border-white/10 print:border-black/20 pb-2">
              <th class="text-left font-semibold pb-2">KATEGORI TIKET</th>
              <th class="text-center font-semibold pb-2">QTY</th>
              <th class="text-right font-semibold pb-2">HARGA SATUAN</th>
              <th class="text-right font-semibold pb-2">SUBTOTAL</th>
            </tr>
          </thead>
          <tbody id="receipt-items-tbody" class="divide-y divide-white/5 print:divide-black/10">
            <!-- Dynamically injected item rows -->
          </tbody>
        </table>
      </div>

      <!-- Financial Totals -->
      <div class="py-6 border-b border-white/10 print:border-black/20 space-y-2 text-xs font-mono">
        <div class="flex justify-between text-muted-gray print:text-neutral-600">
          <span>Subtotal Tiket:</span>
          <span id="receipt-subtotal" class="text-soft-white print:text-black font-semibold">Rp 0</span>
        </div>
        <div id="receipt-discount-row" class="hidden flex justify-between text-emerald-400 print:text-emerald-700">
          <span>Diskon Voucher (<span id="receipt-voucher-code"></span>):</span>
          <span id="receipt-discount" class="font-semibold">-Rp 0</span>
        </div>
        <div class="flex justify-between text-muted-gray print:text-neutral-600">
          <span>Platform & Escrow Convenience Fee (5%):</span>
          <span id="receipt-platform-fee" class="text-soft-white print:text-black font-semibold">Rp 0</span>
        </div>
        <div class="flex justify-between text-sm font-bold pt-3 border-t border-white/10 print:border-black/20">
          <span class="text-soft-white print:text-black font-sans">TOTAL TELAH DIBAYAR:</span>
          <span id="receipt-total-paid" class="font-display text-3xl text-electric-magenta print:text-pink-700">Rp 0</span>
        </div>
      </div>

      <!-- Issued Ticket Codes Summary -->
      <div id="receipt-tickets-box" class="hidden py-5 border-b border-white/10 print:border-black/20">
        <span class="text-[10px] font-mono uppercase tracking-wider text-muted-gray print:text-neutral-600 block mb-2">
          E-TIKET DITERBITKAN:
        </span>
        <div id="receipt-ticket-codes" class="flex flex-wrap gap-2"></div>
      </div>

      <!-- Escrow Guarantee & Legal Disclaimer -->
      <div class="pt-6 text-[11px] text-muted-gray print:text-neutral-500 space-y-2">
        <p>
          🛡️ <strong>Garansi Perlindungan Escrow AFTERGLOW</strong>: Dana pembayaran Anda disimpan aman dalam rekening bersama penampungan platform dan baru akan dicairkan ke promotor setelah konser berhasil digelar.
        </p>
        <p>
          Dokumen kuitansi ini diterbitkan secara elektronik oleh sistem komputerisasi AFTERGLOW dan merupakan bukti transaksi yang sah menurut ketentuan undang-undang perpajakan dan perdagangan elektronik Republik Indonesia.
        </p>
      </div>

      <!-- Action Buttons (Hidden when printing) -->
      <div class="mt-8 flex flex-col sm:flex-row items-center justify-between gap-4 print:hidden">
        <div class="flex items-center gap-3 w-full sm:w-auto">
          <button 
            id="print-receipt-btn" 
            type="button" 
            class="flex items-center justify-center gap-2 px-5 py-3 rounded-xl bg-white/10 hover:bg-white/20 text-soft-white text-xs font-bold uppercase tracking-wider transition-all"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4H7v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z" />
            </svg>
            <span>Cetak Kuitansi</span>
          </button>

          <a 
            id="receipt-calendar-btn" 
            href="#" 
            target="_blank" 
            rel="noopener noreferrer" 
            class="flex items-center justify-center gap-2 px-5 py-3 rounded-xl bg-white/10 hover:bg-white/20 text-soft-white text-xs font-bold uppercase tracking-wider transition-all"
          >
            <svg class="w-4 h-4 text-electric-magenta" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
            <span>Simpan Kalender</span>
          </a>
        </div>

        <a 
          href="/tickets" 
          class="w-full sm:w-auto px-8 py-3.5 rounded-full bg-electric-magenta text-soft-white font-bold text-xs uppercase tracking-wider text-center hover:shadow-magenta-glow transition-all hover:scale-105 active:scale-95"
        >
          BUKA E-TIKET SAYA (QR SCAN) →
        </a>
      </div>

    </div>
  </div>

  <Footer />
</RootLayout>

<script>
  import { api, ApiError } from '../../../lib/api';
  import { isAuthenticated } from '../../../lib/auth';
  import { calculatePlatformFee } from '../../../lib/events';
  import { escapeHtml, formatRupiah, formatDateIndo, getGoogleCalendarUrl } from '../../../lib/formatters';

  function initReceipt() {
    const pathParts = window.location.pathname.split('/').filter(Boolean);
    const orderCode = pathParts[pathParts.length - 2];

    const loadingEl = document.getElementById('receipt-loading');
    const containerEl = document.getElementById('receipt-container');
    const errorEl = document.getElementById('receipt-error-state');
    const errorTitle = document.getElementById('receipt-error-title');
    const errorDesc = document.getElementById('receipt-error-desc');
    const loginBtn = document.getElementById('receipt-login-btn');

    const statusBadge = document.getElementById('receipt-status-badge');
    const statusText = document.getElementById('receipt-status-text');
    const codeSpan = document.getElementById('receipt-order-code');
    const paidAtSpan = document.getElementById('receipt-paid-at');
    const channelSpan = document.getElementById('receipt-channel');
    const buyerEmailSpan = document.getElementById('receipt-buyer-email');
    const eventTitle = document.getElementById('receipt-event-title');
    const eventVenue = document.getElementById('receipt-event-venue');
    const eventDate = document.getElementById('receipt-event-date');
    const itemsTbody = document.getElementById('receipt-items-tbody');
    const subtotalSpan = document.getElementById('receipt-subtotal');
    const discountRow = document.getElementById('receipt-discount-row');
    const voucherCodeSpan = document.getElementById('receipt-voucher-code');
    const discountSpan = document.getElementById('receipt-discount');
    const feeSpan = document.getElementById('receipt-platform-fee');
    const totalPaidSpan = document.getElementById('receipt-total-paid');
    const ticketsBox = document.getElementById('receipt-tickets-box');
    const ticketCodesEl = document.getElementById('receipt-ticket-codes');
    const calendarBtn = document.getElementById('receipt-calendar-btn') as HTMLAnchorElement | null;
    const printBtn = document.getElementById('print-receipt-btn');

    let isDisposed = false;

    printBtn?.addEventListener('click', () => window.print());
    loginBtn?.addEventListener('click', () => {
      if (typeof (window as any).openAuthModal === 'function') (window as any).openAuthModal();
      else window.location.href = '/masuk';
    });

    function showError(title: string, desc: string, needsAuth = false) {
      loadingEl?.classList.add('hidden');
      containerEl?.classList.add('hidden');
      errorEl?.classList.remove('hidden');
      if (errorTitle) errorTitle.textContent = title;
      if (errorDesc) errorDesc.textContent = desc;
      if (needsAuth) loginBtn?.classList.remove('hidden');
      else loginBtn?.classList.add('hidden');
    }

    if (!orderCode) return () => {};

    async function loadReceiptData() {
      if (orderCode === 'demo') {
        const fee = calculatePlatformFee(1500000);
        renderReceipt({
          order_code: 'ORD-UKK-DEMO-2026',
          status: 'paid',
          created_at: new Date().toISOString(),
          event: {
            id: 1,
            nama_event: 'AFTERGLOW FESTIVAL 2026: VOID INCEPTION',
            tanggal_mulai: new Date(Date.now() + 7 * 86400000).toISOString(),
            alamat: 'Gelora Bung Karno Stadium, Jakarta',
          },
          user: { id: 1, username: 'Buyer Demo', email: 'buyer@soundtix.id' },
          items: [{ category_id: 1, nama_kategori: 'VIP PANGGUNG', qty: 1, harga_per_tiket: 1500000, subtotal: 1500000 }],
          pricing: { total_amount: 1500000, diskon_amount: 0, platform_fee: fee, final_amount: 1500000 + fee, kode_voucher: null },
          payment: { payment_method: 'mock', channel: 'INTERNAL_MOCK', payment_status: 'paid', amount: 1500000 + fee, paid_at: new Date().toISOString() },
          tickets: [{ ticket_code: 'TKT-DEMO-001', status: 'active', owner_name: 'Buyer Demo' }],
        });
        return;
      }

      if (!isAuthenticated()) {
        showError('AUTENTIKASI DIPERLUKAN', 'Masuk ke akun pemilik pesanan untuk membuka kuitansi resmi.', true);
        return;
      }

      try {
        const receipt = await api.get(`/orders/${orderCode}/receipt`);
        if (!isDisposed) renderReceipt(receipt);
      } catch (err: any) {
        if (isDisposed) return;
        const status = err instanceof ApiError ? err.status : 0;
        if (status === 401 || status === 403) {
          showError('AKSES KUITANSI DITOLAK', err.message || 'Akun ini bukan pemilik order.', true);
        } else {
          showError('KUITANSI TIDAK DITEMUKAN', err?.message || `Kuitansi untuk order ${orderCode} belum tersedia atau belum lunas.`);
        }
      }
    }

    function renderReceipt(data: any) {
      loadingEl?.classList.add('hidden');
      errorEl?.classList.add('hidden');
      containerEl?.classList.remove('hidden');

      const ev = data.event || {};
      const user = data.user || {};
      const pricing = data.pricing || {};
      const payment = data.payment || {};
      const items = Array.isArray(data.items) ? data.items : [];
      const tickets = Array.isArray(data.tickets) ? data.tickets : [];

      if (statusBadge && statusText) {
        if (data.status === 'refunded') {
          statusBadge.className = 'flex items-center gap-3 px-5 py-2.5 rounded-2xl bg-amber-500/15 border border-amber-500/40 text-amber-300 print:text-amber-700 print:border-amber-600 shadow-lg';
          statusText.textContent = 'REFUNDED';
        } else {
          statusBadge.className = 'flex items-center gap-3 px-5 py-2.5 rounded-2xl bg-emerald-500/15 border border-emerald-500/40 text-emerald-400 print:text-emerald-700 print:border-emerald-600 shadow-lg';
          statusText.textContent = 'LUNAS // PAID';
        }
      }

      if (codeSpan) codeSpan.textContent = data.order_code || orderCode;
      if (paidAtSpan) paidAtSpan.textContent = formatDateIndo(payment.paid_at || data.created_at || new Date());
      if (channelSpan) {
        const channelLabel = payment.channel || payment.payment_method || 'ONLINE PAYMENT';
        channelSpan.textContent = String(channelLabel).toUpperCase();
      }
      if (buyerEmailSpan) buyerEmailSpan.textContent = user.email || user.username || '-';

      const eventName = ev.nama_event || data.nama_event || 'AFTERGLOW Concert';
      const eventAddr = ev.alamat || data.alamat || '-';
      const eventStart = ev.tanggal_mulai || data.tanggal_mulai;

      if (eventTitle) eventTitle.textContent = eventName;
      if (eventVenue) eventVenue.textContent = eventAddr;
      if (eventDate) eventDate.textContent = formatDateIndo(eventStart);

      if (itemsTbody) {
        itemsTbody.innerHTML = items
          .map((item: any) => {
            const unitPrice = Number(item.harga_per_tiket ?? item.price ?? item.harga ?? 0);
            const qty = Number(item.qty || 1);
            const sub = Number(item.subtotal ?? unitPrice * qty);
            const catName = item.nama_kategori || item.category_name || 'Tiket Konser';
            return `
              <tr class="py-2.5">
                <td class="py-2.5 text-soft-white print:text-black font-semibold">${escapeHtml(catName)}</td>
                <td class="py-2.5 text-center text-muted-gray print:text-neutral-600">${qty}</td>
                <td class="py-2.5 text-right font-mono text-muted-gray print:text-neutral-600">${escapeHtml(formatRupiah(unitPrice))}</td>
                <td class="py-2.5 text-right font-mono text-soft-white print:text-black font-bold">${escapeHtml(formatRupiah(sub))}</td>
              </tr>
            `;
          })
          .join('');
      }

      const subtotalVal = Number(pricing.total_amount ?? data.total_amount ?? 0);
      const discountVal = Number(pricing.diskon_amount ?? data.diskon_amount ?? 0);
      const feeVal = Number(pricing.platform_fee ?? data.platform_fee ?? 0);
      const finalVal = Number(pricing.final_amount ?? data.final_amount ?? 0);

      if (subtotalSpan) subtotalSpan.textContent = formatRupiah(subtotalVal);
      if (discountRow && discountSpan && voucherCodeSpan) {
        if (discountVal > 0) {
          discountRow.classList.remove('hidden');
          voucherCodeSpan.textContent = pricing.kode_voucher || 'PROMO';
          discountSpan.textContent = `-${formatRupiah(discountVal)}`;
        } else {
          discountRow.classList.add('hidden');
        }
      }
      if (feeSpan) feeSpan.textContent = formatRupiah(feeVal);
      if (totalPaidSpan) totalPaidSpan.textContent = formatRupiah(finalVal);

      if (ticketsBox && ticketCodesEl) {
        if (tickets.length > 0) {
          ticketsBox.classList.remove('hidden');
          ticketCodesEl.innerHTML = tickets
            .map(
              (t: any) => `
              <span class="px-3 py-1.5 rounded-lg bg-void-black/80 border border-white/15 print:border-black/30 print:bg-neutral-100 font-mono text-[11px] font-bold">
                ${escapeHtml(t.ticket_code)} (${escapeHtml(String(t.status || 'active').toUpperCase())})
              </span>
            `
            )
            .join('');
        } else {
          ticketsBox.classList.add('hidden');
        }
      }

      if (calendarBtn && eventStart) {
        calendarBtn.href = getGoogleCalendarUrl({
          nama_event: eventName,
          tanggal_mulai: eventStart,
          alamat: eventAddr,
          organization_name: 'AFTERGLOW Live',
        });
      }
    }

    const onAuthChanged = () => loadReceiptData();
    window.addEventListener('afterglow-auth-changed', onAuthChanged);
    loadReceiptData();

    return () => {
      isDisposed = true;
      window.removeEventListener('afterglow-auth-changed', onAuthChanged);
    };
  }

  let receiptCleanup: (() => void) | undefined;
  document.addEventListener('astro:page-load', () => {
    if (receiptCleanup) receiptCleanup();
    receiptCleanup = initReceipt();
  });
</script>
