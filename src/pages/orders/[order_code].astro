---
export const prerender = false;

import RootLayout from '../../layouts/RootLayout.astro';
import Footer from '../../components/landing/Footer.astro';
---

<RootLayout 
  title="Selesaikan Pembayaran Tiket — AFTERGLOW" 
  description="Konfirmasi pesanan tiket konser dan selesaikan transaksi dalam 15 menit."
>
  <div class="relative pt-28 pb-24 px-4 sm:px-6 lg:px-12 max-w-4xl mx-auto w-full">
    
    <!-- Loading Skeleton Placeholder -->
    <div id="order-loading-skeleton" class="animate-pulse space-y-6">
      <div class="h-8 bg-neutral-200 dark:bg-white/5 rounded-xl w-1/3"></div>
      <div class="h-64 bg-neutral-200/70 dark:bg-dark-plum/70 rounded-3xl border border-neutral-200 dark:border-white/10"></div>
    </div>

    <!-- Main Order Container (Hidden until client loads order) -->
    <div id="order-content" class="hidden space-y-8">
      
      <!-- Top Status Banner with 15-Minute Countdown -->
      <div class="p-6 sm:p-8 rounded-3xl bg-white dark:bg-dark-plum border border-electric-magenta/40 shadow-magenta-glow backdrop-blur-xl relative overflow-hidden flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6">
        <div class="space-y-1">
          <div class="flex items-center gap-2">
            <span class="w-2.5 h-2.5 rounded-full bg-electric-magenta animate-ping"></span>
            <span class="text-xs font-mono font-bold tracking-widest text-electric-magenta uppercase">
              RESERVASI KUOTA AKTIF
            </span>
          </div>
          <h1 class="font-display text-3xl sm:text-4xl text-neutral-950 dark:text-soft-white tracking-wide">
            SELESAIKAN PEMBAYARAN TIKET
          </h1>
          <p class="text-xs text-neutral-600 dark:text-muted-gray">
            Kode Transaksi: <strong id="order-code-display" class="font-mono text-neutral-950 dark:text-soft-white tracking-wider">ORD-XXXX</strong>
          </p>
        </div>

        <!-- 15-Minute Countdown Clock Disc -->
        <div class="flex flex-col items-center justify-center p-4 rounded-2xl bg-neutral-50 dark:bg-void-black/80 border border-neutral-200 dark:border-white/15 min-w-[140px] text-center shadow-sm dark:shadow-lg">
          <span class="text-[10px] font-mono text-neutral-500 dark:text-muted-gray uppercase tracking-wider mb-1">SISA WAKTU BAYAR</span>
          <span id="order-countdown-timer" class="font-display text-4xl text-electric-magenta tracking-widest animate-pulse">
            15:00
          </span>
          <span class="text-[9px] text-neutral-500 dark:text-muted-gray mt-1 font-mono">Sebelum Kuota Dilepas</span>
        </div>
      </div>

      <!-- Order Summary Card -->
      <div class="p-7 sm:p-9 rounded-3xl bg-white dark:bg-dark-plum/80 border border-neutral-200 dark:border-white/15 shadow-sm dark:shadow-none backdrop-blur-xl space-y-6">
        <h2 class="font-display text-2xl text-neutral-950 dark:text-soft-white border-b border-neutral-200 dark:border-white/10 pb-4">
          RINCIAN TIKET YANG DIPESAN
        </h2>

        <!-- Event Basic Info -->
        <div class="flex items-start gap-4">
          <div class="w-16 h-16 rounded-2xl bg-neutral-100 dark:bg-void-black border border-neutral-200 dark:border-white/10 overflow-hidden shrink-0">
            <img 
              id="order-event-poster" 
              src="https://images.unsplash.com/photo-1470225620780-dba8ba36b745?auto=format&fit=crop&w=300&q=80" 
              alt="Poster Event" 
              class="w-full h-full object-cover" 
            />
          </div>
          <div>
            <h3 id="order-event-title" class="font-bold text-lg text-neutral-950 dark:text-soft-white">Nama Konser Musik</h3>
            <p id="order-event-venue" class="text-xs text-neutral-600 dark:text-muted-gray mt-0.5">Gelora Bung Karno Stadium, Jakarta</p>
            <p id="order-event-date" class="text-xs text-electric-magenta font-mono font-semibold mt-1">Sabtu, 14 Nov 2026 • 19:00 WIB</p>
          </div>
        </div>

        <!-- Purchased Ticket Items List -->
        <div id="order-items-list" class="space-y-3 pt-2">
          <!-- Dynamically injected item rows -->
        </div>

        <!-- Applied Promo Badge (Shown when voucher was attached at checkout) -->
        <div id="order-voucher-badge" class="hidden p-4 rounded-2xl bg-emerald-50 dark:bg-emerald-500/10 border border-emerald-200 dark:border-emerald-500/30 flex items-center justify-between">
          <div>
            <span class="text-[10px] font-mono uppercase tracking-wider text-emerald-700 dark:text-emerald-300 block">Kode Promo Diterapkan</span>
            <strong id="order-voucher-code" class="font-mono text-sm text-neutral-950 dark:text-soft-white"></strong>
          </div>
          <span class="px-2.5 py-1 rounded bg-emerald-100 dark:bg-emerald-500/20 text-emerald-700 dark:text-emerald-300 font-mono text-[10px] font-bold">ACTIVE</span>
        </div>

        <!-- Transparent Price Breakdown (5% Platform Fee) -->
        <div class="space-y-2 py-4 border-t border-b border-neutral-200 dark:border-white/10 text-xs font-mono">
          <div class="flex justify-between text-neutral-600 dark:text-muted-gray">
            <span>Subtotal Tiket:</span>
            <span id="order-subtotal" class="text-neutral-950 dark:text-soft-white">Rp 0</span>
          </div>
          <div id="order-discount-row" class="hidden flex justify-between text-emerald-600 dark:text-emerald-400">
            <span>Potongan Diskon Voucher:</span>
            <span id="order-discount-amount">- Rp 0</span>
          </div>
          <div class="flex justify-between text-neutral-600 dark:text-muted-gray">
            <span>Platform & Escrow Fee (5%):</span>
            <span id="order-platform-fee" class="text-neutral-950 dark:text-soft-white">Rp 0</span>
          </div>
          <div class="flex justify-between text-base font-bold pt-3 border-t border-neutral-200 dark:border-white/10">
            <span class="text-neutral-950 dark:text-soft-white font-sans">Total Pembayaran Lunas:</span>
            <span id="order-final-amount" class="font-display text-3xl text-electric-magenta">Rp 0</span>
          </div>
        </div>

        <!-- Payment Action Feedback -->
        <div id="order-action-msg" class="hidden p-3.5 rounded-xl bg-neutral-100 dark:bg-white/5 border border-neutral-200 dark:border-white/10 text-xs font-mono text-neutral-600 dark:text-muted-gray"></div>

        <!-- Payment Actions (Xendit Invoice OR Mock Payment + Cancel) -->
        <div class="space-y-3 pt-2">
          <!-- XENDIT LIVE INVOICE CONTAINER -->
          <div id="xendit-payment-box" class="hidden space-y-3">
            <a
              id="xendit-pay-link"
              href="#"
              target="_blank"
              rel="noopener noreferrer"
              class="w-full py-4 px-6 rounded-2xl bg-electric-magenta text-white font-bold text-sm tracking-wider uppercase flex items-center justify-center gap-2 hover:shadow-magenta-glow transition-all duration-300 hover:scale-[1.01]"
            >
              <span>LANJUTKAN BAYAR VIA XENDIT INVOICE (QRIS / VA / E-WALLET)</span>
              <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </a>
            <button
              id="check-status-btn"
              type="button"
              class="w-full py-3 px-6 rounded-2xl bg-emerald-50 dark:bg-emerald-500/15 border border-emerald-200 dark:border-emerald-500/40 text-emerald-700 dark:text-emerald-300 hover:bg-emerald-100 dark:hover:bg-emerald-500/25 text-xs font-bold tracking-wider uppercase transition-all"
            >
              Saya Sudah Bayar — Cek Status Transaksi Sekarang
            </button>
          </div>

          <!-- DEV MOCK PAY BUTTON -->
          <button 
            id="mock-pay-btn" 
            type="button" 
            class="hidden w-full py-4 px-6 rounded-2xl bg-electric-magenta text-white font-bold text-sm tracking-wider uppercase flex items-center justify-center gap-2 hover:shadow-magenta-glow transition-all duration-300 hover:scale-[1.01] active:scale-[0.99] disabled:opacity-50"
          >
            <span class="btn-text">⚡ SIMULASIKAN PEMBAYARAN INSTAN (MOCK PAY)</span>
            <svg class="w-4 h-4 btn-spinner hidden animate-spin" fill="none" viewBox="0 0 24 24">
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
              <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
            </svg>
          </button>

          <!-- CANCEL ORDER BUTTON -->
          <button 
            id="cancel-order-btn" 
            type="button" 
            class="w-full py-3 px-6 rounded-2xl bg-neutral-100 dark:bg-white/5 border border-neutral-200 dark:border-white/10 text-neutral-600 dark:text-muted-gray hover:text-red-600 dark:hover:text-red-400 hover:border-red-300 dark:hover:border-red-500/40 text-xs font-semibold tracking-wider uppercase transition-colors"
          >
            Batalkan Pesanan Ini (Kembalikan Kuota)
          </button>
        </div>
      </div>
    </div>

    <!-- Expired / Cancelled / Refunded State -->
    <div id="order-expired-state" class="hidden text-center py-20 max-w-xl mx-auto">
      <div class="w-20 h-20 rounded-full bg-red-50 dark:bg-red-950/40 border border-red-200 dark:border-red-500/40 flex items-center justify-center mx-auto mb-4 text-red-600 dark:text-red-400">
        <svg class="w-8 h-8" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
      </div>
      <h2 id="order-closed-title" class="font-display text-4xl text-neutral-950 dark:text-soft-white mb-2">SESI RESERVASI TELAH BERAKHIR</h2>
      <p id="order-closed-desc" class="text-sm text-neutral-600 dark:text-muted-gray max-w-md mx-auto mb-6">
        Batas waktu pembayaran 15 menit telah habis dan kuota tiket telah dikembalikan ke katalog publik secara otomatis.
      </p>

      <div id="order-late-payment-box" class="hidden mb-6 p-5 rounded-2xl bg-amber-50 dark:bg-amber-950/30 border border-amber-200 dark:border-amber-500/40 text-left space-y-2">
        <div class="flex items-center justify-between gap-2">
          <span class="text-[11px] font-mono font-bold uppercase tracking-wider text-amber-800 dark:text-amber-300">
            Perlindungan Dana Pembeli (Path B)
          </span>
          <span id="order-late-refund-status" class="px-2.5 py-0.5 rounded-full bg-amber-100 dark:bg-amber-500/20 border border-amber-300 dark:border-amber-500/40 text-amber-800 dark:text-amber-200 text-[10px] font-mono font-bold uppercase">
            PENDING
          </span>
        </div>
        <p id="order-late-refund-reason" class="text-xs text-amber-900 dark:text-amber-100/90 leading-relaxed">
          Pembayaran masuk setelah batas reservasi berakhir. Dana otomatis dimasukkan ke antrean pengembalian dana platform.
        </p>
      </div>

      <div class="flex flex-wrap items-center justify-center gap-3">
        <a id="order-refund-track-link" href="/account?tab=refunds" class="hidden px-6 py-3 rounded-full bg-neutral-100 hover:bg-neutral-200 dark:bg-white/10 dark:hover:bg-white/20 border border-neutral-200 dark:border-white/15 text-neutral-900 dark:text-soft-white font-bold text-xs uppercase tracking-wider transition-all">
          Pantau Status Refund →
        </a>
        <a href="/events" class="px-6 py-3 rounded-full bg-electric-magenta text-white font-bold text-xs uppercase tracking-wider hover:shadow-magenta-glow transition-all">
          CARI TIKET LAIN
        </a>
      </div>
    </div>

    <!-- Order Not Found / Error / Unauthorized State -->
    <div id="order-error-state" class="hidden text-center py-20">
      <div class="w-20 h-20 rounded-full bg-white dark:bg-dark-plum border border-neutral-200 dark:border-white/15 shadow-sm dark:shadow-none flex items-center justify-center mx-auto mb-4 text-electric-magenta">
        <svg class="w-8 h-8" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01M5.07 19h13.86c1.54 0 2.5-1.67 1.73-3L13.73 4c-.77-1.33-2.69-1.33-3.46 0L3.34 16c-.77 1.33.19 3 1.73 3z" />
        </svg>
      </div>
      <h2 id="order-error-title" class="font-display text-4xl text-neutral-950 dark:text-soft-white mb-2">ORDER TIDAK DAPAT DIMUAT</h2>
      <p id="order-error-desc" class="text-sm text-neutral-600 dark:text-muted-gray max-w-md mx-auto mb-6"></p>
      <div class="flex flex-wrap justify-center gap-3">
        <button id="order-login-btn" type="button" class="hidden px-6 py-3 rounded-full bg-electric-magenta text-white font-bold text-xs uppercase tracking-wider hover:shadow-magenta-glow transition-all">
          Masuk Ke Akun
        </button>
        <a href="/events" class="px-6 py-3 rounded-full bg-neutral-100 hover:bg-neutral-200 dark:bg-white/10 dark:hover:bg-white/20 text-neutral-900 dark:text-soft-white border border-neutral-200 dark:border-transparent font-bold text-xs uppercase tracking-wider transition-all">
          Kembali ke Katalog
        </a>
      </div>
    </div>

  </div>

  <Footer />
</RootLayout>

<script>
  import { api, ApiError, resolveAssetUrl } from '../../lib/api';
  import { isAuthenticated } from '../../lib/auth';
  import { calculatePlatformFee } from '../../lib/events';
  import { escapeHtml, formatCountdown, formatDateIndo, formatRupiah } from '../../lib/formatters';

  function initOrderCheckout() {
    const pathParts = window.location.pathname.split('/').filter(Boolean);
    const orderCode = pathParts[pathParts.length - 1];

    const skeleton = document.getElementById('order-loading-skeleton');
    const content = document.getElementById('order-content');
    const expiredState = document.getElementById('order-expired-state');
    const closedTitle = document.getElementById('order-closed-title');
    const closedDesc = document.getElementById('order-closed-desc');
    const latePaymentBox = document.getElementById('order-late-payment-box');
    const lateRefundStatus = document.getElementById('order-late-refund-status');
    const lateRefundReason = document.getElementById('order-late-refund-reason');
    const refundTrackLink = document.getElementById('order-refund-track-link');
    const errorState = document.getElementById('order-error-state');
    const errorTitle = document.getElementById('order-error-title');
    const errorDesc = document.getElementById('order-error-desc');
    const loginBtn = document.getElementById('order-login-btn');

    const codeDisplay = document.getElementById('order-code-display');
    const countdownTimer = document.getElementById('order-countdown-timer');
    const eventPoster = document.getElementById('order-event-poster') as HTMLImageElement | null;
    const eventTitle = document.getElementById('order-event-title');
    const eventVenue = document.getElementById('order-event-venue');
    const eventDate = document.getElementById('order-event-date');
    const itemsList = document.getElementById('order-items-list');

    const voucherBadge = document.getElementById('order-voucher-badge');
    const voucherCodeEl = document.getElementById('order-voucher-code');

    const subtotalDisplay = document.getElementById('order-subtotal');
    const discountRow = document.getElementById('order-discount-row');
    const discountAmount = document.getElementById('order-discount-amount');
    const platformFeeDisplay = document.getElementById('order-platform-fee');
    const finalAmountDisplay = document.getElementById('order-final-amount');
    const actionMsg = document.getElementById('order-action-msg');

    const xenditBox = document.getElementById('xendit-payment-box');
    const xenditLink = document.getElementById('xendit-pay-link') as HTMLAnchorElement | null;
    const checkStatusBtn = document.getElementById('check-status-btn') as HTMLButtonElement | null;
    const mockPayBtn = document.getElementById('mock-pay-btn') as HTMLButtonElement | null;
    const cancelBtn = document.getElementById('cancel-order-btn') as HTMLButtonElement | null;

    let timerInterval: any = null;
    let pollingInterval: any = null;
    let pollCount = 0;
    const MAX_POLLS = 40; // 40 x 3s = 2 minutes
    let isDisposed = false;

    if (!orderCode) return () => {};

    loginBtn?.addEventListener('click', () => {
      if (typeof (window as any).openAuthModal === 'function') (window as any).openAuthModal();
      else window.location.href = '/masuk';
    });

    function showFeedback(text: string, isErr = false) {
      if (!actionMsg) return;
      actionMsg.textContent = text;
      actionMsg.className = `p-3.5 rounded-xl border text-xs font-mono ${
        isErr
          ? 'bg-red-50 dark:bg-red-500/10 border-red-200 dark:border-red-500/30 text-red-700 dark:text-red-300'
          : 'bg-neutral-100 dark:bg-white/5 border-neutral-200 dark:border-white/10 text-neutral-600 dark:text-muted-gray'
      }`;
      actionMsg.classList.remove('hidden');
    }

    function showErrorState(title: string, desc: string, needsAuth = false) {
      skeleton?.classList.add('hidden');
      content?.classList.add('hidden');
      expiredState?.classList.add('hidden');
      errorState?.classList.remove('hidden');
      if (errorTitle) errorTitle.textContent = title;
      if (errorDesc) errorDesc.textContent = desc;
      if (needsAuth) loginBtn?.classList.remove('hidden');
      else loginBtn?.classList.add('hidden');
    }

    async function loadOrderDetail() {
      if (orderCode === 'demo') {
        renderOrder({
          order_code: 'ORD-UKK-DEMO-2026',
          event_id: 1,
          nama_event: 'AFTERGLOW FESTIVAL 2026: VOID INCEPTION',
          poster_url: '',
          alamat: 'Gelora Bung Karno Stadium, Jakarta',
          tanggal_mulai: new Date(Date.now() + 7 * 86400000).toISOString(),
          status: 'pending',
          payment_mode: 'mock',
          total_amount: 1500000,
          diskon_amount: 0,
          platform_fee: calculatePlatformFee(1500000),
          final_amount: 1500000 + calculatePlatformFee(1500000),
          payment_expires_at: new Date(Date.now() + 14 * 60 * 1000).toISOString(),
          items: [{ nama_kategori: 'VIP PANGGUNG', qty: 1, harga_per_tiket: 1500000, subtotal: 1500000 }],
        });
        return;
      }

      if (!isAuthenticated()) {
        showErrorState(
          'AUTENTIKASI DIPERLUKAN',
          'Masuk ke akun yang melakukan checkout untuk melihat detail pembayaran dan QR e-tiket order ini.',
          true
        );
        return;
      }

      const urlParams = new URLSearchParams(window.location.search);
      const urlPaymentStatus = urlParams.get('status');
      let hasTriggeredInitialSync = false;

      try {
        const order = await api.get(`/orders/${orderCode}`);
        if (isDisposed) return;
        renderOrder(order);

        if (order.status === 'pending' && urlPaymentStatus === 'success' && !hasTriggeredInitialSync) {
          hasTriggeredInitialSync = true;
          showFeedback('Memverifikasi status pembayaran langsung ke gateway Xendit...');
          await checkOrderStatusOnce(false, true);
        }
      } catch (err: any) {
        if (isDisposed) return;
        const status = err instanceof ApiError ? err.status : 0;
        if (status === 401 || status === 403) {
          showErrorState('AKSES ORDER DITOLAK', err.message || 'Silakan login dengan akun pemilik order ini.', true);
        } else {
          showErrorState('ORDER TIDAK DITEMUKAN', err?.message || `Kode order ${orderCode} tidak tersedia.`);
        }
      }
    }

    function renderClosedState(status: string, order?: any) {
      content?.classList.add('hidden');
      expiredState?.classList.remove('hidden');

      const hasLatePayment = Boolean(order?.is_late_payment) || (status === 'refunded' && Boolean(order?.refund_id));

      if (hasLatePayment) {
        latePaymentBox?.classList.remove('hidden');
        refundTrackLink?.classList.remove('hidden');
        if (lateRefundStatus) {
          lateRefundStatus.textContent = String(order?.refund_status || 'pending').toUpperCase();
        }
        if (lateRefundReason) {
          lateRefundReason.textContent =
            order?.refund_reason ||
            'Pembayaran masuk setelah batas reservasi 15 menit berakhir. Dana Anda otomatis masuk antrean pengembalian dana platform.';
        }
      } else {
        latePaymentBox?.classList.add('hidden');
        refundTrackLink?.classList.add('hidden');
      }

      if (status === 'cancelled') {
        if (closedTitle) closedTitle.textContent = 'PESANAN TELAH DIBATALKAN';
        if (closedDesc) closedDesc.textContent = 'Pesanan ini telah dibatalkan dan kuota tiketnya sudah dilepas kembali ke publik.';
      } else if (status === 'refunded') {
        if (closedTitle) closedTitle.textContent = 'TRANSAKSI TELAH DI-REFUND';
        if (closedDesc) closedDesc.textContent = 'Dana pembelian tiket telah masuk dalam proses pengembalian dana.';
      } else if (hasLatePayment) {
        if (closedTitle) closedTitle.textContent = 'PEMBAYARAN TERLAMBAT // ANTREAN REFUND';
        if (closedDesc) closedDesc.textContent = 'Waktu reservasi sudah habis saat pembayaran tiba di Xendit. Kuota dilepas dan dana otomatis dijadwalkan untuk refund.';
      } else {
        if (closedTitle) closedTitle.textContent = 'SESI RESERVASI TELAH BERAKHIR';
        if (closedDesc) closedDesc.textContent = 'Batas waktu pembayaran 15 menit telah habis dan kuota tiket telah dikembalikan secara otomatis.';
      }
    }

    function renderOrder(order: any) {
      skeleton?.classList.add('hidden');
      errorState?.classList.add('hidden');

      if (order.status === 'paid') {
        window.location.href = `/orders/${orderCode}/receipt`;
        return;
      }

      if (order.status === 'expired' || order.status === 'cancelled' || order.status === 'refunded') {
        renderClosedState(order.status, order);
        return;
      }

      const urlPaymentStatus = new URLSearchParams(window.location.search).get('status');
      if (urlPaymentStatus === 'failed') {
        showFeedback('Pembayaran di Xendit dibatalkan atau gagal. Silakan coba lagi sebelum waktu reservasi berakhir.', true);
      }

      content?.classList.remove('hidden');

      if (codeDisplay) codeDisplay.textContent = order.order_code;
      if (eventPoster) eventPoster.src = resolveAssetUrl(order.poster_url);
      if (eventTitle) eventTitle.textContent = order.nama_event || 'AFTERGLOW Live Concert';
      if (eventVenue) eventVenue.textContent = order.alamat || '-';
      if (eventDate) eventDate.textContent = formatDateIndo(order.tanggal_mulai);

      if (itemsList && Array.isArray(order.items)) {
        itemsList.innerHTML = order.items
          .map((item: any) => {
            const unitPrice = Number(item.harga_per_tiket ?? item.price ?? item.harga ?? 0);
            const qty = Number(item.qty || 1);
            const sub = Number(item.subtotal ?? unitPrice * qty);
            const catName = item.nama_kategori || item.category_name || 'Tiket Konser';
            return `
              <div class="flex items-center justify-between p-3.5 rounded-xl bg-neutral-50 dark:bg-void-black/70 border border-neutral-200 dark:border-white/5 text-xs">
                <div>
                  <span class="font-bold text-neutral-950 dark:text-soft-white block">${escapeHtml(catName)}</span>
                  <span class="text-neutral-600 dark:text-muted-gray">${qty} tiket × ${escapeHtml(formatRupiah(unitPrice))}</span>
                </div>
                <span class="font-mono font-bold text-neutral-950 dark:text-soft-white">${escapeHtml(formatRupiah(sub))}</span>
              </div>
            `;
          })
          .join('');
      }

      const discountVal = Number(order.diskon_amount || 0);
      if (order.kode_voucher && voucherBadge && voucherCodeEl) {
        voucherBadge.classList.remove('hidden');
        voucherCodeEl.textContent = String(order.kode_voucher);
      } else {
        voucherBadge?.classList.add('hidden');
      }

      if (discountRow && discountAmount) {
        if (discountVal > 0) {
          discountRow.classList.remove('hidden');
          discountAmount.textContent = `- ${formatRupiah(discountVal)}`;
        } else {
          discountRow.classList.add('hidden');
        }
      }

      if (subtotalDisplay) subtotalDisplay.textContent = formatRupiah(order.total_amount);
      if (platformFeeDisplay) platformFeeDisplay.textContent = formatRupiah(order.platform_fee ?? 0);
      if (finalAmountDisplay) finalAmountDisplay.textContent = formatRupiah(order.final_amount);

      // Dual payment routing: Xendit live invoice vs Mock instant simulation
      if (order.payment_mode === 'xendit') {
        mockPayBtn?.classList.add('hidden');
        xenditBox?.classList.remove('hidden');
        if (xenditLink) {
          if (order.payment_url) {
            xenditLink.href = order.payment_url;
            xenditLink.classList.remove('hidden');
          } else {
            xenditLink.classList.add('hidden');
            showFeedback('Link invoice Xendit tidak tersedia untuk order ini. Klik Cek Status untuk memuat ulang.');
          }
        }
      } else {
        xenditBox?.classList.add('hidden');
        mockPayBtn?.classList.remove('hidden');
      }

      if (order.payment_expires_at) {
        startCountdown(order.payment_expires_at, order);
      }

      if (orderCode !== 'demo') {
        startPolling();
      }
    }

    function startCountdown(expiresAtStr: string, orderSnapshot?: any) {
      clearInterval(timerInterval);
      const expiresAt = new Date(expiresAtStr).getTime();
      let expirySynced = false;

      function tick() {
        const remaining = Math.max(0, Math.floor((expiresAt - Date.now()) / 1000));
        const { formatted } = formatCountdown(remaining);
        if (countdownTimer) countdownTimer.textContent = formatted;

        if (remaining <= 0) {
          clearInterval(timerInterval);
          clearInterval(pollingInterval);
          if (orderCode !== 'demo' && !expirySynced) {
            expirySynced = true;
            void checkOrderStatusOnce(false, orderSnapshot?.payment_mode === 'xendit', true);
          } else {
            renderClosedState('expired', orderSnapshot);
          }
        }
      }

      tick();
      timerInterval = setInterval(tick, 1000);
    }

    async function checkOrderStatusOnce(manual = false, forceSync = false, closeOnPendingExpired = false) {
      if (orderCode === 'demo') return;
      try {
        let check: any;
        let invoiceStatus: string | undefined;

        if (manual || forceSync) {
          const syncRes = await api.post<any>(`/orders/${orderCode}/sync-payment`);
          if (isDisposed) return;
          invoiceStatus = syncRes?.invoice_status;
          check = syncRes?.order ?? syncRes;
        } else {
          check = await api.get<any>(`/orders/${orderCode}`);
          if (isDisposed) return;
        }

        if (check?.status === 'paid') {
          clearInterval(pollingInterval);
          clearInterval(timerInterval);
          window.dispatchEvent(new CustomEvent('afterglow-active-order-changed'));
          window.location.href = `/orders/${orderCode}/receipt`;
          return;
        }
        if (check?.status === 'expired' || check?.status === 'cancelled' || check?.status === 'refunded') {
          clearInterval(pollingInterval);
          clearInterval(timerInterval);
          window.dispatchEvent(new CustomEvent('afterglow-active-order-changed'));
          renderClosedState(check.status, check);
          return;
        }
        if (closeOnPendingExpired) {
          renderClosedState('expired', check);
          return;
        }
        if (manual || forceSync) {
          const gwInfo = invoiceStatus ? ` (Gateway: ${invoiceStatus})` : '';
          showFeedback(`Status order masih PENDING${gwInfo} menunggu konfirmasi pembayaran. Selesaikan invoice lalu cek lagi.`);
        }
      } catch (err: any) {
        if (closeOnPendingExpired) {
          renderClosedState('expired');
          return;
        }
        if (manual || forceSync) showFeedback(err?.message || 'Gagal menyinkronkan status pembayaran.', true);
      }
    }

    function startPolling() {
      clearInterval(pollingInterval);
      pollCount = 0;
      pollingInterval = setInterval(async () => {
        if (document.hidden) return;
        pollCount++;
        if (pollCount > MAX_POLLS) {
          clearInterval(pollingInterval);
          showFeedback('Pengecekan otomatis dijeda sementara (2 menit). Klik "Saya Sudah Bayar" setelah transfer selesai.');
          return;
        }
        await checkOrderStatusOnce(false);
      }, 3000);
    }

    let checkStatusCooldown = false;
    checkStatusBtn?.addEventListener('click', async () => {
      if (!checkStatusBtn || checkStatusCooldown) return;
      checkStatusCooldown = true;
      checkStatusBtn.disabled = true;
      checkStatusBtn.textContent = 'Menyinkronkan ke Gateway...';
      await checkOrderStatusOnce(true, true);
      if (isDisposed) return;
      checkStatusBtn.textContent = 'Saya Sudah Bayar — Cek Status Transaksi Sekarang';
      setTimeout(() => {
        checkStatusCooldown = false;
        if (checkStatusBtn && !isDisposed) checkStatusBtn.disabled = false;
      }, 2500);
    });

    mockPayBtn?.addEventListener('click', async () => {
      if (orderCode === 'demo') {
        window.location.href = `/orders/demo/receipt`;
        return;
      }
      mockPayBtn.disabled = true;
      const text = mockPayBtn.querySelector('.btn-text');
      const spinner = mockPayBtn.querySelector('.btn-spinner');
      text?.classList.add('opacity-50');
      spinner?.classList.remove('hidden');

      try {
        await api.post(`/payments/mock-pay/${orderCode}`);
        window.dispatchEvent(new CustomEvent('afterglow-active-order-changed'));
        window.location.href = `/orders/${orderCode}/receipt`;
      } catch (err: any) {
        showFeedback(err?.message || 'Gagal memproses mock payment.', true);
        mockPayBtn.disabled = false;
        text?.classList.remove('opacity-50');
        spinner?.classList.add('hidden');
      }
    });

    cancelBtn?.addEventListener('click', async () => {
      const confirmCancel = confirm('Apakah Anda yakin ingin membatalkan pesanan ini? Kuota tiket akan langsung dilepas.');
      if (!confirmCancel) return;

      if (orderCode === 'demo') {
        window.location.href = '/events';
        return;
      }

      cancelBtn.disabled = true;
      try {
        await api.post(`/orders/${orderCode}/cancel`);
        clearInterval(timerInterval);
        clearInterval(pollingInterval);
        window.dispatchEvent(new CustomEvent('afterglow-active-order-changed'));
        renderClosedState('cancelled');
      } catch (err: any) {
        showFeedback(err?.message || 'Gagal membatalkan pesanan.', true);
        cancelBtn.disabled = false;
      }
    });

    const onAuthChanged = () => {
      loadOrderDetail();
    };
    window.addEventListener('afterglow-auth-changed', onAuthChanged);

    loadOrderDetail();

    return () => {
      isDisposed = true;
      clearInterval(timerInterval);
      clearInterval(pollingInterval);
      window.removeEventListener('afterglow-auth-changed', onAuthChanged);
    };
  }

  let orderCleanup: (() => void) | undefined;
  document.addEventListener('astro:page-load', () => {
    if (orderCleanup) orderCleanup();
    orderCleanup = initOrderCheckout();
  });
</script>
